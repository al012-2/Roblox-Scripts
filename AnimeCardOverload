-- Small adapters so the farm logic keeps using ".Text = ..." and "MouseButton1Click:Connect(...)"
local function proxyLabel(lbl)
    return setmetatable({}, { __newindex = function(_, k, v)
        if k == "Text" then pcall(function() lbl:SetText(tostring(v)) end) end
    end })
end
local function mkButton(group, text)
    local fns, btn = {}, nil
    btn = group:AddButton({ Text = text, Func = function()
        for _, fn in ipairs(fns) do task.spawn(fn) end
    end })
    return setmetatable({ MouseButton1Click = { Connect = function(_, fn) fns[#fns + 1] = fn end } }, {
        __newindex = function(_, k, v)
            if k == "Text" then pcall(function() btn:SetText(tostring(v)) end) end
        end })
end

