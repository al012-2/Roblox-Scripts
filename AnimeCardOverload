local function stateBoss(world, boss)
    local ws = qState and qState.Worlds and qState.Worlds[world]
    local info = ws and ws.Bosses and ws.Bosses[boss]
    return type(info) == "table" and info or nil
end

-- Bosses with nothing fightable (Ready == 0) are skipped until the world's next ReadyIn.
local function applyState(st)
    local now = os.clock()
    for _, w in ipairs(WORLDS) do
        local ws = st.Worlds[w.World]
        if type(ws) == "table" then
            local wait = tonumber(ws.ReadyIn) or 30
            if ws.Unlocked == false then wait = 600 end
            for boss, info in pairs(ws.Bosses or {}) do
                local dead = ws.Unlocked == false or (type(info) == "table" and (tonumber(info.Ready) or 1) == 0)
                if dead then
                    local t = now + math.max(wait, 5)
                    for d = 1, #DIFF do
                        local k = keyOf(w.World, boss, d)
                        if (nextAt[k] or 0) < t then nextAt[k] = t end
                    end
                end
            end
        end
    end
end

local function refreshState(force)
    if not force and os.clock() - qStateAt < 45 then return qState end
    qStateAt = os.clock()
    throttle()
    local ok, st = pcall(function() return R.GetStoryTicketState:InvokeServer() end)
    if ok and type(st) == "table" and type(st.Worlds) == "table" then
        qState = st
        ticketsLeft = tonumber(st.Tickets)
        applyState(st)
        updateTicketUI()
    end
    return qState
end

-- A world is farmed with tickets (instead of single fights) when it is fully cleared,
-- the script has learned how to use a ticket there, and tickets are left.
local function ticketMode(w)
    if not (S.Tickets and w.On and learned[w.World]) then return false end
    local ws = qState and qState.Worlds and qState.Worlds[w.World]
    return type(ws) == "table" and ws.Unlocked ~= false and (tonumber(ws.Missing) or 1) == 0
        and (tonumber(qState.Tickets) or 0) > 0
end

local function jsonSafe(v, d)
    d = d or 0
    local t = type(v)
    if t == "string" or t == "number" or t == "boolean" then return v, true end
    if t == "table" and d < 4 then
        local o = {}
        for k, x in pairs(v) do
            if type(k) ~= "string" and type(k) ~= "number" then return nil, false end
            local c, ok = jsonSafe(x, d + 1)
            if not ok then return nil, false end
            o[k] = c
        end
        return o, true
    end
    return nil, false
end

local function findWorld(v, d)
    d = d or 0
    if type(v) == "string" then
        for _, w in ipairs(WORLDS) do
            if w.World == v then return v end
        end
    elseif type(v) == "table" and d < 4 then
        for k, x in pairs(v) do
            local r = findWorld(k, d + 1) or findWorld(x, d + 1)
            if r then return r end
        end
    end
end

-- Called by the hook below when YOU press "Use Ticket" in the game: records the exact arguments.
