local function startTowers()
    if not (GG and GG.ResumeTowerWithRetry and GG.GetAfkRun) then
        log("[T] Couldn't find the game's tower functions (_G.ResumeTowerWithRetry / GetAfkRun)", C.bad)
        return
    end
    if not farmGate("Towers") then return end
    tRun += 1
    local my = tRun
    local function alive()
        return getgenv().TowerFarm and tRun == my and getgenv().TowerGen == tGen and not unloaded
    end
    setTRunning(true)
    log("[T] Tower farm started", C.good)
    task.spawn(function()
        while alive() do
            refreshTowerState(false)
            updateTowerRows()
            local busy = false
            for _, tw in ipairs(TW) do
                if not alive() then break end
                if tw.On and (tNext[tw.Id] or 0) <= os.clock() then
                    local part = towerStatus(tw)
                    if part then
                        busy = true
                        local other = runInfo(nil)
                        if other then
                            tStatus.Text = "A tower run is already active (" .. other .. "), waiting..."
                            task.wait(10)
                            break
                        end
                        currentTower = tw.Id
                        log(("[T] Starting %s from Part %d"):format(tw.Name, part), C.text)
                        local ok, why = runTower(tw, part, alive)
                        currentTower = nil
                        tStale = true
                        if not alive() then break end
                        if not ok then
                            tNext[tw.Id] = os.clock() + 300
                            log(("[T] %s: %s - retry in 5m"):format(tw.Name, tostring(why)), C.warn)
                        end
                        task.wait(5)
                        break
                    end
                end
            end
            if not busy then
                local soonest
                for _, tw in ipairs(TW) do
                    if tw.On then
                        local _, s = towerStatus(tw)
                        local n = (tNext[tw.Id] or 0) - os.clock()
                        if n > 0 then s = math.min(s or math.huge, n) end
                        if s and (not soonest or s < soonest) then soonest = s end
                    end
