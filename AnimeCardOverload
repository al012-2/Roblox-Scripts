local function refreshStats()
    local parts = {}
    for _, w in ipairs(WORLDS) do
        if (kills[w.World] or 0) > 0 then parts[#parts + 1] = w.World .. " " .. kills[w.World] end
    end
    killsL.Text = ("Bosses killed: %d%s%s"):format(wins,
        #parts > 0 and (" | " .. table.concat(parts, " · ")) or "",
        tparts > 0 and (" | Tower parts " .. tparts) or "")

    local names = {}
    for n in pairs(rewards) do names[#names + 1] = n end
    table.sort(names, function(a, b) return rewards[a] > rewards[b] end)
    local out = {}
    for _, n in ipairs(names) do out[#out + 1] = n .. " x" .. rewards[n] end
    rewL.Text = #out > 0 and table.concat(out, "   ·   ") or "No rewards yet"
    rewL.TextColor3 = #out > 0 and C.text or C.dim
end

