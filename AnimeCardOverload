local function startTowers()
    if not (GG and GG.ResumeTowerWithRetry and GG.GetAfkRun) then
        log("[T] Couldn't find the game's tower functions (_G.ResumeTowerWithRetry / GetAfkRun)", C.bad)
        return
    end
    tRun += 1
    local my = tRun
    local function alive()
        return getgenv().TowerFarm and tRun == my and getgenv().TowerGen == tGen
    end
    setTRunning(true)
    log("[T] Tower farm started", C.good)
    task.spawn(function()
        while alive() do
            refreshTowerState(false)
            updateTowerRows()
            local busy = false
            for _, tw in ipairs(TW) do
                if not alive() then break end
                if tw.On and (tNext[tw.Id] or 0) <= os.clock() then
                    local part = towerStatus(tw)
                    if part then
                        busy = true
                        local other = runInfo(nil)
                        if other then
                            tStatus.Text = "A tower run is already active (" .. other .. "), waiting..."
                            task.wait(10)
                            break
                        end
                        currentTower = tw.Id
                        log(("[T] Starting %s from Part %d"):format(tw.Name, part), C.text)
                        local ok, why = runTower(tw, part, alive)
                        currentTower = nil
                        tStale = true
                        if not alive() then break end
                        if not ok then
                            tNext[tw.Id] = os.clock() + 300
                            log(("[T] %s: %s - retry in 5m"):format(tw.Name, tostring(why)), C.warn)
                        end
                        task.wait(5)
                        break
                    end
                end
            end
            if not busy then
                local soonest
                for _, tw in ipairs(TW) do
                    if tw.On then
                        local _, s = towerStatus(tw)
                        local n = (tNext[tw.Id] or 0) - os.clock()
                        if n > 0 then s = math.min(s or math.huge, n) end
                        if s and (not soonest or s < soonest) then soonest = s end
                    end
                end
                tStatus.Text = soonest and ("Waiting, next tower run in " .. fmtWait(soonest)) or "No towers available"
                task.wait(5)
            end
        end
    end)
end

tStartB.MouseButton1Click:Connect(function()
    if getgenv().TowerFarm then
        tRun += 1
        setTRunning(false)
        log("[T] Stopped (a run already in progress finishes on its own)", C.bad)
    else
        startTowers()
    end
end)

tSpeedB.MouseButton1Click:Connect(function()
    if lp:GetAttribute("BattleSpeedUnlocked") ~= true then
        log("[T] Battle speed isn't unlocked on this account", C.warn)
        return
    end
    local mx = tonumber(lp:GetAttribute("MaxBattleSpeed")) or 1
    if GG and type(GG.UpdateSetting) == "function" then
        pcall(GG.UpdateSetting, "BattleSpeed", mx)
        log("[T] Battle speed set to " .. mx .. "x", C.good)
    else
        log("[T] Couldn't reach the game's settings", C.bad)
    end
end)

tEndB.MouseButton1Click:Connect(function()
    local id = runInfo(nil)
    if not id then
        log("[T] No tower run is active", C.dim)
        return
    end
    local ok = pcall(function() return R.EndTowerRun:InvokeServer(id) end)
    tNext[id] = os.clock() + 600
    tStale = true
    log("[T] Ended " .. id .. (ok and "" or " (request failed)") .. " - paused 10m", ok and C.warn or C.bad)
end)

local minimized = false
minB.MouseButton1Click:Connect(function()
