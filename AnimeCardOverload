local function hFlat(t, skip, depth)
    depth = depth or 0
    local o = {}
    for k, v in pairs(t) do
        if k ~= skip then
            local val = tostring(v)
            if type(v) == "table" then
                val = depth < 2 and ("{" .. hFlat(v, nil, depth + 1) .. "}") or "{...}"
            end
            o[#o + 1] = tostring(k) .. "=" .. val
        end
    end
    return table.concat(o, ", ")
end

local function hSummary(rem)
    if not rem then return nil end
    local ok, r = pcall(function() return rem:InvokeServer("Hard") end)
    if ok and type(r) == "table" then return r end
end

local function hItems(s)
    local out = {}
    if type(s) == "table" and type(s.Items) == "table" then
        for _, it in ipairs(s.Items) do
            if type(it) == "table" and it.Name then
                out[#out + 1] = tostring(it.Name) .. " x" .. tostring(it.Count or 1)
            end
        end
    end
    return table.concat(out, ", ")
end

local function hShow(s)
    if type(s) == "table" then
        hInfo.Text = ("Floor %s | Best %s | RewardMult x%s | Climbed %d"):format(
            tostring(s.Floor), tostring(s.Best), tostring(s.RewardMult or 1), hclimbed)
    end
end

local function setHRunning(on)
    getgenv().HardFarm = on
    hStartB.Text = on and "STOP" or "START"
    if not on then hStatus.Text = "Idle" end
end

local function startHard()
    local nextRem = findRem("TowerNextFloor")
    local sumRem  = findRem("GetTowerRunSummary")
    local hideRem = findRem("SetTowerHidden")
    if not nextRem then log("[H] TowerNextFloor remote not found", C.bad) return end
    if not sumRem then log("[H] GetTowerRunSummary remote not found (needed to detect defeat)", C.bad) return end

    local s = hSummary(sumRem)
    if not s then
        log("[H] Couldn't read the Hard run state - is a Hard run active?", C.warn)
        return
    end
    if s.Active == false then
        log("[H] No active Hard run. Start one in the game (Hard Tower NPC), then press START.", C.warn)
        return
    end

    hRun += 1
    local my = hRun
    local function alive() return getgenv().HardFarm and hRun == my and not unloaded end
    local function finish(reason, col)
        if hRun == my then
            setHRunning(false)
            log("[H] Stopped: " .. reason, col or C.warn)
        end
    end

    setHRunning(true)
    log(("[H] Started from floor %s (%ds per floor%s)"):format(tostring(s.Floor), HS.Interval,
        HS.StopAt > 0 and (", stop at " .. HS.StopAt) or ""), C.good)
    if hideRem then pcall(function() hideRem:FireServer(true) end) end -- same as the game's hidden mode

    task.spawn(function()
        local stuck, errs, probes, extra = 0, 0, 0, 0
        local lastFloor = tonumber(s.Floor)
        hShow(s)

        while alive() do
            local t0 = os.clock()
            if HS.StopAt > 0 and lastFloor and lastFloor >= HS.StopAt then
                return finish("reached floor " .. lastFloor, C.good)
            end
            if not throttle(alive) then return end
            hStatus.Text = "Climbing to floor " .. tostring((lastFloor or 0) + 1)

            local ok, res = pcall(function() return nextRem:InvokeServer("Hard") end)
            local slow = false
            if not ok then
                errs += 1
                log("[H] error: " .. tostring(res):sub(1, 120), C.warn)
                if errs >= 3 then return finish("too many errors", C.bad) end
                task.wait(30)
            else
                errs = 0
                if type(res) == "table" then
                    if probes < 3 then
                        probes += 1
                        local n = type(res.Log) == "table" and #res.Log or 0
                        log(("[H] reply#%d Log=%d | %s"):format(probes, n, hFlat(res, "Log"):sub(1, 300)), C.dim)
                    end
                elseif res ~= nil then
                    local m = tostring(res)
                    log("[H] reply: " .. m:sub(1, 120), C.dim)
                    if m:lower():find("slow") then
                        slow = true
                        extra = math.min(extra + 2, 12)
                    end
                end

                local s2 = hSummary(sumRem)
                if s2 then
                    local fl = tonumber(s2.Floor)
                    if fl and lastFloor and fl > lastFloor then
                        hclimbed += fl - lastFloor
                        stuck = 0
                        refreshStats()
                    elseif not slow then
                        stuck += 1
                    end
                    lastFloor = fl or lastFloor
                    hShow(s2)
                    if s2.Active == false then
                        local it = hItems(s2)
                        log("[H] Run ended" .. (it ~= "" and (" | items: " .. it) or ""), C.warn)
                        return finish("run is no longer active")
                    end
                    if stuck >= 3 then
                        return finish(("floor not advancing (%dx) - probably defeated"):format(stuck), C.bad)
                    end
                end

                local target = HS.Interval + extra
                while alive() and os.clock() - t0 < target do
                    hStatus.Text = ("Next floor in %ds"):format(math.ceil(target - (os.clock() - t0)))
                    task.wait(1)
                end
            end
        end
    end)
end

