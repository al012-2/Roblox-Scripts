local function startFarm()
    if not farmGate("Story") then return end
    runId += 1
    local my = runId
    local function alive() return getgenv().StoryFarm and runId == my end
    local act = {}
    inFlight = {}
    wstatus = {}
    setRunning(true)
    lastSlow = os.clock()
    log(("Farm started (%d fight%s at once)"):format(S.Workers, S.Workers > 1 and "s" or ""), C.good)

    refreshState(true)
    task.spawn(function()
        while alive() do
            ticketPass(alive)
            for _ = 1, 45 do
                if not alive() then return end
                task.wait(1)
            end
            refreshState(true)
        end
    end)

    spawnWorker = function(idx)
        if act[idx] then return end
        act[idx] = true
        task.spawn(function()
            while alive() and idx <= S.Workers do
                local w, boss, diff, key = pickJob()
                if not w then
                    decayGap()
                    local soonest
                    for _, t in pairs(nextAt) do
                        if t > os.clock() and (not soonest or t < soonest) then soonest = t end
                    end
                    if idx == 1 then
                        wstatus[1] = "#1 " .. (soonest
                            and ("All on cooldown, next in %ds"):format(math.ceil(soonest - os.clock()))
                            or (next(inFlight) and "Waiting for the other fight" or "No bosses available"))
                    else
                        wstatus[idx] = nil
                    end
                    if alive() then updateStatus() end
                    task.wait(2)
                else
                    wstatus[idx] = ("#%d %s/%s [%s]"):format(idx, w.World, boss, DIFF[diff][1])
                    updateStatus()
                    local ok, info, cd, kind, res = fight(w, boss, diff, alive)
                    inFlight[key] = nil
                    if kind == "stop" then break end
                    if ok then
                        failCount[key] = 0
                        if weakList[key] then
                            weakList[key] = nil
                            updateWeakUI()
                        end
                        local binfo = stateBoss(w.World, boss)
                        if binfo and (tonumber(binfo.Cleared) or 0) < diff then binfo.Cleared = diff end
                        log(("#%d %s/%s [%s] %s"):format(idx, w.World, boss, DIFF[diff][1], tostring(info)), C.good)
                        wins += 1
                        kills[w.World] = (kills[w.World] or 0) + 1
                        if res then tallyRewards(res) end
                        refreshStats()
                        decayGap()
                        nextAt[key] = os.clock() + 3540
                    else
                        if kind == "lost" then
                            failCount[key] = (failCount[key] or 0) + 1
                            if failCount[key] == 1 then
                                nextAt[key] = os.clock() + 15
                                log(("⚠️ #%d خسارة أولى ضد %s [%s] - بيعيد المحاولة بعد 15 ثانية..."):format(
                                    idx, boss, DIFF[diff][1]), C.warn)
                            else
                                for d2 = diff, w.Diff do
                                    nextAt[keyOf(w.World, boss, d2)] = os.clock() + (cd or 600)
                                end
                                weakList[key] = { world = w.World, boss = boss, diff = diff, diffName = DIFF[diff][1] }
                                updateWeakUI()
                                log(("❌ يونتاتك ضعيفة ضد %s [%s]! قوي يونتاتك واضغط Retry Weak (أو بينتظر 10 دقايق)"):format(
                                    boss, DIFF[diff][1]), C.bad)
                            end
                        elseif kind == "locked" then
                            log(("#%d %s/%s [%s] %s"):format(idx, w.World, boss, DIFF[diff][1], tostring(info)), C.dim)
                            for d2 = diff, w.Diff do
                                nextAt[keyOf(w.World, boss, d2)] = os.clock() + (cd or 600)
                            end
                        else
                            log(("#%d %s/%s [%s] %s"):format(idx, w.World, boss, DIFF[diff][1], tostring(info)), C.dim)
                            nextAt[key] = os.clock() + (cd or 60)
                        end
                    end
                end
            end
            wstatus[idx] = nil
            act[idx] = nil
            if alive() then updateStatus() end
        end)
    end

    for i = 1, S.Workers do spawnWorker(i) end
end

