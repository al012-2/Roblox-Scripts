local SLOT_OF = { Story = "STORY", Towers = "RUN", Halloween = "RUN", Hard = "RUN", Raid = "RUN" }
local FARM_NAME = {
    Story = "Story farm", Towers = "Battle Towers", Halloween = "Halloween Tower",
    Hard = "Hard Tower", Raid = "Auto Raid",
}
local FARM_ORDER = { "Story", "Towers", "Halloween", "Hard", "Raid" }
local slotUser = {}

local function updateFarmUI()
    local names = {}
    for _, f in ipairs(FARM_ORDER) do
        if slotUser[SLOT_OF[f]] == f then names[#names + 1] = FARM_NAME[f] end
    end
    farmL.Text = ("Running (%d/2): %s"):format(#names, #names > 0 and table.concat(names, " + ") or "nothing")
end

local function farmGate(name)
    local slot = SLOT_OF[name]
    local cur = slotUser[slot]
    if cur and cur ~= name then
        log(("Can't start %s: %s is running. Turn %s off first."):format(
            FARM_NAME[name], FARM_NAME[cur], FARM_NAME[cur]), C.bad)
        return false
    end
    slotUser[slot] = name
    updateFarmUI()
    return true
end

local function farmFree(name)
    local slot = SLOT_OF[name]
    if slotUser[slot] == name then
        slotUser[slot] = nil
        updateFarmUI()
    end
end


