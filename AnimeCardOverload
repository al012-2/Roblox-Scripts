    local function fmtNum(n)
        n = tonumber(n) or 0
        if n >= 1e12 then return ("%.2fT"):format(n / 1e12) end
        if n >= 1e9 then return ("%.2fB"):format(n / 1e9) end
        if n >= 1e6 then return ("%.2fM"):format(n / 1e6) end
        if n >= 1e3 then return ("%.1fK"):format(n / 1e3) end
        return tostring(math.floor(n))
    end
    local asuraL = proxyLabel(box:AddLabel("Asura auto: off", true))
    local asuraTog = box:AddToggle("AsuraAuto", { Text = "Auto fight Asura (repeat while boss is here)", Default = false,
        Callback = function(on)
            S.AsuraAuto = on == true
            triggerSave()
            asuraRun += 1
            local my = asuraRun
            if not on then
                asuraL.Text = "Asura auto: off"
                log("[Asura] Auto stopped", C.dim)
                return
            end
            local function alive() return asuraRun == my and not unloaded end
            local function sleep(n)
                for _ = 1, n do
                    if not alive() then return false end
                    task.wait(1)
                end
                return alive()
            end
            log("[Asura] Auto started (team " .. S.Team .. ")", C.good)
            task.spawn(function()
                local probes = 0
                while alive() do
                    local rem = R:FindFirstChild("FightAsura")
                    if not rem then
                        log("[Asura] FightAsura remote not found", C.bad)
                        asuraL.Text = "Asura auto: remote missing"
                        return
                    end
                    asuraL.Text = ("Asura auto: fighting | fights %d"):format(asuraFights)
                    local ok, res, msg = pcall(function() return rem:InvokeServer(S.Team) end)
                    if probes < 5 then
                        probes += 1
                        local raw = type(res) == "table" and dumpTable(res) or tostring(res)
                        log(("[Asura] reply#%d ok=%s %s %s"):format(probes, tostring(ok), raw:sub(1, 200),
                            msg ~= nil and tostring(msg) or ""), C.dim)
                    end
                    local m = tostring(msg or (type(res) == "string" and res) or ""):lower()
                    local failed = (not ok) or res == nil or res == false or type(res) == "string"
                        or (type(res) == "table" and (res.Ok == false or res.Success == false or res.Error ~= nil))
                    if not ok then
                        if not sleep(30) then return end
                    elseif m:find("slow") then
                        if not sleep(10) then return end
                    elseif m:find("busy") then
                        asuraL.Text = "Asura auto: battle slots busy, retry in 15s"
                        if not sleep(15) then return end
                    elseif failed then
                        asuraL.Text = "Asura auto: boss not available, retry in 60s"
                        if not sleep(60) then return end
                    elseif type(res) == "table" and res.GrantId then
                        if not sleep(S.FightDelay) then return end
                        local claimed = false
                        for _ = 1, S.MaxDoneTries do
                            local okC, done = pcall(function()
                                local gr = R:FindFirstChild(res.GrantRemote or "AsuraFightDone") or R.AsuraFightDone
                                return gr:InvokeServer(res.GrantId)
                            end)
                            if okC and done then claimed = true break end
                            if not sleep(S.RetryDelay) then return end
                        end
                        if claimed then
                            asuraFights += 1
                            asuraDmg += tonumber(res.BossDamage) or 0
                            asuraL.Text = ("Asura auto: fights %d | damage %s"):format(asuraFights, fmtNum(asuraDmg))
                            log(("[Asura] Fight #%d claimed | +%s damage (session %s)"):format(
                                asuraFights, fmtNum(tonumber(res.BossDamage) or 0), fmtNum(asuraDmg)), C.good)
                        else
                            log("[Asura] AsuraFightDone failed - retrying in 15s", C.warn)
                            if not sleep(15) then return end
                        end
                        if not sleep(2) then return end
                    else
                        log("[Asura] Unknown reply: " .. (type(res) == "table" and dumpTable(res) or tostring(res)):sub(1, 200), C.warn)
                        if not sleep(15) then return end
                    end
                end
            end)
        end })

    if S.AsuraAuto then
        task.defer(function() pcall(function() asuraTog:SetValue(true) end) end)
    end

    box:AddLabel("Windows that load data from the server when they open may look empty if forced open. If one does, open it the normal way in the game.", true)

    task.wait(3)
    fill()
end)
