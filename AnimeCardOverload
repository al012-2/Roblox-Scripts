local function applyState(st)
    local now = os.clock()
    for _, w in ipairs(WORLDS) do
        local ws = st.Worlds[w.World]
        if type(ws) == "table" then
            local wait = tonumber(ws.ReadyIn) or 30
            if ws.Unlocked == false then wait = 600 end
            for boss, info in pairs(ws.Bosses or {}) do
                local dead = ws.Unlocked == false or (type(info) == "table" and (tonumber(info.Ready) or 1) == 0)
                if dead then
                    local t = now + math.max(wait, 5)
                    for d = 1, #DIFF do
                        local k = keyOf(w.World, boss, d)
                        if (nextAt[k] or 0) < t then nextAt[k] = t end
                    end
                end
            end
        end
    end
end

