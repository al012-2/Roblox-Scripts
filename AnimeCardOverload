local function ticketPass(alive)
    if not S.Tickets then return end
    for _, w in ipairs(WORLDS) do
        if not alive() then return end
        local ws = qState and qState.Worlds and qState.Worlds[w.World]
        if ws and ticketMode(w) and (ticketNext[w.World] or 0) <= os.clock()
            and (tonumber(ws.Ready) or 0) >= S.TicketMin then
            local before = tonumber(ws.Ready) or 0
            local leftBefore = tonumber(qState.Tickets) or 0
            local args = learned[w.World]
            if not throttle(alive) then return end
            local ok, res = pcall(function()
                return R.UseStoryTicket:InvokeServer(table.unpack(args, 1, #args))
            end)
            -- قتال التذكرة مثل القتال العادي: لو رجع GrantId لازم نستلم الجائزة وإلا تضيع
            if ok and type(res) == "table" and res.GrantId and res.Winner ~= false then
                claimGrant(res)
            end
            local detail = type(res) == "table" and dumpTable(res) or tostring(res)
            task.wait(1)
            refreshState(true)
            local ws2 = qState and qState.Worlds and qState.Worlds[w.World]
            local after = ws2 and tonumber(ws2.Ready) or before
            if ok and after < before then
                local got = before - after
                wins += got
                kills[w.World] = (kills[w.World] or 0) + got
                if type(res) == "table" then tallyRewards(res) end
                refreshStats()
                triggerSave()
                log(("[Tickets] %s: %d bosses collected (ready %d -> %d, tickets %d -> %s)"):format(
                    w.World, got, before, after, leftBefore, tostring(ticketsLeft)), C.good, true)
            else
                ticketNext[w.World] = os.clock() + 600
                S.Tickets = false
                setTicketBtn()
                triggerSave()
                log(("[Tickets] %s: used a ticket but nothing changed (%s). Tickets turned OFF to protect your tickets.")
                    :format(w.World, detail), C.bad)
            end
        end
    end
end

-- يرجع أول قتال جاهز. وإذا ما فيه، يرجع أقرب وقت جاهزية من البوسات اللي فعلاً بيقاتلها
-- (قبل كان العداد "next in Xs" يحسب كولداونات عوالم مقفلة/مطفية فيطلع رقم ما له معنى)
local function pickJob()
    local soonest, ticketWait = nil, nil
    local now = os.clock()
    for _, w in ipairs(WORLDS) do
        if w.On and ticketMode(w) then
            local ws = qState and qState.Worlds and qState.Worlds[w.World]
            ticketWait = (ticketWait and (ticketWait .. ", ") or "")
                .. ("%s %d/%d"):format(w.World, tonumber(ws and ws.Ready) or 0, S.TicketMin)
        elseif w.On then
            for _, boss in ipairs(bossList(w)) do
                local lo = S.All and 1 or w.Diff
                local hi = w.Diff
                local binfo = stateBoss(w.World, boss)
                if binfo and tonumber(binfo.Cleared) then hi = math.min(hi, binfo.Cleared + 1) end
                for diff = lo, hi do
                    local key = keyOf(w.World, boss, diff)
                    if not inFlight[key] then
                        local t = nextAt[key] or 0
                        if t <= now then
                            inFlight[key] = true
                            return w, boss, diff, key
                        end
                        if not soonest or t < soonest then soonest = t end
                    end
                end
            end
        end
    end
    return nil, nil, nil, nil, soonest, ticketWait
end

local function fmtLeft(sec)
    sec = math.max(0, math.ceil(sec))
    if sec >= 3600 then return ("%dh %dm"):format(sec // 3600, (sec % 3600) // 60) end
    if sec >= 60 then return ("%dm %ds"):format(sec // 60, sec % 60) end
    return sec .. "s"
end

local spawnWorker

local function startFarm()
    if not farmGate("Story") then return end
    runId += 1
    local my = runId
    local function alive() return getgenv().StoryFarm and runId == my and not unloaded end
    local act = {}
    inFlight = {}
    wstatus = {}
    setRunning(true)
    lastSlow = os.clock()
    log(("Farm started (%d fight%s at once)"):format(S.Workers, S.Workers > 1 and "s" or ""), C.good)

    refreshState(true)
    task.spawn(function()
        while alive() do
            ticketPass(alive)
            for _ = 1, 45 do
                if not alive() then return end
                task.wait(1)
            end
            refreshState(true)
        end
    end)

    spawnWorker = function(idx)
        if act[idx] then return end
        act[idx] = true
        task.spawn(function()
            while alive() and idx <= S.Workers do
                local w, boss, diff, key, soonest, ticketWait = pickJob()
                if not w then
                    decayGap()
                    if idx == 1 then
                        local txt
                        if soonest then
                            txt = "All on cooldown, next in " .. fmtLeft(soonest - os.clock())
                        elseif next(inFlight) then
                            txt = "Waiting for the other fight"
                        elseif ticketWait then
                            txt = "Saving bosses for a ticket (" .. ticketWait .. ")"
                        else
                            txt = "No bosses to farm (turn a world ON)"
                        end
                        if soonest and ticketWait then txt = txt .. " | tickets: " .. ticketWait end
                        wstatus[1] = "#1 " .. txt
                    else
                        wstatus[idx] = nil
                    end
                    if alive() then updateStatus() end
                    task.wait(2)
                else
                    wstatus[idx] = ("#%d %s/%s [%s]"):format(idx, w.World, boss, DIFF[diff][1])
                    updateStatus()
                    local ok, info, cd, kind, res = fight(w, boss, diff, alive)
                    inFlight[key] = nil
                    if kind == "stop" then break end
                    if ok then
                        failCount[key] = 0
                        if weakList[key] then
                            weakList[key] = nil
                            updateWeakUI()
                        end
                        local binfo = stateBoss(w.World, boss)
                        if binfo and (tonumber(binfo.Cleared) or 0) < diff then binfo.Cleared = diff end
                        log(("#%d %s/%s [%s] %s"):format(idx, w.World, boss, DIFF[diff][1], tostring(info)), C.good)
                        wins += 1
                        kills[w.World] = (kills[w.World] or 0) + 1
                        if res then tallyRewards(res) end
                        refreshStats()
                        decayGap()
                        nextAt[key] = os.clock() + 3540
                        triggerSave()
                    else
                        if kind == "lost" then
                            failCount[key] = (failCount[key] or 0) + 1
                            if failCount[key] == 1 then
                                nextAt[key] = os.clock() + 15
                                log(("⚠️ #%d خسارة أولى ضد %s [%s] - بيعيد المحاولة بعد 15 ثانية..."):format(
                                    idx, boss, DIFF[diff][1]), C.warn)
                            else
                                for d2 = diff, w.Diff do
                                    nextAt[keyOf(w.World, boss, d2)] = os.clock() + (cd or 600)
                                end
                                weakList[key] = { world = w.World, boss = boss, diff = diff, diffName = DIFF[diff][1] }
                                updateWeakUI()
                                log(("❌ يونتاتك ضعيفة ضد %s [%s]! قوي يونتاتك واضغط Retry Weak (أو بينتظر 10 دقايق)"):format(
                                    boss, DIFF[diff][1]), C.bad)
                            end
                        elseif kind == "locked" then
                            log(("#%d %s/%s [%s] %s"):format(idx, w.World, boss, DIFF[diff][1], tostring(info)), C.dim)
                            for d2 = diff, w.Diff do
                                nextAt[keyOf(w.World, boss, d2)] = os.clock() + (cd or 600)
                            end
                        else
                            log(("#%d %s/%s [%s] %s"):format(idx, w.World, boss, DIFF[diff][1], tostring(info)), C.dim)
                            nextAt[key] = os.clock() + (cd or 60)
                        end
                        triggerSave()
                    end
                end
            end
            wstatus[idx] = nil
            act[idx] = nil
            if alive() then updateStatus() end
        end)
    end

    for i = 1, S.Workers do spawnWorker(i) end
end

