-- ==================== Anti-AFK (Fixed Hook) ====================
do
    getgenv().AntiAfkToken = (getgenv().AntiAfkToken or 0) + 1
    local token = getgenv().AntiAfkToken
    if getgenv().AntiAfkConn then pcall(function() getgenv().AntiAfkConn:Disconnect() end) end

    getgenv().BlockAutoRejoin = true

    getgenv().AntiAfkConn = lp.Idled:Connect(function()
        VU:CaptureController()
        VU:ClickButton2(Vector2.new())
    end)

    local function pressStay()
        local fired = false
        pcall(function()
            local stay = lp.PlayerGui.AutoRejoinUI.Root.StayButton
            if getconnections then
                for _, c in ipairs(getconnections(stay.MouseButton1Click)) do
                    c:Fire()
                    fired = true
                end
            end
            if not fired and firesignal then
                firesignal(stay.MouseButton1Click)
                fired = true
            end
        end)
        return fired
    end

    task.spawn(function()
        while getgenv().AntiAfkToken == token do
            pcall(function()
                VU:CaptureController()
                VU:ClickButton2(Vector2.new())
            end)
            pressStay()
            task.wait(60)
        end
    end)

    -- Hook only once per session; the flag decides whether it blocks or not
    if hookmetamethod and getnamecallmethod and not getgenv().AutoRejoinHooked then
        pcall(function()
            local AutoRejoin = R:WaitForChild("AutoRejoin", 5)
            if AutoRejoin then
                getgenv().AutoRejoinHooked = true
                local old
                local function handler(self, ...)
                    if getgenv().BlockAutoRejoin
                        and self == AutoRejoin
                        and not (checkcaller and checkcaller())
                        and getnamecallmethod() == "FireServer" then
                        return
                    end
                    return old(self, ...)
                end
                old = hookmetamethod(game, "__namecall", newcclosure and newcclosure(handler) or handler)
            end
        end)
    end
end

