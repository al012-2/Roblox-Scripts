local function ticketPass(alive)
    if not S.Tickets then return end
    for _, w in ipairs(WORLDS) do
        if not alive() then return end
        local ws = qState and qState.Worlds and qState.Worlds[w.World]
        if ws and ticketMode(w) and (ticketNext[w.World] or 0) <= os.clock()
            and (tonumber(ws.Ready) or 0) >= S.TicketMin then
            local before = tonumber(ws.Ready) or 0
            local leftBefore = tonumber(qState.Tickets) or 0
            local args = learned[w.World]
            if not throttle(alive) then return end
            local ok, res = pcall(function()
                return R.UseStoryTicket:InvokeServer(table.unpack(args, 1, #args))
            end)
            local detail = type(res) == "table" and dumpTable(res) or tostring(res)
            task.wait(1)
            refreshState(true)
            local ws2 = qState and qState.Worlds and qState.Worlds[w.World]
            local after = ws2 and tonumber(ws2.Ready) or before
            if ok and after < before then
                local got = before - after
                wins += got
                kills[w.World] = (kills[w.World] or 0) + got
                if type(res) == "table" then tallyRewards(res) end
                refreshStats()
                log(("[Tickets] %s: %d bosses collected (ready %d -> %d, tickets %d -> %s)"):format(
                    w.World, got, before, after, leftBefore, tostring(ticketsLeft)), C.good)
            else
                ticketNext[w.World] = os.clock() + 600
                S.Tickets = false
                setTicketBtn()
                log(("[Tickets] %s: used a ticket but nothing changed (%s). Tickets turned OFF to protect your tickets.")
                    :format(w.World, detail), C.bad)
            end
        end
    end
end

local function pickJob()
    for _, w in ipairs(WORLDS) do
        if w.On and not ticketMode(w) then
            for _, boss in ipairs(bossList(w)) do
                local lo = S.All and 1 or w.Diff
                local hi = w.Diff
                local binfo = stateBoss(w.World, boss)
                if binfo and tonumber(binfo.Cleared) then hi = math.min(hi, binfo.Cleared + 1) end
                for diff = lo, hi do
                    local key = keyOf(w.World, boss, diff)
                    if not inFlight[key] and (nextAt[key] or 0) <= os.clock() then
                        inFlight[key] = true
                        return w, boss, diff, key
                    end
                end
            end
        end
    end
end

