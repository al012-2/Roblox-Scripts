local logCount = 0
local logLabels = {}
local function log(msg, col)
    logCount += 1
    local lbl = new("TextLabel", { Text = os.date("%H:%M:%S") .. "  " .. msg, Size = UDim2.new(1, -8, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, TextColor3 = col or C.text,
        Font = Enum.Font.Code, TextSize = 12, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = logCount, Parent = logF })
    logLabels[#logLabels + 1] = lbl
    while #logLabels > 60 do
        local oldest = table.remove(logLabels, 1)
        if oldest then oldest:Destroy() end
    end
    task.defer(function() logF.CanvasPosition = Vector2.new(0, 1e6) end)
end

