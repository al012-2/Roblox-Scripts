getgenv().TowerOnResult = function(res)
    if type(res) ~= "table" then return end
    local id = res.BattleTower or currentTower or "?"
    if res.Died then
        tDeaths[id] = (tDeaths[id] or 0) + 1
        log(("[T] Defeated on %s Part %s wave %s (%d/%d)"):format(
            tostring(id), tostring(res.Part), tostring(res.Wave), tDeaths[id], TS.MaxDeaths), C.bad)
        if tDeaths[id] >= TS.MaxDeaths then
            tDeaths[id] = 0
            tNext[id] = os.clock() + 1800
            log("[T] " .. tostring(id) .. " paused for 30m after repeated defeats - try another team", C.warn)
        else
            tNext[id] = os.clock() + 30
        end
        tStale = true
    elseif res.AllOnCooldown then
        local n = tonumber(res.NextReadyIn)
        log("[T] All parts are cooling down" .. ((n and n < math.huge) and (", next in " .. fmtWait(n)) or ""), C.dim)
        tStale = true
    elseif res.Part then
        tparts += 1
        tDeaths[id] = 0
        tStale = true
        refreshStats()
        log(("[T] %s Part %s cleared%s"):format(tostring(id), tostring(res.Part),
            res.FirstClear and " (first clear)" or ""), C.good)
    end
    if res.Artifact then log("[T] Got artifact: " .. tostring(res.Artifact), C.good) end
    if res.UnlockedCard then log("[T] Unlocked card: " .. tostring(res.UnlockedCard), C.good) end
end

-- is a battle tower run active? (id = that tower, nil = any battle tower)
local function runInfo(id)
    local ok, r = pcall(function() return GG.GetAfkRun and GG.GetAfkRun() end)
    if not (ok and type(r) == "table") then return nil end
    for _, e in ipairs({ r, r.Also }) do
        if type(e) == "table" and type(e.Tower) == "string" then
            if id == nil then
                if BTD and BTD.Get and BTD.Get(e.Tower) then return e.Tower end
            elseif e.Tower == id then
                return e.Tower
            end
        end
    end
    return nil
end

local function runTower(tw, part, alive)
    local opts = { Part = part }
    if TS.Team then opts.Team = TS.Team end
    GG.ResumeTowerWithRetry(true, tw.Id, opts)
    local t0, seen = os.clock(), false
    while alive() do
        task.wait(2)
        if runInfo(tw.Id) then
            seen = true
            tStatus.Text = ("Running %s from Part %d | parts cleared %d"):format(tw.Name, part, tparts)
            updateTowerRows()
        elseif seen then
            return true
        elseif os.clock() - t0 > 90 then
            return false, "the run didn't start (see the game's error toast)"
        end
    end
    return seen, "stopped"
end

local function setTRunning(on)
    getgenv().TowerFarm = on
    tStartB.Text = on and "STOP" or "START"
    tStartB.BackgroundColor3 = on and C.bad or C.good
    if not on then tStatus.Text = "Idle" end
end

local function startTowers()
    if not (GG and GG.ResumeTowerWithRetry and GG.GetAfkRun) then
        log("[T] Couldn't find the game's tower functions (_G.ResumeTowerWithRetry / GetAfkRun)", C.bad)
        return
    end
    tRun += 1
    local my = tRun
    local function alive()
        return getgenv().TowerFarm and tRun == my and getgenv().TowerGen == tGen
    end
    setTRunning(true)
    log("[T] Tower farm started", C.good)
    task.spawn(function()
        while alive() do
            refreshTowerState(false)
            updateTowerRows()
            local busy = false
            for _, tw in ipairs(TW) do
                if not alive() then break end
                if tw.On and (tNext[tw.Id] or 0) <= os.clock() then
                    local part = towerStatus(tw)
                    if part then
                        busy = true
                        local other = runInfo(nil)
                        if other then
                            tStatus.Text = "A tower run is already active (" .. other .. "), waiting..."
                            task.wait(10)
                            break
                        end
                        currentTower = tw.Id
                        log(("[T] Starting %s from Part %d"):format(tw.Name, part), C.text)
                        local ok, why = runTower(tw, part, alive)
                        currentTower = nil
                        tStale = true
                        if not alive() then break end
                        if not ok then
                            tNext[tw.Id] = os.clock() + 300
                            log(("[T] %s: %s - retry in 5m"):format(tw.Name, tostring(why)), C.warn)
                        end
                        task.wait(5)
                        break
                    end
                end
            end
            if not busy then
                local soonest
                for _, tw in ipairs(TW) do
                    if tw.On then
                        local _, s = towerStatus(tw)
                        local n = (tNext[tw.Id] or 0) - os.clock()
                        if n > 0 then s = math.min(s or math.huge, n) end
                        if s and (not soonest or s < soonest) then soonest = s end
                    end
                end
                tStatus.Text = soonest and ("Waiting, next tower run in " .. fmtWait(soonest)) or "No towers available"
                task.wait(5)
            end
        end
    end)
end

