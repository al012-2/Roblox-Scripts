-- Picks the first job that is off cooldown and not already running, and claims it
local function pickJob()
    for _, w in ipairs(WORLDS) do
        if w.On then
            for _, boss in ipairs(bossList(w)) do
                local lo = S.All and 1 or w.Diff
                for diff = lo, w.Diff do
                    local key = keyOf(w.World, boss, diff)
                    if not inFlight[key] and (nextAt[key] or 0) <= os.clock() then
                        inFlight[key] = true
                        return w, boss, diff, key
                    end
                end
            end
        end
    end
end

local spawnWorker -- set by startFarm so the Fights button can add a worker mid-run

local function startFarm()
    runId += 1
    local my = runId
    local function alive() return getgenv().StoryFarm and runId == my end
    local act = {}
    inFlight = {}
    wstatus = {}
    setRunning(true)
    lastSlow = os.clock()
    log(("Farm started (%d fight%s at once)"):format(S.Workers, S.Workers > 1 and "s" or ""), C.good)

    spawnWorker = function(idx)
        if act[idx] then return end
        act[idx] = true
        task.spawn(function()
            while alive() and idx <= S.Workers do
                local w, boss, diff, key = pickJob()
                if not w then
                    decayGap()
                    local soonest
                    for _, t in pairs(nextAt) do
                        if t > os.clock() and (not soonest or t < soonest) then soonest = t end
                    end
                    if idx == 1 then
                        wstatus[1] = "#1 " .. (soonest
                            and ("All on cooldown, next in %ds"):format(math.ceil(soonest - os.clock()))
                            or (next(inFlight) and "Waiting for the other fight" or "No bosses available"))
                    else
                        wstatus[idx] = nil
                    end
                    if alive() then updateStatus() end
                    task.wait(2)
                else
                    wstatus[idx] = ("#%d %s/%s [%s]"):format(idx, w.World, boss, DIFF[diff][1])
                    updateStatus()
                    local ok, info, cd, kind, res = fight(w, boss, diff, alive)
                    inFlight[key] = nil
                    if kind == "stop" then break end
                    log(("#%d %s/%s [%s] %s"):format(idx, w.World, boss, DIFF[diff][1], tostring(info)),
                        ok and C.good or C.dim)
                    if ok then
                        wins += 1
                        kills[w.World] = (kills[w.World] or 0) + 1
                        if res then tallyRewards(res) end
                        refreshStats()
                        decayGap()
                        nextAt[key] = os.clock() + 3540
                    else
                        nextAt[key] = os.clock() + (cd or 60)
                        if kind == "locked" or kind == "lost" then
                            for d2 = diff, w.Diff do
                                nextAt[keyOf(w.World, boss, d2)] = os.clock() + (cd or 600)
                            end
                        end
                    end
                end
            end
            wstatus[idx] = nil
            act[idx] = nil
            if alive() then updateStatus() end
        end)
    end

    for i = 1, S.Workers do spawnWorker(i) end
end

