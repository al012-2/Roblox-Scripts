local function queueRerun()
    saveNow()
    local hasFile = isfile and isfile(SCRIPT_FILE)
    local url = type(getgenv().StoryFarmURL) == "string" and getgenv().StoryFarmURL or nil
    if not (queue_on_teleport and writefile and (hasFile or url)) then
        log(("[Hop] The script won't re-run after the teleport: save it as %s in the workspace folder (or set getgenv().StoryFarmURL)")
            :format(SCRIPT_FILE), C.warn, true)
        return
    end
    pcall(function()
        writefile(TP_STATE, HttpService:JSONEncode({
            At = os.time(), File = SCRIPT_FILE, URL = url,
            GyroHopActive = S.AutoGyroHop == true,
            GyroHopCount = math.floor(tonumber(getgenv().GyroHopCount) or 0),
            Story = getgenv().StoryFarm == true, Towers = getgenv().TowerFarm == true,
            Hard = getgenv().HardFarm == true, Halloween = getgenv().HalloweenFarm == true,
        }))
    end)
    if not getgenv().StoryFarmQueued then
        if pcall(queue_on_teleport, TP_LOADER) then getgenv().StoryFarmQueued = true end
    end
end

