-- مفتاح تشغيل/إيقاف بدل زر START. نفس واجهة mkButton (MouseButton1Click + Text)
-- عشان باقي الكود يشتغل بدون تغيير. المفتاح دايماً يرجع لحالة الفارم الحقيقية
-- (مثلاً لو الفارم ما قدر يبدأ، يرجع OFF بنفسه).
local function mkStartToggle(group, id, text)
    local fns, tog, lastOn, syncing = {}, nil, false, false
    local function sync()
        if tog and tog.Value ~= lastOn then
            syncing = true
            pcall(function() tog:SetValue(lastOn) end)
            syncing = false
        end
    end
    tog = group:AddToggle(id, { Text = text, Default = false, Callback = function(v)
        if syncing or v == lastOn then return end
        task.spawn(function()
            for _, fn in ipairs(fns) do pcall(fn) end
            sync()
        end)
    end })
    return setmetatable({ MouseButton1Click = { Connect = function(_, fn) fns[#fns + 1] = fn end } }, {
        __newindex = function(_, k, v)
            if k ~= "Text" then return end
            if v == "STOP" then lastOn = true elseif v == "START" then lastOn = false else return end
            sync()
            triggerSave()
        end })
end

