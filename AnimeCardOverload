local function farmGate(name)
    local slot = SLOT_OF[name]
    local cur = slotUser[slot]
    if cur and cur ~= name then
        log(("Can't start %s: %s is running. Turn %s off first."):format(
            FARM_NAME[name], FARM_NAME[cur], FARM_NAME[cur]), C.bad)
        return false
    end
    slotUser[slot] = name
    updateFarmUI()
    return true
end

local function farmFree(name)
