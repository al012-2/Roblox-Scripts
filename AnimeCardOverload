    body.Visible = not minimized
    statsP.Visible = not minimized
    win.Size = minimized and UDim2.fromOffset(460, 34) or UDim2.fromOffset(460, 580)
end)

closeB.MouseButton1Click:Connect(function()
    saveSettings()
    pcall(function() RunService:Set3dRenderingEnabled(true) end)
    runId += 1
    getgenv().StoryFarm = false
    getgenv().BlockAutoRejoin = false -- the hook stays installed but stops blocking
    tRun += 1
    getgenv().TowerFarm = false
    getgenv().TowerOnResult = nil
    getgenv().AntiAfkToken = (getgenv().AntiAfkToken or 0) + 1
    if getgenv().AntiAfkConn then pcall(function() getgenv().AntiAfkConn:Disconnect() end) end
    if getgenv().WeatherConn then pcall(function() getgenv().WeatherConn:Disconnect() end) end
    for _, c in ipairs(getgenv().StoryFarmConns or {}) do pcall(function() c:Disconnect() end) end
    getgenv().StoryFarmConns = {}
    gui:Destroy()
end)

