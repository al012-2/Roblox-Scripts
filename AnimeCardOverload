local function hFlat(t, skip, depth)
    depth = depth or 0
    local o = {}
    for k, v in pairs(t) do
        if k ~= skip then
            local val = tostring(v)
            if type(v) == "table" then
                val = depth < 2 and ("{" .. hFlat(v, nil, depth + 1) .. "}") or "{...}"
            end
            o[#o + 1] = tostring(k) .. "=" .. val
        end
    end
    return table.concat(o, ", ")
end

local function hSummary(rem)
    if not rem then return nil end
    local ok, r = pcall(function() return rem:InvokeServer("Hard") end)
    if ok and type(r) == "table" then return r end
end

local function hItems(s)
    local out = {}
    if type(s) == "table" and type(s.Items) == "table" then
        for _, it in ipairs(s.Items) do
            if type(it) == "table" and it.Name then
                out[#out + 1] = tostring(it.Name) .. " x" .. tostring(it.Count or 1)
            end
        end
    end
    return table.concat(out, ", ")
end

local function hShow(s)
    if type(s) == "table" then
        if s.Active == false and (tonumber(s.Floor) or 0) <= 0 then
            hInfo.Text = ("No active run | Best %s | Climbed %d"):format(tostring(s.Best or "?"), hclimbed)
        else
            hInfo.Text = ("Floor %s | Best %s | RewardMult x%s | Climbed %d"):format(
                tostring(s.Floor), tostring(s.Best), tostring(s.RewardMult or 1), hclimbed)
        end
    end
end

