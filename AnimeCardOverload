local function toggleEventConnections(ev, enable)
    if ev and getconnections then
        for _, conn in ipairs(getconnections(ev.OnClientEvent)) do
            pcall(function()
                if enable then conn:Enable() else conn:Disable() end
            end)
        end
    end
end

