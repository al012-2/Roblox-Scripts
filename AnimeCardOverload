local function httpGet(url)
    local req = (syn and syn.request) or http_request or request
    if req then
        local ok, res = pcall(req, { Url = url, Method = "GET" })
        if ok and type(res) == "table" and res.Body then return res.Body end
    end
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if ok then return body end
end

local hopping = false
hopB.MouseButton1Click:Connect(function()
    if hopping then return end
    hopping = true
    hopB.Text = "Searching..."
    task.spawn(function()
        local target
        local cursor = ""
        for _ = 1, 3 do
            local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true%s")
                :format(game.PlaceId, cursor ~= "" and ("&cursor=" .. cursor) or "")
            local body = httpGet(url)
            local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
            if not (ok and type(data) == "table" and type(data.data) == "table") then break end
            local pool = {}
            for _, sv in ipairs(data.data) do
                if sv.id ~= game.JobId and (sv.playing or 0) < (sv.maxPlayers or 0) - 1 then
                    pool[#pool + 1] = sv.id
                end
            end
            if #pool > 0 then
                target = pool[math.random(1, math.min(#pool, 15))]
                break
            end
            cursor = data.nextPageCursor or ""
            if cursor == "" then break end
        end

        if not target then
            hopB.Text = "No server"
            task.wait(2)
            hopB.Text = "Server Hop"
            hopping = false
            return
        end

        hopB.Text = "Hopping..."
        queueRerun()
        local ok = pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, target, lp) end)
        if not ok then
            hopB.Text = "Failed"
            task.wait(2)
        end
        hopB.Text = "Server Hop"
        hopping = false
    end)
end)

