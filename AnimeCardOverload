local inFlight = {}  -- keys of fights currently running
local wstatus = {}   -- per-worker status text
local nextSlot = 0   -- shared throttle: next time a remote call is allowed

-- One shared throttle for every worker so two fights never trip "slow down" together
local function throttle(alive)
    local now = os.clock()
    local slot = math.max(now, nextSlot)
    nextSlot = slot + S.Gap
    if slot > now then task.wait(slot - now) end
    return (not alive) or alive()
end
local progress, progAt = {}, {}
local lastSlow = 0 -- os.clock() of the last "slow down" (or last gap decay step)

local function keyOf(world, boss, diff) return world .. "|" .. boss .. "|" .. diff end

local function parseWait(msg)
    if type(msg) ~= "string" then return nil end
    local n, unit = msg:lower():match("wait%s+(%d+)%s*(%a+)")
    n = tonumber(n)
    if not n then return nil end
    if unit:find("hour") then return n * 3600 end
    if unit:find("min") then return n * 60 end
    return n
end

local function dumpTable(t)
    local o = {}
    for k, v in pairs(t) do
        if type(v) ~= "table" and type(v) ~= "function" then
            o[#o + 1] = tostring(k) .. "=" .. tostring(v)
        end
    end
    return table.concat(o, ", ")
end

local function getProgress(world)
    if (progAt[world] or 0) + 60 < os.clock() then
        progAt[world] = os.clock()
        local ok, n = pcall(function() return R.GetStoryProgress:InvokeServer(world) end)
        if ok and type(n) == "number" then progress[world] = n end
    end
    return progress[world]
end

local function autoBosses(world)
    local out = {}
    pcall(function()
        local st = SD.Stories[world]
        local beaten = getProgress(world)
        if beaten == nil then beaten = math.huge end
        for i, id in ipairs(st.Order) do
            if i <= beaten + 1 then out[#out + 1] = id end
        end
    end)
    if #out == 0 then
        for _, id in ipairs(KNOWN[world] or {}) do out[#out + 1] = id end
    end
    return out
end

local function bossList(w)
    local out = {}
    for name in string.gmatch(w.Bosses, "[^,]+") do
        name = name:match("^%s*(.-)%s*$")
        if name ~= "" then out[#out + 1] = name end
    end
    if #out == 0 then return autoBosses(w.World) end
    return out
end

local function addReward(name, amount)
    name = tostring(name)
    rewards[name] = (rewards[name] or 0) + (tonumber(amount) or 1)
end

local function tallyRewards(res)
    local got = false
    pcall(function()
        if type(res.WinItems) == "table" then
            for _, it in pairs(res.WinItems) do
                if type(it) == "table" then
                    local name = it.Potion or it.Item or it.Name or it.Id or it.Kind
                    if name then
                        addReward(name, it.Amount or it.Count or it.Qty)
                        got = true
                    end
                end
            end
        end
    end)
    if not got then
        pcall(function()
            if type(res.WinPackText) == "string" then
                for amt, name in res.WinPackText:gmatch("(%d+)x%s*([^,+]+)") do
                    addReward((name:gsub("%s+$", "")), amt)
                end
            end
        end)
    end
end

-- Lowers the gap by 1s every GapDecayEvery seconds without a "slow down"
local function decayGap()
    if S.Gap > S.BaseGap and (os.clock() - lastSlow) >= S.GapDecayEvery then
        S.Gap = math.max(S.BaseGap, S.Gap - 1)
        lastSlow = os.clock()
        log("Gap decreased -> " .. S.Gap .. "s", C.dim)
    end
end

local function fight(w, boss, diff, alive)
    if not throttle(alive) then return false, "stopped", 0, "stop" end

    local r = table.pack(pcall(function()
        return R.StartStoryBattle:InvokeServer(w.World, boss, diff, S.Team)
    end))
    if not r[1] then return false, "error: " .. tostring(r[2]), 30, "err" end
    local res, msg = r[2], r[3]

    if type(res) == "table" and res.GrantId then
        if res.Winner ~= "A" then
            return false, "lost (Winner=" .. tostring(res.Winner) .. ")", 600, "lost"
        end
        task.wait(S.FightDelay)
        throttle()
        for _ = 1, S.MaxDoneTries do
            local ok, done = pcall(function()
                local rem = R:FindFirstChild(res.GrantRemote or "StoryFightDone") or R.StoryFightDone
                return rem:InvokeServer(res.GrantId)
            end)
            if ok and done then
                local pack = type(res.WinPackText) == "string" and (" " .. res.WinPackText) or ""
                return true, "WIN" .. pack .. " (claimed)", nil, nil, res
            end
            task.wait(S.RetryDelay)
        end
        return false, "StoryFightDone failed", 30, "err"
    end

    if type(res) == "table" then
        return false, "no GrantId: " .. dumpTable(res), 600, "lost"
    end

    local m = tostring(msg or res)
    local ml = m:lower()
    if ml:find("slow down") then
        S.Gap = math.min(S.Gap + 2, 15)
        lastSlow = os.clock()
        return false, "slow down -> gap " .. S.Gap .. "s", 8, "slow"
    end
    local wait = parseWait(m)
    if wait then return false, m, wait, "cd" end
    if ml:find("beat") or ml:find("defeat") or ml:find("lock") or ml:find("unlock") or ml:find("first") then
        return false, m, 600, "locked"
    end
    return false, m, 120, "unknown"
end

