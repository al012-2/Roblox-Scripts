local function toggleEventConnections(ev, enable)
    if ev and getconnections then
        for _, conn in ipairs(getconnections(ev.OnClientEvent)) do
            pcall(function()
                if enable then conn:Enable() else conn:Disable() end
            end)
        end
    end
end

H.team = function(v) S.Team = tonumber(v) or S.Team end

H.antiLag = function(v)
    if v == S.AntiLag then return end
    S.AntiLag = v
    local enableEvents = not S.AntiLag
    toggleEventConnections(RS:FindFirstChild("HitAnnounce"), enableEvents)
    toggleEventConnections(RS:FindFirstChild("NewCardAlert"), enableEvents)
    toggleEventConnections(R:FindFirstChild("PlayerRolled"), enableEvents)
    toggleEventConnections(R:FindFirstChild("PlayerShowcase"), enableEvents)
    log("Anti-Lag (Mute Roll/Hit Events): " .. (S.AntiLag and "ON" or "OFF"), S.AntiLag and C.good or C.dim)
end

H.silentRoll = function(v)
    if v == S.SilentRoll then return end
    S.SilentRoll = v
    pcall(function()
        if S.SilentRoll then
            R.SetAutoRollPopup:FireServer(false)
            R.SetAutoRollEnabled:FireServer(true)
        else
            R.SetAutoRollEnabled:FireServer(false)
        end
    end)
    log("Silent Auto-Roll: " .. (S.SilentRoll and "ON" or "OFF"), S.SilentRoll and C.good or C.dim)
end

H.render = function(v)
    S.No3D = v == true
    pcall(function() RunService:Set3dRenderingEnabled(not v) end)
