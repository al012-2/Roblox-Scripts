local function updateTowerRows()
    for _, tw in ipairs(TW) do
        local ready, soonest, cleared = towerStatus(tw)
        local txt = ("Cleared %d/%d"):format(cleared, tw.Parts)
        local pausedFor = (tNext[tw.Id] or 0) - os.clock()
        if pausedFor > 0 then
            txt = txt .. " | paused " .. fmtWait(pausedFor)
        elseif ready then
            txt = txt .. " | ready: Part " .. ready
        elseif soonest then
            txt = txt .. " | next repeat in " .. fmtWait(soonest)
        else
            txt = txt .. " | nothing to run"
        end
        tw.info.Text = txt
    end
end

