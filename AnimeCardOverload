local startHalloween
do
    local hwRun = 0

    local HwBox = Tabs.Halloween:AddLeftGroupbox("Halloween Tower")
    local hwStatus = proxyLabel(HwBox:AddLabel("Idle", true))
    local hwStartB = mkStartToggle(HwBox, "HalloweenRun", "Halloween farm")
    HwBox:AddDropdown("HalloweenTeam", { Values = { "1", "2", "3", "4" }, Default = HW.Team, Text = "Team",
        Callback = function(v) HW.Team = tonumber(v) or HW.Team; triggerSave() end })

    local HwNote = Tabs.Halloween:AddRightGroupbox("Notes")
    HwNote:AddLabel("50 parts, 10 waves each, a Major part every 10 (the Soul Relic comes from Major 3, probably Part 30).", true)
    HwNote:AddLabel("An active run is only watched, never restarted. Otherwise the next uncleared part starts.", true)
    HwNote:AddLabel("It stops on its own when all 50 parts are cleared, after 3 failed starts, or after 3 runs in a row that cleared nothing (change the team).", true)
    HwNote:AddLabel("Shares the tower slot with Battle Towers and Hard Tower: only one can run at a time.", true)

    local function hwSer(v, d, b)
        d = d or 0
        b = b or { n = 0 }
        if type(v) == "string" then return string.format("%q", v:sub(1, 200)) end
        if type(v) ~= "table" then return tostring(v) end
        if d >= 3 or b.n > 60 then return "{...}" end
        local o = {}
        for k, x in pairs(v) do
            b.n += 1
            if b.n > 60 then o[#o + 1] = "..." break end
            o[#o + 1] = tostring(k) .. "=" .. hwSer(x, d + 1, b)
        end
        return "{" .. table.concat(o, ", ") .. "}"
    end

    local function hwAlive(my)
        return getgenv().HalloweenFarm == true and hwRun == my and not unloaded
    end

    local function setHwRunning(on)
        getgenv().HalloweenFarm = on
        hwStartB.Text = on and "STOP" or "START"
        if not on then
            hwStatus.Text = "Idle"
            farmFree("Halloween")
        end
    end

    local function hwFinish(my, reason, col)
        if hwRun == my then
            hwRun += 1
            setHwRunning(false)
            log("[HW] Stopped: " .. reason, col or C.warn, true)
        end
    end

    startHalloween = function()
        local startRem = findRem("StartTowerRun")
        local sumRem = findRem("GetTowerRunSummary")
        if not (startRem and sumRem) then
            log("[HW] StartTowerRun / GetTowerRunSummary remotes not found", C.bad)
            return
        end
        local function summary()
            local ok, r = pcall(function() return sumRem:InvokeServer("Halloween") end)
            if ok and type(r) == "table" then return r end
        end
        if not summary() then
            log("[HW] Couldn't read the Halloween state", C.warn)
            return
        end
        if not farmGate("Halloween") then return end

        hwRun += 1
        local my = hwRun
        setHwRunning(true)
        log(("[HW] Started (team %d)"):format(HW.Team), C.good)

        task.spawn(function()
            local fails, started, startCleared = 0, false, 0
            local lastKey, lastChange, warned, replies, lastLog = nil, os.clock(), false, 0, 0

            while hwAlive(my) do
                local s = summary()
                if not s then
                    hwStatus.Text = "Can't read the run state"
                    task.wait(10)
                else
                    local cleared = tonumber(s.Cleared) or 0
                    local parts = tonumber(s.Parts) or 50

                    if s.Active then
                        local run = type(s.Run) == "table" and s.Run or {}
                        local key = tostring(run.Part) .. ":" .. tostring(run.Wave)
                        if key ~= lastKey then
                            lastKey, lastChange, warned = key, os.clock(), false
                        end
                        local msg = ("Running part %s wave %s | cleared %d/%d"):format(
                            tostring(run.Part), tostring(run.Wave), cleared, parts)
                        hwStatus.Text = msg
                        if os.clock() - lastLog > 60 then
                            lastLog = os.clock()
                            log("[HW] " .. msg, C.dim)
                        end
                        if not warned and os.clock() - lastChange > 180 then
                            warned = true
                            log("[HW] Part/Wave haven't changed for 3 min - the run may be stuck", C.warn)
                        end
                        if started and cleared > startCleared then fails = 0 end
                        task.wait(5)
                    else
                        if started then
                            started = false
                            if cleared > startCleared then
                                fails = 0
                                log(("[HW] Part(s) cleared, now %d/%d"):format(cleared, parts), C.good)
                            else
                                fails += 1
                                log(("[HW] Run ended without clearing part %d (%d/3)"):format(startCleared + 1, fails), C.warn)
                                if fails >= 3 then
                                    return hwFinish(my, "3 failed runs in a row - try another team", C.bad)
                                end
                                task.wait(30)
                            end
                        end

                        if hwAlive(my) then
                            if cleared >= parts then
                                return hwFinish(my, "all " .. parts .. " parts cleared", C.good)
                            end
                            local part = cleared + 1
                            hwStatus.Text = "Starting part " .. part
                            local ok, res, msg = pcall(function()
                                return startRem:InvokeServer("Halloween", { Part = part, Team = HW.Team })
                            end)
                            if replies < 5 then
                                replies += 1
                                log(("[HW] StartTowerRun(%d) -> %s%s"):format(part,
                                    ok and hwSer(res) or ("error " .. tostring(res)),
                                    msg ~= nil and (", " .. hwSer(msg)) or ""), C.dim)
                            end
                            if not ok then
                                task.wait(30)
                            else
                                started, startCleared = true, cleared
                                local t0, seen = os.clock(), false
                                while hwAlive(my) and os.clock() - t0 < 20 do
                                    task.wait(2)
                                    local s2 = summary()
                                    if s2 and s2.Active then seen = true break end
                                end
                                if hwAlive(my) and not seen then
                                    started = false
                                    fails += 1
                                    log(("[HW] The run didn't start (%d/3)"):format(fails), C.warn)
                                    if fails >= 3 then
                                        return hwFinish(my, "the run won't start - see the StartTowerRun reply above", C.bad)
                                    end
                                    task.wait(30)
                                end
                            end
                        end
                    end
                end
            end
        end)
    end

    hwStartB.MouseButton1Click:Connect(function()
        if getgenv().HalloweenFarm then
            hwRun += 1
            setHwRunning(false)
            log("[HW] Stopped (a run already in progress keeps going on the server)", C.bad)
        else
            startHalloween()
        end
    end)
end

