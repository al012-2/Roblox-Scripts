task.spawn(function()
    local Tab = Window:AddTab("Machines")
    local box = Tab:AddLeftGroupbox("Game windows")
    local pg = lp:WaitForChild("PlayerGui")
    local entries, picked, filter = {}, nil, ""
    local opened = {}
    local selL = proxyLabel(box:AddLabel("Selected: -", true))
    local cntL = proxyLabel(box:AddLabel("Found: 0", true))
    local SKIP = { Frame = true, ImageLabel = true, TextLabel = true, Holder = true, Template = true,
        Content = true, Container = true, Background = true, Main = true, Inner = true }

    local function pathOf(o)
        local parts, cur = {}, o
        while cur and cur ~= pg do
            table.insert(parts, 1, cur.Name)
            cur = cur.Parent
        end
        return table.concat(parts, "/")
    end

    local function collect()
        local list = {}
        local function walk(o, depth)
            for _, ch in ipairs(o:GetChildren()) do
                if ch:IsA("GuiObject") then
                    if (ch:IsA("Frame") or ch:IsA("ScrollingFrame") or ch:IsA("ImageLabel"))
                        and not SKIP[ch.Name] and (depth == 1 or ch.Visible == false) then
                        list[#list + 1] = ch
                    end
                    if depth < 3 then walk(ch, depth + 1) end
                end
            end
        end
        for _, g in ipairs(pg:GetChildren()) do
            if g:IsA("ScreenGui") then
                list[#list + 1] = g
                walk(g, 1)
            end
        end
        return list
    end

    local dd
    local function fill()
        entries = {}
        local labels, used = {}, {}
        for _, o in ipairs(collect()) do
            local name = o.Name
            local path = pathOf(o)
            if filter == "" or name:lower():find(filter, 1, true) or path:lower():find(filter, 1, true) then
                local label = o:IsA("ScreenGui") and (name .. "  [ScreenGui]") or (name .. "  ·  " .. (path:match("^[^/]+") or ""))
                if used[label] then
                    used[label] += 1
                    label = label .. " #" .. used[label]
                else
                    used[label] = 1
                end
                entries[label] = o
                labels[#labels + 1] = label
            end
        end
        table.sort(labels)
        cntL.Text = "Found: " .. #labels
        if dd then pcall(function() dd:SetValues(labels) end) end
    end

    dd = box:AddDropdown("GuiPick", { Values = {}, Default = nil, Text = "Window", Searchable = true,
        Callback = function(v)
            picked = v and entries[v] or nil
            selL.Text = "Selected: " .. (picked and pathOf(picked) or "-")
        end })
    box:AddInput("GuiFilter", { Default = "", Text = "Filter by name", Placeholder = "e.g. trait, craft, skill",
        Callback = function(v)
            filter = tostring(v or ""):lower()
            fill()
        end })

    local function valid(o) return o and o.Parent ~= nil end

    local function openObj(o)
        local cur = o
        while cur and cur ~= pg do
            if cur:IsA("ScreenGui") then cur.Enabled = true
            elseif cur:IsA("GuiObject") then cur.Visible = true end
            cur = cur.Parent
        end
    end
    local function closeObj(o)
        if o:IsA("ScreenGui") then o.Enabled = false
        elseif o:IsA("GuiObject") then o.Visible = false end
    end

    local openB = mkButton(box, "Open")
    local closeB = mkButton(box, "Close")
    local closeAllB = mkButton(box, "Close everything I opened")
    local refreshB = mkButton(box, "Refresh list")

    openB.MouseButton1Click:Connect(function()
        if not valid(picked) then log("[Machines] Pick a window first (or refresh the list)", C.warn) return end
        openObj(picked)
        opened[picked] = true
        log("[Machines] Opened " .. pathOf(picked), C.good)
    end)
    closeB.MouseButton1Click:Connect(function()
        if not valid(picked) then log("[Machines] Pick a window first (or refresh the list)", C.warn) return end
        closeObj(picked)
        opened[picked] = nil
        log("[Machines] Closed " .. pathOf(picked), C.dim)
    end)
    closeAllB.MouseButton1Click:Connect(function()
        for o in pairs(opened) do
            if valid(o) then closeObj(o) end
        end
        opened = {}
        log("[Machines] Closed everything the script opened", C.dim)
    end)
    refreshB.MouseButton1Click:Connect(fill)

    local QUICK = {
        { "MergeUI", "mergeui", "GetMergeCards" },
        { "ExpeditionUI", "expeditionui", "GetExpeditions" },
        { "SkillTreeUI", "skilltreeui", nil },
    }
    local function findGui(exact, pat)
        local g = pg:FindFirstChild(exact, true)
        if g then return g end
        for _, o in ipairs(pg:GetDescendants()) do
            if (o:IsA("ScreenGui") or o:IsA("Frame")) and o.Name:lower():find(pat, 1, true) then
                return o
            end
        end
    end
    for _, q in ipairs(QUICK) do
        local qb = mkButton(box, "Open " .. q[1])
        qb.MouseButton1Click:Connect(function()
            local gui = findGui(q[1], q[2])
            if not valid(gui) then
                log("[Machines] " .. q[1] .. " not found in PlayerGui", C.warn)
                return
            end
            local rem = q[3] and R:FindFirstChild(q[3])
            if rem then pcall(function() rem:InvokeServer() end) end
            openObj(gui)
            opened[gui] = true
            log("[Machines] Opened " .. pathOf(gui), C.good)
        end)
    end

    local asuraB = mkButton(box, "Fight Asura (uses Story team)")
    asuraB.MouseButton1Click:Connect(function()
        local rem = R:FindFirstChild("FightAsura")
        if not rem then log("[Asura] FightAsura remote not found", C.bad) return end
        local ok, res, msg = pcall(function() return rem:InvokeServer(S.Team) end)
        if not ok then
            log("[Asura] error: " .. tostring(res):sub(1, 120), C.bad)
        elseif type(res) == "table" then
            log("[Asura] " .. dumpTable(res):sub(1, 200), C.good)
            if res.GrantId then
                task.wait(S.FightDelay)
                for _ = 1, S.MaxDoneTries do
                    local okC, done = pcall(function()
                        local gr = R:FindFirstChild(res.GrantRemote or "AsuraFightDone") or R.AsuraFightDone
                        return gr:InvokeServer(res.GrantId)
                    end)
                    if okC and done then
                        log("[Asura] Claimed (+" .. tostring(res.BossDamage) .. " damage)", C.good)
                        break
                    end
                    task.wait(S.RetryDelay)
                end
            end
        else
            log("[Asura] reply: " .. tostring(msg or res), C.dim)
        end
    end)

    local asuraRun, asuraFights, asuraDmg = 0, 0, 0
    local function fmtNum(n)
        n = tonumber(n) or 0
        if n >= 1e12 then return ("%.2fT"):format(n / 1e12) end
        if n >= 1e9 then return ("%.2fB"):format(n / 1e9) end
        if n >= 1e6 then return ("%.2fM"):format(n / 1e6) end
        if n >= 1e3 then return ("%.1fK"):format(n / 1e3) end
        return tostring(math.floor(n))
    end
    local asuraL = proxyLabel(box:AddLabel("Asura auto: off", true))
    box:AddToggle("AsuraAuto", { Text = "Auto fight Asura (repeat while boss is here)", Default = false,
        Callback = function(on)
            asuraRun += 1
            local my = asuraRun
            if not on then
                asuraL.Text = "Asura auto: off"
                log("[Asura] Auto stopped", C.dim)
                return
            end
            local function alive() return asuraRun == my and not unloaded end
            local function sleep(n)
                for _ = 1, n do
                    if not alive() then return false end
                    task.wait(1)
                end
                return alive()
            end
            log("[Asura] Auto started (team " .. S.Team .. ")", C.good)
            task.spawn(function()
                local probes = 0
                while alive() do
                    local rem = R:FindFirstChild("FightAsura")
                    if not rem then
                        log("[Asura] FightAsura remote not found", C.bad)
                        asuraL.Text = "Asura auto: remote missing"
                        return
                    end
                    asuraL.Text = ("Asura auto: fighting | fights %d"):format(asuraFights)
                    local ok, res, msg = pcall(function() return rem:InvokeServer(S.Team) end)
                    if probes < 5 then
                        probes += 1
                        local raw = type(res) == "table" and dumpTable(res) or tostring(res)
                        log(("[Asura] reply#%d ok=%s %s %s"):format(probes, tostring(ok), raw:sub(1, 200),
                            msg ~= nil and tostring(msg) or ""), C.dim)
                    end
                    local m = tostring(msg or (type(res) == "string" and res) or ""):lower()
                    local failed = (not ok) or res == nil or res == false or type(res) == "string"
                        or (type(res) == "table" and (res.Ok == false or res.Success == false or res.Error ~= nil))
                    if not ok then
                        if not sleep(30) then return end
                    elseif m:find("slow") then
                        if not sleep(10) then return end
                    elseif m:find("busy") then
                        asuraL.Text = "Asura auto: battle slots busy, retry in 15s"
                        if not sleep(15) then return end
                    elseif failed then
                        asuraL.Text = "Asura auto: boss not available, retry in 60s"
                        if not sleep(60) then return end
                    elseif type(res) == "table" and res.GrantId then
                        -- Winner=B is normal here: you can't kill the boss, the fight just adds damage.
                        if not sleep(S.FightDelay) then return end
                        local claimed = false
                        for _ = 1, S.MaxDoneTries do
                            local okC, done = pcall(function()
                                local gr = R:FindFirstChild(res.GrantRemote or "AsuraFightDone") or R.AsuraFightDone
                                return gr:InvokeServer(res.GrantId)
                            end)
                            if okC and done then claimed = true break end
                            if not sleep(S.RetryDelay) then return end
                        end
                        if claimed then
                            asuraFights += 1
                            asuraDmg += tonumber(res.BossDamage) or 0
                            asuraL.Text = ("Asura auto: fights %d | damage %s"):format(asuraFights, fmtNum(asuraDmg))
                            log(("[Asura] Fight #%d claimed | +%s damage (session %s)"):format(
                                asuraFights, fmtNum(tonumber(res.BossDamage) or 0), fmtNum(asuraDmg)), C.good)
                        else
                            log("[Asura] AsuraFightDone failed - retrying in 15s", C.warn)
                            if not sleep(15) then return end
                        end
                        if not sleep(2) then return end
                    else
                        log("[Asura] Unknown reply: " .. (type(res) == "table" and dumpTable(res) or tostring(res)):sub(1, 200), C.warn)
                        if not sleep(15) then return end
                    end
                end
            end)
        end })

    box:AddLabel("Windows that load data from the server when they open may look empty if forced open. If one does, open it the normal way in the game.", true)

    task.wait(3)
    fill()
end)
