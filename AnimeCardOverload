local gyroHopToken = 0
H.gyroHop = function(v)
    S.AutoGyroHop = v == true
    getgenv().GyroHopActive = S.AutoGyroHop
    gyroHopToken += 1
    local my = gyroHopToken
    if not S.AutoGyroHop then getgenv().GyroHopCount = 0 end
    triggerSave()
    if not S.AutoGyroHop then return end

    local function alive() return S.AutoGyroHop and gyroHopToken == my and not unloaded end
    local function stopHop(reason, col)
        S.AutoGyroHop = false
        getgenv().GyroHopActive = false
        getgenv().GyroHopCount = 0
        pcall(function() gyroHopToggle:SetValue(false) end)
        triggerSave()
        log(reason, col, true)
    end
    local function found(luck)
        stopHop(("[StarGyro] Found target server! Current Luck: +%d"):format(luck), C.good)
    end

    task.spawn(function()
        local count = math.floor(tonumber(getgenv().GyroHopCount) or 0)
        local luck = updateGyroUI()
        if luck >= S.MinGyroLuck then return found(luck) end
        if count >= S.MaxHops then
            return stopHop(("[StarGyro] Reached max hops (%d) without finding +%d. Auto-Hop stopped.")
                :format(S.MaxHops, S.MinGyroLuck), C.bad)
        end

        log(("[StarGyro] Luck +%d (Target +%d). Hop %d/%d in %ds..."):format(
            luck, S.MinGyroLuck, count + 1, S.MaxHops, S.HopDelay), C.warn)
        for _ = 1, S.HopDelay do
            if not alive() then return end
            task.wait(1)
        end
        -- نعيد الفحص بعد التأخير (اللك ممكن يتحمّل متأخر بعد دخول السيرفر)
        luck = updateGyroUI()
        if luck >= S.MinGyroLuck then return found(luck) end

        getgenv().GyroHopCount = count + 1
        doServerHop()

        -- إذا بعد 45 ثانية لسا هنا، القفزة فشلت: نحاول مرة ثانية (وتنحسب من الحد)
        for _ = 1, 45 do
            if not alive() then return end
            task.wait(1)
        end
        log("[StarGyro] Hop didn't go through, trying again", C.warn)
        H.gyroHop(true)
    end)
end

onCleanup(function() S.AutoGyroHop = false end)

