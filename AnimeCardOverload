getgenv().TowerOnResult = function(res)
    if type(res) ~= "table" then return end
    local id = res.BattleTower or currentTower or "?"
    if res.Died then
        tDeaths[id] = (tDeaths[id] or 0) + 1
        log(("[T] Defeated on %s Part %s wave %s (%d/%d)"):format(
            tostring(id), tostring(res.Part), tostring(res.Wave), tDeaths[id], TS.MaxDeaths), C.bad)
        if tDeaths[id] >= TS.MaxDeaths then
            tDeaths[id] = 0
            tNext[id] = os.clock() + 1800
            log("[T] " .. tostring(id) .. " paused for 30m after repeated defeats - try another team", C.warn)
        else
            tNext[id] = os.clock() + 30
        end
        tStale = true
    elseif res.AllOnCooldown then
        local n = tonumber(res.NextReadyIn)
        log("[T] All parts are cooling down" .. ((n and n < math.huge) and (", next in " .. fmtWait(n)) or ""), C.dim)
        tStale = true
    elseif res.Part then
        tparts += 1
        tDeaths[id] = 0
        tStale = true
        refreshStats()
        log(("[T] %s Part %s cleared%s"):format(tostring(id), tostring(res.Part),
            res.FirstClear and " (first clear)" or ""), C.good)
    end
    if res.Artifact then log("[T] Got artifact: " .. tostring(res.Artifact), C.good) end
    if res.UnlockedCard then log("[T] Unlocked card: " .. tostring(res.UnlockedCard), C.good) end
end

local function runInfo(id)
    local ok, r = pcall(function() return GG.GetAfkRun and GG.GetAfkRun() end)
    if not (ok and type(r) == "table") then return nil end
    for _, e in ipairs({ r, r.Also }) do
        if type(e) == "table" and type(e.Tower) == "string" then
            if id == nil then
                if BTD and BTD.Get and BTD.Get(e.Tower) then return e.Tower end
            elseif e.Tower == id then
                return e.Tower
            end
        end
    end
    return nil
end

local function runTower(tw, part, alive)
    local opts = { Part = part }
    if TS.Team then opts.Team = TS.Team end
    GG.ResumeTowerWithRetry(true, tw.Id, opts)
    local t0, seen = os.clock(), false
    while alive() do
        task.wait(2)
        if runInfo(tw.Id) then
            seen = true
            tStatus.Text = ("Running %s from Part %d | parts cleared %d"):format(tw.Name, part, tparts)
            updateTowerRows()
        elseif seen then
            return true
        elseif os.clock() - t0 > 90 then
            return false, "the run didn't start (see the game's error toast)"
        end
    end
    return seen, "stopped"
end

local function setTRunning(on)
