local function towerStatus(tw)
    local st = tState and tState.Towers and tState.Towers[tw.Id]
    local cleared = st and tonumber(st.Cleared) or 0
    local top = math.min(tw.Parts, TS.First and (cleared + 1) or cleared)
    local ready, soonest
    for p = 1, top do
        local wait = 0
        if p <= cleared then
            local r = st and st.RepeatIn and tonumber(st.RepeatIn[tostring(p)])
            if r then wait = r - (os.clock() - tStateAt) end
        end
        if wait <= 0 then
            ready = ready or p
        elseif not soonest or wait < soonest then
            soonest = wait
        end
    end
    return ready, soonest, cleared
end

