local function startHard()
    local nextRem = findRem("TowerNextFloor")
    local sumRem  = findRem("GetTowerRunSummary")
    local hideRem = findRem("SetTowerHidden")
    if not nextRem then return hFail("TowerNextFloor remote not found", C.bad) end
    if not sumRem then return hFail("GetTowerRunSummary remote not found (needed to detect defeat)", C.bad) end

    local s = hSummary(sumRem)
    if not s then
        return hFail("Couldn't read the Hard run state - try again in a few seconds")
    end
    hShow(s)
    if s.Active == false and (tonumber(s.Floor) or 0) <= 0 then
        return hFail("No active Hard run. Start one from the Hard Tower NPC (press Start once), then turn this ON.")
    end
    if not farmGate("Hard") then
        hStatus.Text = "Another tower farm is running - turn it off first"
        return
    end

    hRun += 1
    local my = hRun
    local function alive() return getgenv().HardFarm and hRun == my and not unloaded end
    local function finish(reason, col)
        if hRun == my then
            setHRunning(false)
            hStatus.Text = "Stopped: " .. reason
            log("[H] Stopped: " .. reason, col or C.warn, true)
        end
    end

    setHRunning(true)
    log(("[H] Started from floor %s (%ds per floor%s)"):format(tostring(s.Floor), HS.Interval,
        HS.StopAt > 0 and (", stop at " .. HS.StopAt) or ""), C.good)
    if hideRem then pcall(function() hideRem:FireServer(true) end) end

    task.spawn(function()
        local stuck, errs, probes, extra = 0, 0, 0, 0
        local lastFloor = tonumber(s.Floor)
        hShow(s)

        while alive() do
            local t0 = os.clock()
            if HS.StopAt > 0 and lastFloor and lastFloor >= HS.StopAt then
                return finish("reached floor " .. lastFloor, C.good)
            end
            if not throttle(alive) then return end
            hStatus.Text = "Climbing to floor " .. tostring((lastFloor or 0) + 1)

            local ok, res = pcall(function() return nextRem:InvokeServer("Hard") end)
            local slow = false
            if not ok then
                errs += 1
                log("[H] error: " .. tostring(res):sub(1, 120), C.warn)
                if errs >= 3 then return finish("too many errors", C.bad) end
                task.wait(30)
            else
                errs = 0
                if type(res) == "table" then
                    if probes < 3 then
                        probes += 1
                        local n = type(res.Log) == "table" and #res.Log or 0
                        log(("[H] reply#%d Log=%d | %s"):format(probes, n, hFlat(res, "Log"):sub(1, 300)), C.dim)
                    end
                elseif res ~= nil then
                    local m = tostring(res)
                    log("[H] reply: " .. m:sub(1, 120), C.dim)
                    if m:lower():find("slow") then
                        slow = true
                        extra = math.min(extra + 2, 12)
                    end
                end

                local s2 = hSummary(sumRem)
                if s2 then
                    local fl = tonumber(s2.Floor)
                    if fl and lastFloor and fl > lastFloor then
                        hclimbed += fl - lastFloor
                        stuck = 0
                        refreshStats()
                        triggerSave()
                    elseif not slow then
                        stuck += 1
                    end
                    lastFloor = fl or lastFloor
                    hShow(s2)
                    if s2.Active == false and (tonumber(s2.Floor) or 0) <= 0 then
                        local it = hItems(s2)
                        log("[H] Run ended" .. (it ~= "" and (" | items: " .. it) or ""), C.warn)
                        return finish("run is no longer active")
                    end
                    if stuck >= 3 then
                        return finish(("floor not advancing (%dx) - probably defeated"):format(stuck), C.bad)
                    end
                end

                local target = HS.Interval + extra
                while alive() and os.clock() - t0 < target do
                    hStatus.Text = ("Next floor in %ds"):format(math.ceil(target - (os.clock() - t0)))
                    task.wait(1)
                end
            end
        end
    end)
end

