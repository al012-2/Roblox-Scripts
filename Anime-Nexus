local function farmForStep(s)
    local kind, desc = tostring(s.kind), tostring(s.desc):lower()
    if kind == "portals" or desc:find("pumpkin portal") then return "AutoPortalToggle", "Pumpkin Portal" end
    if kind == "tower" or desc:find("tower") then
        State.TowerFloor = tonumber(s.goal) or State.TowerFloor
        return "AutoInfTowerToggle", "Tower floor " .. tostring(s.goal)
    end
    if desc:find("roll") then return "AutoRollToggle", "Auto Roll" end
    if desc:find("boss") then return "AutoBossRushToggle", "Boss Rush" end
    if kind == "best" or desc:find("wave") then
        State.StoryAct = "Infinite"
        return "AutoStoryToggle", "Story (Infinite) for waves"
    end
    if kind == "stat" or kind == "kills" or kind == "wins" or kind == "level" or kind == "dmg"
        or desc:find("defeat") or desc:find("win") or desc:find("level") then
        return "AutoStoryToggle", "Story stages"
    end
    return nil, "this step needs you (" .. kind .. "): " .. tostring(s.desc)
end

