local function parseTierOrder(txt)
    local list, seen = {}, {}
    for n in tostring(txt or ""):gmatch("%d") do
        local t = tonumber(n)
        if t and t >= 1 and t <= 6 and not seen[t] then seen[t] = true; list[#list + 1] = t end
    end
    if #list > 0 then State.TierOrder = list end
end

local function ownedPortals()
    local res = invokeRemote("NWHwPortal", "state")
    local st = type(res) == "table" and (res.state or res) or nil
    local owned = type(st) == "table" and st.Owned
    if type(owned) == "table" then return owned end
    -- fallback: item counts HwPortal1..HwPortal6
    local inv = (type(findInventory) == "function" and findInventory()) or {}
    local out = {}
    for t = 1, 6 do out[t] = tonumber(inv["HwPortal" .. t]) or 0 end
    return out
end

local function pickTier()
    local owned = ownedPortals()
    for _, t in ipairs(State.TierOrder) do
        if (tonumber(owned[t]) or 0) > 0 then return t, owned end
    end
    return nil, owned
end

