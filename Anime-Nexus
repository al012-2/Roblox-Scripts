-- the minigames belong to the Portal Keeper on Halloween Island: stand next to him first
State.MiniTP = false
local function keeperCFrame()
    local k = workspace:FindFirstChild("NW_HwPortalKeeper")
    if not k then return nil end
    local ok, cf = pcall(function() return k:GetPivot() end)
    return ok and cf or nil
end
local function goToKeeper()
    if not State.MiniTP then return true end
    local cf = keeperCFrame()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (cf and hrp) then return false end
    if (hrp.Position - cf.Position).Magnitude > 12 then
        local spot = cf.Position + cf.LookVector * 6 + Vector3.new(0, 3, 0)
        hrp.CFrame = CFrame.new(spot, cf.Position)
        task.wait(1.2)
    end
    return true
end

-- open the game's own minigame window (_G.P2_OpenPortalMini, from NWPortalMiniGame): it sends "sync" itself
local function openMiniWindow()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    local gui = pg and pg:FindFirstChild("NW_PortalMiniGame")
    if gui and gui.Enabled then return true end
    local f = GG.P2_OpenPortalMini
    if type(f) == "function" then
        local ok, err = pcall(f)
        if not ok then Mini.last = "open failed: " .. tostring(err) end
        task.wait(0.8)
        return ok
    end
    Mini.last = IN_PORTAL and "window not loaded yet, wait a bit" or "only inside a Pumpkin Portal"
    return false
end

local function playMini()
    local k = nextMini()
    if not k then return false end
    openMiniWindow()
    Mini.kind, Mini.busy, Mini.busyUntil = k, true, os.clock() + 90
    miniSend("start", k)
    return true
end

