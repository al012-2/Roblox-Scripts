local merlynBusy, merlynAgain = false, false
local merlynCheckRaw
local function merlynCheck()
    if merlynBusy then
        merlynAgain = true
        return false, nil
    end
    merlynBusy = true
    local ok, a, b = pcall(merlynCheckRaw)
    merlynBusy = false
    if merlynAgain then
        merlynAgain = false
        return merlynCheck()
    end
    if not ok then warn("[Merlyn] " .. tostring(a)) return false, nil end
    return a, b
end

merlynCheckRaw = function()
    buildLootIndex() -- may take a moment the first time: done BEFORE reading the selected unit
    local unitKey = State.MerlynUnit
    local step = EvoSteps[unitKey]
    if type(step) ~= "table" then return false, "no recipe" end
    local invFound = findInventory()
    local inv = invFound or {}
    State.InvReadable = invFound ~= nil
    local units = findUnits(unitKey)
    local best = units[1]
    local lines, ready = {}, true
    lines[#lines + 1] = string.format("%s -> %s", unitKey, tostring(step.to))
    local lvOk = best and best.level >= (tonumber(step.level) or 0)
    if not lvOk then ready = false end
    lines[#lines + 1] = string.format("%s Level %s / %s%s", lvOk and "OK" or "--", best and best.level or "?",
        tostring(step.level or 0), best and "" or " (unit not found)")
    if (tonumber(step.yen) or 0) > 0 then lines[#lines + 1] = "   Yen " .. tostring(step.yen) end
    if (tonumber(step.gems) or 0) > 0 then lines[#lines + 1] = "   Gems " .. tostring(step.gems) end
    buildLootIndex()
    State.MissingItem = nil
    local okLines, missLines = {}, {}
    local total, met = 1, (lvOk and 1 or 0)
    for _, it in ipairs(recipeItems(step)) do
        total = total + 1
        local have = tonumber(inv[it.key]) or 0
        local ok = have >= it.n
        if ok then met = met + 1 else ready = false end
        local src = bestSource(it.key)
        local info = ItemInfo[it.key]
        local where = ""
        if not ok then
            if src and src.portal then
                where = " <- " .. src.text
            elseif src and src.infinite then
                where = string.format(" <- Inf %s w%d+", src.map, src.wave)
            elseif src then
                where = string.format(" <- %s %s %d%%%s", src.map:gsub("^Legend", "L."), src.act, math.floor(src.chance * 100 + 0.5),
                    src.pity and (" p" .. tostring(src.pity)) or "")
            elseif info and (info.Obtain or info.obtain) then
                where = "  <- " .. tostring(info.Obtain or info.obtain)
            else
                where = " <- ?"
            end
            if src and not State.MissingItem then State.MissingItem = { key = it.key, need = it.n, src = src } end
        end
        local line
        if State.InvReadable then
            line = string.format("%s %s %d / %d%s", ok and "OK" or "--", it.key, have, it.n, where)
        else
            line = string.format("   %s ? / %d", it.key, it.n) -- unknown here
        end
        if ok then okLines[#okLines + 1] = line else missLines[#missLines + 1] = line end
    end
    for _, l in ipairs(okLines) do lines[#lines + 1] = l end
    for _, l in ipairs(missLines) do lines[#lines + 1] = l end
    State.MerlynScore = string.format("%d/%d", met, total)
    if State.MissingItem then
        lines[#lines + 1] = "Next: " .. State.MissingItem.key .. " @ " .. State.MissingItem.src.map .. " " .. State.MissingItem.src.act
    end
    if type(step.tasks) == "table" then
        for _, t in ipairs(step.tasks) do
            if type(t) == "table" then
                lines[#lines + 1] = "   Task: " .. tostring(t.short or t.label or t.key)
            end
        end
    end
    if not State.InvReadable then
        ready = false
        State.MissingItem = nil
        table.insert(lines, 2, "In match: items unknown, check in lobby")
    end
    MerlynInfo:Set({
        Title = (not State.InvReadable and "Items unknown here") or (ready and "READY TO EVOLVE") or "Missing items",
        Content = table.concat(lines, "\n"),
    })
    return ready, best and best.uuid
end

-- how close a unit is to its evolution (0..1), from level + items
local function readiness(unitKey, owned, inv)
    local step = EvoSteps[unitKey]
    if type(step) ~= "table" then return 0 end
    local o = owned[unitKey]
    local total, met = 1, (o and o.level >= (tonumber(step.level) or 0)) and 1 or 0
    for _, it in ipairs(recipeItems(step)) do
        total = total + 1
        if (tonumber(inv[it.key]) or 0) >= it.n then met = met + 1 end
    end
    return met / total
end

State.ShowAllUnits = false
local function merlynList()
    local owned = ownedUnits(true)
    local inv = findInventory() or {}
    local list = {}
    for _, k in ipairs(merlynKeys) do
        if State.ShowAllUnits or owned[k] then list[#list + 1] = k end
    end
    local score = {}
    for _, k in ipairs(list) do score[k] = (owned[k] and 1 or 0) + readiness(k, owned, inv) end
    table.sort(list, function(a, b)
        if score[a] ~= score[b] then return score[a] > score[b] end
        return a < b
    end)
    if #list == 0 then list = { "(no evolvable units found)" } end
    return list
end

