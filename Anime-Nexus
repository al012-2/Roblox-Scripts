-- ===== Library loading (safe) =====
local function fetch(ref, path)
    local url = "https://raw.githubusercontent.com/deividcomsono/Obsidian/" .. ref .. "/" .. path
    local ok, result = pcall(function()
        return loadstring(game:HttpGet(url))()
    end)
    if ok and result then return result end
    return nil, tostring(result)
end

local function loadLib(path)
    local lib, err = fetch(OBSIDIAN_REF, path)
    if lib then return lib end
    if FALLBACK_REF ~= OBSIDIAN_REF then
        warn("[UI] " .. path .. " failed on " .. OBSIDIAN_REF .. ", trying " .. FALLBACK_REF .. ": " .. err)
        lib, err = fetch(FALLBACK_REF, path)
        if lib then return lib end
    end
    error("[UI] Could not load " .. path .. ": " .. tostring(err), 0)
end

