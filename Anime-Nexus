-- Trick or Treat: the game says "Walk up to the door", so the server checks distance.
-- We walk (teleport) to every door in workspace.NW_HalloweenIsland.NWDoorBlocks, press its prompt
-- if it has one, and send NWAction {type="TrickOrTreat", op="Knock", door=...} like the game does.
local function getDoors()
    local island = workspace:FindFirstChild("NW_HalloweenIsland")
    local folder = island and island:FindFirstChild("NWDoorBlocks")
    if not folder then return {} end
    local doors = folder:GetChildren()
    table.sort(doors, function(a, b)
        local na, nb = tonumber(a.Name), tonumber(b.Name)
        if na and nb then return na < nb end
        return a.Name < b.Name
    end)
    return doors
end

local function doorCFrame(door)
    if door:IsA("BasePart") then return door.CFrame end
    if door:IsA("Model") then return door:GetPivot() end
    local part = door:FindFirstChildWhichIsA("BasePart", true)
    return part and part.CFrame
end

-- doors are named Block_Door_1 .. Block_Door_7 -> the door id is the number at the end
local function doorId(door, index)
    return door:GetAttribute("Door") or door:GetAttribute("Id") or door:GetAttribute("Index")
        or tonumber(door.Name:match("(%d+)$")) or index
end

local function knockAllDoors()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return 0 end
    local doors = getDoors()
    if #doors == 0 then return 0 end
    local back = hrp.CFrame
    nwAction({ type = "TrickOrTreat", op = "Sync" })
    for index, door in ipairs(doors) do
        if not State.Running then break end
        local cf = doorCFrame(door)
        if cf then
            -- stand 4 studs in front of the door, facing it
            local pos = cf.Position + cf.LookVector * 4
            hrp.CFrame = CFrame.new(pos, cf.Position)
            task.wait(0.6)
            local prompt = door:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt and fireproximityprompt then pcall(fireproximityprompt, prompt) end
            nwAction({ type = "TrickOrTreat", op = "Knock", door = doorId(door, index) })
            task.wait(0.2)
            nwAction({ type = "TrickOrTreat", op = "Knock", door = door.Name }) -- in case the server wants the name
            task.wait(1.2)
        end
    end
    hrp.CFrame = back
    return #doors
end

