-- ---------- Smart Abilities: use a unit's ability only when a boss / enemy is in ITS range ----------
--   ability : Character.CharacterHandler.Remotes.UnitAction:FireServer("Active", unitModel, 1)   (verified)
--   units / enemies : workspace.Entities (name = "<Unit>_<number>")
--   unit range : model attribute Range, else UnitData.Units.<Unit>.BaseStats.Range
--   bosses : names in UnitData.Bosses, or attribute Boss / IsBoss
AutoFarmTab:CreateSection("Smart Abilities")

local UD = ReplicatedStorage:FindFirstChild("Modules")
UD = UD and UD:FindFirstChild("Shared")
UD = UD and UD:FindFirstChild("Data")
UD = UD and UD:FindFirstChild("UnitData")
local UNIT_SET, BOSS_SET, RANGE_CACHE = {}, {}, {}
if UD then
    local u = UD:FindFirstChild("Units")
    if u then for _, m in ipairs(u:GetChildren()) do UNIT_SET[m.Name] = m end end
    local b = UD:FindFirstChild("Bosses")
    if b then for _, m in ipairs(b:GetChildren()) do BOSS_SET[m.Name] = true end end
end

local function baseName(model)
    return (model.Name:match("^(.-)_%d[%d%.]*$")) or model.Name
end

local function unitRange(model, base)
    for _, a in ipairs({ "Range", "range", "Rng", "UnitRange" }) do
        local v = tonumber(model:GetAttribute(a))
        if v and v > 0 then return v end
    end
    if RANGE_CACHE[base] == nil then
        RANGE_CACHE[base] = false
        local mod = UNIT_SET[base]
        if mod and mod:IsA("ModuleScript") then
            local ok, d = pcall(require, mod)
            local r = ok and type(d) == "table" and ((type(d.BaseStats) == "table" and d.BaseStats.Range) or d.Range)
            if tonumber(r) then RANGE_CACHE[base] = tonumber(r) end
        end
    end
    return RANGE_CACHE[base] or State.AbilityDefaultRange
end

local function isBoss(model, base)
    if BOSS_SET[base] then return true end
    if model:GetAttribute("Boss") == true or model:GetAttribute("IsBoss") == true then return true end
    local n = base:lower()
    return n:find("_boss", 1, true) ~= nil or n:sub(-4) == "boss"
end

local function isMyUnit(model, base)
    if not UNIT_SET[base] or BOSS_SET[base] then return false end
    local owner = model:GetAttribute("Owner") or model:GetAttribute("OwnerId") or model:GetAttribute("Player")
    if owner ~= nil and owner ~= LocalPlayer.Name and owner ~= LocalPlayer.UserId and tostring(owner) ~= tostring(LocalPlayer.UserId) then
        return false
    end
    return true
end

local function posOf(model)
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    return root and root.Position
end

State.AbilityMode = "Bosses only"
State.AbilityDefaultRange = 30
State.AbilityMinEnemies = 3
State.AbilityRangeMul = 1
local lastUse = {}

local function abilityRemote()
    local c = LocalPlayer.Character
    local h = c and c:FindFirstChild("CharacterHandler")
    local r = h and h:FindFirstChild("Remotes")
    return r and r:FindFirstChild("UnitAction")
end

local function smartAbilityTick()
    local ents = workspace:FindFirstChild("Entities")
    local remote = abilityRemote()
    if not (ents and remote) then return end
    local units, enemies = {}, {}
    for _, m in ipairs(ents:GetChildren()) do
        if m:IsA("Model") then
            local base = baseName(m)
            local p = posOf(m)
            if p then
                if isMyUnit(m, base) then
                    units[#units + 1] = { model = m, pos = p, range = unitRange(m, base) * State.AbilityRangeMul }
                elseif not UNIT_SET[base] or BOSS_SET[base] then
                    local hum = m:FindFirstChildOfClass("Humanoid")
                    if not hum or hum.Health > 0 then
                        enemies[#enemies + 1] = { pos = p, boss = isBoss(m, base) }
                    end
                end
            end
        end
    end
    for _, u in ipairs(units) do
        local bosses, count = 0, 0
        for _, e in ipairs(enemies) do
            if (e.pos - u.pos).Magnitude <= u.range then
                count = count + 1
                if e.boss then bosses = bosses + 1 end
            end
        end
        local mode = State.AbilityMode
        local fire = (mode == "Bosses only" and bosses > 0)
            or (mode == "Any enemy" and count > 0)
            or (mode == "Boss or many enemies" and (bosses > 0 or count >= State.AbilityMinEnemies))
        if fire and (os.clock() - (lastUse[u.model] or 0)) > 1 then
            lastUse[u.model] = os.clock()
            pcall(remote.FireServer, remote, "Active", u.model, 1)
        end
    end
end

