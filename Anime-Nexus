function choose(options, autoIndex)
    local mode = State.CardMode
    if mode == "Always 1" then return 1 end
    if mode == "Always 2" then return 2 end
    if mode == "Always 3" then return 3 end
    if mode == "Random" then return math.random(1, #options) end
    if mode == "Priority List" then
        for _, want in ipairs(State.CardOrder) do
            for i, o in ipairs(options) do
                if type(o) == "table" and (o.id == want or o.name == want) then return i end
            end
        end
    end
    -- "Best Rarity", or no card from the list: highest rarity wins, the game's own pick breaks ties
    local best, bestScore = autoIndex or 1, -1
    for i, o in ipairs(options) do
        local sc = RARITY_SCORE[type(o) == "table" and o.rarity or ""] or 0
        if i == autoIndex then sc = sc + 0.5 end
        if sc > bestScore then best, bestScore = i, sc end
    end
    return best
end

