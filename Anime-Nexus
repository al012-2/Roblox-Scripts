local function fireRemote(name, ...)
    local r = Remotes:FindFirstChild(name)
    if r and r:IsA("RemoteEvent") then
        pcall(r.FireServer, r, ...)
    end
end

-- InvokeServer with a timeout so a loop never hangs if the server does not answer
local INVOKE_TIMEOUT = 5
local function invokeRemote(name, ...)
    local r = Remotes:FindFirstChild(name)
    if not (r and r:IsA("RemoteFunction")) then return nil end
    local args, done, result = table.pack(...), false, nil
    task.spawn(function()
        local ok, res = pcall(r.InvokeServer, r, table.unpack(args, 1, args.n))
        if ok then result = res end
        done = true
    end)
    local t0 = os.clock()
    while not done and os.clock() - t0 < INVOKE_TIMEOUT do task.wait() end
    return result
end

-- One loop per key: turning a toggle off/on quickly never leaves two loops running
local State
local Gen = {}
local function loop(key, enabled, interval, body)
    Gen[key] = (Gen[key] or 0) + 1
    if not enabled then return end
    local my = Gen[key]
    task.spawn(function()
        while State.Running and Gen[key] == my do
            local ok, err = pcall(body)
            if not ok then warn("[" .. key .. "] " .. tostring(err)) end
            if Gen[key] ~= my then break end
            task.wait(type(interval) == "function" and interval() or interval)
        end
    end)
end

