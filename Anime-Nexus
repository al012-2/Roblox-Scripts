-- your items: the table in memory that holds StatChip / SuperStatChip amounts
local invCache, invTime = nil, 0
local function findInventory()
    if invCache and os.clock() - invTime < 30 then return invCache end
    if not getgc then return nil end
    local ok, gc = pcall(getgc, true)
    if not ok then return nil end
    for _, t in ipairs(gc) do
        if type(t) == "table" and type(rawget(t, "StatChip")) == "number" and type(rawget(t, "SuperStatChip")) == "number"
            and rawget(t, "Gems") == nil then
            invCache, invTime = t, os.clock()
            return t
        end
    end
    return nil
end

-- ALL your units in one scan: the table keyed by uuid whose values name units
local ownedCache, ownedTime = nil, 0
local function unitNameOf(v)
    return rawget(v, "Name") or rawget(v, "Unit") or rawget(v, "Key") or rawget(v, "N") or rawget(v, "UnitName")
end
local function ownedUnits(force)
    if ownedCache and not force and os.clock() - ownedTime < 30 then return ownedCache end
    local best = {}
    if not getgc then return best end
    local ok, gc = pcall(getgc, true)
    if not ok then return best end
    local bestCount = 0
    for _, t in ipairs(gc) do
        if type(t) == "table" then
            local found, count = {}, 0
            for k, v in pairs(t) do
                if type(k) == "string" and #k >= 30 and k:find("%-") and type(v) == "table" then
                    local name = unitNameOf(v)
                    if type(name) == "string" then
                        count = count + 1
                        local lv = tonumber(rawget(v, "Level") or rawget(v, "Lv") or rawget(v, "L")) or 0
                        local cur = found[name]
                        if not cur or lv > cur.level then found[name] = { uuid = k, level = lv } end
                    end
                end
            end
            -- the real inventory is the biggest such table
            if count > bestCount then best, bestCount = found, count end
        end
    end
    ownedCache, ownedTime = best, os.clock()
    return best
end

-- your units: tables keyed by uuid whose value names a unit from the recipes
local function findUnits(unitName)
    local o = ownedUnits()[unitName]
    if o then return { o } end
    local res = {}
    if not getgc then return res end
    local ok, gc = pcall(getgc, true)
    if not ok then return res end
    for _, t in ipairs(gc) do
        if type(t) == "table" then
            for k, v in pairs(t) do
                if type(k) == "string" and #k >= 30 and k:find("%-") and type(v) == "table" then
                    local name = rawget(v, "Name") or rawget(v, "Unit") or rawget(v, "Key") or rawget(v, "N") or rawget(v, "UnitName")
                    if name == unitName then
                        res[#res + 1] = { uuid = k, level = tonumber(rawget(v, "Level") or rawget(v, "Lv") or rawget(v, "L")) or 0 }
                    end
                end
            end
            if #res > 0 then break end
        end
    end
    table.sort(res, function(a, b) return a.level > b.level end)
    return res
end

-- recipe items come as {key = n} or {{key, n}} or {{item = key, n = n}}
local function recipeItems(step)
    local list = {}
    for k, v in pairs(type(step.items) == "table" and step.items or {}) do
        if type(k) == "string" and type(v) == "number" then
            list[#list + 1] = { key = k, n = v }
        elseif type(v) == "table" then
            local key = v[1] or v.key or v.item or v.id or v.name
            local n = v[2] or v.n or v.amount or v.count or 1
            if key then list[#list + 1] = { key = tostring(key), n = tonumber(n) or 1 } end
        end
    end
    return list
end

-- where every item drops: StageData.<Map>.<Mode>.<Act>.LootPool = { Item = {Chance, Pity, Quantity} }
local LootIndex, lootBuilt = {}, false
local function buildLootIndex()
    if lootBuilt then return end
    lootBuilt = true
    local sd = ReplicatedStorage:FindFirstChild("Modules")
    sd = sd and sd:FindFirstChild("Shared")
    sd = sd and sd:FindFirstChild("Data")
    sd = sd and sd:FindFirstChild("StageData")
    if not sd then return end
    local n = 0
    for _, mapF in ipairs(sd:GetChildren()) do
        for _, modeF in ipairs(mapF:GetChildren()) do
            for _, act in ipairs(modeF:GetChildren()) do
                if act:IsA("ModuleScript") then
                    n = n + 1
                    local ok, data = pcall(require, act)
                    if ok and type(data) == "table" and type(data.LootPool) == "table" then
                        for item, info in pairs(data.LootPool) do
                            local list = LootIndex[item] or {}
                            LootIndex[item] = list
                            list[#list + 1] = {
                                map = mapF.Name, mode = modeF.Name, act = act.Name,
                                chance = tonumber(type(info) == "table" and info.Chance) or 0,
                                pity = type(info) == "table" and info.Pity or nil,
                            }
                        end
                    end
                    if n % 20 == 0 then task.wait() end
                end
            end
        end
    end
    -- best place first
    for _, list in pairs(LootIndex) do
        table.sort(list, function(a, b) return a.chance > b.chance end)
    end
end

-- items that are not in any LootPool but drop in Infinite mode (from the in-game tooltip)
--   Rainbow Star Essence: "Drops in Infinite mode on every map from wave 35"
local INFINITE_ITEMS = { RelicEssence_Mythic = 35 }
-- items from Pumpkin Portals (tooltips):
--   ZafkielClockCore : "Phantom Portal VI: every win"
--   ZafkielSecondHand: "Night of Terror: clear a tier IV or V Pumpkin Portal with at least 2 Hexes"
local PORTAL_ITEMS = {
    ZafkielClockCore = { tier = 6, mods = 0, text = "Portal VI win" },
    ZafkielSecondHand = { tier = 4, mods = 2, text = "Portal IV + 2 Hex" },
}

local function bestSource(item)
    local list = LootIndex[item]
    if list and list[1] then return list[1] end
    if PORTAL_ITEMS[item] then
        local p = PORTAL_ITEMS[item]
        return { portal = true, tier = p.tier, mods = p.mods, map = "Pumpkin Portal", act = "Tier " .. p.tier,
            chance = 1, text = p.text }
    end
    if INFINITE_ITEMS[item] then
        return { map = State.StoryMap or "InnovationCity", mode = "Story", act = "Infinite", chance = 0,
            infinite = true, wave = INFINITE_ITEMS[item] }
    end
