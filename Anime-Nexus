local function roomIdFrom(list)
    if type(list) ~= "table" then return nil end
    local rooms = list.rooms or list.list or list.Rooms or list
    if type(rooms) ~= "table" then return nil end
    local me, myId = LocalPlayer.Name, LocalPlayer.UserId
    local best
    for key, r in pairs(rooms) do
        if type(r) == "table" then
            local id = r.id or r.Id or r.room or tonumber(key)
            local owner = r.owner or r.host or r.Owner or r.Host or r.ownerId or r.hostId or r.userId or r.name
            local mine = owner == me or owner == myId or tostring(owner) == tostring(myId)
            if not mine and type(r.players) == "table" then
                for _, p in pairs(r.players) do
                    if p == me or p == myId or (type(p) == "table" and (p.name == me or p.userId == myId)) then mine = true end
                end
            end
            if id and mine then return id end
            if id and (not best or (tonumber(id) or 0) > (tonumber(best) or 0)) then best = id end
        end
    end
    return best -- fallback: newest room
end

function openAndJoinPortal()
    if not IN_LOBBY then return false, "not in lobby" end
    if State.UseTierOrder and not State.ForceTier then
        local t, owned = pickTier()
