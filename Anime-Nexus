-- ---------- portal minigames (NWPortalMini) ----------
-- verified from NWPortalMiniGame: the server sends the answer of every round
--   you -> NWPortalMini:FireServer("start", kind) / "sync" / "cancel"
--   server -> ("round", data) ("win", {wins, mult}) ("fail", {readyAt}) ("state", {wins, maxWins, mult, cd, playing})
--   answers: lock "hit" t | cups "pick" ball | memory "answer" seq | whack "whack" t cell | quick "draw" t | bats "count" n
PortalTab:CreateSection("Minigames")

local MINI_KINDS = { "lock", "cups", "memory", "whack", "quick", "bats" }
local MINI_NAMES = { lock = "Lock", cups = "Cups", memory = "Memory", whack = "Ghost Whack", quick = "Quick Draw", bats = "Bat Count" }
local Mini = { busy = false, busyUntil = 0, wins = 0, maxWins = 0, mult = 1, cd = {}, last = "-", pick = "All" }
-- the remote can appear late (the game itself waits up to 120 s for it)
local miniRemote = Remotes:FindFirstChild("NWPortalMini")
local function miniSend(...)
    miniRemote = miniRemote or Remotes:FindFirstChild("NWPortalMini")
    if miniRemote then pcall(miniRemote.FireServer, miniRemote, ...) end
    Mini.sent = (Mini.sent or 0) + 1
end
local function now() return workspace:GetServerTimeNow() end
local function waitUntil(t) while now() < t do task.wait() end end

local function solveRound(kind, d)
    local t0 = tonumber(d.t0) or now()
    if kind == "lock" then
        -- needle: v = (t - t0) * speed % 2, position = v (<= 1) or 2 - v; hit when position = zone centre c
        local sp, c = tonumber(d.speed) or 1, tonumber(d.c) or 0.5
        local base = math.max(0, (now() - t0) * sp) + 0.08 * sp
        local k, best = math.floor(base / 2), nil
        for kk = k, k + 2 do
            for _, v in ipairs({ c, 2 - c }) do
                local x = 2 * kk + v
                if x >= base then
                    local t = t0 + x / sp
                    if not best or t < best then best = t end
                end
            end
        end
        task.spawn(function() waitUntil(best or now()) miniSend("hit", now()) end)
    elseif kind == "cups" then
        local ready = t0 + (tonumber(d.show) or 1.6) + #(type(d.seq) == "table" and d.seq or {}) * (tonumber(d.dur) or 0.4)
        task.spawn(function() waitUntil(ready + 0.15) miniSend("pick", tonumber(d.ball) or 1) end)
    elseif kind == "memory" then
        local seq = type(d.seq) == "table" and d.seq or {}
        local ready = t0 + #seq * (tonumber(d.flash) or 0.6)
        local ans = {}
        for i, v in ipairs(seq) do ans[i] = v end
        task.spawn(function() waitUntil(ready + 0.2) miniSend("answer", ans) end)
    elseif kind == "whack" then
        for _, g in ipairs(type(d.ghosts) == "table" and d.ghosts or {}) do
            local cell, at = g[1], tonumber(g[2])
            if cell and at then
                task.spawn(function() waitUntil(at + 0.06) miniSend("whack", now(), cell) end)
            end
        end
    elseif kind == "quick" then
        local go = tonumber(d.go) or (now() + 2)
        task.spawn(function() waitUntil(go + 0.02) miniSend("draw", now()) end)
    elseif kind == "bats" then
        local ready = t0 + (tonumber(d.show) or 3)
        task.spawn(function() waitUntil(ready + 0.15) miniSend("count", tonumber(d.count) or 5) end)
    end
end

task.spawn(function()
    miniRemote = miniRemote or Remotes:WaitForChild("NWPortalMini", 120)
    if not (miniRemote and miniRemote:IsA("RemoteEvent")) then
        Mini.last = "NWPortalMini remote not found here"
        return
    end
    miniRemote.OnClientEvent:Connect(function(ev, d)
        if not State.Running then return end
        Mini.got = (Mini.got or 0) + 1
        Mini.lastEv = tostring(ev)
        d = type(d) == "table" and d or {}
        if ev == "state" then
            Mini.wins = tonumber(d.wins) or Mini.wins
            Mini.maxWins = tonumber(d.maxWins) or Mini.maxWins
            Mini.mult = tonumber(d.mult) or Mini.mult
            Mini.cd = type(d.cd) == "table" and d.cd or Mini.cd
            if not d.playing then Mini.busy = false end
        elseif ev == "round" then
            if State.MiniAuto or Mini.solveManual then solveRound(d.kind or Mini.kind, d) end
        elseif ev == "win" then
            Mini.busy = false
            Mini.wins = tonumber(d.wins) or Mini.wins
            Mini.mult = tonumber(d.mult) or Mini.mult
            Mini.last = "WIN " .. tostring(MINI_NAMES[d.kind] or d.kind)
        elseif ev == "fail" then
            Mini.busy = false
            if d.kind then Mini.cd[d.kind] = tonumber(d.readyAt) or (now() + 10) end
            Mini.last = "FAIL " .. tostring(MINI_NAMES[d.kind] or d.kind)
        end
    end)
end)

