-- TELEPORT — every NPC (search by name) and every area of the lobby
--   NPCs  : models with a talk prompt (ObjectText = NPC name) + workspace.npcs
--   Areas : NW_HwTravelAnchors, P2_Portals, spawn points, halls (NWWarp), Halloween Island
-- ====================================================================
do -- ===== section =====
local TeleportTab = Window:CreateTab("Teleport")

local function hrpNow()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function tpTo(target)
    local hrp = hrpNow()
    if not hrp or not target then return false end
    local cf
    if typeof(target) == "CFrame" then cf = target
    elseif typeof(target) == "Vector3" then cf = CFrame.new(target)
    elseif typeof(target) == "Instance" and target.Parent then
        local ok, piv = pcall(function() return target:IsA("BasePart") and target.CFrame or target:GetPivot() end)
        cf = ok and piv or nil
    end
    if not cf then return false end
    -- stand a few studs in front, a bit higher, facing the target
    local pos = cf.Position + cf.LookVector * 5 + Vector3.new(0, 3, 0)
    hrp.CFrame = CFrame.new(pos, cf.Position)
    return true
end

-- ---------- NPCs ----------
local NpcMap = {}
local function topModel(inst)
    local cur = inst
    while cur.Parent and cur.Parent ~= workspace and not (cur:IsA("Model") and cur:FindFirstChildOfClass("Humanoid")) do
        cur = cur.Parent
    end
    return cur
end

local function scanNpcs()
    local map, names = {}, {}
    local function add(name, inst)
        name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if name == "" or map[name] then return end
        map[name] = inst
        names[#names + 1] = name
    end
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") and not isMine(d) then
            local m = topModel(d)
            local isNpc = m:IsA("Model") and m:FindFirstChildOfClass("Humanoid")
            if isNpc or d.Name:lower():find("talk", 1, true) then
                local name = d.ObjectText ~= "" and d.ObjectText or m.Name
                local extra = d.ActionText ~= "" and (" (" .. d.ActionText .. ")") or ""
                add(name .. extra, m)
            end
        end
    end
    local folder = workspace:FindFirstChild("npcs") or workspace:FindFirstChild("NPCs") or workspace:FindFirstChild("Npcs")
    if folder then
        for _, m in ipairs(folder:GetChildren()) do add(m.Name, m) end
    end
    table.sort(names, function(a, b) return a:lower() < b:lower() end)
    NpcMap = map
    if #names == 0 then names = { "(no NPC found, press Refresh)" } end
    return names
end

TeleportTab:CreateSection("NPCs")
local NpcDD = TeleportTab:CreateDropdown({
    Name = "NPC (type to search)",
    Options = scanNpcs(),
    Callback = function(opt)
        State.LastNpc = opt[1]
        local target = NpcMap[opt[1] or ""]
        if Booted and target then tpTo(target) end
    end,
})
TeleportTab:CreateButton({
    Name = "TP Again",
    Callback = function() tpTo(NpcMap[State.LastNpc or ""]) end,
})
TeleportTab:CreateButton({ Name = "Refresh NPCs", Callback = function() NpcDD:Refresh(scanNpcs()) end })

-- ---------- areas / worlds ----------
local AreaMap = {}
local function scanAreas()
    local map, names = {}, {}
    local function add(name, target)
        if not target or map[name] then return end
        map[name] = target
        names[#names + 1] = name
    end
    add("Lobby (spawn)", function()
        local sp = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
        return sp
    end)
    add("Quest Hall (warp)", "warp:QuestHall")
    add("Hall of Fame (warp)", "warp:HallOfFame")
    add("Halloween Island", function() return workspace:FindFirstChild("NW_HwPortalKeeper") end)
    add("Halloween Island Gate", function()
        local g = workspace:FindFirstChild("NW_HwPortalGate")
        return g and g:FindFirstChild("PromptPart") or g
    end)
    local anchors = workspace:FindFirstChild("NW_HwTravelAnchors")
    if anchors then
        for _, a in ipairs(anchors:GetChildren()) do add("Island: " .. a.Name, a) end
    end
    local portals = workspace:FindFirstChild("P2_Portals")
    if portals then
        for _, pt in ipairs(portals:GetChildren()) do add("Portal pad: " .. pt.Name, pt) end
    end
    for _, d in ipairs(workspace:GetChildren()) do
        local n = d.Name:lower()
        if (d:IsA("Model") or d:IsA("Folder")) and (n:find("hall", 1, true) or n:find("island", 1, true)
            or n:find("zone", 1, true) or n:find("area", 1, true) or n:find("lair", 1, true) or n:find("arena", 1, true)) then
            if d:IsA("Model") then add("Area: " .. d.Name, d)
            else
                local part = d:FindFirstChildWhichIsA("BasePart", true)
                if part then add("Area: " .. d.Name, part) end
            end
        end
    end
    AreaMap = map
    return names
end

local function goArea(name)
    local t = AreaMap[name]
    if type(t) == "function" then t = t() end
    if type(t) == "string" and t:sub(1, 5) == "warp:" then
        fireRemote("NWWarp", t:sub(6))
        return
    end
    if not tpTo(t) then Rayfield:Notify({ Title = "Teleport", Content = "not loaded: " .. tostring(name) }) end
end

