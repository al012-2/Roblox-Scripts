-- item info (display name + where it drops), searched by item key in every item data module
local ItemInfo = {}
local function indexItems(t, depth)
    if type(t) ~= "table" or depth > 3 then return end
    for k, v in pairs(t) do
        if type(v) == "table" then
            if v.Obtain or v.Des or v.desc or v.obtain then
