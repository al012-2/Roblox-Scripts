local ignoreIdx = { "MenuKeybind", "SpySettingChange", "AutoStartOnLoad", "AutoSaveConfig", "AutoSaveEvery" }

local function nextIdx(flag)
    if flag and flag ~= "" then return flag end
    uiCounter = uiCounter + 1
    local id = "_ui" .. uiCounter
    table.insert(ignoreIdx, id)
    return id
end

local function safe(fn, name)
    if type(fn) ~= "function" then return function() end end
    return function(...)
        local ok, err = pcall(fn, ...)
        if not ok then warn("[UI] callback error (" .. tostring(name) .. "): " .. tostring(err)) end
    end
end

local function decimalsOf(step)
    step = tonumber(step) or 1
    if step >= 1 then return 0 end
    local s = tostring(step)
    local dot = s:find("%.")
    return dot and (#s - dot) or 0
end

local function toList(value)
    if type(value) ~= "table" then
        return value ~= nil and { value } or {}
    end
    -- Rayfield style list {"a", "b"} (this was the bug: defaults were treated as a set and lost)
    if value[1] ~= nil then
        local list = {}
        for _, v in ipairs(value) do list[#list + 1] = v end
        return list
    end
    local list = {}
    for k, v in pairs(value) do
        if v == true then table.insert(list, k) end
    end
    table.sort(list, function(a, b) return tostring(a) < tostring(b) end)
    return list
end

local function toSet(list)
    local set = {}
    if type(list) == "table" then
        for _, v in ipairs(list) do set[v] = true end
    elseif list ~= nil then
        set[list] = true
    end
    return set
end

