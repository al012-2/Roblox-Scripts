-- COLLECTOR — finds hidden items in the map, walks (teleports) to them and picks them up
--   works with ProximityPrompts, ClickDetectors and touch pickups whose names match
-- ====================================================================
local isMine
do -- ===== section =====
local CollectTab = Window:CreateTab("Collector")

local COLLECT = {
    { key = "Fingers",     words = { "finger" },                       note = "Sukuno fingers (Itaduri quest), Curse Lair" },
    { key = "Chests",      words = { "chest", "grimoire" },            avoid = { "mimic" }, note = "Grimoire chests (Frieren), Halloween Island" },
    { key = "Horseshoes",  words = { "horseshoe" },                    note = "Golden Horseshoes (Johnny): lobby, Quest Hall, Event Hall" },
    { key = "Reishi",      words = { "reishi" },                       note = "Reishi orbs (Ichigo) near the lobby NPCs" },
    { key = "Dragonballs", words = { "dragonball", "dragon ball", "1star", "2star", "3star", "4star", "5star", "6star", "7star" }, note = "Dragon Balls (Potara)" },
    { key = "Ghosts",      words = { "hwghost", "ghost" },             note = "Halloween ghosts (daily: catch 15)" },
}

local function lower(s) return tostring(s or ""):lower() end
local function hasAny(s, list)
    s = lower(s)
    for _, w in ipairs(list or {}) do if s:find(w, 1, true) then return true end end
    return false
end

-- the name chain of an object (its own name + 3 parents), used to match the words
local function nameChain(inst)
    local parts, cur = {}, inst
    for _ = 1, 4 do
        if not cur or cur == workspace then break end
        parts[#parts + 1] = cur.Name
        cur = cur.Parent
    end
    return table.concat(parts, " ")
end

function isMine(inst)
    local char = LocalPlayer.Character
    if char and inst:IsDescendantOf(char) then return true end
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Character and inst:IsDescendantOf(pl.Character) then return true end
    end
    return false
end

local function looksMimic(inst)
    local cur = inst
    for _ = 1, 4 do
        if not cur then break end
        if cur:GetAttribute("Mimic") == true or cur:GetAttribute("IsMimic") == true or lower(cur.Name):find("mimic", 1, true) then
            return true
        end
        cur = cur.Parent
    end
    return false
end

local function partOf(inst)
    if inst:IsA("BasePart") then return inst end
    local p = inst.Parent
    if p and p:IsA("BasePart") then return p end
    if p and p:IsA("Model") then return p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart", true) end
    if p and p:IsA("Attachment") and p.Parent and p.Parent:IsA("BasePart") then return p.Parent end
    return nil
end

-- every pickup of one kind: {part, prompt / click / touch}
local function scanKind(kind)
    local found, used = {}, {}
    for _, d in ipairs(workspace:GetDescendants()) do
        local isPrompt = d:IsA("ProximityPrompt")
        local isClick = d:IsA("ClickDetector")
        local isTouch = d:IsA("TouchTransmitter")
        if (isPrompt or isClick or isTouch) and not isMine(d) then
            local text = nameChain(d) .. (isPrompt and (" " .. d.ActionText .. " " .. d.ObjectText) or "")
            if hasAny(text, kind.words) and not hasAny(text, kind.avoid) and not (kind.avoid and looksMimic(d)) then
                local part = partOf(d)
                if part and not used[part] and (not isPrompt or d.Enabled) then
                    used[part] = true
                    found[#found + 1] = { part = part, prompt = isPrompt and d or nil, click = isClick and d or nil, touch = isTouch }
                end
            end
        end
    end
    return found
end

local function pickUp(item, hrp)
    local part = item.part
    if not part or not part.Parent then return end
    hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
    task.wait(0.35)
    if item.prompt and fireproximityprompt then
        pcall(fireproximityprompt, item.prompt)
    elseif item.click and fireclickdetector then
        pcall(fireclickdetector, item.click)
    elseif item.touch and firetouchinterest then
        pcall(firetouchinterest, hrp, part, 0)
        task.wait(0.05)
        pcall(firetouchinterest, hrp, part, 1)
    end
    task.wait(0.5)
end

local collectBusy = false
local function collectKind(kind, quiet)
    if collectBusy then return 0 end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return 0 end
    collectBusy = true
    local back = hrp.CFrame
    local list = scanKind(kind)
    for _, item in ipairs(list) do
        if not State.Running then break end
        pcall(pickUp, item, hrp)
    end
    hrp.CFrame = back
    collectBusy = false
    if not quiet then
        Rayfield:Notify({ Title = "Collector", Content = string.format("%s: %d found", kind.key, #list) })
    end
    return #list
end

