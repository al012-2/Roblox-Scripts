    State.ForceTier = nil
    local res = invokeRemote("NWHwPortalRoom", "create", State.PortalTier, State.PortalMods)
    if type(res) == "table" and res.ok == false then return false, tostring(res.msg or "create failed") end
    task.wait(1)
    local list = invokeRemote("NWHwPortalRoom", "list")
    State.LastRoomList = list
    local id = roomIdFrom(list)
    if not id then return false, "room id not found (press Print Room List)" end
    local j = invokeRemote("NWHwPortalRoom", "join", id)
    return type(j) == "table" and j.ok ~= false, "join " .. tostring(id)
end

