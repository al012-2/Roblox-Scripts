    -- ONE folder for every place. Before, the folder had the PlaceId in it, so configs made in the lobby
    -- "disappeared" inside the portal (another PlaceId) and the other way round.
    local function migrateOldConfigs()
        if not (listfiles and isfolder and readfile and writefile and makefolder) then return end
        local newDir = CONFIG_FOLDER .. "/settings"
        pcall(function()
            if not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
            if not isfolder(newDir) then makefolder(newDir) end
        end)
        for _, pid in ipairs({ "85962582687820", "135920189096514", tostring(game.PlaceId) }) do
            local oldDir = CONFIG_FOLDER .. "/" .. pid .. "/settings"
            if isfolder(oldDir) then
                local ok, files = pcall(listfiles, oldDir)
                for _, f in ipairs(ok and files or {}) do
                    local name = f:match("([^/\\]+)$")
                    if name then
                        local target = newDir .. "/" .. name
                        local isAuto = name == "autoload.txt"
                        if not isfile(target) or (isAuto and pid == "85962582687820") then
                            pcall(function() writefile(target, readfile(f)) end)
                        end
                    end
                end
            end
        end
    end
    migrateOldConfigs()
    SaveManager:SetFolder(CONFIG_FOLDER)
    SaveManager:BuildConfigSection(settingsTab)
    ThemeManager:ApplyToTab(settingsTab)

    Rayfield.Loading = true
    pcall(function() SaveManager:LoadAutoloadConfig() end)
    Rayfield.Loading = false

    -- ===== Auto Save: saves the config by itself when something changed =====
    local function autoloadName()
        local ok, name = pcall(function()
            if SaveManager.GetAutoloadConfig then return SaveManager:GetAutoloadConfig() end
        end)
        if ok and type(name) == "string" and name ~= "" and name ~= "none" then return name end
        for _, path in ipairs({ CONFIG_FOLDER .. "/settings/autoload.txt", CONFIG_FOLDER .. "/autoload.txt" }) do
            local ok2, txt = pcall(function() return isfile and isfile(path) and readfile(path) end)
            if ok2 and type(txt) == "string" and txt ~= "" then return (txt:gsub("%s+$", "")) end
        end
        return nil
    end

    local ignoreSet = {}
    for _, k in ipairs(ignoreIdx) do ignoreSet[k] = true end
    local function snapshot()
        local keys, parts = {}, {}
        for k in pairs(LToggles) do if not ignoreSet[k] then keys[#keys + 1] = "T" .. k end end
        for k in pairs(LOptions) do if not ignoreSet[k] then keys[#keys + 1] = "O" .. k end end
        table.sort(keys)
        for _, key in ipairs(keys) do
            local obj = key:sub(1, 1) == "T" and LToggles[key:sub(2)] or LOptions[key:sub(2)]
            local v = obj and obj.Value
            if type(v) == "table" then
                local t = {}
                for a, b in pairs(v) do t[#t + 1] = tostring(a) .. "=" .. tostring(b) end
                table.sort(t)
                v = "{" .. table.concat(t, ",") .. "}"
            end
            parts[#parts + 1] = key .. ":" .. tostring(v)
        end
        return table.concat(parts, "|")
    end

    local auto = settingsTab:AddLeftGroupbox("Auto Save", "save")
    auto:AddToggle("AutoSaveConfig", { Text = "Auto Save Config", Default = true })
    auto:AddSlider("AutoSaveEvery", { Text = "Every", Default = 10, Min = 5, Max = 60, Rounding = 0, Suffix = " s" })
    local saveLabel = auto:AddLabel("saves into your autoload config", true)

    -- remember the Auto Save switch between sessions (it is not part of the config itself)
    local autoPref = CONFIG_FOLDER .. "/autosave.txt"
    pcall(function()
        if isfile and isfile(autoPref) then LToggles.AutoSaveConfig:SetValue(readfile(autoPref) ~= "0") end
    end)
    LToggles.AutoSaveConfig:OnChanged(function()
        pcall(function() if writefile then writefile(autoPref, LToggles.AutoSaveConfig.Value and "1" or "0") end end)
    end)

    task.spawn(function()
        local last = snapshot()
        local stopped = false
        table.insert(unloadHandlers, function() stopped = true end)
        while not stopped and not Library.Unloaded do
            task.wait(tonumber(LOptions.AutoSaveEvery and LOptions.AutoSaveEvery.Value) or 10)
            if LToggles.AutoSaveConfig and LToggles.AutoSaveConfig.Value then
                local now = snapshot()
                if now ~= last then
                    local name = autoloadName()
                    if not name then
                        -- no autoload yet: make one called "autosave" and load it next time
                        name = "autosave"
                        pcall(function()
                            if SaveManager.SaveAutoloadConfig then SaveManager:SaveAutoloadConfig(name)
                            elseif writefile then writefile(CONFIG_FOLDER .. "/settings/autoload.txt", name) end
                        end)
                    end
                    local ok = pcall(function() return SaveManager:Save(name) end)
                    if ok then
                        last = now
                        pcall(function() saveLabel:SetText("saved into '" .. name .. "' at " .. os.date("%H:%M:%S")) end)
                    end
                end
            end
        end
    end)

    if not LToggles.AutoStartOnLoad.Value then
        for idx in pairs(runToggles) do
            local t = LToggles[idx]
            if t and t.Value then t:SetValue(false) end
        end
    end
end

