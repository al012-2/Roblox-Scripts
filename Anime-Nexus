-- ===== Tab class =====
local TabClass = {}
TabClass.__index = TabClass

function TabClass:_box()
    if self._tabbox then return self._tabbox end
    local g = self._group
    if g.Left <= g.Right then
        self._tabbox = g.Tab:AddLeftTabbox(self.Name)
        self._side = "Left"
    else
        self._tabbox = g.Tab:AddRightTabbox(self.Name)
        self._side = "Right"
    end
    return self._tabbox
end

function TabClass:_target()
    if not self._current then
        self._current = self:_box():AddTab("Main")
    end
    local g = self._group
    g[self._side] = g[self._side] + 1
    return self._current
end

function TabClass:CreateSection(name)
    self._current = self:_box():AddTab(L(name or "Section"))
    local tab = self
    return {
        Set = function(_, newName)
            tab._current = tab:_box():AddTab(L(newName))
        end,
    }
end

function TabClass:CreateDivider()
    self:_target():AddDivider()
    return { Set = function() end }
end

function TabClass:CreateLabel(text)
    local label = self:_target():AddLabel(tostring(text or ""), true)
    return {
        Set = function(_, newText) label:SetText(tostring(newText)) end,
    }
end

-- A paragraph = a title line + a fixed number of line labels.
-- (one big label does not grow when its text changes, so long text got cut)
function TabClass:CreateParagraph(opts)
    opts = opts or {}
    local target = self:_target()
    local maxLines = tonumber(opts.Lines) or 14
    -- find the real TextLabel behind a library label (to colour it)
    local function textObj(lbl, marker)
        local obj = rawget(lbl, "TextLabel") or rawget(lbl, "Label") or rawget(lbl, "Instance")
        if typeof(obj) == "Instance" and obj:IsA("TextLabel") then return obj end
        local root = (gethui and gethui()) or game:GetService("CoreGui")
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("TextLabel") and d.Text == marker then return d end
        end
        return nil
    end
    uiCounter = uiCounter + 1
    local tmark = "\1title" .. uiCounter
    local title = target:AddLabel(tmark, true)
    local titleObj = textObj(title, tmark)
    local lines, objs = {}, {}
    for i = 1, maxLines do
        local mark = "\1line" .. uiCounter .. "_" .. i
        lines[i] = target:AddLabel(mark, true)
        objs[i] = textObj(lines[i], mark)
    end
    local GREEN, RED, WHITE = Color3.fromRGB(90, 230, 120), Color3.fromRGB(240, 95, 95), nil

    local cur = { Title = opts.Title, Content = opts.Content }
    local function render()
        title:SetText("[ " .. tostring(cur.Title or "") .. " ]")
        if titleObj then
            local t = tostring(cur.Title or ""):upper()
            titleObj.TextColor3 = t:find("READY") and GREEN or (t:find("MISSING") and RED or titleObj.TextColor3)
        end
        local WRAP = tonumber(opts.Wrap) or 40
        local list = {}
        for line in (tostring(cur.Content or "") .. "\n"):gmatch("(.-)\n") do
            if #line <= WRAP then
                list[#list + 1] = line
            else
                -- cut at spaces; continuation lines keep the colour of the first one
                local prefix = line:sub(1, 2)
                local tag = (prefix == "OK" or prefix == "--") and prefix or "  "
                local rest, first, parts = line, true, 0
                while #rest > 0 and parts < 3 do
                    local chunk
                    if #rest <= WRAP or parts == 2 then
                        chunk, rest = rest, ""
                    else
                        local cut = rest:sub(1, WRAP):match("^.*() ")
                        if cut and cut > 1 then
                            chunk, rest = rest:sub(1, cut - 1), rest:sub(cut + 1)
                        else
                            chunk, rest = rest:sub(1, WRAP), rest:sub(WRAP + 1)
                        end
                    end
                    list[#list + 1] = first and chunk or (tag .. "   " .. chunk)
                    first, parts = false, parts + 1
                end
            end
        end
        if #list > maxLines then
            list[maxLines] = "... (" .. (#list - maxLines + 1) .. " more)"
        end
        for i = 1, maxLines do
            local text = list[i] or " "
            local colourTag = text:sub(1, 2)
            if text:sub(3, 5) == "   " and (colourTag == "OK" or colourTag == "--") and text:sub(1, 5) ~= text then
                -- continuation: hide the tag but keep the colour
                text = "     " .. text:sub(6)
            end
            local ok = pcall(function() lines[i]:SetText(text) end)
            local o = objs[i]
            if o then
                pcall(function()
                    if not ok then o.Text = text end -- fallback: write the text straight into the label
                    if WHITE == nil then WHITE = o.TextColor3 end
                    local t2 = colourTag
                    o.TextColor3 = (t2 == "OK" and GREEN) or (t2 == "--" and RED) or WHITE
                end)
            end
        end
    end
    render()
    return {
        Set = function(_, o)
            o = o or {}
            cur.Title = o.Title or cur.Title
            cur.Content = o.Content or cur.Content
            render()
        end,
    }
end

function TabClass:CreateButton(opts)
    opts = opts or {}
    local cb = safe(opts.Callback, opts.Name)
    local btn = self:_target():AddButton({
        Text = L(opts.Name or "Button"),
        Func = cb,
        DoubleClick = opts.DoubleClick or false,
        Tooltip = opts.Tooltip,
    })
    return {
        Set = function(_, newText) if btn and btn.SetText then btn:SetText(tostring(newText)) end end,
    }
end

function TabClass:CreateToggle(opts)
    opts = opts or {}
    local idx = nextIdx(opts.Flag)
    local cb = safe(opts.Callback, opts.Name)
    local obj = { CurrentValue = opts.CurrentValue == true, Type = "Toggle" }

    self:_target():AddToggle(idx, {
        Text = L(opts.Name or idx),
        Default = obj.CurrentValue,
        Tooltip = opts.Tooltip,
        Callback = function(v)
            obj.CurrentValue = v
            -- while the config loads, run toggles stay off unless Auto-start is enabled
            if v and Rayfield.Loading and runToggles[idx]
                and not (LToggles.AutoStartOnLoad and LToggles.AutoStartOnLoad.Value) then
                return
            end
            cb(v)
        end,
    })

    if opts.Flag and (opts.Run == true or (opts.Run == nil and RUN_GROUPS[self.Group])) then
        runToggles[idx] = true
    end

    function obj:Set(v) LToggles[idx]:SetValue(v == true) end
    if opts.Flag then Rayfield.Flags[opts.Flag] = obj end
    return obj
end

function TabClass:CreateSlider(opts)
    opts = opts or {}
    local idx = nextIdx(opts.Flag)
    local cb = safe(opts.Callback, opts.Name)
    local range = opts.Range or { 0, 100 }
    local obj = { CurrentValue = opts.CurrentValue or range[1], Type = "Slider" }

    self:_target():AddSlider(idx, {
        Text = L(opts.Name or idx),
        Default = obj.CurrentValue,
        Min = range[1],
        Max = range[2],
        Rounding = decimalsOf(opts.Increment),
        Suffix = opts.Suffix and (" " .. tostring(opts.Suffix)) or nil,
        Tooltip = opts.Tooltip,
        Callback = function(v)
            obj.CurrentValue = v
            cb(v)
        end,
    })

    function obj:Set(v) LOptions[idx]:SetValue(v) end
    if opts.Flag then Rayfield.Flags[opts.Flag] = obj end
    return obj
end

function TabClass:CreateDropdown(opts)
    opts = opts or {}
    local idx = nextIdx(opts.Flag)
    local cb = safe(opts.Callback, opts.Name)
    local multi = opts.MultipleOptions == true
    local values = opts.Options or {}
    local obj = { CurrentOption = toList(opts.CurrentOption), Options = values, Type = "Dropdown" }

    self:_target():AddDropdown(idx, {
        Text = L(opts.Name or idx),
        Values = values,
        Multi = multi,
        Searchable = #values > 8,
        AllowNull = true,
        Tooltip = opts.Tooltip,
        Callback = function(v)
            obj.CurrentOption = toList(v)
            cb(obj.CurrentOption)
        end,
    })

    local dd = LOptions[idx]
    if #obj.CurrentOption > 0 then
        if multi then dd:SetValue(toSet(obj.CurrentOption)) else dd:SetValue(obj.CurrentOption[1]) end
    end

    function obj:Set(v)
        local list = toList(v)
        if multi then dd:SetValue(toSet(list)) else dd:SetValue(list[1]) end
    end
    function obj:Refresh(newValues)
        obj.Options = newValues or {}
        dd:SetValues(obj.Options)
    end
    if opts.Flag then Rayfield.Flags[opts.Flag] = obj end
    return obj
end

function TabClass:CreateInput(opts)
    opts = opts or {}
    local idx = nextIdx(opts.Flag)
    local cb = safe(opts.Callback, opts.Name)
    local obj = { CurrentValue = tostring(opts.CurrentValue or ""), Type = "Input" }

    self:_target():AddInput(idx, {
        Text = L(opts.Name or idx),
        Default = obj.CurrentValue,
        Placeholder = opts.PlaceholderText or "",
        Numeric = opts.Numeric or false,
        Finished = true,
        ClearTextOnFocus = false,
        Tooltip = opts.Tooltip,
        Callback = function(v)
            obj.CurrentValue = v
            cb(v)
            if opts.RemoveTextAfterFocusLost and v ~= "" then
                task.defer(function() LOptions[idx]:SetValue("") end)
            end
        end,
    })

    function obj:Set(v) LOptions[idx]:SetValue(tostring(v)) end
    if opts.Flag then Rayfield.Flags[opts.Flag] = obj end
    return obj
end

function TabClass:CreateKeybind(opts)
    opts = opts or {}
    local idx = nextIdx(opts.Flag)
    local cb = safe(opts.Callback, opts.Name)
    local obj = { CurrentKeybind = opts.CurrentKeybind or "None", Type = "Keybind" }

    self:_target():AddLabel(L(opts.Name or idx)):AddKeyPicker(idx, {
        Default = obj.CurrentKeybind,
        Mode = opts.HoldToInteract and "Hold" or "Toggle",
        Text = L(opts.Name or idx),
        Callback = function(state) cb(state) end,
        ChangedCallback = function(key)
