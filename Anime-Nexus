-- the step to work on: claimable first, then the active one, then the first not finished
local function currentStep(st)
    if type(st) ~= "table" or type(st.Steps) ~= "table" then return nil end
    for _, s in ipairs(st.Steps) do if type(s) == "table" and s.ready then return s end end
    for _, s in ipairs(st.Steps) do if type(s) == "table" and s.status == "active" then return s end end
    for _, s in ipairs(st.Steps) do
        if type(s) == "table" and s.status ~= "done" and s.status ~= "claimed" and s.status ~= "complete" then return s end
    end
    return nil
end

