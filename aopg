-- منطق الطيران المباشر بالمسافة المحددة مع جعل النظرة نحو البوت دائماً
local function FlyToTargetEnemy(targetHRP)
    local char = GetCharacter()
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp or not targetHRP then return end

    -- حساب الموقع بالمسافة المحددة من زر Distance
    local standPos = targetHRP.Position + (targetHRP.CFrame.LookVector * farmDistance) + Vector3.new(0, 1.5, 0)
    local targetCFrame = CFrame.lookAt(standPos, targetHRP.Position)

    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    if distance < 2 then
        hrp.CFrame = targetCFrame
        return
    end

    local tweenInfo = TweenInfo.new(distance / 160, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()
end

local function GetQuestPart()
    local ok, result = pcall(function()
        return workspace.Interactables[selectedDummy][selectedDummy]
    end)
    return ok and result or nil
end

local function GetCurrentTargetData()
    local quests = player:FindFirstChild("Quests2")
    if quests and quests:FindFirstChild("1") and quests["1"]:FindFirstChild("Targets") then
        local targetObj = quests["1"].Targets:GetChildren()[1]
        if targetObj then
            local killed = targetObj:FindFirstChild("Killed")
            local amount = targetObj:FindFirstChild("Amount")
            return targetObj.Name, killed, amount
        end
    end
    return nil, nil, nil
end

local function GetTargetEnemy(targetName)
    local closestEnemy = nil
    local shortestDistance = math.huge
    local char = GetCharacter()
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local searchLocations = {workspace:FindFirstChild("Entities"), workspace:FindFirstChild("Enemies"), workspace}
    for _, location in pairs(searchLocations) do
        if location then
            for _, model in pairs(location:GetChildren()) do
                if model:IsA("Model") and model.Name ~= player.Name and model.Name:find(targetName) and model:FindFirstChild("Humanoid") and model.Humanoid.Health > 0 and model:FindFirstChild("HumanoidRootPart") then
                    local dist = (hrp.Position - model.HumanoidRootPart.Position).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        closestEnemy = model
                    end
                end
            end
        end
    end
    return closestEnemy
end

local function TakeQuest()
    local QuestPart = GetQuestPart()
    if not QuestPart then return end

    local char = GetCharacter()
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local targetPos = QuestPart.Position + Vector3.new(0, 3, 4)
        local targetCFrame = CFrame.lookAt(targetPos, QuestPart.Position)
        local tween = TweenService:Create(hrp, TweenInfo.new((hrp.Position - targetPos).Magnitude / 160, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
        tween:Play()
        tween.Completed:Wait()
    end

    task.wait(0.2)

    local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if Remotes then
        if Remotes:FindFirstChild("talk") then Remotes.talk:FireServer(QuestPart) end
        task.wait(0.3)
        if Remotes:FindFirstChild("quest") then
            Remotes.quest:FireServer("Accept", { Index = 1, Model = QuestPart })
        end
    end
end

local function CloseDialogue()
    local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if Remotes then
        pcall(function() Remotes.talk:FireServer("Cancel") end)
        pcall(function() Remotes.talk:FireServer(nil) end)
        pcall(function() Remotes.quest:FireServer("Cancel") end)
    end
    for _, v in pairs(PlayerGui:GetChildren()) do
        if v:IsA("ScreenGui") and v.Name ~= "AOPG_UltraUI" then
            local name = v.Name:lower()
            if name:find("dialog") or name:find("talk") or name:find("quest") or name:find("interaction") then
                v.Enabled = false
            end
        end
    end
end

local function AutoEquipSelectedWeapon()
    if not autoEquipEnabled or not selectedWeapon then return end
    local char = GetCharacter()
    if not char then return end

    local currentTool = char:FindFirstChildOfClass("Tool")
    if not currentTool or currentTool.Name ~= selectedWeapon then
        local backpack = player:FindFirstChild("Backpack")
        if backpack then
            local targetTool = backpack:FindFirstChild(selectedWeapon)
            if targetTool and char:FindFirstChild("Humanoid") then
                char.Humanoid:EquipTool(targetTool)
            end
        end
    end
end

local function CastSkills()
    if not autoSkillsEnabled then return end
    if tick() - lastSkillTime > 0.6 then
        lastSkillTime = tick()
        for keyName, isEnabled in pairs(activeKeys) do
            if isEnabled then
                local enumKey = Enum.KeyCode[keyName]
                if enumKey then
                    VirtualInputManager:SendKeyEvent(true, enumKey, false, game)
                    task.wait(0.03)
                    VirtualInputManager:SendKeyEvent(false, enumKey, false, game)
                end
            end
        end
    end
end

local function PerformAttack()
    AutoEquipSelectedWeapon()
    local char = GetCharacter()
    if not char then return end

    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        tool:Activate()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if remotes then
            if remotes:FindFirstChild("Attack") then remotes.Attack:FireServer()
            elseif remotes:FindFirstChild("Hit") then remotes.Hit:FireServer() end
        end
        CastSkills()
    end
end

local function AutoFarmLoop()
    task.spawn(function()
        while autoFarmEnabled do
            task.wait(0.08)
            local targetName, killedObj, amountObj = GetCurrentTargetData()
            if targetName then
                local kVal = killedObj and killedObj.Value or 0
                local aVal = amountObj and amountObj.Value or 5

                if kVal >= aVal then
                    task.wait(0.2)
                    TakeQuest()
                    task.wait(0.3)
                    CloseDialogue()
                else
                    local enemy = GetTargetEnemy(targetName)
                    if enemy and enemy:FindFirstChild("HumanoidRootPart") and enemy.Humanoid.Health > 0 then
                        FlyToTargetEnemy(enemy.HumanoidRootPart)
                        PerformAttack()
                    end
                end
            else
                if autoEnabled then
                    TakeQuest()
                    task.wait(0.3)
                    CloseDialogue()
                else
                    autoFarmEnabled = false
                    break
                end
            end
        end
    end)
end

