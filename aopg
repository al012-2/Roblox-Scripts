--// Variables for Farming
local autoFarmEnabled = false
local autoQuestEnabled = false
local autoEquipEnabled = true
local autoSkillsEnabled = true
local farmDistance = 5
local selectedDummy = "Quest Dummy 1"
local selectedWeapon = "Chop Fruit"
local activeKeys = {Q = true, E = true, R = true, F = true}

--// Helper Functions
local function GetCharacter()
    local entities = workspace:FindFirstChild("Entities")
    if entities and entities:FindFirstChild(player.Name) then
        return entities[player.Name]
    end
    return player.Character
end

local function GetTargetEnemy()
    local char = GetCharacter()
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local closestEnemy = nil
    local shortestDistance = math.huge

    local npcs = workspace:FindFirstChild("NPCs") or workspace:FindFirstChild("Enemies") or workspace
    for _, model in pairs(npcs:GetChildren()) do
        if model:IsA("Model") and model.Name ~= player.Name and model:FindFirstChild("Humanoid") and model.Humanoid.Health > 0 and model:FindFirstChild("HumanoidRootPart") then
            local dist = (hrp.Position - model.HumanoidRootPart.Position).Magnitude
            if dist < shortestDistance then
                shortestDistance = dist
                closestEnemy = model
            end
        end
    end
    return closestEnemy
end

local function FlyToTargetEnemy(targetHRP)
    local char = GetCharacter()
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp or not targetHRP then return end

    local standPos = targetHRP.Position + (targetHRP.CFrame.LookVector * farmDistance) + Vector3.new(0, 1.5, 0)
    local targetCFrame = CFrame.lookAt(standPos, targetHRP.Position)

    if (hrp.Position - targetCFrame.Position).Magnitude < 2 then
        hrp.CFrame = targetCFrame
        return
    end

    local tween = TweenService:Create(hrp, TweenInfo.new(0.05, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    tween:Play()
end

local function PerformAttack()
    local char = GetCharacter()
    if not char then return end

    if autoEquipEnabled and selectedWeapon then
        local backpack = player:FindFirstChild("Backpack")
        local tool = backpack and backpack:FindFirstChild(selectedWeapon)
        if tool and char:FindFirstChild("Humanoid") then
            char.Humanoid:EquipTool(tool)
        end
    end

    local equippedTool = char:FindFirstChildOfClass("Tool")
    if equippedTool then
        equippedTool:Activate()
    end

    if autoSkillsEnabled then
        for key, enabled in pairs(activeKeys) do
            if enabled and Enum.KeyCode[key] then
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
                task.wait(0.01)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
            end
        end
    end
end

