-- ===================== Loop =====================
task.spawn(function()
    while true do
        task.wait(0.05)
        if autoFarmEnabled then
            local targetName, killedObj, amountObj = GetCurrentTargetData()
            
            if killAnyNearby then
                -- يقتل أي NPC قريب
                local enemy = GetClosestEnemy(nil)
                if enemy and enemy:FindFirstChild("HumanoidRootPart") and enemy.Humanoid.Health > 0 then
                    PositionToEnemy(enemy.HumanoidRootPart)
                    PerformAttack()
                else
                    ClearFarmForces()
                end
            elseif targetName then
                local kVal = killedObj and killedObj.Value or 0
                local aVal = amountObj and amountObj.Value or 5

                if kVal >= aVal then
                    ClearFarmForces()
                    TakeQuest()
                    task.wait(0.2)
                    CloseDialogue()
                else
                    local enemy = GetClosestEnemy(targetName)
                    if enemy and enemy:FindFirstChild("HumanoidRootPart") and enemy.Humanoid.Health > 0 then
                        PositionToEnemy(enemy.HumanoidRootPart)
                        PerformAttack()
                    else
                        ClearFarmForces()
                    end
                end
            else
                ClearFarmForces()
                if autoQuestEnabled then
                    TakeQuest()
                    task.wait(0.2)
                    CloseDialogue()
                end
            end
        end
    end
end)

