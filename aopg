-- ===================== Helpers =====================
local function GetCharacter()
    local entities = workspace:FindFirstChild("Entities")
    if entities and entities:FindFirstChild(player.Name) then
        return entities[player.Name]
    end
    return player.Character
end

local function GetOrCreateFarmPart()
    if farmPart and farmPart.Parent then return farmPart end
    farmPart = Instance.new("Part")
    farmPart.Name = "FarmPositionPart"
    farmPart.Size = Vector3.new(1, 1, 1)
    farmPart.Transparency = 1
    farmPart.CanCollide = false
    farmPart.Anchored = true
    farmPart.Parent = workspace
    return farmPart
end

local function EnableNoclip()
    if noclipConnection then return end
    noclipConnection = RunService.Stepped:Connect(function()
        local char = GetCharacter()
        if char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)
end

local function DisableNoclip()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
    local char = GetCharacter()
    if char then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.CanCollide = true
            end
        end
    end
end

local function GetQuestPart()
    local ok, result = pcall(function()
        return workspace.Interactables[selectedDummy][selectedDummy]
    end)
    return ok and result or nil
end

local function TakeQuest()
    local QuestPart = GetQuestPart()
    if not QuestPart then return end
    local char = GetCharacter()
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = CFrame.lookAt(QuestPart.Position + Vector3.new(0, 3, 4), QuestPart.Position)
    end
    task.wait(0.1)
    local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if Remotes then
        if Remotes:FindFirstChild("talk") then Remotes.talk:FireServer(QuestPart) end
        task.wait(0.2)
        if Remotes:FindFirstChild("quest") then
            Remotes.quest:FireServer("Accept", { Index = 1, Model = QuestPart })
        end
    end
end

local function CloseDialogue()
    local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if Remotes then
        pcall(function() Remotes.talk:FireServer("Cancel") end)
        pcall(function() Remotes.talk:FireServer(nil) end)
        pcall(function() Remotes.quest:FireServer("Cancel") end)
    end
end

local function GetCurrentTargetData()
    local quests = player:FindFirstChild("Quests2")
    if quests and quests:FindFirstChild("1") and quests["1"]:FindFirstChild("Targets") then
        local targetObj = quests["1"].Targets:GetChildren()[1]
        if targetObj then
            return targetObj.Name, targetObj:FindFirstChild("Killed"), targetObj:FindFirstChild("Amount")
        end
    end
    return nil, nil, nil
end

local function GetClosestEnemy(optionalName)
    local closestEnemy = nil
    local shortestDistance = math.huge
    local char = GetCharacter()
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local searchLocations = {workspace:FindFirstChild("Entities"), workspace:FindFirstChild("Enemies"), workspace}
    for _, location in pairs(searchLocations) do
        if location then
            for _, model in pairs(location:GetChildren()) do
                if model:IsA("Model") and model.Name ~= player.Name 
                    and model:FindFirstChild("Humanoid") and model.Humanoid.Health > 0 
                    and model:FindFirstChild("HumanoidRootPart") then
                    
                    -- لو killAnyNearby = true ياخذ أي واحد، غير كذا يدور على الاسم
                    if killAnyNearby or (optionalName and model.Name:find(optionalName)) then
                        local dist = (hrp.Position - model.HumanoidRootPart.Position).Magnitude
                        if dist < shortestDistance and dist < 300 then -- حد أقصى 300
                            shortestDistance = dist
                            closestEnemy = model
                        end
                    end
                end
            end
        end
    end
    return closestEnemy
end

local function PositionToEnemy(targetHRP)
    local char = GetCharacter()
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp or not targetHRP then return end

    local offset = Vector3.new(0, 0, 0)
    if farmPosition == "Behind" then
        offset = (targetHRP.CFrame.LookVector * -farmDistance) + Vector3.new(0, 1.5, 0)
    elseif farmPosition == "Above" then
        offset = Vector3.new(0, farmDistance, 0)
    elseif farmPosition == "Below" then
        offset = Vector3.new(0, -farmDistance, 0)
    end

    local part = GetOrCreateFarmPart()
    part.CFrame = CFrame.lookAt(targetHRP.Position + offset, targetHRP.Position)

    local bp = hrp:FindFirstChild("FarmBodyPosition")
    if not bp then
        bp = Instance.new("BodyPosition")
        bp.Name = "FarmBodyPosition"
        bp.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bp.P = 50000
        bp.D = 2000
        bp.Parent = hrp
    end
    bp.Position = part.Position

    local bg = hrp:FindFirstChild("FarmBodyGyro")
    if not bg then
        bg = Instance.new("BodyGyro")
        bg.Name = "FarmBodyGyro"
        bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
        bg.P = 5000
        bg.Parent = hrp
    end
    bg.CFrame = CFrame.lookAt(hrp.Position, targetHRP.Position)
end

local function ClearFarmForces()
    local char = GetCharacter()
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local bp = hrp:FindFirstChild("FarmBodyPosition")
        if bp then bp:Destroy() end
        local bg = hrp:FindFirstChild("FarmBodyGyro")
        if bg then bg:Destroy() end
    end
    if farmPart then
        farmPart:Destroy()
        farmPart = nil
    end
end

local function AutoEquipSelectedWeapon()
    if not autoEquipEnabled or not selectedWeapon then return end
    local char = GetCharacter()
    if not char then return end
    local currentTool = char:FindFirstChildOfClass("Tool")
    if not currentTool or currentTool.Name ~= selectedWeapon then
        local backpack = player:FindFirstChild("Backpack")
        if backpack then
            local targetTool = backpack:FindFirstChild(selectedWeapon)
            if targetTool and char:FindFirstChild("Humanoid") then
                char.Humanoid:EquipTool(targetTool)
            end
        end
    end
end

local function PressKey(key)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, key, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, key, false, game)
    end)
end

local function CastSkills()
    if autoBusoHaki and not busoActivated then
        PressKey(Enum.KeyCode.J)
        busoActivated = true
    elseif not autoBusoHaki then
        busoActivated = false
    end

    if autoKenHaki and not kenActivated then
        PressKey(Enum.KeyCode.K)
        kenActivated = true
    elseif not autoKenHaki then
        kenActivated = false
    end

    if autoConquerorHaki and not conquerorActivated then
        PressKey(Enum.KeyCode.L)
        conquerorActivated = true
    elseif not autoConquerorHaki then
        conquerorActivated = false
    end

    if not autoSkillsEnabled then return end
    if tick() - lastSkillTime < 0.85 then return end
    lastSkillTime = tick()

    for keyName, isEnabled in pairs(activeKeys) do
        if isEnabled then
            local enumKey = Enum.KeyCode[keyName]
            if enumKey then
                PressKey(enumKey)
                task.wait(0.12)
            end
        end
    end
end

local function PerformAttack()
    AutoEquipSelectedWeapon()
    local char = GetCharacter()
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        tool:Activate()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if remotes then
            if remotes:FindFirstChild("Attack") then remotes.Attack:FireServer()
            elseif remotes:FindFirstChild("Hit") then remotes.Hit:FireServer() end
        end
        CastSkills()
    end
end

-- ===================== Fly Function =====================
local function FlyToPosition(targetPos, name)
    local char = GetCharacter()
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    ClearFarmForces()
    EnableNoclip()

    local finalPos = targetPos + Vector3.new(0, 8, 0)

    local bp = Instance.new("BodyPosition")
    bp.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bp.P = 12000
    bp.D = 800
    bp.Position = hrp.Position
    bp.Parent = hrp

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bg.P = 3000
    bg.CFrame = hrp.CFrame
    bg.Parent = hrp

    local distance = (hrp.Position - finalPos).Magnitude
    local time = math.clamp(distance / 80, 1.5, 8)

    local tween = TweenService:Create(bp, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = finalPos
    })
    tween:Play()
    tween.Completed:Wait()

    bp:Destroy()
    bg:Destroy()
    DisableNoclip()

    Library:Notification({
        Title = "Travel",
        Description = "وصلت إلى: " .. tostring(name),
        Duration = 3
    })
end

local function GetIslandPosition(islandName)
    local islands = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Islands")
    if not islands then return nil end
    local islandFolder = islands:FindFirstChild(islandName)
    if not islandFolder then return nil end

    local model = islandFolder:FindFirstChild("Model") or islandFolder
    local target = model:FindFirstChild(islandName) or model:FindFirstChildWhichIsA("BasePart") or model:FindFirstChildWhichIsA("Model")
    
    if target then
        if target:IsA("Model") then return target:GetPivot().Position
        elseif target:IsA("BasePart") then return target.Position end
    end
    return nil
end

local function GetNPCPosition(npcName)
    local interactables = workspace:FindFirstChild("Interactables")
    if not interactables then return nil end
    local npc = interactables:FindFirstChild(npcName)
    if not npc then return nil end

    local part = npc:FindFirstChild(npcName) or npc:FindFirstChildWhichIsA("BasePart") or npc:FindFirstChildWhichIsA("Model")
    if part then
        if part:IsA("Model") then return part:GetPivot().Position
        elseif part:IsA("BasePart") then return part.Position end
    end
    return npc:IsA("Model") and npc:GetPivot().Position or nil
end

local function GetDungeonPosition(dungeonName)
    local map = workspace:FindFirstChild("Map")
    if not map then return nil end

    -- نبحث في أماكن محتملة
    local possible = {
        map:FindFirstChild("Dungeons"),
        map:FindFirstChild("Dungeon"),
        map:FindFirstChild("Raids"),
        map
    }

    for _, folder in pairs(possible) do
        if folder then
            local dung = folder:FindFirstChild(dungeonName)
            if dung then
                local part = dung:FindFirstChildWhichIsA("BasePart") or dung:FindFirstChildWhichIsA("Model")
                if part then
                    if part:IsA("Model") then return part:GetPivot().Position
                    else return part.Position end
                end
            end
        end
    end
    return nil
end

