})

HakiSection:Toggle({
    Name = "Auto Observation Haki (K)",
    Flag = "AutoKen",
    Default = false,
    Callback = function(Value) autoKenHaki = Value end
})

HakiSection:Toggle({
    Name = "Auto Conqueror Haki (L)",
    Flag = "AutoConqueror",
    Default = false,
    Callback = function(Value) autoConquerorHaki = Value end
})

Window:Category("Settings")
Library:CreateSettingsPage(Window, KeybindList)

-- Loop Execution
task.spawn(function()
    while true do
        task.wait(0.05)
        if autoFarmEnabled then
            local targetName, killedObj, amountObj = GetCurrentTargetData()
            if targetName then
                local kVal = killedObj and killedObj.Value or 0
                local aVal = amountObj and amountObj.Value or 5

                if kVal >= aVal then
                    TakeQuest()
                    task.wait(0.2)
                    CloseDialogue()
                else
                    local enemy = GetTargetEnemy(targetName)
                    if enemy and enemy:FindFirstChild("HumanoidRootPart") and enemy.Humanoid.Health > 0 then
                        PositionToEnemy(enemy.HumanoidRootPart)
                        PerformAttack()
                    end
                end
            else
                if autoQuestEnabled then
                    TakeQuest()
                    task.wait(0.2)
                    CloseDialogue()
                end
            end
        end
    end
end)

