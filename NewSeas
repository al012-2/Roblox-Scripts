local function getWeaponsList()
    local list = {}
    local function scan(container)
        if not container then return end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") and not table.find(list, item.Name) then
                table.insert(list, item.Name)
            end
        end
    end
    scan(player.Character)
    scan(player:FindFirstChild("Backpack"))
    if #list == 0 then table.insert(list, "Combat") end
    return list
end

local function cleanMobName(name)
    return (name:gsub("%s*#%d+", ""))
end

local function getMobsList()
    local names, seen = {}, {}
    for _, entity in ipairs(liveFolder:GetChildren()) do
        if entity:IsA("Model") and not Players:GetPlayerFromCharacter(entity) and entity ~= player.Character then
            local cleanName = cleanMobName(entity.Name)
            if not seen[cleanName] then
                seen[cleanName] = true
                table.insert(names, cleanName)
            end
        end
    end
    table.sort(names)
    table.insert(names, 1, "Nearest")
    return names
end

local function getPlayersList()
    local plist = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then table.insert(plist, p.Name) end
    end
    if #plist == 0 then table.insert(plist, "لا يوجد لاعبين آخرين") end
    return plist
end

local function getIslandsNames()
    local names = {}
    for name in pairs(islandLocations) do table.insert(names, name) end
    table.sort(names)
    return names
end

local chestKeyword = "chest"
local excludeWords = {"npc", "quest", "player", "appraiser", "merchant", "shop", "dealer", "vendor", "seller", "buyer", "trader", "guide", "key"}

local function matchesChestName(lowName)
    if not (lowName:find(chestKeyword, 1, true) or lowName:find("spawner", 1, true)) then
        return false
    end
    for _, w in ipairs(excludeWords) do
        if lowName:find(w, 1, true) then return false end
    end
    return true
end

-- هل هذا الكائن (أو أحد آبائه) شخصية/NPC؟
local function hasHumanoidAround(obj)
    if obj:IsA("Model") and obj:FindFirstChildWhichIsA("Humanoid", true) then return true end
    local m = obj:FindFirstAncestorOfClass("Model")
    while m do
        if m:FindFirstChildOfClass("Humanoid") then return true end
        m = m:FindFirstAncestorOfClass("Model")
    end
    return false
end

local function getRealChests()
    local myChar = player.Character
    local root = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not root then return {} end
    local myPos = root.Position
    local found = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            -- فحص الاسم أولاً (رخيص)، والفحوصات الثقيلة بعده فقط
            local lowName = string.lower(obj.Name)
            if matchesChestName(lowName) then

                local skip = obj:FindFirstAncestor("Live") or obj:FindFirstAncestor("NPCs")
                    or (myChar and obj:IsDescendantOf(myChar))
                    or obj:IsDescendantOf(farmPlatform)
                    or hasHumanoidAround(obj)
                    or obj:FindFirstChildWhichIsA("Dialog", true)

                if not skip then
                    local part
                    if obj:IsA("BasePart") then
                        part = obj
                    else
                        part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
                    end
                    if part and part.Parent then
                        table.insert(found, {
                            baseName = obj.Name,
                            model = obj,
                            part = part,
                            dist = (myPos - part.Position).Magnitude
                        })
                    end
                end
            end
        end
    end

    table.sort(found, function(a, b) return a.dist < b.dist end)
    return found
end

-- يبني القائمة ويخزن الصناديق بالاسم (المسافة وقت التحديث)
local function refreshChestList()
    chestMap = {}
    local list = {}
    for i, c in ipairs(getRealChests()) do
        local display = string.format("%d. %s (%dm)", i, c.baseName, math.floor(c.dist))
        chestMap[display] = c
        table.insert(list, display)
        if i >= 60 then break end
    end
    if #list == 0 then table.insert(list, "لا توجد صناديق متاحة") end
    return list
end

-- ================= أدوات الواجهة (GUI) =================
local function stripRich(t)
    return (tostring(t):gsub("<[^>]->", ""))
end

local function isGuiShown(obj)
    local cur = obj
    while cur and cur ~= game do
        if cur:IsA("GuiObject") and not cur.Visible then return false end
        if cur:IsA("ScreenGui") and not cur.Enabled then return false end
        cur = cur.Parent
    end
    return true
end

-- يبحث عن نص ظاهر في PlayerGui (أو داخل root إذا انحدد)
local function findGuiByText(text, root)
    root = root or player:FindFirstChildOfClass("PlayerGui")
    if not root then return nil end
    local want = string.lower(text)
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("TextButton") or d:IsA("TextLabel") then
            local t = string.lower(stripRich(d.Text)):match("^%s*(.-)%s*$")
            if t == want and isGuiShown(d) then return d end
        end
    end
    return nil
end

-- ضغط زر واجهة: إشارات أولاً، وإذا ما تأثر يضغط بالماوس الافتراضي
local function clickGui(obj)
    local btn = obj:IsA("GuiButton") and obj or obj:FindFirstAncestorWhichIsA("GuiButton")
    if btn then
        if firesignal then
            for _, ev in ipairs({"MouseButton1Down", "MouseButton1Click", "Activated", "MouseButton1Up"}) do
                pcall(function() firesignal(btn[ev]) end)
            end
        elseif getconnections then
            for _, ev in ipairs({"MouseButton1Click", "Activated"}) do
                pcall(function()
                    for _, conn in ipairs(getconnections(btn[ev])) do conn:Fire() end
                end)
            end
        end
    end

    task.wait(0.3)

    if VIM and obj.Parent and isGuiShown(obj) then
        local pos, size = obj.AbsolutePosition, obj.AbsoluteSize
        local sg = obj:FindFirstAncestorOfClass("ScreenGui")
        local inset = (sg and sg.IgnoreGuiInset) and 0 or GuiService:GetGuiInset().Y
        local x, y = pos.X + size.X / 2, pos.Y + size.Y / 2 + inset
        pcall(function()
            VIM:SendMouseMoveEvent(x, y, game)
            task.wait(0.05)
            VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
            task.wait(0.05)
            VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
        end)
    end
end

-- ضغطة مطولة بالماوس على الصندوق في العالم
local function holdClickPart(part, duration)
    if not VIM then return end
    local cam = workspace.CurrentCamera
    if not cam or not part or not part.Parent then return end

    local oldType = cam.CameraType
    pcall(function()
        cam.CameraType = Enum.CameraType.Scriptable
        cam.CFrame = CFrame.new(part.Position + Vector3.new(-1, 10, -8), part.Position)
        task.wait(0.2)

        local v, onScreen = cam:WorldToViewportPoint(part.Position)
        if onScreen then
            VIM:SendMouseMoveEvent(v.X, v.Y, game)
            task.wait(0.05)
            VIM:SendMouseButtonEvent(v.X, v.Y, 0, true, game, 0)
            task.wait(duration)
            VIM:SendMouseButtonEvent(v.X, v.Y, 0, false, game, 0)
        end
    end)
    pcall(function() cam.CameraType = oldType end)
end

-- يرجع: (الصندوق موجود؟, تم جمع الغنائم؟)
local function openChest(c)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root or not c or not c.part or not c.part.Parent then return false, false end

    root.AssemblyLinearVelocity = Vector3.zero
    char:PivotTo(CFrame.new(c.part.Position + Vector3.new(4, 3, 0)))
    task.wait(0.3)

    -- 1) البرومبتات و ClickDetector
    for _, d in ipairs(c.model:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            pcall(function() d.HoldDuration = 0 end)
            pcall(fireproximityprompt, d)
        elseif d:IsA("ClickDetector") and fireclickdetector then
            pcall(fireclickdetector, d)
        end
    end

    local function waitLoot(t)
        local t0 = os.clock()
        while os.clock() - t0 < t do
            local b = findGuiByText("loot all")
            if b then return b end
            task.wait(0.2)
        end
        return nil
    end

    local lootBtn = waitLoot(1)

    -- 2) إذا ما انفتح: ضغطة مطولة فعلية على الصندوق
    if not lootBtn then
        holdClickPart(c.part, chestHoldTime)
        lootBtn = waitLoot(2.5)
    end

    -- 3) Loot All ثم Close
    if lootBtn then
        task.wait(0.2)
        clickGui(lootBtn)
        task.wait(0.4)

        local sg = lootBtn:FindFirstAncestorOfClass("ScreenGui")
        local closeBtn = sg and findGuiByText("close", sg)
        if closeBtn then clickGui(closeBtn) end
        return true, true
    end

    return true, false
end

-- ================= Hitbox (للوحوش فقط، مو اللاعبين) =================
local hitboxEnabled = false
local hitboxSize = 15
local hitboxBackup = {}

local function getMobRoot(entity)
    return entity:FindFirstChild("HumanoidRootPart") or entity.PrimaryPart
        or entity:FindFirstChild("Root") or entity:FindFirstChild("Torso")
end

local hitboxRange = 60
local bringEnabled = false
local bringDistance = 4
local bringCount = 10

local function restorePart(part)
    local o = hitboxBackup[part]
    if not o then return end
    hitboxBackup[part] = nil
    if part and part.Parent then
        pcall(function()
            part.Size = o.Size
            part.Transparency = o.Transparency
            part.CanCollide = o.CanCollide
            part.Massless = o.Massless
        end)
    end
end

-- يطبّق الهت بوكس فقط على الوحوش القريبة الحية، ويرجّع الباقي لوضعه الطبيعي
local function applyHitbox()
    local char = player.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local myPos = myRoot.Position
    local active = {}
    local sz = Vector3.new(hitboxSize, hitboxSize, hitboxSize)

    for _, entity in ipairs(liveFolder:GetChildren()) do
        if entity:IsA("Model") and entity ~= char and not Players:GetPlayerFromCharacter(entity) then
            local part = getMobRoot(entity)
            local hum = entity:FindFirstChildOfClass("Humanoid")
            if part and part:IsA("BasePart") and (not hum or hum.Health > 0)
                and (myPos - part.Position).Magnitude <= hitboxRange then
                active[part] = true
                if not hitboxBackup[part] then
                    hitboxBackup[part] = {
                        Size = part.Size,
                        Transparency = part.Transparency,
                        CanCollide = part.CanCollide,
                        Massless = part.Massless
                    }
                end
                if part.Size ~= sz then part.Size = sz end
                part.Transparency = 0.8
                part.CanCollide = false
                part.Massless = true
            end
        end
    end

    for part in pairs(hitboxBackup) do
        if not active[part] then restorePart(part) end
    end
end

local function restoreHitbox()
    for part, o in pairs(hitboxBackup) do
        if part and part.Parent then
            pcall(function()
                part.Size = o.Size
                part.Transparency = o.Transparency
                part.CanCollide = o.CanCollide
                part.Massless = o.Massless
            end)
        end
    end
    hitboxBackup = {}
end

task.spawn(function()
    while alive do
        task.wait(0.5)
        if hitboxEnabled then pcall(applyHitbox) end
    end
    pcall(restoreHitbox) -- عند إغلاق السكربت يرجع الأحجام
end)

-- ================= تشخيص أسماء الوحوش =================
local function dumpMobs()
    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local groups, order = {}, {}

    local function add(entity, place)
        if entity == player.Character or Players:GetPlayerFromCharacter(entity) then return end
        local hum = entity:FindFirstChildOfClass("Humanoid")
        local part = getMobRoot(entity)
        local dist = (myRoot and part) and math.floor((myRoot.Position - part.Position).Magnitude) or -1
        local key = string.format("%s | %s | humanoid=%s", cleanMobName(entity.Name), place, tostring(hum ~= nil))
        local g = groups[key]
        if not g then
            g = { count = 0, loaded = 0, nearest = math.huge, raw = entity.Name }
            groups[key] = g
            table.insert(order, key)
        end
        g.count = g.count + 1
        if part then g.loaded = g.loaded + 1 end
        if dist >= 0 and dist < g.nearest then g.nearest = dist end
    end

    for _, child in ipairs(liveFolder:GetChildren()) do
        if child:IsA("Model") then
            add(child, "Live")
        elseif child:IsA("Folder") then
            for _, sub in ipairs(child:GetChildren()) do
                if sub:IsA("Model") then add(sub, "Live/" .. child.Name) end
            end
        end
    end

    -- كائنات فيها Humanoid خارج Live (يمكن وحوش مخزنة في مكان ثاني)
    for _, h in ipairs(workspace:GetDescendants()) do
        if h:IsA("Humanoid") then
            local m = h.Parent
            if m and m:IsA("Model") and not m:IsDescendantOf(liveFolder) then
                add(m, "workspace/" .. (m.Parent and m.Parent.Name or "?"))
            end
        end
    end

    local lines = {}
    for _, key in ipairs(order) do
        local g = groups[key]
        local near = g.nearest == math.huge and "?" or (g.nearest .. "m")
        local line = string.format("%s  x%d  محمّل=%d/%d  أقرب=%s  (الاسم الخام: %s)", key, g.count, g.loaded, g.count, near, g.raw)
        print("[GameHub][Mob] " .. line)
        table.insert(lines, line)
    end
    return lines
end

