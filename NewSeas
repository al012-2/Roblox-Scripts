-- جلب الوحوش أمامك (يأثر على السيرفر فقط لو تملك فيزياء الوحش)
local function matchesTarget(entity)
    if currentTarget == "Nearest" then return true end
    return cleanMobName(entity.Name) == currentTarget
        or string.find(string.lower(entity.Name), string.lower(currentTarget), 1, true) ~= nil
end

local lastOwnerWarn = 0
table.insert(connections, RunService.Heartbeat:Connect(function()
    if not bringEnabled then return end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local cands = {}
    for _, entity in ipairs(liveFolder:GetChildren()) do
        if entity:IsA("Model") and entity ~= char and not Players:GetPlayerFromCharacter(entity)
            and matchesTarget(entity) then
            local part = getMobRoot(entity)
            local hum = entity:FindFirstChildOfClass("Humanoid")
            if part and part:IsA("BasePart") and (not hum or hum.Health > 0) then
                local d = (root.Position - part.Position).Magnitude
                if d <= hitboxRange then
                    table.insert(cands, { part = part, dist = d })
                end
            end
        end
    end

    -- نجلب مجموعة: الأقرب أولاً وبحد أقصى العدد المحدد
    table.sort(cands, function(a, b) return a.dist < b.dist end)
    while #cands > bringCount do table.remove(cands) end

    local owned = 0
    for i, c in ipairs(cands) do
        c.part.CFrame = root.CFrame * CFrame.new((((i - 1) % 5) - 2) * 1.2, 0, -bringDistance - math.floor((i - 1) / 5) * 1.2)
        c.part.AssemblyLinearVelocity = Vector3.zero
        if isnetworkowner and isnetworkowner(c.part) then owned = owned + 1 end
    end

    if isnetworkowner and #cands > 0 and owned == 0 and os.clock() - lastOwnerWarn > 8 then
        lastOwnerWarn = os.clock()
        notify("Bring", "ما تملك فيزياء هالوحوش، الجلب يتغير عندك بس ولا يأثر على السيرفر", 6)
    end
end))

