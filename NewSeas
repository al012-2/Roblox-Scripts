local function getTarget()
    local char = player.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local myPos = myRoot.Position

    local nearestPart, minDist = nil, math.huge
    local want = string.lower(currentTarget)

    for _, entity in ipairs(liveFolder:GetChildren()) do
        if entity:IsA("Model") and entity ~= char and not Players:GetPlayerFromCharacter(entity) then
            if currentTarget == "Nearest" or cleanMobName(entity.Name) == currentTarget
                or string.find(string.lower(entity.Name), want, 1, true) then
                local hum = entity:FindFirstChildOfClass("Humanoid")
                local part = entity.PrimaryPart or entity:FindFirstChild("Root")
                    or entity:FindFirstChild("HumanoidRootPart") or entity:FindFirstChild("Torso")
                if part and (not hum or hum.Health > 0) then
                    local d = (myPos - part.Position).Magnitude
                    if d < minDist then
                        minDist = d
                        nearestPart = part
                    end
                end
            end
        end
    end
    return nearestPart
end

