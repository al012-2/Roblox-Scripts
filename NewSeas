    ToggleChestFarm:OnChanged(function()
        isCollectingChests = Fluent.Options.AutoChestToggle.Value
        if not isCollectingChests then return end
        visitedChests = {}

        task.spawn(function()
            while alive and isCollectingChests do
                -- مسح واحد للخريطة، ثم نمر على النتائج بالترتيب
                local ok, chests = pcall(getRealChests)
                local queue = {}
                if ok then
                    for _, c in ipairs(chests) do
                        if not visitedChests[c.model] then table.insert(queue, c) end
                    end
                end

                if #queue == 0 then
                    notify("الصناديق", "ما بقي صناديق جديدة", 3)
                    isCollectingChests = false
                    pcall(function() ToggleChestFarm:SetValue(false) end)
                    break
                end

                for _, c in ipairs(queue) do
                    if not (alive and isCollectingChests) then break end
                    visitedChests[c.model] = true
                    if c.part and c.part.Parent then
                        openChest(c)
                        task.wait(0.5)
                    end
                end
            end
        end)
    end)
end)

