                    cards += 1
                    if addId(info.name, baseId, true) then count += 1 end
                    local okS, skins = pcall(getSkinsForCard, key)
                    if okS and type(skins) == "table" then
                        for _, skin in ipairs(skins) do
                            if skin ~= "default" then
                                local okA, a = pcall(getCardAsset, { card = key, skin = skin })
                                local id = okA and type(a) == "string" and a:match("%d+")
                                if id and id ~= baseId and addId(info.name, id, false) then
                                    count += 1
                                    skinsTotal += 1
                                end
                            end
                        end
                    end
                    -- اسم بديل من المفتاح
                    local alt = prettify(tostring(key))
                    if clean(alt) ~= clean(info.name) then addId(alt, baseId, true) end
                end
            end
        end
        print(string.format("✅ القائمة الرسمية: %d بطاقة | %d سكن", cards, skinsTotal))
    end

    -- احتياط: الطريقة القديمة (لو دوال اللعبة ما اشتغلت)
    if count < 100 then
        warn("⚠️ ما قدرت أستخدم دوال اللعبة، برجع للطريقة القديمة")
