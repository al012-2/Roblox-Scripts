local function findCardImage(root, nonce)
    local best, bestArea = nil, 0
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("ImageLabel") and d.Visible and d.AbsoluteSize.X > 60 then
            local p, inOption = d.Parent, false
            while p and p ~= root do
                if isOptionNode(p, nonce) then inOption = true break end
                p = p.Parent
            end
            local area = d.AbsoluteSize.X * d.AbsoluteSize.Y
            if not inOption and area > bestArea then best, bestArea = d, area end
        end
    end
    return best
