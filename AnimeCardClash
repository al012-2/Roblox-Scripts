-- 6. اختيار الجواب
-- ==========================================
local function chooseOption(options, fp, budget, skinChance)
    skinChance = skinChance or 0
    -- أ) التعلم
    local lIdx, lDist = nil, math.huge
    for i, name in ipairs(options) do
        for _, lfp in ipairs(learned[clean(name)] or {}) do
            local d = distance(lfp, fp)
            if d < lDist then lIdx, lDist = i, d end
        end
    end
    if lIdx and lDist < CONFIG.SURE_DIST then return lIdx, lDist, "learned", true end

    -- ب) الصور الأصلية (بالتوازي): بصمة المربعات + تشابه البكسلات
    local best, bestCorr, hasData, tried = {}, {}, {}, {}
    local pending = 0
    local t = os.clock()

    local function pass(fromJ, toJ)
        for i, name in ipairs(options) do
            local ids = nameToIds[clean(name)]
            if not ids or #ids == 0 then
                noteMissing(name)
            else
                for j = fromJ, math.min(#ids, toJ) do
                    local id = ids[j]
                    if not tried[id] then
                        tried[id] = true
                        pending += 1
                        task.spawn(function()
                            local afp = getAssetFp(id)
                            if afp then
                                hasData[i] = true
                                local d = distance(afp, fp)
                                if d < (best[i] or math.huge) then best[i] = d end
                                local c = corr(getPixels(id), fp.px)
                                if c and c > (bestCorr[i] or -2) then bestCorr[i] = c end
                            end
                            pending -= 1
                        end)
                    end
                end
            end
        end
        while pending > 0 and os.clock() - t < budget do task.wait() end
    end

    local function evaluate()
        local aIdx, aDist = nil, math.huge
        local cIdx, c1, c2 = nil, -2, -2
        for i = 1, #options do
            if best[i] and best[i] < aDist then aIdx, aDist = i, best[i] end
            local c = bestCorr[i]
            if c then
                if c > c1 then c2 = c1 cIdx, c1 = i, c
                elseif c > c2 then c2 = c end
            end
        end
        local corrSure = cIdx ~= nil and c1 >= CONFIG.CORR_SURE and (c1 - c2) >= CONFIG.CORR_MARGIN
        return aIdx, aDist, cIdx, c1, c2, corrSure
    end

    -- اللعبة: لو random < skinChance والبطاقة لها سكنات → سكن، غير كذا → الأساسية
    if skinChance >= 0.99 then
        pass(2, CONFIG.MAX_SKINS_RETRY) -- غالباً سكن
        pass(1, 1)                      -- الأساسية (لو البطاقة ما لها سكنات)
    elseif skinChance > 0 then
        pass(1, CONFIG.MAX_SKINS)
    else
        pass(1, 1)
    end
    local aIdx, aDist, cIdx, c1, c2, corrSure = evaluate()

    -- مو متأكد؟ جرّب كل نسخ/سكنات الخيارات
    if not corrSure and aDist > CONFIG.SURE_DIST and os.clock() - t < budget then
        local before = aDist
        pass(2, CONFIG.MAX_SKINS_RETRY)
        aIdx, aDist, cIdx, c1, c2, corrSure = evaluate()
        if aDist < before - 5 then dprint(string.format("🎭 لقيته بنسخة ثانية (%.1f ← %.1f)", aDist, before)) end
    end

    if cIdx then
        dprint(string.format("📊 تشابه البكسلات: أول %.3f | ثاني %.3f", c1, c2))
    end

    -- ج) القرار
    if corrSure then
        return cIdx, (1 - c1) * 100, string.format("pixel %.0f%%", c1 * 100), true
    end
    if aIdx and aDist < CONFIG.SURE_DIST and (not cIdx or cIdx == aIdx) then
        return aIdx, aDist, "asset", true
    end

    -- د) استبعاد: كل اللي عندي بعيد، والصح غالباً خيار ما عندي صورته
    local nothingMatches = (cIdx ~= nil and c1 < 0.6 and lDist > CONFIG.SURE_DIST)
        or (aDist > CONFIG.ELIM_DIST and lDist > CONFIG.ELIM_DIST and c1 < 0.6)
    if nothingMatches then
        local unknown = {}
        for i, name in ipairs(options) do
            if not hasData[i] and not (learned[clean(name)] and #learned[clean(name)] > 0) then
                table.insert(unknown, i)
            end
        end
        if #unknown > 0 then
            dprint("🧩 استبعاد")
            return unknown[math.random(1, #unknown)], math.min(aDist, lDist), "elimination", false
        end
    end

    -- هـ) دمج الطريقتين: مسافة المربعات + (1 - التشابه)
    local bIdx, bScore = nil, math.huge
    for i = 1, #options do
        local g = best[i] or (i == lIdx and lDist) or 100
        local c = bestCorr[i] or 0
        local score = g + (1 - c) * 60
        if i == lIdx then score = math.min(score, lDist + 10) end
        if score < bScore then bIdx, bScore = i, score end
    end
    if bIdx and bScore < 200 then
        return bIdx, bScore / 2, "combined", false
    end
    if lIdx then return lIdx, lDist, "learned", false end
    return math.random(1, #options), math.huge, "guess", false
end

