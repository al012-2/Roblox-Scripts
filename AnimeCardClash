local W, H = 120, 160 -- حجم صورة اللعبة (يتحدث من الجولة)

-- buffer -> مصفوفة RGB
local function bufToArr(buf, w, h, bpp)
    local arr = table.create(w * h * 3)
    local n = 0
    for p = 0, w * h - 1 do
        local i = p * bpp
        arr[n + 1] = buffer.readu8(buf, i)
        arr[n + 2] = buffer.readu8(buf, i + 1)
        arr[n + 3] = buffer.readu8(buf, i + 2)
        n += 3
    end
    return arr
end

-- تصغير بالمتوسط (Area) من sw×sh إلى tw×th
local function downsample(buf, sw, sh, bpp, tw, th)
    local sum = table.create(tw * th * 3, 0)
    local cnt = table.create(tw * th, 0)
    for sy = 0, sh - 1 do
        local ty = math.floor(sy * th / sh)
        local rowT = ty * tw
        local rowS = sy * sw
        for sx = 0, sw - 1 do
            local t = rowT + math.floor(sx * tw / sw)
            local i = (rowS + sx) * bpp
            local k = t * 3
            sum[k + 1] += buffer.readu8(buf, i)
            sum[k + 2] += buffer.readu8(buf, i + 1)
            sum[k + 3] += buffer.readu8(buf, i + 2)
            cnt[t + 1] += 1
        end
        if sy % 64 == 63 then task.wait() end
    end
    for t = 0, tw * th - 1 do
        local c = cnt[t + 1]
        if c > 0 then
            local k = t * 3
            sum[k + 1] /= c
            sum[k + 2] /= c
            sum[k + 3] /= c
        end
    end
    return sum
end

-- تغبيش Box (أفقي ثم عمودي)
local function boxBlur(arr, w, h, r)
    if r <= 0 then return arr end
    local tmp = table.create(w * h * 3, 0)
    local out = table.create(w * h * 3, 0)
    for y = 0, h - 1 do
        for x = 0, w - 1 do
            local R, G, B, n = 0, 0, 0, 0
            for dx = -r, r do
                local xx = math.clamp(x + dx, 0, w - 1)
                local k = (y * w + xx) * 3
                R += arr[k + 1] G += arr[k + 2] B += arr[k + 3] n += 1
            end
            local k = (y * w + x) * 3
            tmp[k + 1], tmp[k + 2], tmp[k + 3] = R / n, G / n, B / n
        end
    end
    for y = 0, h - 1 do
        for x = 0, w - 1 do
            local R, G, B, n = 0, 0, 0, 0
            for dy = -r, r do
                local yy = math.clamp(y + dy, 0, h - 1)
                local k = (yy * w + x) * 3
                R += tmp[k + 1] G += tmp[k + 2] B += tmp[k + 3] n += 1
            end
            local k = (y * w + x) * 3
            out[k + 1], out[k + 2], out[k + 3] = R / n, G / n, B / n
        end
    end
    return out
end

-- متوسط كل مربع في شبكة gx×gy
local function grid(arr, w, h, gx, gy)
    local sum = table.create(gx * gy * 3, 0)
    local cnt = table.create(gx * gy, 0)
    for y = 0, h - 1 do
        local cy = math.floor(y * gy / h)
        for x = 0, w - 1 do
            local c = cy * gx + math.floor(x * gx / w)
            local k = (y * w + x) * 3
            local o = c * 3
            sum[o + 1] += arr[k + 1]
            sum[o + 2] += arr[k + 2]
            sum[o + 3] += arr[k + 3]
            cnt[c + 1] += 1
        end
    end
    for c = 0, gx * gy - 1 do
        local n = math.max(cnt[c + 1], 1)
        local o = c * 3
        sum[o + 1] /= n
        sum[o + 2] /= n
        sum[o + 3] /= n
    end
    return sum
end

local function makeFp(arr, w, h)
    return { c = grid(arr, w, h, 6, 8), f = grid(arr, w, h, 12, 16) }
end

-- مصفوفة بكسلات صغيرة للمقارنة الدقيقة
local PX, PY = CONFIG.PIXEL_SIZE[1], CONFIG.PIXEL_SIZE[2]

local function toHex(arr)
    local t = table.create(#arr)
    for i = 1, #arr do t[i] = string.format("%02x", math.clamp(math.floor(arr[i] + 0.5), 0, 255)) end
    return table.concat(t)
end

local function fromHex(hex)
    local n = #hex // 2
    local arr = table.create(n)
    for i = 1, n do arr[i] = tonumber(hex:sub(i * 2 - 1, i * 2), 16) end
    return arr
end

-- Pearson correlation لكل قناة لون، والمتوسط (1 = نفس الصورة)
local function corr(a, b)
    if not a or not b or #a ~= #b then return nil end
    local total = 0
    for ch = 1, 3 do
        local sa, sb, n = 0, 0, 0
        for i = ch, #a, 3 do sa += a[i] sb += b[i] n += 1 end
        local ma, mb = sa / n, sb / n
        local num, da, db = 0, 0, 0
        for i = ch, #a, 3 do
            local x, y = a[i] - ma, b[i] - mb
            num += x * y
            da += x * x
            db += y * y
        end
        if da < 1e-6 or db < 1e-6 then total += 0 else total += num / math.sqrt(da * db) end
    end
    return total / 3
end

local function rms(a, b)
    if not a or not b or #a ~= #b then return nil end
    local d = 0
    for i = 1, #a do
        local x = a[i] - b[i]
        d += x * x
    end
    return math.sqrt(d / #a)
end

-- البصمات القديمة (V13) مصفوفة أرقام = خشنة بس
local function normFp(fp)
    if type(fp) ~= "table" then return nil end
    if type(fp[1]) == "number" then return { c = fp } end
    return fp
end

local function distance(a, b)
    a, b = normFp(a), normFp(b)
    if not a or not b then return math.huge end
    local dc = rms(a.c, b.c)
    if not dc then return math.huge end
    local df = rms(a.f, b.f)
    if df then return (dc + df) / 2 end
    return dc
end

