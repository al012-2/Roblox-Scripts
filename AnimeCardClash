    for _, d in ipairs(holder:GetDescendants()) do
        if d:IsA("GuiObject") and d.Visible then
            local a = d.AbsoluteSize.X * d.AbsoluteSize.Y
            if a > bestA then target, bestA = d, a end
        end
    end
    return target
