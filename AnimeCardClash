-- 12. اللوب الرئيسي
-- ==========================================
local busy = false
task.spawn(function()
    while isAlive() and task.wait(0.1) do
        local feed = getFeed()
        local phase = feed and feed.phase
        currentLives = feed and tonumber(feed.lives)
        if feed and feed.runId then currentRunId = feed.runId end
        env.__GTC_AUTO = CONFIG.AUTO_SOLVE

        if feed then
            if phase == "round" and type(feed.round) == "table" and feed.round.nonce then
                if not busy and not answered[feed.round.nonce] then
                    busy = true
                    task.spawn(function()
                        local ok, err = pcall(handleRound, feed.round)
                        if not ok then warn("[GTC] خطأ: " .. tostring(err)) end
                        busy = false
                    end)
                end
            elseif phase == "feedback" then
                handleFeedback(feed)
            elseif phase == "results" then
                clearHints()
                handleResults(feed)
                if CONFIG.AUTO_REPLAY then
                    if not tryReplay() then tryOpenWindow() end
                end
            else
                clearHints()
            end
        end
        refreshUI(phase)
    end
end)

-- تحميل بصمات كل البطاقات بالخلفية
-- تحميل بصمات كل الصور (الأساسية أول، بعدين السكنات) بالخلفية
local prefetchGen = 0
local function startPrefetch()
    if not CONFIG.PREFETCH then return end
    prefetchGen += 1
    local gen = prefetchGen
    task.spawn(function()
        local todo, seen = {}, {}
        for _, ids in pairs(nameToIds) do
            local id = ids[1]
            if id and not assetFp[id] and not seen[id] then seen[id] = true table.insert(todo, id) end
        end
        local primaries = #todo
        for _, ids in pairs(nameToIds) do
            for j = 2, #ids do
                local id = ids[j]
                if not assetFp[id] and not seen[id] then seen[id] = true table.insert(todo, id) end
            end
        end
        if #todo == 0 then return end
        print(string.format("📥 تحميل %d صورة بالخلفية (%d أساسية + %d سكن)...", #todo, primaries, #todo - primaries))
        for i, id in ipairs(todo) do
            if not isAlive() or not editableWorks or gen ~= prefetchGen then return end
            while busy do task.wait(0.2) end -- لا يزاحم الجولة
            getAssetFp(id)
            if i % 100 == 0 then print("📥 " .. i .. "/" .. #todo) end
            if i == primaries then print("✅ خلصت الصور الأساسية، الحين السكنات") end
            task.wait(0.03)
        end
        saveAssetFp(true)
        print("✅ خلص تحميل كل البصمات")
    end)
end

