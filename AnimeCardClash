local function handleRound(round)
    local nonce = round.nonce
    if answered[nonce] then return end
    answered[nonce] = true

    local buf, w, h, options = round.pixels, round.width, round.height, round.options
    if typeof(buf) ~= "buffer" or type(options) ~= "table" or #options == 0 then
        warn("[GTC] بيانات الجولة ناقصة")
        return
    end
    local bpp = buffer.len(buf) / (w * h)
    if bpp ~= 3 and bpp ~= 4 then
        warn("[GTC] صيغة بكسلات غريبة: " .. bpp)
        return
    end
    if w ~= W or h ~= H then
        W, H = w, h
        dprint("📐 حجم الصورة تغيّر " .. w .. "x" .. h .. " — امسح " .. CONFIG.FILES.assetFp .. " إذا قلّت الدقة")
    end

    local t0 = os.clock()
    local budget = 4
    if type(round.deadline) == "number" then
        budget = math.clamp(round.deadline - workspace:GetServerTimeNow() - CONFIG.SAFETY_MARGIN - 0.5, 0.5, 6)
    end

    local arrR = bufToArr(buf, w, h, bpp)
    local fp = makeFp(arrR, w, h)
    fp.px = grid(arrR, w, h, PX, PY)
    local skinChance = tonumber(round.skinChance) or 0
    local idx, dist, method, sure = chooseOption(options, fp, budget, skinChance)
    vStage.Text = string.format("R%s • %.1fs • skin %d%%", tostring(round.round), tonumber(round.timer) or 0, math.floor(skinChance * 100))

    dprint(string.format("🔎 جولة %s | [%d] %s | %s | مسافة %.1f | %.2fs",
        tostring(round.round), idx - 1, options[idx], method, dist, os.clock() - t0))

    vPick.Text = options[idx]
    vPick.TextColor3 = sure and C.green or C.warn
    vMethod.Text = method .. ((dist < math.huge and not method:find("pixel")) and string.format(" (%.0f)", dist) or "")
    pending = { nonce = nonce, fp = fp, arr = arrR, w = w, h = h, picked = options[idx], sent = idx - 1 }
    pcall(showHints, nonce, options[idx], sure)

    if not CONFIG.AUTO_SOLVE then return end

    -- وقت ذكي + عشوائي
    local lo, hi = CONFIG.UNSURE_MIN, CONFIG.UNSURE_MAX
    if sure then lo, hi = CONFIG.SURE_MIN, CONFIG.SURE_MAX end
    local delay = lo + math.random() * (hi - lo)

    -- السيرفر يعلّم الجولة لو متوسط وقت أجوبتك أقل من minAvg
    if tonumber(round.round) == 1 or runStats.runId ~= currentRunId then
        runStats.sum, runStats.n, runStats.runId = 0, 0, currentRunId
    end
    local target = ANTI.minAvg * CONFIG.AVG_SAFETY
    local need = target * (runStats.n + 1) - runStats.sum
    if delay < need then
        dprint(string.format("🛡️ أطوّل الوقت عشان المتوسط (%.1f ← %.1f)", delay, need))
        delay = need
    end

    if type(round.deadline) == "number" then
        local left = round.deadline - workspace:GetServerTimeNow() - CONFIG.SAFETY_MARGIN
        delay = math.max(0, math.min(delay, (os.clock() - t0) + left))
    end
    dprint(string.format("⏱️ بجاوب بعد %.1f ثانية", delay))
    local spent = os.clock() - t0
    if delay > spent then task.wait(delay - spent) end
    -- الوقت اللي يحسبه السيرفر تقريباً = من بداية الجولة
    local elapsed = (tonumber(round.timer) or 10) - math.max(0, (round.deadline or 0) - workspace:GetServerTimeNow())
    runStats.sum += math.max(elapsed, os.clock() - t0)
    runStats.n += 1

    local feed = getFeed()
    if not CONFIG.AUTO_SOLVE or not feed or feed.phase ~= "round" or not feed.round or feed.round.nonce ~= nonce then
        dprint("⏭️ الجولة تغيّرت أو انطفى Auto Solve")
        return
    end

    if not isAlive() then return end
    local done = false
    if CONFIG.ANSWER_MODE == "click" then
        local root = getGtcRoot()
        local holder = root and root:FindFirstChild(nonce .. ":" .. options[idx], true)
        local b = holder and (holder:IsA("GuiButton") and holder or holder:FindFirstChildWhichIsA("GuiButton", true))
        if b then done = pressBtn(b) end
    end
    if not done then send({ kind = "answer", nonce = nonce, option = idx - 1 }) end
end

-- معايرة التغبيش: نقارن صورة الكشف الواضحة بعد تغبيشها مع صورة الجولة
local calibSamples = {}
local calibrating = false
local startPrefetchRef -- يتعبى بعدين

local function calibrate(clearArr, roundArr, w, h)
    if calibrating or not CONFIG.AUTO_CALIBRATE then return end
    calibrating = true
    local same = rms(clearArr, roundArr)
    if same and same < 3 then
        dprint("ℹ️ صورة الكشف نفس المغبشة، المعايرة مو ممكنة")
        CONFIG.AUTO_CALIBRATE = false
        calibrating = false
        return
    end
    local bestR, bestD = CONFIG.BLUR_RADIUS, math.huge
    for r = 0, 12 do
        local d = rms(boxBlur(clearArr, w, h, r), roundArr)
        if d and d < bestD then bestR, bestD = r, d end
        task.wait()
    end
    table.insert(calibSamples, bestR)
    dprint(string.format("🎯 معايرة: أفضل تغبيش %d (فرق %.1f)", bestR, bestD))
    if #calibSamples >= 3 then
        table.sort(calibSamples)
        local r = calibSamples[math.ceil(#calibSamples / 2)]
        CONFIG.AUTO_CALIBRATE = false
        if r ~= CONFIG.BLUR_RADIUS then
            print(string.format("♻️ درجة تغبيش اللعبة = %d (كانت %d)، بعيد حساب البصمات", r, CONFIG.BLUR_RADIUS))
            CONFIG.BLUR_RADIUS = r
            stats.blurRadius = r
            saveStats()
            assetFp = { __radius = r }
            pixelCache = {}
            failed = {}
            saveAssetFp(true)
            if startPrefetchRef then startPrefetchRef() end
        else
            stats.blurRadius = r
            saveStats()
            print("✅ درجة التغبيش مضبوطة: " .. r)
        end
    end
    calibrating = false
end

local function handleFeedback(feed)
    local fb = feed.feedback
    if type(fb) ~= "table" or not pending or lastFeedback == pending.nonce then return end
    lastFeedback = pending.nonce
    clearHints()

    session.rounds += 1
    stats.totalRounds += 1
    if fb.correct then
        session.correct += 1
        stats.totalCorrect += 1
    end

    if fb.name then
        learn(fb.name, pending.fp)

        -- اربط الاسم بالصورة الحقيقية
        local rid = type(feed.revealAsset) == "string" and feed.revealAsset:match("%d+")
        if rid then
            local key = clean(fb.name)
            if addId(fb.name, rid, true) or savedNames[key] ~= rid then
                if savedNames[key] ~= rid then
                    savedNames[key] = rid
                    saveJson(CONFIG.FILES.names, savedNames)
                    if missing[fb.name] then
                        missing[fb.name] = nil
                        saveJson(CONFIG.FILES.missing, missing)
                        dprint("🔗 ربطت " .. fb.name .. " بصورتها")
                    end
                end
            end
        end

        -- صورة الكشف الواضحة: تعبي البصمة لو الصورة ما تحمّلت، وتعاير التغبيش
        local img = feed.image
        if type(img) == "table" and typeof(img.pixels) == "buffer" and img.width and img.height then
            local iw, ih = img.width, img.height
            local ibpp = buffer.len(img.pixels) / (iw * ih)
            if (ibpp == 3 or ibpp == 4) and iw == pending.w and ih == pending.h then
                local clearArr = bufToArr(img.pixels, iw, ih, ibpp)
                local roundArr = pending.arr
                if rid and not assetFp[rid] then
                    local blurred = boxBlur(clearArr, iw, ih, CONFIG.BLUR_RADIUS)
                    local fp = makeFp(blurred, iw, ih)
                    fp.p = toHex(grid(blurred, iw, ih, PX, PY))
                    assetFp[rid] = fp
                    failed[rid] = nil
                    saveAssetFp()
                    dprint("🧷 حفظت بصمة " .. fb.name .. " من صورة الكشف")
                end
                if CONFIG.AUTO_CALIBRATE and roundArr then
                    task.spawn(calibrate, clearArr, roundArr, iw, ih)
                end
            end
        end

        if fb.correct then
            dprint("✅ صح: " .. fb.name)
        else
            warn(string.format("[GTC] ❌ غلط: اخترت %s (أرسلت %s) والصح %s (correctOption=%s)",
                tostring(pending.picked), tostring(pending.sent), tostring(fb.name), tostring(fb.correctOption)))
        end
    end
    saveStats()
    pending = nil
end

local function handleResults(feed)
    local r = feed.result
    if type(r) ~= "table" or not r.id or lastResult == r.id then return end
    lastResult = r.id

    local pts = tonumber(r.points) or 0
    session.runs += 1
    session.points += pts
    stats.totalRuns += 1
    stats.totalPoints += pts
    if pts > stats.bestRun then stats.bestRun = pts end
    saveStats()
    print(string.format("🏁 خلصت الجولة: %d نقطة | %s جولة | متوسط %.2fs", pts, tostring(r.rounds), tonumber(r.averageSeconds) or 0))

    if r.flagged then
        warn("🚩 السيرفر علّم الجولة (flagged)!")
        title.Text = "⚠ FLAGGED"
        title.TextColor3 = C.red
        mainStroke.Color = C.red
        if CONFIG.STOP_ON_FLAG then
            setAutoSolve(false)
            CONFIG.AUTO_REPLAY = false
            warn("⛔ وقفت Auto Solve و Auto Replay. زيد وقت الجواب قبل ما تكمل")
        end
    end
end

