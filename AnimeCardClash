end
local pixelCache = {} -- [id] = مصفوفة (مفكوكة من hex)
local failed = {}
local editableWorks = true
local failStreak = 0
local dirty = 0

local function saveAssetFp(force)
    dirty += 1
    if force or dirty >= 10 then
        dirty = 0
        saveJson(CONFIG.FILES.assetFp, assetFp)
    end
end

local function getPixels(id)
    local e = assetFp[id]
    if type(e) ~= "table" or not e.p then return nil end
    local arr = pixelCache[id]
    if not arr then arr = fromHex(e.p) pixelCache[id] = arr end
    return arr
end

local inflight = {}
local function getAssetFp(id)
    if assetFp[id] then return assetFp[id] end
    if failed[id] or not editableWorks then return nil end
    if inflight[id] then
        while inflight[id] do task.wait() end
        return assetFp[id]
    end
    inflight[id] = true
    local ok, result = pcall(function()
        local img
        pcall(function() img = AssetService:CreateEditableImageAsync(Content.fromUri("rbxassetid://" .. id)) end)
        if not img then img = AssetService:CreateEditableImageAsync("rbxassetid://" .. id) end
        local size = img.Size
        local buf = img:ReadPixelsBuffer(Vector2.zero, size)
        img:Destroy()
        local arr = downsample(buf, size.X, size.Y, 4, W, H)
        arr = boxBlur(arr, W, H, CONFIG.BLUR_RADIUS)
        local fp = makeFp(arr, W, H)
        fp.p = toHex(grid(arr, W, H, PX, PY))
        return fp
    end)
    inflight[id] = nil
    if ok and result then
        failStreak = 0
        assetFp[id] = result
        saveAssetFp()
        return result
    end
    failed[id] = true
    failStreak += 1
