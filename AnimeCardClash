local function safeRequire(mod, timeout)
    if not mod or not mod:IsA("ModuleScript") then return nil end
    local result, finished
    task.spawn(function()
        local ok, data = pcall(require, mod)
        if ok then result = data else warn("[GTC] require فشل: " .. mod:GetFullName() .. " | " .. tostring(data)) end
        finished = true
    end)
    local t = os.clock()
    while not finished and os.clock() - t < (timeout or 3) do task.wait() end
    return result
end

