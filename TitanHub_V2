-- cannot be read, the script falls back to its own drink time, so it never spams potions.
-- own scope: adds no top-level locals
do (function()
    local PotionsTab = Window:CreateTab("Potions", 4483362458)

    -- names taken from the game's own UI (RaidShopFrame > potions: cells & Halloween Candy Shop)
