-- small caches so heavy lookups do not run every frame
local PerfCache = { cd = {}, scanAt = 0, failCount = {}, startBusyUntil = 0 }

-- battle_start does not say which system asked for it, so only one system may wait for one at a time.
-- `hold` is an expiry, so a dead thread can never block the others for good.
function PerfCache.acquireStart(hold, shouldContinue)
    while os.clock() < PerfCache.startBusyUntil do
        if shouldContinue and not shouldContinue() then return false end
        task.wait(0.05)
    end
    PerfCache.startBusyUntil = os.clock() + hold
    return true
end
function PerfCache.releaseStart()
    PerfCache.startBusyUntil = 0
end

