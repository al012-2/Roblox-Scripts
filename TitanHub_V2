        runCallbacks(false)
        -- make sure nothing keeps running even if a callback did not cover it
        ActiveMode = nil
        ActiveWorldKey = nil
        FarmToken += 1
        autoTowerToken += 1
        autoClaimToken += 1
        fastBattleToken += 1
        DisableBattleAnimation = false
        pcall(restoreBattleGuis)
    end

