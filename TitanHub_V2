-- ==================== Farm logic ====================
local SkipUntil = {}

local function attemptBoss(boss, diff, alive, worldKey, useWalk)
    if useWalk == "teleport" then useWalk = false   -- explicit teleport (ignore the global Farm style)
    elseif not useWalk then useWalk = FarmWalk end
    local isRemote = (useWalk == "remote" or useWalk == "remote_world")
    local k = boss .. "|" .. diff
    if SkipUntil[k] and os.clock() < SkipUntil[k] then return false end
    if not recoverIfDead(worldKey, alive) then return false end
    if isBossOnCooldown(boss, diff) then return false end

    local function stillGoing() return alive() and isCharAlive() end

    -- FIX: the "Wait for battle end" option is now passed through (was hard-coded to true)
    local fired = hitAndRunBoss(boss, diff, stillGoing, WaitForBattle, useWalk)
    if not alive() then return false end

    if not fired then
        if not isCharAlive() then return false end
        -- locked / refused: wait 15s, 30s, 60s ... up to 10 min, so the ready bosses aren't kept waiting
        local fails = (PerfCache.failCount[k] or 0) + 1
        PerfCache.failCount[k] = fails
        SkipUntil[k] = os.clock() + math.min(15 * 2 ^ (fails - 1), 600)
        return false
    end
    PerfCache.failCount[k] = nil
    if not isCharAlive() then return false end

    if isRemote then
        -- When fighting from far away, the boss's BillboardGui may not be streamed in,
        -- so if hitAndRunBoss confirmed the battle started/finished, mark cooldown directly.
        SkipUntil[k] = os.clock() + math.max(LastBossCooldown - 5, 20)
        return true
    end

    task.wait(0.8)
    if isBossOnCooldown(boss, diff) then
        SkipUntil[k] = os.clock() + math.max(LastBossCooldown - 5, 20)
        return true
    end

    SkipUntil[k] = os.clock() + 45
    return false
end

local function diffsToRun()
    if not LadderMode then return {SelectedDifficulty} end
    local list = {}
    for _, d in ipairs(DiffList) do
        table.insert(list, d)
        if d == MaxDifficulty then break end
    end
    return list
end

local function worldHasWork(worldKey, bossFilter)
    for _, diff in ipairs(diffsToRun()) do
        for _, boss in ipairs(BossHierarchy[worldKey]) do
            if not bossFilter or bossFilter[boss] then
                local s = SkipUntil[boss .. "|" .. diff]
                if not s or os.clock() >= s then return true end
            end
        end
    end
    return false
end

local function farmWorldOnce(worldKey, alive, bossFilter, useWalk)
    local didAny = false
    for _, diff in ipairs(diffsToRun()) do
        for _, boss in ipairs(BossHierarchy[worldKey]) do
            if not alive() then return didAny end
            if not bossFilter or bossFilter[boss] then
                if attemptBoss(boss, diff, alive, worldKey, useWalk) then didAny = true end
            end
        end
    end
    return didAny
end

