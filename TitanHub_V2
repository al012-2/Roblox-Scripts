-- Shop entry lookup (npcHandlerClient): raidShopRequest:InvokeServer("get", shopId) returns
-- { entries = { {id, name, section, stock, maxStock, unlimited, locked, owned}, ... }, balances, restockIn }
-- The real buy key is entry.id, so we look it up by name instead of guessing "potions:<name>".
-- (kept on the Rayfield table: the main chunk is at Lua's 200-locals limit)
Rayfield.ShopCache = {}
function Rayfield.ShopEntry(remote, shopId, name)
    local c = Rayfield.ShopCache[shopId]
    if not c or os.clock() - c.at > 20 then
        local ok, res = pcall(function() return remote:InvokeServer("get", shopId) end)
        local left = ok and type(res) == "table" and tonumber(res.restockIn) or nil
        c = {
            at = os.clock(),
            entries = (ok and type(res) == "table" and type(res.entries) == "table") and res.entries or nil,
            restockAt = left and (os.time() + left) or nil,
            balances = ok and type(res) == "table" and res.balances or nil,
        }
        Rayfield.ShopCache[shopId] = c
    end
    if not c.entries then return nil end
    for _, e in ipairs(c.entries) do
        if type(e) == "table" and e.name == name then return e end
    end
    return false -- shop answered, but doesn't sell this
end
-- returns key or nil + reason; falls back to the old "<tab>:<name>" key when the shop data can't be read
function Rayfield.ShopKey(remote, shopId, name, fallback, keep)
    local e = Rayfield.ShopEntry(remote, shopId, name)
    if e == false then return nil, "not sold here" end
    if e then
        if e.locked and not e.owned then return nil, "locked" end
        if not e.unlimited and tonumber(e.stock) and tonumber(e.stock) <= 0 then return nil, "out of stock" end
        if keep and keep > 0 then
            local okReserve, reason = Rayfield.ShopReserveOk(shopId, e, keep)
            if not okReserve then return nil, reason end
        end
        Rayfield.ShopCache[shopId].at = 0 -- stock changes after a buy: re-read next time
        return e.id
    end
    -- shop data unreadable: with a reserve set, the balance can't be checked, so don't buy
    if keep and keep > 0 then return nil, "noreply" end
    return fallback
end

-- resets the buy counters when the server really restocked (restockIn jumped forward);
-- the fixed cycle is only the fallback for when the shop data can't be read
function Rayfield.ShopRoll(State, remote, shopId, cycle)
    if remote then Rayfield.ShopEntry(remote, shopId, "") end
    local c = Rayfield.ShopCache[shopId]
    local at = c and c.restockAt
    if at then
        if State.restockAt and at > State.restockAt + 60 then
            State.bought, State.nextTry, State.cycleStart = {}, {}, os.time()
        end
        State.restockAt = at
    elseif os.time() - State.cycleStart >= cycle then
        State.bought, State.nextTry, State.cycleStart = {}, {}, os.time()
    end
end

-- Reads a buy reply. Seen from the server:
--   { message = "Bought X!", shop = {...} }  /  { message = "You can't afford this yet!", shop = {...} }  /  nil (nothing happened)
-- Only a confirmed purchase returns "bought". The reply's shop data also refreshes the cache.
function Rayfield.ShopResult(shopId, res)
    if type(res) ~= "table" then
        if res == true then return "bought" end
        return res == nil and "noreply" or "refused"
    end
    local shop = res.shop
    if type(shop) == "table" then
        local c = Rayfield.ShopCache[shopId] or {}
        c.at = os.clock()
        local first = type(shop.entries) == "table" and shop.entries[1]
        if type(first) == "table" and first.name ~= nil then c.entries = shop.entries end
        if type(shop.balances) == "table" then c.balances = shop.balances end
        local left = tonumber(shop.restockIn)
        if left then c.restockAt = os.time() + left end
        Rayfield.ShopCache[shopId] = c
    end
    if res.success == false or res.ok == false or res.error ~= nil then return "refused" end
    local msg = type(res.message) == "string" and res.message or ""
    if msg:find("^Bought") or res.success == true or res.ok == true then return "bought" end
    return msg == "" and "noreply" or "refused"
end

-- when to try this item again: soon after no answer, later after a real refusal
function Rayfield.ShopRetry(why, long)
    return os.time() + (why == "noreply" and 5 or long)
end

-- true if buying `entry` leaves at least `keep` of every currency it costs.
-- A price or balance that can't be read counts as "don't buy".
function Rayfield.ShopReserveOk(shopId, entry, keep)
    local c = Rayfield.ShopCache[shopId]
    local balances = c and c.balances
    if type(entry.cost) ~= "table" or type(balances) ~= "table" then return false, "noreply" end
    for _, price in ipairs(entry.cost) do
        local have
        for _, b in ipairs(balances) do
            if type(b) == "table" and type(price) == "table" and b.name == price.name then have = tonumber(b.amount) end
        end
        local amount = type(price) == "table" and tonumber(price.amount)
        if not have or not amount then return false, "noreply" end
        if have - amount < keep then return false, "reserve" end
    end
    return true
end

