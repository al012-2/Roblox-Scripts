local function addPage(name)
    local info = GroupInfo[name] or {}
    local shown, icon, desc, order = info[1] or name, info[2] or "layers", info[3], info[4]
    local ok, tab = pcall(function()
        return LWindow:AddTab({ Name = shown, Icon = icon, Description = desc, Order = order })
    end)
    if not (ok and tab) then
        ok, tab = pcall(function() return LWindow:AddTab(shown, icon) end)
        if not (ok and tab) then tab = LWindow:AddTab(shown, "layers") end
    end
    pcall(function() GroupOf.__addHeaders(tab.Button and tab.Button.Parent) end)
    return tab
end

