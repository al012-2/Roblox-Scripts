    -- ===== Secret areas (workspace.HalloweenEvent["07_Secret_Areas"], e.g. SecretStoneRoom = Faceless Prophet) =====
    local function secretAreas()
        local hw = workspace:FindFirstChild("HalloweenEvent")
        local f = hw and hw:FindFirstChild("07_Secret_Areas")
        local list = {}
        if f then
            for _, c in ipairs(f:GetChildren()) do
                if c:IsA("Model") or c:IsA("BasePart") or c:IsA("Folder") then table.insert(list, c) end
            end
            table.sort(list, function(a, b) return a.Name < b.Name end)
        end
        return list
    end

    local function centerOf(area)
        -- prefer a floor-ish part, else the bounding box center
        local ok, cf = pcall(function()
            if area:IsA("BasePart") then return area.CFrame end
            if area:IsA("Model") then return area:GetBoundingBox() end
            local best
            for _, d in ipairs(area:GetDescendants()) do
                if d:IsA("BasePart") and (not best or d.Size.Magnitude > best.Size.Magnitude) then best = d end
            end
            return best and best.CFrame
        end)
        return ok and cf or nil
    end

