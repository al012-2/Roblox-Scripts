        "Battle Potion I", "Battle Potion II", "Battle Potion III", "Battle Potion IV",
        "Boss Potion", "Raid Potion",
        "Pumpkin Luck Potion", "Witch's Brew", "Pumpkin Battle Potion",
    }

    -- Halloween Candy Shop potions last 30 minutes (1800s) each
    local CustomDuration = {
        ["Pumpkin Luck Potion"] = 1800,
        ["Witch's Brew"] = 1800,
        ["Pumpkin Battle Potion"] = 1800,
    }

    local SelectedPotions = {}
