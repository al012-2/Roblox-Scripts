local AutoJump = true
do
    local jumpToken = 0
    table.insert(activeConnections, { Disconnect = function() jumpToken += 1 end })
    local myToken = jumpToken

    task.spawn(function()
        local lastPos, lastMove, lastJump = nil, os.clock(), 0
        while jumpToken == myToken do
