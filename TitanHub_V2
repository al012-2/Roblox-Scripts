        if not ok then warn("[Server tab] " .. tostring(err)) end
    end
    local menu = settings:AddLeftGroupbox("Menu")
    menu:AddButton({
        Text = "Unload",
        Func = function() Library:Unload() end,
    })
    -- UI scale (makes everything bigger / smaller)
    menu:AddDropdown("UiScale", {
        Values = { "50%", "75%", "100%", "125%", "150%", "175%", "200%" },
        Default = "100%",
        Text = "UI scale",
        Callback = function(v)
            local n = tonumber((tostring(v):gsub("%%", "")))
            if n and Library.SetDPIScale then pcall(function() Library:SetDPIScale(n) end) end
        end,
    })
    menu:AddDropdown("NotificationSide", {
        Values = { "Left", "Right" },
        Default = "Right",
        Text = "Notification Side",
        Callback = function(v)
            if Library.SetNotifySide then pcall(function() Library:SetNotifySide(v) end) end
        end,
    })
    if LWindow and LWindow.SetCornerRadius then
        menu:AddSlider("UICornerSlider", {
            Text = "Corner Radius",
            Default = Library.CornerRadius or 6,
            Min = 0,
            Max = 20,
            Rounding = 0,
            Callback = function(v)
                pcall(function() LWindow:SetCornerRadius(v) end)
            end,
        })
    end
    -- Window transparency: fades every Frame background of the menu (text stays solid)
    -- + AA text outline. Frames made later (dropdowns, pages) get it too.
    local origT = setmetatable({}, { __mode = "k" })
    local curT, outlineOn = 0.35, true
    local function styleOne(d, skip)
        if skip and d:IsDescendantOf(skip) then return end
        if d:IsA("Frame") or d:IsA("ScrollingFrame") then
            if origT[d] == nil then origT[d] = d.BackgroundTransparency end
            local o = origT[d]
            if o < 1 then d.BackgroundTransparency = o + (1 - o) * curT end
        elseif d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
            d.TextStrokeColor3 = Rayfield.AA.Line
            d.TextStrokeTransparency = outlineOn and 0.35 or 1
        end
    end
    local function applyTransparency(t)
        curT = t or curT
        local root = Library.ScreenGui
        if not root then return end
        local skip = Library.NotificationArea
        for _, d in ipairs(root:GetDescendants()) do styleOne(d, skip) end
    end
    pcall(function()
        Library:GiveSignal(Library.ScreenGui.DescendantAdded:Connect(function(d)
            task.defer(function() pcall(styleOne, d, Library.NotificationArea) end)
        end))
    end)
    menu:AddToggle("AAOutline", {
        Text = "AA text outline",
        Default = true,
        Callback = function(v) outlineOn = v; pcall(applyTransparency) end,
    })
    menu:AddSlider("UiTransparency2", {
        Text = "Transparency",
        Default = 35,
        Min = 0,
        Max = 85,
        Rounding = 0,
        Suffix = "%",
        Callback = function(v)
            pcall(applyTransparency, (tonumber(v) or 0) / 100)
        end,
    })
    -- pages build some frames lazily: apply the saved transparency again once everything exists
    task.delay(3, function()
        local o = LOptions.UiTransparency2
        if o then pcall(applyTransparency, (tonumber(o.Value) or 0) / 100) end
    end)

    menu:AddLabel("Menu bind"):AddKeyPicker("MenuKeybind", { Default = "RightShift", NoUI = true, Text = "Menu keybind" })
    Library.ToggleKeybind = LOptions.MenuKeybind

    ThemeManager:SetLibrary(Library)
    pcall(function()
        ThemeManager:SetDefaultTheme({
            BackgroundColor = Rayfield.AA.Back,
            MainColor = Rayfield.AA.Main,
            AccentColor = Rayfield.AA.Gold,
            OutlineColor = Rayfield.AA.Line,
            FontColor = Rayfield.AA.Text,
            FontFace = "FredokaOne",
        })
    end)
    SaveManager:SetLibrary(Library)
    SaveManager:IgnoreThemeSettings()
    SaveManager:SetIgnoreIndexes(ignoreIdx)
    ThemeManager:SetFolder("TitanRNG_Smart")
    SaveManager:SetFolder("TitanRNG_Smart")
    SaveManager:BuildConfigSection(settings)
    ThemeManager:ApplyToTab(settings)

    -- ===== Auto Save =====
    local auto = settings:AddRightGroupbox("Auto Save")
    auto:AddToggle("AutoSaveCfg", { Text = "Auto save config (when something changes)", Default = true })
    auto:AddLabel("Saves farm / roll / pity state, so it resumes after a server change.", true)
    auto:AddToggle("SpendArmed", {
        Text = "Allow auto-spending this session",
        Default = false,
        Callback = function(v) Rayfield.SpendArmed = v end,
    })
    auto:AddLabel("Off after every load: auto-buy, packs, crafting, fuser, upgrades and awakening wait for this. Buttons and potions are not affected.", true)

    local myTok = (getgenv().TitanSaveTok or 0) + 1
    getgenv().TitanSaveTok = myTok

    local function currentCfgName()
        local n
        pcall(function()
            local p = "TitanRNG_Smart/settings/autoload.txt"
            if isfile(p) then n = readfile(p) end
        end)
        if type(n) ~= "string" then return nil end
        n = n:gsub("^%s+", ""):gsub("%s+$", "")
        return n ~= "" and n or nil
    end

    -- cheap fingerprint of every toggle / option, so the file is written only when something changed
    local function signature()
        local parts = {}
        for k, t in pairs(LToggles) do parts[#parts + 1] = k .. "=" .. tostring(t.Value) end
        for k, o in pairs(LOptions) do
            local v = o.Value
            if type(v) == "table" then
                local ks = {}
                for kk, vv in pairs(v) do ks[#ks + 1] = tostring(kk) .. ":" .. tostring(vv) end
                table.sort(ks)
                v = table.concat(ks, ",")
            end
            parts[#parts + 1] = k .. "=" .. tostring(v)
        end
        table.sort(parts)
        return table.concat(parts, "|")
    end

    task.spawn(function()
        task.wait(8) -- let the autoload finish first, so defaults never overwrite the saved config
        local lastSig
        while getgenv().TitanSaveTok == myTok do
            local t = LToggles.AutoSaveCfg
            if t and t.Value and not Rayfield.Loading then
                local ok, sig = pcall(signature)
                if ok and sig ~= lastSig then
                    local name = currentCfgName()
                    local fresh = not name
                    name = name or "AutoSave"
                    pcall(function() SaveManager:Save(name) end)
                    if fresh then pcall(function() SaveManager:SaveAutoloadConfig(name) end) end
                    lastSig = sig
                end
            end
            task.wait(5)
        end
    end)

    -- ===== Load the autoload config =====
    Rayfield.Loading = true
    pcall(function() SaveManager:LoadAutoloadConfig() end)
    task.delay(2.5, function() Rayfield.Loading = false end)
end

