local function getCharWithTimeout(timeout)
    local char = player.Character
    if char then return char end
    local t = os.clock()
    repeat
        task.wait(0.2)
        char = player.Character
    until char or os.clock() - t > (timeout or 10)
    return char
end

local function isCharAlive()
    local char = player.Character
