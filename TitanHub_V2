-- ==================== Crafting (auto craft potions) ====================
-- craftItem is a RemoteEvent, captured with Cobalt:
--   FireServer("craft", "<Potion Name>", amount)
-- Stock is read from the game's Inventory UI (confirmed with the F9 dump):
--   PlayerGui.Inventory.InventoryFrame.itemsFrame.CollectionFrame.itemScroll.<Potion Name>.quantityLabel  ("43x")
-- A potion is crafted only when its stock is below "Keep at least". If the stock cannot be read,
-- that potion is SKIPPED (never crafted blindly), so materials are not wasted.
-- own scope: adds no top-level locals
do (function()
    local CraftTab = Window:CreateTab("Crafting", 4483362458)

    local craftRemote
    task.spawn(function()
        craftRemote = Rep:WaitForChild("craftItem", 180)
        if not craftRemote then
            warn("[Titan Hub] missing remote: craftItem")
            pcall(function() Rayfield:Notify({ Title = "Missing remote", Content = "craftItem", Duration = 6 }) end)
        end
    end)

    -- Skill Tree Reset and Weather Reroll are not potions to craft, so they are not listed
    local CraftNames = {
        "Luck Potion I", "Luck Potion II", "Luck Potion III", "Luck Potion IV",
        "Speed Potion I", "Speed Potion II", "Speed Potion III", "Speed Potion IV",
        "Battle Potion I", "Battle Potion II", "Battle Potion III", "Battle Potion IV",
        "Boss Potion", "Raid Potion",
    }
    local Selected = {}
    local Amount = 1          -- max amount per craft request
    local MinStock = 50       -- keep at least this many of each selected potion
    local IntervalMin = 10    -- how often the auto mode checks the stock
    local craftToken = 0

    -- survives re-execute / server hop in the same executor session (best effort)
    getgenv().TitanCraftLast = getgenv().TitanCraftLast or {}
    local lastCraft = getgenv().TitanCraftLast

    table.insert(activeConnections, { Disconnect = function() craftToken += 1 end })

    -- how many of this potion you own, or nil if the Inventory UI cannot be read right now
    local function getStock(name)
        local node = player:FindFirstChild("PlayerGui")
        for _, nm in ipairs({ "Inventory", "InventoryFrame", "itemsFrame", "CollectionFrame", "itemScroll" }) do
            node = node and node:FindFirstChild(nm)
        end
        if not node then return nil end

        -- only trust a populated list (an empty list means the UI has not been built yet)
        local populated = false
        for _, c in ipairs(node:GetChildren()) do
            if c:IsA("Frame") then populated = true break end
        end
        if not populated then return nil end

        local cell = node:FindFirstChild(name)
        if not cell then return 0 end   -- the inventory lists only items you own

        local lbl = cell:FindFirstChild("quantityLabel", true)
        if not (lbl and lbl:IsA("TextLabel")) then return nil end
        local txt = tostring(lbl.Text):gsub("<[^>]+>", "")
        txt = txt:gsub(",", "")
        local n = txt:match("(%d+)")
        return n and tonumber(n) or nil
    end

    local function craftOne(name, amt)
        if not craftRemote then return false end
        local ok = pcall(function() craftRemote:FireServer("craft", name, amt) end)
        if ok then
            lastCraft[name] = os.time()
            if PerfCache.onCraft then PerfCache.onCraft(amt) end -- Live Tracker
        end
        return ok
    end

    local function hasSelection() return next(Selected) ~= nil end

    -- crafts every selected potion that is below MinStock. Returns (requests sent, potions skipped as unreadable)
    local function craftDue()
        local sent, unreadable = 0, 0
        for _, name in ipairs(CraftNames) do
            if Selected[name] then
                local stock = getStock(name)
                if stock == nil then
                    unreadable += 1
                elseif stock < MinStock then
                    local last = lastCraft[name]
                    -- never hit the same potion twice within 15 seconds
                    if not last or os.time() - last >= 15 then
                        -- never craft more than what is missing to reach MinStock
                        local amt = math.min(Amount, MinStock - stock)
                        if craftOne(name, amt) then sent += 1 end
                        task.wait(0.6)
                    end
                end
            end
        end
        return sent, unreadable
    end

    CraftTab:CreateSection("Potions to craft")

    CraftTab:CreateDropdown({
        Name = "Craft these potions",
        Options = CraftNames,
        CurrentOption = {},
        MultipleOptions = true,
        Flag = "CraftPotionsPick",
        Callback = function(list)
            Selected = {}
            for _, n in ipairs(list) do Selected[n] = true end
        end,
    })

    CraftTab:CreateInput({
        Name = "Keep at least (stock)",
        Default = "50",
        Placeholder = "e.g. 50",
        Flag = "CraftMinStock",
        Callback = function(v)
            MinStock = math.clamp(math.floor(tonumber(v) or 50), 1, 100000)
        end,
    })

    CraftTab:CreateInput({
        Name = "Max amount per craft request",
        Default = "1",
        Placeholder = "e.g. 1",
        Flag = "CraftAmount",
        Callback = function(v)
            Amount = math.clamp(math.floor(tonumber(v) or 1), 1, 50)
        end,
    })

    CraftTab:CreateSection("Craft")

    CraftTab:CreateButton({
        Name = "Craft selected now (only below stock)",
        Callback = function()
            if not hasSelection() then
                Rayfield:Notify({ Title = "Crafting", Content = "Pick at least one potion first", Duration = 3 })
                return
            end
            if not craftRemote then
                Rayfield:Notify({ Title = "Crafting", Content = "craftItem remote not ready", Duration = 3 })
                return
            end
            task.spawn(function()
                local sent, unreadable = craftDue()
                local msg = "Sent " .. sent .. " craft request(s)"
                if unreadable > 0 then
                    msg = msg .. " | could not read the stock of " .. unreadable .. " (skipped)"
                end
                Rayfield:Notify({ Title = "Crafting", Content = msg, Duration = 5 })
            end)
        end,
    })

    CraftTab:CreateInput({
        Name = "Check stock every (minutes)",
        Default = "10",
        Placeholder = "e.g. 10",
        Flag = "CraftIntervalMin",
        Callback = function(v)
            IntervalMin = math.clamp(math.floor(tonumber(v) or 10), 1, 1440)
        end,
    })

    CraftTab:CreateToggle({
        Name = "Auto craft selected potions",
        CurrentValue = false,
        Flag = "AutoCraftPotions",
        Callback = function(Value)
            craftToken += 1
            local myToken = craftToken
            if not Value then return end
            task.spawn(function()
                while craftToken == myToken and Rayfield.Loading do task.wait(0.3) end
                local warnedUnread = false
                while craftToken == myToken do
                    if hasSelection() and craftRemote and Rayfield.SpendArmed then
                        local sent, unreadable = craftDue()
                        if sent > 0 then
                            Rayfield:Notify({ Title = "Crafting", Content = "Sent " .. sent .. " craft request(s)", Duration = 4 })
                        end
                        if unreadable > 0 and not warnedUnread then
                            warnedUnread = true
                            Rayfield:Notify({
                                Title = "Crafting",
                                Content = "Could not read the stock of " .. unreadable .. " potion(s) - skipped (open the Inventory once)",
                                Duration = 6,
                            })
                        elseif unreadable == 0 then
                            warnedUnread = false
                        end
                    end
                    -- wait in 1s steps so turning the toggle off reacts immediately
                    local waited = 0
                    while craftToken == myToken and waited < IntervalMin * 60 do
                        task.wait(1)
                        waited += 1
                    end
                end
            end)
        end,
    })

    CraftTab:CreateSection("Debug")

    CraftTab:CreateButton({
        Name = "Print potion stock (F9)",
        Callback = function()
            print("[Crafting] stock read from the Inventory UI (nil = cannot read):")
            for _, name in ipairs(CraftNames) do
                print(("  %-18s %s"):format(name, tostring(getStock(name))))
            end
            Rayfield:Notify({ Title = "Crafting", Content = "Stock printed in the F9 console", Duration = 4 })
        end,
    })

    CraftTab:CreateParagraph({
        Title = "Spends materials",
        Content = "Only potions below 'Keep at least' are crafted, and never more than what is missing. The server refuses a craft you cannot afford.",
    })
end)() end

-- ==================== Offline rolls: auto collect ====================
do (function()
    local token = 0
    table.insert(activeConnections, { Disconnect = function() token += 1 end })

    local function visible(o)
        local n = o
        while n and n ~= game do
            if n:IsA("GuiObject") and not n.Visible then return false end
            if n:IsA("ScreenGui") and not n.Enabled then return false end
            n = n.Parent
        end
        return true
    end

    -- the WELCOME BACK window only shows after joining, so the watcher gives up after 90s
    local function start()
        token += 1
        local my = token
        task.spawn(function()
            local t0, tries = os.clock(), 0
            while token == my and os.clock() - t0 < 90 and tries < 3 do
                local ok, btn = pcall(function() return player.PlayerGui.OfflineUI.panel.collect end)
                if ok and btn and btn:IsA("GuiButton") and visible(btn) then
                    task.wait(1)
                    tries += 1
                    pressButton(btn)
                    task.wait(2)
                    if not visible(btn) then
                        Rayfield:Notify({ Title = "Offline rolls", Content = "Collected", Duration = 3 })
                        return
                    end
                end
                task.wait(1)
            end
        end)
    end

    RollTab:CreateSection("Offline rolls")
    RollTab:CreateToggle({
        Name = "Auto collect offline rolls (WELCOME BACK window)",
        CurrentValue = true,
        Flag = "AutoCollectOffline",
        Callback = function(Value)
            if Value then start() else token += 1 end
        end,
    })
    start()
end)() end

-- ==================== Endless Raid ====================
-- endlessAction is a RemoteEvent, captured with Cobalt:
--   FireServer("start")
-- A start counts as accepted only if a battle starts within 5 seconds (battleEvent "battle_start").
-- Auto mode starts again after a battle ends (never sooner than "Wait at least"), and backs off when starts fail.
-- own scope: adds no top-level locals
do (function()
    local EndlessTab = Window:CreateTab("Endless Raid", 4483362458)

    local endlessRemote
    task.spawn(function()
        endlessRemote = Rep:WaitForChild("endlessAction", 180)
        if not endlessRemote then
            warn("[Titan Hub] missing remote: endlessAction")
            pcall(function() Rayfield:Notify({ Title = "Missing remote", Content = "endlessAction", Duration = 6 }) end)
        end
    end)

    local GoToNpc = false   -- teleport next to the Kaiju Researcher before each start
    local MinGap = 20       -- seconds between two starts, at least
    local MaxWait = 600     -- restart anyway if no battle end was seen for this long
    local endlessToken = 0

    table.insert(activeConnections, { Disconnect = function() endlessToken += 1 end })

    -- workspace.KaijuRaid.endless["Kaiju Researcher"] (confirmed in the dump)
    local function npcPart()
        local kr = workspace:FindFirstChild("KaijuRaid")
        local f = kr and kr:FindFirstChild("endless")
        local npc = f and f:FindFirstChild("Kaiju Researcher")
        if not npc then return nil end
        return npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChildWhichIsA("BasePart", true)
    end

    local function goToNpc()
        if not isCharAlive() then return false end
        local part = npcPart()
        if not part or not nearWorldBosses("raid") then
            forceTeleportToWorld("raid")
            part = npcPart()
        end
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if part and root then
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = part.CFrame * CFrame.new(0, 0, 4) + Vector3.new(0, 2, 0)
            task.wait(0.6)
            return true
        end
        return false
    end

    -- true if a battle started within 5 seconds after the request
    local function startEndless()
        if not endlessRemote then return false, "endlessAction remote not ready" end
        if GoToNpc and not goToNpc() then return false, "Kaiju Researcher not found" end
        local started, why = PerfCache.sendAndWaitBattle(function() endlessRemote:FireServer("start") end, 5)
        if started then return true end
        return false, why or "no battle started (already running, or the server refused)"
    end

    EndlessTab:CreateSection("Endless Raid")

    EndlessTab:CreateButton({
        Name = "Start Endless now",
        Callback = function()
            task.spawn(function()
                local ok, why = startEndless()
                Rayfield:Notify({
                    Title = "Endless",
                    Content = ok and "Endless started" or ("Not started: " .. tostring(why)),
                    Duration = 5,
                })
            end)
        end,
    })

    EndlessTab:CreateToggle({
        Name = "Go to Kaiju Researcher before starting",
        CurrentValue = false,
        Flag = "EndlessGoToNpc",
        Callback = function(v) GoToNpc = v end,
    })

    EndlessTab:CreateInput({
        Name = "Wait at least (seconds) between starts",
        Default = "20",
        Placeholder = "e.g. 20",
        Flag = "EndlessMinGap",
        Callback = function(v)
            MinGap = math.clamp(math.floor(tonumber(v) or 20), 5, 3600)
        end,
    })

    EndlessTab:CreateToggle({
        Name = "Auto Endless (start again when it ends)",
        CurrentValue = false,
        Flag = "AutoEndless",
        Callback = function(Value)
            endlessToken += 1
            local my = endlessToken
            if not Value then return end
            task.spawn(function()
                while endlessToken == my and Rayfield.Loading do task.wait(0.3) end
                local fails = 0
                while endlessToken == my do
                    local endsBefore, fightEndsBefore = BattleEnds, PerfCache.fightEnds
                    local ok, why = startEndless()
                    local t = os.clock()
                    if ok then
                        fails = 0
                        -- wait for a battle end (or MaxWait), never sooner than MinGap
                        while endlessToken == my and os.clock() - t < MaxWait do
                            -- with a tower running, battle_ended also fires for its floors: only the fight tab counts then
                            local ended = PerfCache.fightEnds ~= fightEndsBefore
                                or (BattleEnds ~= endsBefore and not PerfCache.towerInTabs)
                            if ended and os.clock() - t >= MinGap then break end
                            task.wait(0.5)
                        end
                    else
                        fails += 1
                        if fails == 3 then
                            Rayfield:Notify({
                                Title = "Endless",
                                Content = "Did not start 3 times: " .. tostring(why) .. ". Try 'Go to Kaiju Researcher before starting'.",
                                Duration = 7,
                            })
                        end
                        -- back off: MinGap, 2x, 3x ... up to 6x
                        local waitFor = MinGap * math.min(fails, 6)
                        while endlessToken == my and os.clock() - t < waitFor do task.wait(0.5) end
                    end
                end
            end)
        end,
    })

    EndlessTab:CreateParagraph({
        Title = "How it works",
        Content = "Sends the same 'start' the game sends. A start counts only if a battle begins within 5s. Auto mode starts again after a battle ends.",
    })
end)() end

