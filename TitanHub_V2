    if not AutoReconnectEnabled or rejoining then return end
    local msg = tostring(GuiService:GetErrorMessage() or ""):lower()
    if msg == "" then return end

    -- rejoin only for real disconnect / kick messages (not asset or image load errors)
    local isDisconnect = false
    for _, kw in ipairs({ "disconnect", "kick", "unexpected", "lost connection", "shutdown" }) do
        if msg:find(kw, 1, true) then isDisconnect = true break end
    end
    if not isDisconnect then return end

    rejoining = true
    rejoinAttempt = 0
    pcall(function()
        Rayfield:Notify({ Title = "Rejoin", Content = "Disconnected: " .. msg:sub(1, 150) .. " - trying to rejoin", Duration = 5 })
    end)
    task.spawn(function()
        -- capped retries with a growing delay (no endless teleport spam)
        local tries = 0
        while AutoReconnectEnabled and rejoining and tries < 10 do
