-- World 6 (Hueco Mundo): bosses are read from workspace.bossNpcs["6"] (attribute bossId, or the model name).
-- No waiting at startup: the folder usually streams in only after you enter the world,
-- so scanWorld6() runs once now and again every time we arrive in world 6.
local function scanWorld6()
    local bn = workspace:FindFirstChild("bossNpcs")
    local f6 = bn and bn:FindFirstChild("6")
    if not f6 then return false end
    local ids, seen = {}, {}
    for _, m in ipairs(f6:GetChildren()) do
        if m:IsA("Model") and not m:GetAttribute("AreaOrder") then
            local id = m:GetAttribute("bossId")
            if type(id) ~= "string" or id == "" then
                id = m.Name:lower():gsub("%s+", "_")
            end
            if id ~= "" and not seen[id] then
                seen[id] = true
                table.insert(ids, id)
                if m.Name ~= "" and not BossDisplayName[id] then BossDisplayName[id] = m.Name end
            end
        end
    end
    if #ids == 0 then return false end
    BossHierarchy["6"] = ids
    return true
end
