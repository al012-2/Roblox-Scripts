local function returnToLobby()
    local char = getCharWithTimeout(5)
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if teleportAreaRemote then
        pcall(function() teleportAreaRemote:FireServer("Lobby") end)
    end

    local lobby = workspace:FindFirstChild("Lobby")
    if lobby then
        local lobbySpawn = lobby:FindFirstChildWhichIsA("SpawnLocation", true) or lobby:FindFirstChild("portals")
        if lobbySpawn then
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = lobbySpawn.CFrame + Vector3.new(0, 4, 0)
            task.wait(0.5)
        end
    end
end

local lastTpWorld, lastTpChar = nil, nil

local function nearWorldBosses(worldKey)
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    if worldKey == "halloween" then
        local hw = workspace:FindFirstChild("HalloweenEvent")
        if hw then
            local evNpcs = hw:FindFirstChild("EventNPCs")
            local bosses = evNpcs and evNpcs:FindFirstChild("Bosses")
            if bosses then
                for _, m in ipairs(bosses:GetChildren()) do
                    if m:IsA("Model") then
                        local ok, pos = pcall(function() return m:GetPivot().Position end)
                        if ok and (pos - root.Position).Magnitude < 900 then return true end
                    end
                end
            end
            local p = hw:FindFirstChildWhichIsA("BasePart", true)
            if p and (p.Position - root.Position).Magnitude < 900 then return true end
        end
        return false
    end

    if worldKey == "raid" then
        local raidFolder = workspace:FindFirstChild("KaijuRaid")
        if not raidFolder then return false end
        -- "am I inside the raid map": distance to the raid portal spawn (no map scan, works even with no bosses alive)
        local sp = raidFolder:FindFirstChild("portal")
        sp = sp and sp:FindFirstChild("spawnLoc")
        if sp and sp:IsA("BasePart") then
            return (sp.Position - root.Position).Magnitude < 600
        end
        return false
    end
    local folder = workspace:FindFirstChild("bossNpcs")
    folder = folder and folder:FindFirstChild(tostring(worldKey))
    if not folder then return true end
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") then
            local ok, pos = pcall(function() return m:GetPivot().Position end)
            if ok and (pos - root.Position).Magnitude < 500 then return true end
        end
    end
    return false
end

-- press a button the way a click would (runs the game's own handler)
local function fireButton(btn)
    if getconnections then
        for _, sig in ipairs({ btn.Activated, btn.MouseButton1Click, btn.MouseButton1Down }) do
            local ok, conns = pcall(getconnections, sig)
            if ok and conns and #conns > 0 then
                for _, c in ipairs(conns) do pcall(function() c:Fire() end) end
                return true
            end
        end
    end
    if firesignal then
        pcall(function() firesignal(btn.MouseButton1Click) end)
        pcall(function() firesignal(btn.Activated) end)
        return true
    end
    return false
end

-- single implementation: pressButton just adds the nil check
local function pressButton(btn)
    if not btn then return false end
    return fireButton(btn)
end

-- find the world's button inside the game's Teleport menu and press it (FALLBACK only)
local function pressTeleportMenuButton(keyword, tabName)
    local pgui = player:FindFirstChild("PlayerGui")
    local ok, frame = pcall(function() return pgui.Inventory.InventoryFrame.teleportFrame end)
    if not (ok and frame) then return false end

    if tabName then
        local tabFrame = frame:FindFirstChild("tabFrame")
        local tab = tabFrame and tabFrame:FindFirstChild(tabName)
        if tab and tab:IsA("GuiButton") then
            fireButton(tab)
            task.wait(0.6)
        end
    end

    local collection = frame:FindFirstChild("CollectionFrame")
    local scope = (tabName == "raidsTab" and collection and collection:FindFirstChild("raidScrollFrame")) or frame

    for _, d in ipairs(scope:GetDescendants()) do
        if d.Name == "tpFrame" then
            local nameLabel = d:FindFirstChild("nameLabel")
            if nameLabel and nameLabel:IsA("TextLabel") and norm(nameLabel.Text):find(keyword, 1, true) then
                local btn = d:FindFirstChild("teleportButton", true)
                if btn and btn:IsA("GuiButton") and fireButton(btn) then return true end
            end
        end
    end
    return false
end

