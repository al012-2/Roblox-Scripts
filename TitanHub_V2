-- ==================== Auto Roll state helpers (used by Pity Roll) ====================
-- reads the dot inside PlayerGui.Main.Bottom.rollButtons.AutoRollFrame (grey = off, green = on)
do
    local indicator

    local function getFrame()
        local ok, f = pcall(function()
            return player.PlayerGui.Main.Bottom.rollButtons.AutoRollFrame
        end)
        return ok and f or nil
    end

    local NameHints = { "dot", "indicator", "circle", "status", "light", "state", "ball", "toggle" }

    local function colorOf(o)
        if o:IsA("ImageLabel") or o:IsA("ImageButton") then return o.ImageColor3 end
        return o.BackgroundColor3
    end

    local function findIndicator()
        local frame = getFrame()
        if not frame then return nil end
        local fallback
        for _, d in ipairs(frame:GetDescendants()) do
            if d:IsA("GuiObject") and not d:IsA("TextLabel") and not d:IsA("TextButton") then
                local n = d.Name:lower()
                for _, hint in ipairs(NameHints) do
                    if n:find(hint, 1, true) then return d end
                end
                -- round and roughly square = likely the status dot
                local corner = d:FindFirstChildOfClass("UICorner")
                local s = d.AbsoluteSize
                if not fallback and corner and corner.CornerRadius.Scale >= 0.45
                    and s.X > 0 and math.abs(s.X - s.Y) < 3 then
                    fallback = d
                end
            end
        end
        return fallback
    end

    local function isGreen(c)
        return c.G > 0.5 and c.G > c.R * 1.25 and c.G > c.B * 1.25
    end

    -- true = on, false = off, nil = indicator not found
    local function getState()
        if not (indicator and indicator.Parent) then indicator = findIndicator() end
        if not indicator then return nil end
        return isGreen(colorOf(indicator))
    end

    local function toggleGame()
        if autoRollRemote then pcall(function() autoRollRemote:FireServer() end) end
    end

    -- shared with the Pity Roll block
    PerfCache.arGetState = getState
    PerfCache.arToggle = toggleGame
end

