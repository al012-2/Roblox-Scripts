        scriptStopped = not scriptStopped
        if scriptStopped then
            offBtn.BackgroundColor3 = RED
            pauseEverything()
            Rayfield:Notify({ Title = "Titan Hub", Content = "Paused. Your toggles and config are untouched.", Duration = 3 })
        else
            offBtn.BackgroundColor3 = GREEN
            resumeEverything()
            Rayfield:Notify({ Title = "Titan Hub", Content = "Resumed with your current toggles.", Duration = 3 })
        end
    end))

    local parent
    if gethui then
        local ok, h = pcall(gethui)
        if ok then parent = h end
    end
    if not parent then
        local ok = pcall(function() gui.Parent = game:GetService("CoreGui") end)
        if ok and gui.Parent then parent = gui.Parent end
    end
    gui.Parent = parent or player:WaitForChild("PlayerGui")

    -- tap = show/hide the menu, drag = move the button
    local dragging, dragStart, startPos, moved = false, nil, nil, false
    table.insert(activeConnections, btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, moved = true, false
            dragStart, startPos = input.Position, btn.Position
        end
    end))
    table.insert(activeConnections, UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            if d.Magnitude > 6 then moved = true end
            if moved then
                btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
                offBtn.Position = btn.Position + UDim2.fromOffset(52, 0)
            end
        end
    end))
    table.insert(activeConnections, UIS.InputEnded:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            if not moved then
                local ok = pcall(function() Library:Toggle() end)
                if not ok and Library.ToggleKeybind then
                    warn("[Titan Hub] Library:Toggle() unavailable")
                end
            end
        end
    end))
    table.insert(activeConnections, { Disconnect = function() pcall(function() gui:Destroy() end) end })
end

