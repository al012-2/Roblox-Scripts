-- ==================== Auto Roll state helpers (used by Pity Roll) ====================
-- reads the dot inside PlayerGui.Main.Bottom.rollButtons.AutoRollFrame (grey = off, green = on)
do
    local indicator

    local function getFrame()
        local ok, f = pcall(function()
            return player.PlayerGui.Main.Bottom.rollButtons.AutoRollFrame
        end)
        return ok and f or nil
    end

    local NameHints = { "dot", "indicator", "circle", "status", "light", "state", "ball", "toggle" }

    local function colorOf(o)
        if o:IsA("ImageLabel") or o:IsA("ImageButton") then return o.ImageColor3 end
        return o.BackgroundColor3
    end

    local function findIndicator()
        local frame = getFrame()
        if not frame then return nil end
        local fallback
        for _, d in ipairs(frame:GetDescendants()) do
            if d:IsA("GuiObject") and not d:IsA("TextLabel") and not d:IsA("TextButton") then
                local n = d.Name:lower()
                for _, hint in ipairs(NameHints) do
                    if n:find(hint, 1, true) then return d end
                end
                -- round and roughly square = likely the status dot
                local corner = d:FindFirstChildOfClass("UICorner")
                local s = d.AbsoluteSize
                if not fallback and corner and corner.CornerRadius.Scale >= 0.45
                    and s.X > 0 and math.abs(s.X - s.Y) < 3 then
                    fallback = d
                end
            end
        end
        return fallback
    end

    local function isGreen(c)
        return c.G > 0.5 and c.G > c.R * 1.25 and c.G > c.B * 1.25
    end

    -- true = on, false = off, nil = indicator not found
    local function getState()
        if not (indicator and indicator.Parent) then indicator = findIndicator() end
        if not indicator then return nil end
        return isGreen(colorOf(indicator))
    end

    local function toggleGame()
        if autoRollRemote then pcall(function() autoRollRemote:FireServer() end) end
    end

    -- shared with the Pity Roll block
    PerfCache.arGetState = getState
    PerfCache.arToggle = toggleGame
end

-- ==================== Pity Roll ====================
do
    local MaxPity = 10000
    local MaxSpendRolls = 25

    local PityWeathers = {}
    local FillWhileWaiting = true
    local pityToken = 0
    local pityToggle

    -- merged mode: the game's Auto Roll fills the pity, the script takes over near full
    local UseGameAuto = false
    local AutoHandoff = 300      -- switch from game Auto Roll to manual rolls this far from full
    local autoOwned, lastAutoToggle = false, 0

    -- make the game's Auto Roll match `want` (true = on). Returns false if the state is unreadable.
    local function setAuto(want)
        local get, tog = PerfCache.arGetState, PerfCache.arToggle
        if not (get and tog) then return false end
        local st = get()
        if st == nil then return false end
        if st ~= want and os.clock() - lastAutoToggle > 1.5 then
            lastAutoToggle = os.clock()
            tog()
        end
        if want then autoOwned = true end
        return true
    end

    -- stop the pity loop on Unload / re-execute
    table.insert(activeConnections, { Disconnect = function() pityToken += 1 end })

    local WeatherNames, WeatherSet = {}, {}
    do
        local folder = Rep:FindFirstChild("weatherEffects")
        local skip = { possible = true, skyboxes = true }
        if folder then
            for _, c in ipairs(folder:GetChildren()) do
                if not skip[c.Name:lower()] then table.insert(WeatherNames, c.Name) end
            end
        end
        if #WeatherNames == 0 then
            WeatherNames = { "Arcane", "Aurora", "Awakened", "Doodle", "Eclipse", "Galactic", "Glitch", "Goofy",
                "Hailstorm", "Ice Age", "Light Rain", "Mashup", "Monsoon", "Sandstorm", "Snowfall", "Thunderstorm", "Windy" }
        end
        table.sort(WeatherNames)
        for _, n in ipairs(WeatherNames) do WeatherSet[norm(n)] = true end
    end

    -- weather arrives through sendUI("weatherUpdate", data), not through its own remote
    -- data fields (captured): Name, duration, startedAt (unix), rollSpeedMultiplier, luckMultiplier, setBy
    local ServerWeather = nil -- { name, endsAt, speed, luck }
    onRemoteEvent("sendUI", function(action, data)
        if action ~= "weatherUpdate" then return end
        if type(data) == "table" and type(data.Name) == "string" and data.Name ~= "" then
            local started = type(data.startedAt) == "number" and data.startedAt or workspace:GetServerTimeNow()
            local dur = type(data.duration) == "number" and data.duration or 0
            ServerWeather = {
                name = data.Name,
                endsAt = started + dur,
                speed = tonumber(data.rollSpeedMultiplier),
                luck = tonumber(data.luckMultiplier),
            }
        else
            ServerWeather = nil
        end
    end)

    -- fallback: the HUD label, accepted only if it is visible AND the timer is not zero
    local function labelWeather()
        local ok, wi = pcall(function() return player.PlayerGui.Main.weatherInfo end)
        if not (ok and wi) then return nil end
        if wi:IsA("GuiObject") and not wi.Visible then return nil end
        local nameL = wi:FindFirstChild("nameLabel", true)
        local durL = wi:FindFirstChild("durationLabel", true)
        if not (nameL and durL) then return nil end
        local left = tostring(durL.Text):gsub("^Ends in:%s*", "")
        if not left:find("[1-9]") then return nil end   -- "0s" = expired
        if not WeatherSet[norm(nameL.Text)] then return nil end
        return nameL.Text
    end

    -- returns name, secondsLeft (nil if unknown), data
    local function weatherInfo()
        local sw = ServerWeather
        if sw then
            local left = sw.endsAt - workspace:GetServerTimeNow()
            if left > 0 then return sw.name, left, sw end
            ServerWeather = nil
        end
        local n = labelWeather()
        if n then return n, nil, nil end
        return nil
    end

    local function currentWeather() return (weatherInfo()) end

    local function doRoll()
        local rollRemote = Rep:FindFirstChild("RollRequest")
        if rollRemote then
            pcall(function() rollRemote:FireServer() end)
        else
            local ok, btn = pcall(function()
                return player.PlayerGui.Main.Bottom.rollButtons.RollButtonFrame.RollButton
            end)
            if ok and btn then pressButton(btn) end
        end
    end

    local ServerProgress, ServerReady, ServerInterval = nil, false, 0.2
    local ResultTick = 0 -- counts rollResult events (used to wait for the server answer)

    local function parseAmount(s)
        s = tostring(s or ""):gsub(",", ""):gsub("%s", "")
        local num, suf = s:match("^([%d%.]+)([KkMmBb]?)$")
        num = tonumber(num)
        if not num then return nil end
        return num * (({ k = 1e3, m = 1e6, b = 1e9 })[suf:lower()] or 1)
    end

    onRemoteEvent("rollResult", function(...)
            ResultTick += 1
            for i = 1, select("#", ...) do
                local v = select(i, ...)
                if type(v) == "table" and type(v.rollProgress) == "number" then
                    local maxT = (type(v.maxTierThreshold) == "number" and v.maxTierThreshold > 0) and v.maxTierThreshold or MaxPity
                    ServerProgress = v.rollProgress % maxT
                    local lbl = type(v.activeTier) == "table" and tostring(v.activeTier.label or "") or ""
                    local mult = parseAmount(lbl:match("^%s*([%d%.,]+%s*[KkMmBb]?)%s*[xX]"))
                    ServerReady = mult ~= nil and mult >= 10000
                    if type(v.baseCooldown) == "number" and type(v.rollSpeed) == "number" and v.rollSpeed > 0 then
                        ServerInterval = math.max(v.baseCooldown / v.rollSpeed, 0.125)
                    end
                end
            end
    end)

    local progLabel
    local function readBarText()
        if not (progLabel and progLabel.Parent) then
            progLabel = nil
            local ok, area = pcall(function() return player.PlayerGui.Main.Bottom.rollButtons end)
            if ok and area then
                for _, d in ipairs(area:GetDescendants()) do
                    if d.Name == "progressLabel" and d:IsA("TextLabel") then progLabel = d break end
                end
            end
        end
        if not progLabel then return nil end
        local txt = tostring(progLabel.Text)
        local mult = parseAmount(txt:match("^%s*([%d%.,]+%s*[KkMmBb]?)%s*[xX]"))
        if mult and mult >= 10000 then return MaxPity - 1 end
        local a, b = tostring(progLabel.Text):match("^%s*([%d%.,]+%s*[KkMmBb]?)%s*/%s*([%d%.,]+%s*[KkMmBb]?)%s*$")
        local cur, max = parseAmount(a), parseAmount(b)
        if cur and max == MaxPity then return cur end
        return nil
    end

    local function getPity()
        local t = readBarText()
        if t then return t end
        if ServerReady then return MaxPity - 1 end
        return ServerProgress
    end

    -- share with the Infinity Tower tab (end tower on weather) and the Live Tracker
    PerfCache.getWeather = currentWeather
    PerfCache.getWeatherInfo = weatherInfo
    PerfCache.getPity = getPity -- Live Tracker
    PerfCache.weatherNames = WeatherNames

    local function weatherMatches(w)
        if next(PityWeathers) == nil then return true end
        if not w then return false end
        return PityWeathers[norm(w)] == true
    end

    local function stopPity(reason)
        if reason then Rayfield:Notify({ Title = "Pity Roll", Content = reason, Duration = 5 }) end
        if pityToggle then pityToggle:Set(false) end
    end

    local function runPity(token)
        -- wait for the config to finish loading (weather picks must be applied before spending pity)
        while pityToken == token and Rayfield.Loading do task.wait(0.3) end

        local notifiedFull, spending, spendRolls, missingSince = false, false, 0, nil

        while pityToken == token do
            local cur = getPity()
            if cur == nil then
                missingSince = missingSince or os.clock()
                -- after a server change the roll UI can take a while to appear
                if os.clock() - missingSince > 30 then
                    stopPity("Pity bar value not found")
                    return
                end
                -- never roll blindly here: a roll could spend a ready pity outside the chosen weather
                task.wait(0.5)
            else
                missingSince = nil
                local full = cur >= MaxPity - 1
                local w = currentWeather()

                if not full then
                    if spending then
                        spending, spendRolls = false, 0
                        Rayfield:Notify({ Title = "Pity Roll", Content = "Pity used! Filling it again...", Duration = 4 })
                    end
                    notifiedFull = false
                    if FillWhileWaiting and UseGameAuto and cur < MaxPity - AutoHandoff and setAuto(true) then
                        -- far from full: the game's own Auto Roll does the rolling
                        task.wait(0.5)
                    elseif FillWhileWaiting then
                        if UseGameAuto then setAuto(false) end
                        local before = ResultTick
                        doRoll()
                        if cur >= MaxPity - 80 then
                            -- near full: wait for the server answer before the next roll,
                            -- otherwise an in-flight roll can spend the boosted (pity) roll by accident
                            local t = os.clock()
                            while ResultTick == before and os.clock() - t < 1.5 and pityToken == token do
                                task.wait(0.02)
                            end
                            task.wait(0.1)
                        else
                            task.wait(ServerInterval + 0.02)
                        end
                    else
                        if UseGameAuto then setAuto(false) end
                        task.wait(0.5)
                    end
                elseif weatherMatches(w) then
                    if not spending then
                        spending, spendRolls = true, 0
                        Rayfield:Notify({ Title = "Pity Roll", Content = "Weather active (" .. tostring(w or "Any") .. ") - spending pity!", Duration = 4 })
                    end
                    if UseGameAuto then setAuto(false) end
                    spendRolls += 1
                    if spendRolls > MaxSpendRolls then
                        stopPity("Bar didn't reset after " .. MaxSpendRolls .. " rolls.")
                        return
                    end
                    doRoll()
                    task.wait(0.25)
                else
                    if UseGameAuto then setAuto(false) end
                    if not notifiedFull then
                        notifiedFull = true
                        Rayfield:Notify({ Title = "Pity Roll", Content = "Pity is full. Holding until the chosen weather arrives.", Duration = 5 })
                    end
                    task.wait(0.5)
                end
            end
        end
    end

    RollTab:CreateSection("Pity Roll (spend pity on weather)")

    RollTab:CreateDropdown({
        Name = "Spend pity during these weathers",
        Options = WeatherNames,
        CurrentOption = {},
        MultipleOptions = true,
        Flag = "RollPityWeathers",
        Callback = function(list)
            PityWeathers = {}
            for _, n in ipairs(list) do PityWeathers[norm(n)] = true end
        end,
    })

    RollTab:CreateToggle({
        Name = "Keep rolling to fill pity while waiting",
        CurrentValue = true,
        Flag = "RollPityFill",
        Callback = function(v) FillWhileWaiting = v end,
    })

    RollTab:CreateToggle({
        Name = "Use game Auto Roll to fill pity",
        CurrentValue = false,
        Flag = "RollPityUseAuto",
        Callback = function(v) UseGameAuto = v end,
    })

    pityToggle = RollTab:CreateToggle({
        Name = "Start Pity Cycle",
        CurrentValue = false,
        Flag = "RollPityStart",
        Callback = function(Value)
            pityToken += 1
            local myToken = pityToken
            if not Value then
                -- hand the game's Auto Roll back to "off" if this mode turned it on
                if autoOwned then
                    autoOwned = false
                    task.spawn(function() setAuto(false) end)
                end
                return
            end
            task.spawn(function()
                local ok, err = pcall(runPity, myToken)
                if not ok then warn("[Pity Roll] error:", err) end
            end)
        end,
    })

    RollTab:CreateButton({
        Name = "Show pity + weather",
        Callback = function()
            local wn, wl = weatherInfo()
            Rayfield:Notify({
                Title = "Pity Roll",
                Content = "Pity: " .. tostring(getPity()) .. "/" .. MaxPity
                    .. " (text=" .. tostring(readBarText()) .. ", server=" .. tostring(ServerProgress) .. ")"
                    .. " | Weather: " .. tostring(wn) .. (wl and (" (" .. math.floor(wl) .. "s left)") or ""),
                Duration = 8,
            })
        end,
    })
end

