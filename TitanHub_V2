    local UseGameAuto = false
    local AutoHandoff = 300      -- switch from game Auto Roll to manual rolls this far from full
    local autoOwned, lastAutoToggle = false, 0

    -- make the game's Auto Roll match `want` (true = on). Returns false if the state is unreadable.
    local function setAuto(want)
        local get, tog = PerfCache.arGetState, PerfCache.arToggle
        if not (get and tog) then return false end
        local st = get()
        if st == nil then return false end
        if st ~= want and os.clock() - lastAutoToggle > 1.5 then
            lastAutoToggle = os.clock()
            tog()
            -- only ours if we turned it on: never switch off an Auto Roll you started yourself
            if want then autoOwned = true end
        end
        return true
    end

    -- stop the pity loop on Unload / re-execute
    table.insert(activeConnections, { Disconnect = function() pityToken += 1 end })

    local WeatherNames, WeatherSet = {}, {}
    do
        local folder = Rep:FindFirstChild("weatherEffects")
        local skip = { possible = true, skyboxes = true }
        if folder then
            for _, c in ipairs(folder:GetChildren()) do
                if not skip[c.Name:lower()] then table.insert(WeatherNames, c.Name) end
            end
        end
        if #WeatherNames == 0 then
            WeatherNames = { "Arcane", "Aurora", "Awakened", "Cataclysm", "Doodle", "Eclipse", "Galactic", "Glitch", "Goofy",
                "Hailstorm", "Ice Age", "Light Rain", "Mashup", "Monsoon", "Sandstorm", "Snowfall", "Thunderstorm", "Windy" }
        end
        table.sort(WeatherNames)
        for _, n in ipairs(WeatherNames) do WeatherSet[norm(n)] = true end

        -- Halloween has its own weathers (halloweenInfo.WEATHERS), rarest first. They go in WeatherSet as well,
        -- otherwise the HUD fallback in labelWeather would reject them.
        local hwNames = {}
        pcall(function()
            local list = require(Rep.Modules.halloweenInfo).WEATHERS
            table.sort(list, function(a, b) return (tonumber(a.weight) or 0) > (tonumber(b.weight) or 0) end)
            for _, w in ipairs(list) do
                if type(w.name) == "string" then table.insert(hwNames, w.name) end
            end
        end)
        if #hwNames == 0 then
            hwNames = { "Witching Hour", "Blood Moon", "Fog of Souls", "Harvest Moon", "Clear Night" }
        end
        for _, n in ipairs(hwNames) do WeatherSet[norm(n)] = true end
        PerfCache.hwWeatherNames = hwNames
    end

    -- weather arrives through sendUI("weatherUpdate", data), not through its own remote
    -- data fields (captured): Name, duration, startedAt (unix), rollSpeedMultiplier, luckMultiplier, setBy
    local ServerWeather = nil -- { name, endsAt, speed, luck }
    onRemoteEvent("sendUI", function(action, data)
        if action ~= "weatherUpdate" then return end
        if type(data) == "table" and type(data.Name) == "string" and data.Name ~= "" then
            local started = type(data.startedAt) == "number" and data.startedAt or workspace:GetServerTimeNow()
            local dur = type(data.duration) == "number" and data.duration or 0
            ServerWeather = {
                name = data.Name,
                endsAt = started + dur,
                speed = tonumber(data.rollSpeedMultiplier),
                luck = tonumber(data.luckMultiplier),
            }
        else
            ServerWeather = nil
        end
    end)

    -- fallback: the HUD label, accepted only if it is visible AND the timer is not zero
    local function labelWeather()
        local ok, wi = pcall(function() return player.PlayerGui.Main.weatherInfo end)
        if not (ok and wi) then return nil end
        if wi:IsA("GuiObject") and not wi.Visible then return nil end
        local nameL = wi:FindFirstChild("nameLabel", true)
        local durL = wi:FindFirstChild("durationLabel", true)
        if not (nameL and durL) then return nil end
        local left = tostring(durL.Text):gsub("^Ends in:%s*", "")
        if not left:find("[1-9]") then return nil end   -- "0s" = expired
        if not WeatherSet[norm(nameL.Text)] then return nil end
        return nameL.Text
    end

    -- returns name, secondsLeft (nil if unknown), data
    local function weatherInfo()
        local sw = ServerWeather
        if sw then
            local left = sw.endsAt - workspace:GetServerTimeNow()
            if left > 0 then return sw.name, left, sw end
            ServerWeather = nil
        end
        local n = labelWeather()
        if n then return n, nil, nil end
        return nil
    end

    local function currentWeather() return (weatherInfo()) end

    local function doRoll()
        local rollRemote = Rep:FindFirstChild("RollRequest")
        if rollRemote then
            pcall(function() rollRemote:FireServer() end)
        else
            local ok, btn = pcall(function()
                return player.PlayerGui.Main.Bottom.rollButtons.RollButtonFrame.RollButton
            end)
            if ok and btn then pressButton(btn) end
        end
    end

    local ServerProgress, ServerReady, ServerInterval = nil, false, 0.2
    local ResultTick = 0 -- counts rollResult events (used to wait for the server answer)

    local function parseAmount(s)
        s = tostring(s or ""):gsub(",", ""):gsub("%s", "")
        local num, suf = s:match("^([%d%.]+)([KkMmBb]?)$")
        num = tonumber(num)
        if not num then return nil end
        return num * (({ k = 1e3, m = 1e6, b = 1e9 })[suf:lower()] or 1)
    end

    onRemoteEvent("rollResult", function(...)
            ResultTick += 1
            for i = 1, select("#", ...) do
                local v = select(i, ...)
                if type(v) == "table" and type(v.rollProgress) == "number" then
                    local maxT = (type(v.maxTierThreshold) == "number" and v.maxTierThreshold > 0) and v.maxTierThreshold or MaxPity
                    ServerProgress = v.rollProgress % maxT
                    local lbl = type(v.activeTier) == "table" and tostring(v.activeTier.label or "") or ""
                    local mult = parseAmount(lbl:match("^%s*([%d%.,]+%s*[KkMmBb]?)%s*[xX]"))
                    ServerReady = mult ~= nil and mult >= 10000
                    if type(v.baseCooldown) == "number" and type(v.rollSpeed) == "number" and v.rollSpeed > 0 then
                        ServerInterval = math.max(v.baseCooldown / v.rollSpeed, 0.125)
                    end
                end
            end
    end)

    local progLabel
    local function readBarText()
        if not (progLabel and progLabel.Parent) then
            progLabel = nil
            local ok, area = pcall(function() return player.PlayerGui.Main.Bottom.rollButtons end)
            if ok and area then
                for _, d in ipairs(area:GetDescendants()) do
                    if d.Name == "progressLabel" and d:IsA("TextLabel") then progLabel = d break end
                end
            end
        end
        if not progLabel then return nil end
        local txt = tostring(progLabel.Text)
        local mult = parseAmount(txt:match("^%s*([%d%.,]+%s*[KkMmBb]?)%s*[xX]"))
        if mult and mult >= 10000 then return MaxPity - 1 end
        local a, b = tostring(progLabel.Text):match("^%s*([%d%.,]+%s*[KkMmBb]?)%s*/%s*([%d%.,]+%s*[KkMmBb]?)%s*$")
        local cur, max = parseAmount(a), parseAmount(b)
        if cur and max == MaxPity then return cur end
        return nil
    end

    local function getPity()
        local t = readBarText()
        if t then return t end
        if ServerReady then return MaxPity - 1 end
        return ServerProgress
    end

    -- share with the Infinity Tower tab (end tower on weather) and the Live Tracker
    PerfCache.getWeather = currentWeather
    PerfCache.getWeatherInfo = weatherInfo
    PerfCache.getPity = getPity -- Live Tracker
    PerfCache.weatherNames = WeatherNames

    local function weatherMatches(w)
        -- nothing picked: hold, unless "any weather" is switched on explicitly
        if next(PityWeathers) == nil then return PerfCache.pitySpendAny == true end
        if not w then return false end
        return PityWeathers[norm(w)] == true
    end

    local function stopPity(reason)
        if reason then Rayfield:Notify({ Title = "Pity Roll", Content = reason, Duration = 5 }) end
        if pityToggle then pityToggle:Set(false) end
    end

    local function runPity(token)
        -- wait for the config to finish loading (weather picks must be applied before spending pity)
        while pityToken == token and Rayfield.Loading do task.wait(0.3) end

        local notifiedFull, spending, spendRolls, missingSince = false, false, 0, nil

        while pityToken == token do
            local cur = getPity()
            if cur == nil then
                missingSince = missingSince or os.clock()
                -- after a server change the roll UI can take a while to appear
                if os.clock() - missingSince > 30 then
                    stopPity("Pity bar value not found")
                    return
                end
                -- never roll blindly here: a roll could spend a ready pity outside the chosen weather
                task.wait(0.5)
            else
                missingSince = nil
                local full = cur >= MaxPity - 1
                local w = currentWeather()

                if not full then
                    if spending then
                        spending, spendRolls = false, 0
                        Rayfield:Notify({ Title = "Pity Roll", Content = "Pity used! Filling it again...", Duration = 4 })
                    end
                    notifiedFull = false
                    if FillWhileWaiting and UseGameAuto and cur < MaxPity - AutoHandoff and setAuto(true) then
                        -- far from full: the game's own Auto Roll does the rolling
                        task.wait(0.5)
                    elseif FillWhileWaiting then
                        if UseGameAuto then setAuto(false) end
                        local before = ResultTick
                        doRoll()
                        if cur >= MaxPity - 80 then
                            -- near full: wait for the server answer before the next roll,
                            -- otherwise an in-flight roll can spend the boosted (pity) roll by accident
                            local t = os.clock()
                            while ResultTick == before and os.clock() - t < 1.5 and pityToken == token do
                                task.wait(0.02)
                            end
                            task.wait(0.1)
                        else
                            task.wait(ServerInterval + 0.02)
                        end
                    else
                        if UseGameAuto then setAuto(false) end
                        task.wait(0.5)
                    end
                elseif weatherMatches(w) then
                    if not spending then
                        spending, spendRolls = true, 0
                        Rayfield:Notify({ Title = "Pity Roll", Content = "Weather active (" .. tostring(w or "Any") .. ") - spending pity!", Duration = 4 })
                    end
                    if UseGameAuto then setAuto(false) end
                    spendRolls += 1
                    if spendRolls > MaxSpendRolls then
                        stopPity("Bar didn't reset after " .. MaxSpendRolls .. " rolls.")
                        return
                    end
                    doRoll()
                    task.wait(0.25)
                else
                    if UseGameAuto then setAuto(false) end
                    if not notifiedFull then
                        notifiedFull = true
                        Rayfield:Notify({ Title = "Pity Roll", Content = "Pity is full. Holding until the chosen weather arrives.", Duration = 5 })
                    end
                    task.wait(0.5)
                end
            end
        end
    end

    RollTab:CreateSection("Pity Roll (spend pity on weather)")

    RollTab:CreateDropdown({
        Name = "Spend pity during these weathers",
        Options = WeatherNames,
        CurrentOption = {},
        MultipleOptions = true,
        Flag = "RollPityWeathers",
        Callback = function(list)
            PityWeathers = {}
            for _, n in ipairs(list) do PityWeathers[norm(n)] = true end
        end,
    })

    RollTab:CreateToggle({
        Name = "Spend pity on any weather (when none is picked)",
        CurrentValue = false,
        Flag = "RollPitySpendAny",
        Callback = function(v) PerfCache.pitySpendAny = v end,
    })

    RollTab:CreateToggle({
        Name = "Keep rolling to fill pity while waiting",
        CurrentValue = true,
        Flag = "RollPityFill",
        Callback = function(v) FillWhileWaiting = v end,
    })

    RollTab:CreateToggle({
        Name = "Use game Auto Roll to fill pity",
        CurrentValue = false,
        Flag = "RollPityUseAuto",
        Callback = function(v) UseGameAuto = v end,
    })

    pityToggle = RollTab:CreateToggle({
        Name = "Start Pity Cycle",
        CurrentValue = false,
        Flag = "RollPityStart",
        Callback = function(Value)
            pityToken += 1
            local myToken = pityToken
            if not Value then
                -- hand the game's Auto Roll back to "off" if this mode turned it on
                if autoOwned then
                    autoOwned = false
                    task.spawn(function() setAuto(false) end)
                end
                return
            end
            task.spawn(function()
                local ok, err = pcall(runPity, myToken)
                if not ok then warn("[Pity Roll] error:", err) end
            end)
        end,
    })

    RollTab:CreateButton({
        Name = "Show pity + weather",
        Callback = function()
            local wn, wl = weatherInfo()
            Rayfield:Notify({
                Title = "Pity Roll",
                Content = "Pity: " .. tostring(getPity()) .. "/" .. MaxPity
                    .. " (text=" .. tostring(readBarText()) .. ", server=" .. tostring(ServerProgress) .. ")"
                    .. " | Weather: " .. tostring(wn) .. (wl and (" (" .. math.floor(wl) .. "s left)") or ""),
                Duration = 8,
            })
        end,
    })
end

-- ==================== Infinity Tower tab ====================
-- own function scope: adds no top-level locals
do (function()
    local TowerTab = Window:CreateTab("Infinity Tower", 4483362458)
    local towerRemote
    task.spawn(function()
        towerRemote = Rep:WaitForChild("infinityTowerAction", 180)
        if not towerRemote then warn("[Titan Hub] missing remote: infinityTowerAction") end
    end)

    local TargetFloor = 0
    local autoToken = 0
    local autoToggle
    local function sendAction(action)
        if not towerRemote then return false end
        return pcall(function() towerRemote:FireServer(action) end)
    end

    -- drink the chosen potions first (luck etc., only if they are not already running), then end the tower
    local function endTowerPrepared()
        local prep = PerfCache.prepBeforeTowerEnd
        if prep then
            local ok, n = pcall(prep)
            if ok and type(n) == "number" and n > 0 then
                Rayfield:Notify({ Title = "Infinity Tower", Content = "Drank " .. n .. " potion(s) before ending the tower", Duration = 4 })
            end
        end
        return sendAction("end")
    end

    local function floorNumber(txt, loose)
        if not txt then return nil end
        txt = tostring(txt):gsub("<[^>]+>", "")
        local n = txt:match("[Ff]loor%s*:?%s*([%d,]+)")
        if not n and loose then n = txt:match("[Ff]%s*([%d,]+)") end   -- "Infinite F474"
        return n and tonumber((n:gsub(",", ""))) or nil
    end

    local function labelText(root, path)
        local node = root
        for _, nm in ipairs(path) do node = node and node:FindFirstChild(nm) end
        if node and (node:IsA("TextLabel") or node:IsA("TextButton")) then
            local t = node.ContentText
            if t == nil or t == "" then t = node.Text end
            return t
        end
        return nil
    end

    local function readFloor()
        local pg = player:FindFirstChild("PlayerGui")
        local ui = pg and pg:FindFirstChild("BattleUI")
        if not ui then return nil end
        -- 1) the tower tab itself: specific to the Infinity Tower ("Infinite F474")
        return floorNumber(labelText(ui, { "battleContainer", "battleTabs", "tower", "textLabel" }), true)
            -- 2) "Currently in battle: Floor 2"
            or floorNumber(labelText(ui, { "battleNotifierLabel" }))
            -- 3) "Floor: 2"
            or floorNumber(labelText(ui, { "battleContainer", "floorCount" }))
    end

    -- the floor from the Infinity Tower's own tab only (nil = no Infinity Tower running).
    -- Auto-end uses this, so another tower's "Floor N" label can't end this one.
    local function towerFloor()
        local ok, tab = pcall(function() return player.PlayerGui.BattleUI.battleContainer.battleTabs.tower end)
        if not (ok and tab) then return nil end
        if tab:IsA("GuiObject") and not tab.Visible then return nil end
        return floorNumber(labelText(tab, { "textLabel" }), true)
    end

    TowerTab:CreateSection("End the tower at a floor (claim the big reward)")

    TowerTab:CreateInput({
        Name = "End at floor",
        Default = "",
        Placeholder = "e.g. 2500",
        Flag = "TowerTargetFloor",
        Callback = function(v)
            TargetFloor = tonumber((tostring(v or ""):gsub("[%s,]", ""))) or 0
        end,
    })

    autoToggle = TowerTab:CreateToggle({
        Name = "Auto End when floor reaches target",
        CurrentValue = false,
        Flag = "TowerAutoEnd",
        Callback = function(Value)
            autoToken += 1
            local myToken = autoToken
            if not Value then return end
            task.spawn(function()
                -- wait for the saved config so the target floor is applied first
                while autoToken == myToken and Rayfield.Loading do task.wait(0.3) end
                while autoToken == myToken do
                    local f = towerFloor()
                    if f and TargetFloor > 0 and f >= TargetFloor then
                        local ok = endTowerPrepared()
                        Rayfield:Notify({
                            Title = "Infinity Tower",
                            Content = ok and ("Reached floor " .. f .. " - ending the tower to claim the reward")
                                or "Tower remote not ready yet",
                            Duration = 6,
                        })
                        if ok then
                            autoToggle:Set(false)
                            return
                        end
                    end
                    task.wait(0.5)
                end
            end)
        end,
    })

    -- ===== end the tower when a chosen weather appears =====
    TowerTab:CreateSection("End the tower on weather")

    local EndWeathers = { arcane = true, awakened = true } -- normal world tower
    local HwEndWeathers, HwEndTyped = {}, {}               -- Halloween tower: nothing until you pick
    local endedOn = {}                                     -- [world] = weather that already ended that tower
    local weatherTok = 0
    local weatherToggle

    -- stop both auto-end loops on Unload / re-execute
    table.insert(activeConnections, { Disconnect = function()
        autoToken += 1
        weatherTok += 1
    end })

    TowerTab:CreateDropdown({
        Name = "Normal world: end tower on these weathers",
        Options = PerfCache.weatherNames or { "Arcane", "Awakened" },
        CurrentOption = { "Arcane", "Awakened" },
        MultipleOptions = true,
        Flag = "TowerEndWeathers",
        Callback = function(list)
            EndWeathers = {}
            for _, n in ipairs(list) do EndWeathers[norm(n)] = true end
        end,
    })

    TowerTab:CreateDropdown({
        Name = "Halloween: end tower on these weathers",
        Options = PerfCache.hwWeatherNames or { "Witching Hour", "Blood Moon", "Fog of Souls", "Harvest Moon", "Clear Night" },
        CurrentOption = {},
        MultipleOptions = true,
        Flag = "TowerEndWeathersHalloween",
        Callback = function(list)
            HwEndWeathers = {}
            for _, n in ipairs(list) do HwEndWeathers[norm(n)] = true end
        end,
    })

    TowerTab:CreateInput({
        Name = "Other Halloween weathers (names, comma separated)",
        Default = "",
        Placeholder = "for weathers missing from the list",
        Flag = "TowerEndWeathersHalloweenTyped",
        Callback = function(v)
            HwEndTyped = {}
            for n in tostring(v or ""):gmatch("[^,]+") do
                local key = norm(n)
                if key ~= "" then HwEndTyped[key] = true end
            end
        end,
    })

    weatherToggle = TowerTab:CreateToggle({
        Name = "Auto End tower on weather",
        CurrentValue = false,
        Flag = "TowerEndOnWeather",
        Callback = function(Value)
            weatherTok += 1
            local myTok = weatherTok
            if not Value then return end
            task.spawn(function()
                local fromLoad = Rayfield.Loading
                while weatherTok == myTok and Rayfield.Loading do task.wait(0.3) end
                if fromLoad then
                    -- turned on by the saved config: only a weather that starts from now on may end the tower
                    local w0 = PerfCache.getWeather and PerfCache.getWeather()
                    if w0 then
                        endedOn[player:GetAttribute("InHalloween") == true and "halloween" or "normal"] = norm(w0)
                    end
                end
                while weatherTok == myTok do
                    local w = PerfCache.getWeather and PerfCache.getWeather()
                    local key = w and norm(w) or nil
                    local inHw = player:GetAttribute("InHalloween") == true
                    local world = inHw and "halloween" or "normal"
                    -- a new weather in this world may end this world's tower again
                    if endedOn[world] ~= key then endedOn[world] = nil end
                    local wanted = key ~= nil and (inHw and (HwEndWeathers[key] or HwEndTyped[key]) or (not inHw and EndWeathers[key]))
                    -- stays on for both worlds. Once per weather: Auto Run restarts the tower straight away,
                    -- and without this it would be ended again (with more potions) while the weather lasts.
                    -- No running tower: nothing to end, so keep waiting (and keep the potions).
                    if wanted and endedOn[world] ~= key and towerFloor() then
                        local ok = endTowerPrepared()
                        Rayfield:Notify({
                            Title = "Infinity Tower",
                            Content = ok and ((inHw and "Halloween" or "Normal") .. " tower: weather " .. w .. " is active - ending it")
                                or "Tower remote not ready yet",
                            Duration = 6,
                        })
                        if ok then
                            endedOn[world] = key
                        else
                            task.wait(5)
                        end
                    end
                    task.wait(0.5)
                end
            end)
        end,
    })

    TowerTab:CreateSection("Manual")

    TowerTab:CreateButton({
        Name = "End Tower NOW (claim reward)",
        Callback = function()
            local ok = sendAction("end")
            Rayfield:Notify({ Title = "Infinity Tower", Content = ok and "End sent" or "Tower remote not found", Duration = 4 })
        end,
    })

    TowerTab:CreateButton({
        Name = "Pause Tower",
        Callback = function()
            local ok = sendAction("pause")
            Rayfield:Notify({ Title = "Infinity Tower", Content = ok and "Pause sent" or "Tower remote not found", Duration = 4 })
        end,
    })

    TowerTab:CreateButton({
        Name = "Show current floor",
        Callback = function()
            local f = readFloor()
            Rayfield:Notify({
                Title = "Infinity Tower",
                Content = f and ("Current floor: " .. f .. " | Target: " .. TargetFloor)
                    or "Floor not found (no tower tab in the BATTLES list and no 'Currently in battle' label)",
                Duration = 5,
            })
        end,
    })

    TowerTab:CreateSection("Auto Run")

    TowerTab:CreateToggle({
        Name = "Auto Run Infinite Tower",
        CurrentValue = false,
        Flag = "AutoInfTowerMulti",
        Callback = function(Value)
            autoTowerToken += 1
            local towerToken = autoTowerToken
            if not Value then return end
            task.spawn(function()
                local lastFire = os.clock() -- no forced request at load: a tower that is already running stays untouched
                while autoTowerToken == towerToken do
                    -- FIX: removed "and not ActiveMode" so the tower runs together with a farm mode
                    -- (the game allows 2 battles at once: 1 farm + 1 tower)
                    -- a running tower is left alone: the server only answers "already climbing"
                    -- (re-checked every 5 min in case the tab is stale)
                    if runInfTowerRemote and (not towerFloor() or os.clock() - lastFire > 300) then
                        lastFire = os.clock()
                        PerfCache.sendAndWaitBattle(function() runInfTowerRemote:FireServer() end, 1)
                    end
                    task.wait(15)
                end
            end)
        end,
    })
end)() end

-- ==================== Potions tab ====================
