local rejoining = false
local qotQueued = false
local rejoinAttempt = 0

local function queueReload()
    if qotQueued or ScriptLoadURL == "" then return end
    local qot = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
    if qot then
        qotQueued = true
        -- %q escapes quotes / backslashes so the URL can never break out of the string
        pcall(qot, ("loadstring(game:HttpGet(%q))()"):format(ScriptLoadURL))
    end
end

