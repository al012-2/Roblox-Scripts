local function forceTeleportToWorld(worldKey)
    local char = getCharWithTimeout(10)
    if not char then return end
    local root = char:WaitForChild("HumanoidRootPart", 5)
    if not root then return end

    -- If we are already near the world's bosses, don't teleport again
    if nearWorldBosses(worldKey) then
        lastTpWorld, lastTpChar = worldKey, char
        if worldKey == "6" then refreshWorld6Data() end
        return
    end

    if worldKey == "halloween" then
        local startPos = root.Position
        if teleportAreaRemote then
            pcall(function() teleportAreaRemote:FireServer("event", "halloween") end)
            local t = os.clock()
            while os.clock() - t < 6 do
                if nearWorldBosses("halloween") then
                    task.wait(0.6)
                    return
                end
                local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if r and (r.Position - startPos).Magnitude > 100 then
                    task.wait(1.0)
                    return
                end
                task.wait(0.3)
            end
        end
        return
    end

    if worldKey == "raid" then
        local startPos = root.Position

        local function arrived(maxWait)
            local t = os.clock()
            repeat
                if nearWorldBosses("raid") then return true end
                task.wait(0.3)
            until os.clock() - t >= maxWait
            return false
        end

        -- 1) the real arguments captured with the Spy (direct remote call, no GUI needed)
        if teleportAreaRemote then
            for _, args in ipairs({
                { "raid", "kaiju" }, -- confirmed with Cobalt
            }) do
                pcall(function() teleportAreaRemote:FireServer(args[1], args[2]) end)
                if arrived(6) then return end

                local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if r and (r.Position - startPos).Magnitude > 150 then
                    task.wait(1.5)
                    return
                end
            end
        end

        -- 2) fallback: press the Kaiju Raid button in the game's Teleport menu
        if pressTeleportMenuButton("kaiju", "raidsTab") and arrived(6) then return end

        -- 3) last resort: move to the raid map if it is loaded
        local raidFolder = workspace:FindFirstChild("KaijuRaid")
        if raidFolder then
            local raidPart = raidFolder:FindFirstChildWhichIsA("BasePart", true)
            if raidPart then
                root.AssemblyLinearVelocity = Vector3.zero
                root.CFrame = raidPart.CFrame + Vector3.new(0, 3, 0)
                task.wait(1.0)
            end
        end

        if not nearWorldBosses("raid") and os.clock() - lastRaidNotify > 30 then
            lastRaidNotify = os.clock()
            Rayfield:Notify({ Title = "Raid", Content = "Could not reach the Kaiju Raid (maybe closed right now).", Duration = 6 })
        end
        return
    end

    if lastTpWorld == worldKey and lastTpChar == char then return end

    local areaIndex = tonumber(worldKey)
    local startPos = root.Position
    if teleportAreaRemote and areaIndex then
        for _ = 1, 2 do
            pcall(function() teleportAreaRemote:FireServer(areaIndex, nil) end)
            local t = os.clock()
            while os.clock() - t < 5 do
                task.wait(0.25)
                local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                local dist = r and (r.Position - startPos).Magnitude or 0
                -- a long jump counts as arrived even when the boss folder has not streamed in yet
                if r and (dist >= 100 or (nearWorldBosses(worldKey) and (dist >= 25 or os.clock() - t >= 2))) then
                    task.wait(0.5)
                    lastTpWorld, lastTpChar = worldKey, player.Character
                    if worldKey == "6" then refreshWorld6Data() end
                    return
                end
            end
        end
    end

    if TravelViaMenu and teleportAreaRemote then
        warn("[Travel] Teleport menu did not move us to world " .. tostring(worldKey) .. " (portals disabled)")
        return
    end

    local lobby = workspace:FindFirstChild("Lobby")
    local portals = lobby and lobby:FindFirstChild("portals")
    local portalFolder = portals and portals:FindFirstChild(tostring(worldKey))

    if not portalFolder then
        returnToLobby()
        task.wait(0.5)
        lobby = workspace:FindFirstChild("Lobby")
        portals = lobby and lobby:FindFirstChild("portals")
        portalFolder = portals and portals:FindFirstChild(tostring(worldKey))
    end

    if portalFolder then
        local pModel = portalFolder:FindFirstChild("portalModel")
        local triggerPart = nil
        if pModel then
            triggerPart = pModel:FindFirstChild("Part") or pModel:FindFirstChildWhichIsA("BasePart", true)
        end
        triggerPart = triggerPart or portalFolder:FindFirstChildWhichIsA("BasePart", true)

        if triggerPart and root.Parent then
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = triggerPart.CFrame
            task.wait(0.15)
            if firetouchinterest then
                firetouchinterest(root, triggerPart, 0)
                task.wait(0.1)
                firetouchinterest(root, triggerPart, 1)
            end
            humanDelay(1.2, 1.6)
        end
    end
end

local function recoverIfDead(worldKey, alive)
    if isCharAlive() then return true end
    local t = os.clock()
    repeat
        task.wait(0.5)
    until isCharAlive() or not alive() or os.clock() - t > 30
    if not alive() or not isCharAlive() then return false end
    humanDelay(1.5, 2.0)
    if FarmWalk ~= "remote" and worldKey ~= "secret" then
        forceTeleportToWorld(worldKey)
    end
    return true
end

-- ==================== Boss lookup and cooldowns ====================
local BossCache, MissUntil = {}, {}

local function findBossModel(bossName)
    local key = bossName:lower()
    local cached = BossCache[key]
    if cached and cached.Parent and cached:IsDescendantOf(workspace) then
        return cached
    end
    BossCache[key] = nil

    if MissUntil[key] and os.clock() < MissUntil[key] then return nil end

    local want = norm(bossName)
    local want2 = BossDisplayName[bossName] and norm(BossDisplayName[bossName]) or nil
    local found

    local hwFolder = workspace:FindFirstChild("HalloweenEvent")
    local searchRoots = {
        workspace:FindFirstChild("bossNpcs"),
        workspace:FindFirstChild("KaijuRaid"),
        hwFolder and hwFolder:FindFirstChild("EventNPCs"),
        hwFolder,
    }
    for _, root in ipairs(searchRoots) do
        if root then
            local unnamed
            for _, folder in ipairs(root:GetChildren()) do
                if folder:IsA("Model") and not folder:GetAttribute("AreaOrder") then
                    local n = norm(folder.Name)
                    if folder:GetAttribute("bossId") == bossName or n == want or (want2 and n == want2) then
                        found = folder
                        break
                    end
                end
                if folder.Name ~= "BossAreas" and folder.Name ~= "Guides" then
                    for _, m in ipairs(folder:GetChildren()) do
                        if m:IsA("Model") and not m:GetAttribute("AreaOrder") then
                            local n = norm(m.Name)
                            if m:GetAttribute("bossId") == bossName
                                or n == want
                                or (want2 and n == want2)
                                or (n ~= "" and want ~= "" and n:find(want, 1, true)) then
                                found = m
                                break
                            elseif n == "" and UnnamedFallback[bossName] and BossWorldOf[bossName] == folder.Name then
                                unnamed = unnamed or m
                            end
                        end
                    end
                end
                if found then break end
            end
            if found then break end
            found = found or unnamed
        end
    end

    if not found and hwFolder then
        for _, subName in ipairs({ "EventNPCs", "Ghosts" }) do
            local sub = hwFolder:FindFirstChild(subName)
            if sub then
                for _, d in ipairs(sub:GetDescendants()) do
                    if d:IsA("Model") and not d:GetAttribute("AreaOrder") then
                        local n = norm(d.Name)
                        if d:GetAttribute("bossId") == bossName or n == want or (want2 and n == want2) then
                            found = d
                            break
                        end
                    end
                end
            end
            if found then break end
        end
    end

    -- full-workspace scan is expensive: allowed at most once every 20s (shared by all bosses)
    if not found and os.clock() - PerfCache.scanAt > 20 then
        PerfCache.scanAt = os.clock()
        local npcsFolder = workspace:FindFirstChild("npcs")
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model")
                and not (npcsFolder and obj:IsDescendantOf(npcsFolder))
                and (norm(obj.Name) == want or (want2 and norm(obj.Name) == want2)) then
                found = obj
                break
            end
        end
    end

    if found then BossCache[key] = found else MissUntil[key] = os.clock() + 5 end
    return found
end

local function isBossOnCooldownRaw(bossName, difficulty)
    local bossModel = findBossModel(bossName)
    if not bossModel then return false end

    local pgui = player:FindFirstChild("PlayerGui")
    if not pgui then return false end

    for _, gui in ipairs(pgui:GetChildren()) do
        if gui.Name == "bossCooldownBillboard" and gui:IsA("BillboardGui") then
            local adornee = gui.Adornee
            if adornee and adornee:IsDescendantOf(bossModel) then
                local label = gui:FindFirstChild("cooldownLabel", true)
                if label and label:IsA("TextLabel") and label.Text:find(difficulty, 1, true) then
                    return true
                end
            end
        end
    end
    return false
end

-- cached for 0.5s (cleared on every boss result / battle end, so it never gets stale)
local function isBossOnCooldown(bossName, difficulty)
    local k = bossName .. "|" .. difficulty
    local c = PerfCache.cd[k]
    if c and os.clock() - c.t < 0.5 then return c.v end
    local v = isBossOnCooldownRaw(bossName, difficulty)
    PerfCache.cd[k] = { t = os.clock(), v = v }
    return v
end

-- ==================== Movement (teleport + natural walking for raid) ====================
local function groundAt(x, y, z, ignore)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = ignore
    params.RespectCanCollide = true
    return workspace:Raycast(Vector3.new(x, y + 8, z), Vector3.new(0, -200, 0), params)
end

local function getSafeSpotNearBoss(targetPosition, attempt, bossModel)
    local AttemptDistances = { {4, 6}, {3, 5}, {2, 4} }
    local range = AttemptDistances[attempt or 1] or AttemptDistances[1]
    local char = player.Character
    local ignore = { char }
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Character then table.insert(ignore, pl.Character) end
    end
    if bossModel then table.insert(ignore, bossModel) end

    local base = groundAt(targetPosition.X, targetPosition.Y, targetPosition.Z, ignore)
    local groundY = base and base.Position.Y or targetPosition.Y
    groundY = math.min(groundY, targetPosition.Y)

    for _ = 1, 10 do
        local angle = math.random() * math.pi * 2
        local dist = range[1] + math.random() * (range[2] - range[1])
        local x = targetPosition.X + math.cos(angle) * dist
        local z = targetPosition.Z + math.sin(angle) * dist
        local hit = groundAt(x, groundY, z, ignore)
        if hit and math.abs(hit.Position.Y - groundY) <= 3 then
            return hit.Position + Vector3.new(0, 3.2, 0)
        end
    end
    return Vector3.new(targetPosition.X + range[1], groundY + 3.2, targetPosition.Z)
end

local function teleportNear(targetPosition, attempt, bossModel)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    -- Underground bosses (secretBosses, Halloween hidden bosses like Primordial Dread / Faceless Prophet):
    -- the ground raycast finds no proper floor and the character falls, then the game sends us back.
    -- So we land at the boss's own height and hold still briefly.
    local function isUndergroundBoss()
        if not bossModel then return false end
        local bn = workspace:FindFirstChild("bossNpcs")
        local sf = bn and bn:FindFirstChild("secretBosses")
        if sf and bossModel:IsDescendantOf(sf) then return true end
        local id = bossModel:GetAttribute("bossId")
        if id == "halloween_friend" or id == "halloween_darkness" then return true end
        local n = bossModel.Name
        if n == "Primordial Dread" or n == "Faceless Prophet" then return true end
        -- generic check: is there solid ground clearly ABOVE the boss?
        local ignoreList = { char }
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl.Character then table.insert(ignoreList, pl.Character) end
        end
        table.insert(ignoreList, bossModel)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = ignoreList
        params.RespectCanCollide = true
        local hit = workspace:Raycast(Vector3.new(targetPosition.X, targetPosition.Y + 150, targetPosition.Z), Vector3.new(0, -150, 0), params)
        return hit ~= nil and hit.Position.Y > targetPosition.Y + 12
    end

    if isUndergroundBoss() then
        local ang = math.random() * math.pi * 2
        local spot = Vector3.new(targetPosition.X + math.cos(ang) * 5, targetPosition.Y, targetPosition.Z + math.sin(ang) * 5)
        root.AssemblyLinearVelocity = Vector3.zero
        root.CFrame = CFrame.new(spot)
        root.Anchored = true
        task.delay(1.5, function()
            if root.Parent then root.Anchored = false end
        end)
        return true
    end

    local spot = getSafeSpotNearBoss(targetPosition, attempt, bossModel)
    root.AssemblyLinearVelocity = Vector3.zero
    root.CFrame = CFrame.new(spot)
    return true
end

-- Walk to the boss naturally (no instant teleport)
local function walkNearBoss(targetPosition, attempt, bossModel, shouldContinue, timeout)
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and root) then return false end

    local deadline = timeout and (os.clock() + timeout) or math.huge
    local destination = getSafeSpotNearBoss(targetPosition, attempt, bossModel)
    local distToTarget = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(destination.X, 0, destination.Z)).Magnitude

    if distToTarget <= 7 then
        return true
    end

    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        WaypointSpacing = 8,
    })

    local ok = pcall(function()
        path:ComputeAsync(root.Position, destination)
    end)

    if ok and path.Status == Enum.PathStatus.Success then
        local waypoints = path:GetWaypoints()
        for i = 2, #waypoints do
            if not shouldContinue() or not isCharAlive() then return false end
            if os.clock() > deadline then break end
            local wp = waypoints[i]
            if wp.Action == Enum.PathWaypointAction.Jump then
                hum.Jump = true
            end
            hum:MoveTo(wp.Position)
            local stepStart = os.clock()
            while os.clock() - stepStart < 2.2 do
                if not shouldContinue() or not isCharAlive() then return false end
                if os.clock() > deadline then break end
                local d = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(wp.Position.X, 0, wp.Position.Z)).Magnitude
                if d <= 4.5 then break end
                task.wait(0.08)
            end
        end
    else
        local walkStart = os.clock()
        local lastPos = root.Position
        local lastCheck = os.clock()
        while os.clock() - walkStart < 20 do
            if not shouldContinue() or not isCharAlive() then return false end
            if os.clock() > deadline then break end
            hum:MoveTo(destination)
            local horizDist = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(destination.X, 0, destination.Z)).Magnitude
            if horizDist <= 6.5 then
                break
            end
            if os.clock() - lastCheck > 1.2 then
                if (root.Position - lastPos).Magnitude < 1.5 then
                    hum.Jump = true
                end
                lastPos = root.Position
                lastCheck = os.clock()
            end
            task.wait(0.15)
        end
    end

    local finalDist = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(targetPosition.X, 0, targetPosition.Z)).Magnitude
    return finalDist <= 14
end

local ResultCounter = 0
local LastBossCooldown = 300
local BossResults = {}

local function recordBossResult(boss, diff)
    if type(boss) ~= "string" or boss == "" then
        BossResults["?"] = (BossResults["?"] or 0) + 1   -- result without a readable boss name
        return
    end
    local nb = norm(boss)
    BossResults[nb] = (BossResults[nb] or 0) + 1
    if type(diff) == "string" and diff ~= "" then
        local k = nb .. "|" .. norm(diff)
        BossResults[k] = (BossResults[k] or 0) + 1
    end
end

onRemoteEvent("bossResult", function(won, boss, diff, cd)
    ResultCounter += 1
    PerfCache.cd = {}
    if type(won) == "table" then
        boss = boss or won.boss or won.bossId or won.bossName or won.name
        diff = diff or won.diff or won.difficulty
        cd = cd or won.cd or won.cooldown
    end
    if type(cd) == "number" then LastBossCooldown = cd end
    recordBossResult(boss, diff)
end)

local BattleStarts, BattleEnds = 0, 0
PerfCache.fightStarts, PerfCache.fightEnds = 0, 0
onRemoteEvent("battleEvent", function(action, data)
    if action == "battle_start" then
        BattleStarts += 1
        -- every tower floor is its own battle_start and carries floorCount: those are not a new fight
        local towerFloorStart = type(data) == "table" and data.floorCount ~= nil and data.isPrestige ~= true
        if not towerFloorStart then PerfCache.fightStarts += 1 end
    elseif action == "battle_ended" then
        BattleEnds += 1
        PerfCache.cd = {}
    elseif action == "battleTabs" and type(data) == "table" then
        -- battle_ended doesn't say which battle ended; the "fight" tab disappearing does
        if PerfCache.fightTab and data.fight == nil then PerfCache.fightEnds += 1 end
        PerfCache.fightTab = data.fight
        PerfCache.towerInTabs = data.tower ~= nil
    end
end)

-- the server explains a refused challenge right away, so there's no need to sit out the whole wait
PerfCache.refuse = { at = -1, kind = nil }
onRemoteEvent("sendUI", function(action, text)
    if action ~= "message" or type(text) ~= "string" then return end
    if text:find("Get closer", 1, true) then
        PerfCache.refuse.at, PerfCache.refuse.kind = os.clock(), "distance"
    elseif text:find("^Beat .+ first") then
        PerfCache.refuse.at, PerfCache.refuse.kind = os.clock(), "locked"
    end
end)

-- sends a request and reports whether a battle started within `window` seconds
function PerfCache.sendAndWaitBattle(send, window)
    PerfCache.acquireStart(window + 0.5)
    local before = PerfCache.fightStarts
    if not pcall(send) then
        PerfCache.releaseStart()
        return false, "send failed"
    end
    local t, started = os.clock(), false
    while os.clock() - t < window do
        if PerfCache.fightStarts ~= before then started = true break end
        task.wait(0.1)
    end
    PerfCache.releaseStart()
    return started
end

local function hitAndRunBoss(bossName, difficulty, shouldContinue, forceWait, useWalk)
    shouldContinue = shouldContinue or function() return true end
    local isRemote = (useWalk == "remote" or useWalk == "remote_world")
    if isBossOnCooldown(bossName, difficulty) then return false end

    local targetModel, targetPart
    if not isRemote then
        targetModel = findBossModel(bossName)
        if not targetModel then return false end

        targetPart = targetModel:FindFirstChild("HumanoidRootPart")
            or targetModel:FindFirstChild("Head")
            or targetModel:FindFirstChildWhichIsA("BasePart", true)
        if not targetPart then return false end
    end

    local nb = norm(tostring(bossName))
    local nd = norm(tostring(difficulty))
    local bossKey = nb .. "|" .. nd
    local altName = BossDisplayName[bossName]
    local altNb = altName and norm(tostring(altName)) or nil
    local altKey = altNb and (altNb .. "|" .. nd) or nil

    local function bossResCount()
        return (BossResults[bossKey] or 0)
            + (altKey and (BossResults[altKey] or 0) or 0)
            + (BossResults[nb] or 0)
            + (altNb and (BossResults[altNb] or 0) or 0)
            + (BossResults["?"] or 0)
    end

    local accepted = false
    local startsBefore = PerfCache.fightStarts
    local bossResBefore = bossResCount()

    for attempt = 1, (isRemote and 2 or 3) do
        if not shouldContinue() then return false end

        if not isRemote then
            local pos = targetPart.Parent and targetPart.Position or targetModel:GetPivot().Position
            local reached = false
            if useWalk then
                reached = walkNearBoss(pos, attempt, targetModel, shouldContinue,
                    useWalk == "hybrid" and WalkTimeout or nil)
                -- walking failed / timed out (building, wall, stuck): teleport next to the boss instead
                if not reached and useWalk == "hybrid" and shouldContinue() and isCharAlive() then
                    reached = teleportNear(pos, attempt, targetModel)
                end
            else
                reached = teleportNear(pos, attempt, targetModel)
            end
            if not reached then return false end

            task.wait(0.45 + attempt * 0.15)
            if not shouldContinue() then return false end
        elseif attempt > 1 then
            task.wait(0.25)
            if not shouldContinue() then return false end
        end

        local waitWindow = isRemote and 1.2 or 2.0
        if not PerfCache.acquireStart(waitWindow + 0.5, shouldContinue) then return false end
        startsBefore = PerfCache.fightStarts
        bossResBefore = bossResCount()
        local sentAt = os.clock()
        if challengeRemote then
            pcall(function() challengeRemote:FireServer(tostring(bossName), tostring(difficulty)) end)
        end

        local refusedKind
        local t = os.clock()
        while os.clock() - t < waitWindow do
            if PerfCache.refuse.at >= sentAt then
                refusedKind = PerfCache.refuse.kind
                break
            end
            if PerfCache.fightStarts ~= startsBefore
                or bossResCount() ~= bossResBefore
                or isBossOnCooldown(bossName, difficulty) then
                accepted = true
                break
            end
            task.wait(0.05)
        end
        PerfCache.releaseStart()
        if refusedKind then
            if refusedKind == "locked" then
                -- needs a lower difficulty beaten first: no point asking again soon
                PerfCache.failCount[tostring(bossName) .. "|" .. tostring(difficulty)] = 4
            elseif not PerfCache.closerWarned then
                PerfCache.closerWarned = true
                Rayfield:Notify({ Title = "Farm", Content = "A boss refused: Get closer to fight. Farm style 'Remote (World Only)' or 'Teleport' can reach it.", Duration = 8 })
            end
            return false
        end
        if accepted then break end
    end

    if not accepted then return false end

    if WaitForBattle or forceWait then
        -- wait for THIS boss's own result; the tower's named results can't end this wait
        local t = os.clock()
        while bossResCount() == bossResBefore and os.clock() - t < 180 do
            if not shouldContinue() then break end
            task.wait(0.2)
        end
    else
        humanDelay(0.3, 0.5)
    end
    return true
end

-- ==================== Mode management ====================
local function startMode(mode, loopFn)
    ActiveMode = mode
    ActiveWorldKey = mode
    lastTpWorld = nil
    FarmToken += 1
    local myToken = FarmToken

    isSwitchingMode = true
    for m, tog in pairs(ModeToggles) do
        if m ~= mode and tog then pcall(function() tog:Set(false) end) end
    end
    isSwitchingMode = false

    local function alive() return FarmToken == myToken and ActiveMode == mode end
    task.spawn(function()
        -- wait until the config finished loading (so difficulty / boss picks are applied first)
        while alive() and Rayfield.Loading do task.wait(0.3) end
        -- do not start farming until the map is loaded
        local t0 = os.clock()
        while alive() and not (workspace:FindFirstChild("bossNpcs") or workspace:FindFirstChild("KaijuRaid")) and os.clock() - t0 < 120 do
            task.wait(0.5)
        end
        if not alive() then return end
        local ok, err = pcall(loopFn, alive)
        if not ok then warn("farm loop error:", err) end
    end)
end

local function stopMode(mode)
    if isSwitchingMode then return end
    if ActiveMode == mode then
        ActiveMode = nil
        ActiveWorldKey = nil
        FarmToken += 1
    end
end

local function stopAllFarming()
    ActiveMode = nil
    ActiveWorldKey = nil
    FarmToken += 1
    isSwitchingMode = true
    for _, tog in pairs(ModeToggles) do
        if tog then pcall(function() tog:Set(false) end) end
    end
    isSwitchingMode = false
end

