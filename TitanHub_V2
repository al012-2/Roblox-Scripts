            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if AutoJump and ActiveMode and hum and root and hum.Health > 0 then
                if not lastPos or (root.Position - lastPos).Magnitude > 1.5 then
                    lastPos, lastMove = root.Position, os.clock()
                elseif os.clock() - lastMove > 2.5 and os.clock() - lastJump > 1.5 then
                    lastJump = os.clock()
                    pcall(function()
                        hum:ChangeState(Enum.HumanoidStateType.Jumping)
                        hum.Jump = true
                    end)
                end
            else
                lastPos, lastMove = nil, os.clock()
            end
        end
    end)
end

