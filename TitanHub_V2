            local valid = true
            for _, d in ipairs(doorCache) do
                if not d.prompt.Parent then valid = false break end
            end
            if valid then return doorCache end
        end
        doorCacheAt = os.clock()
        local out = {}
        local hw = workspace:FindFirstChild("HalloweenEvent")
        local folder = hw and hw:FindFirstChild("CandyDoors")
        if not folder then return out end
        for _, door in ipairs(folder:GetChildren()) do
            local prompt = door:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                local part = prompt.Parent:IsA("BasePart") and prompt.Parent or door:FindFirstChild("PromptPart")
                table.insert(out, { model = door, prompt = prompt, part = part })
            end
        end
        doorCache = out
        return out
    end

    local function doorsPass(alive)
        local didAny = false
        for _, d in ipairs(collectDoors()) do
            if not alive() then break end
            if d.prompt.Parent and d.prompt.Enabled and os.clock() >= (doorNext[d.model] or 0) then
                local ok, pos = pcall(function()
                    return d.part and d.part.Position or d.model:GetPivot().Position
                end)
                if ok and reachTarget(pos, d.model, alive) and alive() then
                    task.wait(0.3)
                    if fireproximityprompt then
                        pcall(function() fireproximityprompt(d.prompt) end)
                        didAny = true
                        doorNext[d.model] = os.clock() + 32 -- door cooldown is ~30s
                    end
                    task.wait(0.8)
                end
            end
        end
        return didAny
    end

