-- ==================== Raid Shop (auto buy potions) ====================
-- raidShopRequest is a RemoteFunction, captured with Cobalt:
--   InvokeServer("buy", "kaiju", "potions:<Potion Name>")   -> purchase
--   InvokeServer("get", "kaiju")                            -- shop data
-- This spends real in-game currency, so every purchase is capped (see MaxBuys).
-- own scope: adds no top-level locals
do (function()
    local HttpService = game:GetService("HttpService")
    local ShopTab = Window:CreateTab("Raid Shop", 4483362458)

    local shopRemote
    task.spawn(function()
        shopRemote = Rep:WaitForChild("raidShopRequest", 180)
        if not shopRemote then
            warn("[Titan Hub] missing remote: raidShopRequest")
            pcall(function() Rayfield:Notify({ Title = "Missing remote", Content = "raidShopRequest", Duration = 6 }) end)
        end
    end)

    local ShopId = "kaiju"
    -- Skill Tree Reset and Weather Reroll are in the shop too, but are NOT buyable from this tab on purpose
    local BuyNames = {
        "Luck Potion I", "Luck Potion II", "Luck Potion III", "Luck Potion IV",
        "Speed Potion I", "Speed Potion II", "Speed Potion III", "Speed Potion IV",
        "Battle Potion I", "Battle Potion II", "Battle Potion III", "Battle Potion IV",
        "Boss Potion", "Raid Potion",
    }
    local Selected = {}
    local MaxBuys = 5                  -- max purchases per potion per restock cycle (the shop shows 5/5)
    local CYCLE = 4 * 3600 + 60        -- the shop restocks about every 4 hours
    local RETRY_AFTER_FAIL = 900       -- after a refused purchase, wait this long before trying that potion again
    local buyToken = 0

    -- survives re-execute / server hop in the same executor session (best effort)
    getgenv().TitanShop = getgenv().TitanShop or { bought = {}, nextTry = {}, cycleStart = os.time() }
    local State = getgenv().TitanShop

    table.insert(activeConnections, { Disconnect = function() buyToken += 1 end })

    local function rollCycle()
        if os.time() - State.cycleStart >= CYCLE then
            State.bought, State.nextTry, State.cycleStart = {}, {}, os.time()
        end
    end

    local function show(v)
        if type(v) == "table" then
            local ok, s = pcall(function() return HttpService:JSONEncode(v) end)
            if ok then return s end
        end
        return tostring(v)
    end

    -- explicit refusals only; a nil / true / data reply counts as an attempt (bounded by MaxBuys anyway)
    local function refused(res)
        if res == false then return true end
        if type(res) == "table" and (res.success == false or res.ok == false or res.error ~= nil) then return true end
        if type(res) == "string" then
            local s = res:lower()
            for _, kw in ipairs({ "not enough", "out of stock", "sold out", "insufficient", "fail", "error", "cannot", "invalid" }) do
                if s:find(kw, 1, true) then return true end
            end
        end
        return false
    end

    local function buyOne(name)
        if not shopRemote then return false, "remote not ready" end
        local ok, res = pcall(function() return shopRemote:InvokeServer("buy", ShopId, "potions:" .. name) end)
        if not ok then return false, tostring(res) end
        warn("[Raid Shop] " .. name .. " -> " .. show(res))
        if refused(res) then return false, res end
        return true, res
    end

    local function hasSelection() return next(Selected) ~= nil end

    local function buyCycle(alive)
        rollCycle()
        local total = 0
        for _, name in ipairs(BuyNames) do
            if Selected[name] then
                while alive() and (State.bought[name] or 0) < MaxBuys and (State.nextTry[name] or 0) <= os.time() do
                    local ok = buyOne(name)
                    if ok then
                        State.bought[name] = (State.bought[name] or 0) + 1
                        total += 1
                        task.wait(0.7)
                    else
                        State.nextTry[name] = os.time() + RETRY_AFTER_FAIL
                        break
                    end
                end
            end
        end
        return total
    end

    local function dump(v, indent, depth)
        indent, depth = indent or "", depth or 0
        if type(v) ~= "table" or depth > 4 then
            print(indent .. tostring(v))
            return
        end
        for k, x in pairs(v) do
            if type(x) == "table" then
                print(indent .. tostring(k) .. " = {")
                dump(x, indent .. "  ", depth + 1)
                print(indent .. "}")
            else
                print(indent .. tostring(k) .. " = " .. tostring(x))
            end
        end
    end

    ShopTab:CreateSection("Potions to buy")

    ShopTab:CreateDropdown({
        Name = "Buy these potions",
        Options = BuyNames,
        CurrentOption = {},
        MultipleOptions = true,
        Flag = "ShopPotionsPick",
        Callback = function(list)
            Selected = {}
            for _, n in ipairs(list) do Selected[n] = true end
        end,
    })

    ShopTab:CreateInput({
        Name = "Max buys per potion per restock",
        Default = "5",
        Placeholder = "e.g. 5",
        Flag = "ShopMaxBuys",
        Callback = function(v)
            MaxBuys = math.clamp(math.floor(tonumber(v) or 5), 1, 50)
        end,
    })

    ShopTab:CreateSection("Buy")

    ShopTab:CreateButton({
        Name = "Buy selected now (1 of each)",
        Callback = function()
            if not hasSelection() then
                Rayfield:Notify({ Title = "Shop", Content = "Pick at least one potion first", Duration = 3 })
                return
            end
            task.spawn(function()
                rollCycle()
                local n = 0
                for _, name in ipairs(BuyNames) do
                    if Selected[name] then
                        if buyOne(name) then
                            State.bought[name] = (State.bought[name] or 0) + 1
                            n += 1
                        end
                        task.wait(0.7)
                    end
                end
                Rayfield:Notify({ Title = "Shop", Content = "Purchase accepted for " .. n .. " potion(s)", Duration = 4 })
            end)
        end,
    })

    ShopTab:CreateToggle({
        Name = "Auto buy selected potions",
        CurrentValue = false,
        Flag = "AutoBuyShopPotions",
        Callback = function(Value)
            buyToken += 1
            local myToken = buyToken
            if not Value then return end
            local function alive() return buyToken == myToken end
            task.spawn(function()
                while alive() and Rayfield.Loading do task.wait(0.3) end
                while alive() do
                    if hasSelection() then
                        local n = buyCycle(alive)
                        if n > 0 then
                            Rayfield:Notify({ Title = "Shop", Content = "Bought " .. n .. " potion(s) from the Kaiju Raid shop", Duration = 4 })
                        end
                    end
                    task.wait(60)
                end
            end)
        end,
    })

    ShopTab:CreateButton({
        Name = "Reset buy counters",
        Callback = function()
            State.bought, State.nextTry, State.cycleStart = {}, {}, os.time()
            Rayfield:Notify({ Title = "Shop", Content = "Counters reset", Duration = 3 })
        end,
    })

    ShopTab:CreateSection("Debug")

    ShopTab:CreateButton({
        Name = "Print shop data (F9)",
        Callback = function()
            task.spawn(function()
                if not shopRemote then
                    Rayfield:Notify({ Title = "Shop", Content = "raidShopRequest not ready", Duration = 3 })
                    return
                end
                local ok, data = pcall(function() return shopRemote:InvokeServer("get", ShopId) end)
                print("[Raid Shop] get ok:", ok)
                dump(data)
                Rayfield:Notify({ Title = "Shop", Content = "Shop data printed in the F9 console", Duration = 4 })
            end)
        end,
    })

    ShopTab:CreateParagraph({
        Title = "Spends currency",
        Content = "Each purchase costs raid-shop currency. Buying stops at the max per restock, and a refused purchase pauses that potion for 15 minutes.",
    })
end)() end

-- ==================== Crafting (auto craft potions) ====================
-- craftItem is a RemoteEvent, captured with Cobalt:
--   FireServer("craft", "<Potion Name>", amount)
-- Stock is read from the game's Inventory UI (confirmed with the F9 dump):
--   PlayerGui.Inventory.InventoryFrame.itemsFrame.CollectionFrame.itemScroll.<Potion Name>.quantityLabel  ("43x")
-- A potion is crafted only when its stock is below "Keep at least". If the stock cannot be read,
-- that potion is SKIPPED (never crafted blindly), so materials are not wasted.
-- own scope: adds no top-level locals
do (function()
    local CraftTab = Window:CreateTab("Crafting", 4483362458)

    local craftRemote
    task.spawn(function()
        craftRemote = Rep:WaitForChild("craftItem", 180)
        if not craftRemote then
            warn("[Titan Hub] missing remote: craftItem")
            pcall(function() Rayfield:Notify({ Title = "Missing remote", Content = "craftItem", Duration = 6 }) end)
        end
    end)

    -- Skill Tree Reset and Weather Reroll are not potions to craft, so they are not listed
    local CraftNames = {
        "Luck Potion I", "Luck Potion II", "Luck Potion III", "Luck Potion IV",
        "Speed Potion I", "Speed Potion II", "Speed Potion III", "Speed Potion IV",
        "Battle Potion I", "Battle Potion II", "Battle Potion III", "Battle Potion IV",
        "Boss Potion", "Raid Potion",
    }
    local Selected = {}
    local Amount = 1          -- max amount per craft request
    local MinStock = 50       -- keep at least this many of each selected potion
    local IntervalMin = 10    -- how often the auto mode checks the stock
    local craftToken = 0

    -- survives re-execute / server hop in the same executor session (best effort)
    getgenv().TitanCraftLast = getgenv().TitanCraftLast or {}
    local lastCraft = getgenv().TitanCraftLast

    table.insert(activeConnections, { Disconnect = function() craftToken += 1 end })

    -- how many of this potion you own, or nil if the Inventory UI cannot be read right now
    local function getStock(name)
        local node = player:FindFirstChild("PlayerGui")
        for _, nm in ipairs({ "Inventory", "InventoryFrame", "itemsFrame", "CollectionFrame", "itemScroll" }) do
            node = node and node:FindFirstChild(nm)
        end
        if not node then return nil end

        -- only trust a populated list (an empty list means the UI has not been built yet)
        local populated = false
        for _, c in ipairs(node:GetChildren()) do
            if c:IsA("Frame") then populated = true break end
        end
        if not populated then return nil end

        local cell = node:FindFirstChild(name)
        if not cell then return 0 end   -- the inventory lists only items you own

        local lbl = cell:FindFirstChild("quantityLabel", true)
        if not (lbl and lbl:IsA("TextLabel")) then return nil end
        local txt = tostring(lbl.Text):gsub("<[^>]+>", "")
        txt = txt:gsub(",", "")
        local n = txt:match("(%d+)")
        return n and tonumber(n) or nil
    end

    local function craftOne(name, amt)
        if not craftRemote then return false end
        local ok = pcall(function() craftRemote:FireServer("craft", name, amt) end)
        if ok then
            lastCraft[name] = os.time()
            if PerfCache.onCraft then PerfCache.onCraft(amt) end -- Live Tracker
        end
        return ok
    end

    local function hasSelection() return next(Selected) ~= nil end

    -- crafts every selected potion that is below MinStock. Returns (requests sent, potions skipped as unreadable)
    local function craftDue()
        local sent, unreadable = 0, 0
        for _, name in ipairs(CraftNames) do
            if Selected[name] then
                local stock = getStock(name)
                if stock == nil then
                    unreadable += 1
                elseif stock < MinStock then
                    local last = lastCraft[name]
                    -- never hit the same potion twice within 15 seconds
                    if not last or os.time() - last >= 15 then
                        -- never craft more than what is missing to reach MinStock
                        local amt = math.min(Amount, MinStock - stock)
                        if craftOne(name, amt) then sent += 1 end
                        task.wait(0.6)
                    end
                end
            end
        end
        return sent, unreadable
    end

    CraftTab:CreateSection("Potions to craft")

    CraftTab:CreateDropdown({
        Name = "Craft these potions",
        Options = CraftNames,
        CurrentOption = {},
        MultipleOptions = true,
        Flag = "CraftPotionsPick",
        Callback = function(list)
            Selected = {}
            for _, n in ipairs(list) do Selected[n] = true end
        end,
    })

    CraftTab:CreateInput({
        Name = "Keep at least (stock)",
        Default = "50",
        Placeholder = "e.g. 50",
        Flag = "CraftMinStock",
        Callback = function(v)
            MinStock = math.clamp(math.floor(tonumber(v) or 50), 1, 100000)
        end,
    })

    CraftTab:CreateInput({
        Name = "Max amount per craft request",
        Default = "1",
        Placeholder = "e.g. 1",
        Flag = "CraftAmount",
        Callback = function(v)
            Amount = math.clamp(math.floor(tonumber(v) or 1), 1, 50)
        end,
    })

    CraftTab:CreateSection("Craft")

    CraftTab:CreateButton({
        Name = "Craft selected now (only below stock)",
        Callback = function()
            if not hasSelection() then
                Rayfield:Notify({ Title = "Crafting", Content = "Pick at least one potion first", Duration = 3 })
                return
            end
            if not craftRemote then
                Rayfield:Notify({ Title = "Crafting", Content = "craftItem remote not ready", Duration = 3 })
                return
            end
            task.spawn(function()
                local sent, unreadable = craftDue()
                local msg = "Sent " .. sent .. " craft request(s)"
                if unreadable > 0 then
                    msg = msg .. " | could not read the stock of " .. unreadable .. " (skipped)"
                end
                Rayfield:Notify({ Title = "Crafting", Content = msg, Duration = 5 })
            end)
        end,
    })

    CraftTab:CreateInput({
        Name = "Check stock every (minutes)",
        Default = "10",
        Placeholder = "e.g. 10",
        Flag = "CraftIntervalMin",
        Callback = function(v)
            IntervalMin = math.clamp(math.floor(tonumber(v) or 10), 1, 1440)
        end,
    })

    CraftTab:CreateToggle({
        Name = "Auto craft selected potions",
        CurrentValue = false,
        Flag = "AutoCraftPotions",
        Callback = function(Value)
            craftToken += 1
            local myToken = craftToken
            if not Value then return end
            task.spawn(function()
                while craftToken == myToken and Rayfield.Loading do task.wait(0.3) end
                local warnedUnread = false
                while craftToken == myToken do
                    if hasSelection() and craftRemote then
                        local sent, unreadable = craftDue()
                        if sent > 0 then
                            Rayfield:Notify({ Title = "Crafting", Content = "Sent " .. sent .. " craft request(s)", Duration = 4 })
                        end
                        if unreadable > 0 and not warnedUnread then
                            warnedUnread = true
                            Rayfield:Notify({
                                Title = "Crafting",
                                Content = "Could not read the stock of " .. unreadable .. " potion(s) - skipped (open the Inventory once)",
                                Duration = 6,
                            })
                        elseif unreadable == 0 then
                            warnedUnread = false
                        end
                    end
                    -- wait in 1s steps so turning the toggle off reacts immediately
                    local waited = 0
                    while craftToken == myToken and waited < IntervalMin * 60 do
                        task.wait(1)
                        waited += 1
                    end
                end
            end)
        end,
    })

    CraftTab:CreateSection("Debug")

    CraftTab:CreateButton({
        Name = "Print potion stock (F9)",
        Callback = function()
            print("[Crafting] stock read from the Inventory UI (nil = cannot read):")
            for _, name in ipairs(CraftNames) do
                print(("  %-18s %s"):format(name, tostring(getStock(name))))
            end
            Rayfield:Notify({ Title = "Crafting", Content = "Stock printed in the F9 console", Duration = 4 })
        end,
    })

    CraftTab:CreateParagraph({
        Title = "Spends materials",
        Content = "Only potions below 'Keep at least' are crafted, and never more than what is missing. The server refuses a craft you cannot afford.",
    })
end)() end

-- ==================== Offline rolls: auto collect ====================
do (function()
    local token = 0
    table.insert(activeConnections, { Disconnect = function() token += 1 end })

    local function visible(o)
        local n = o
        while n and n ~= game do
            if n:IsA("GuiObject") and not n.Visible then return false end
            if n:IsA("ScreenGui") and not n.Enabled then return false end
            n = n.Parent
        end
        return true
    end

    -- the WELCOME BACK window only shows after joining, so the watcher gives up after 90s
    local function start()
        token += 1
        local my = token
        task.spawn(function()
            local t0, tries = os.clock(), 0
            while token == my and os.clock() - t0 < 90 and tries < 3 do
                local ok, btn = pcall(function() return player.PlayerGui.OfflineUI.panel.collect end)
                if ok and btn and btn:IsA("GuiButton") and visible(btn) then
                    task.wait(1)
                    tries += 1
                    pressButton(btn)
                    task.wait(2)
                    if not visible(btn) then
                        Rayfield:Notify({ Title = "Offline rolls", Content = "Collected", Duration = 3 })
                        return
                    end
                end
                task.wait(1)
            end
        end)
    end

