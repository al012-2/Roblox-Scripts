-- small shared helpers for this part
local function xNotify(title, text, dur)
    pcall(function() Rayfield:Notify({ Title = title, Content = tostring(text), Duration = dur or 4 }) end)
end

-- runs fn(alive) in a loop every `every` seconds while the toggle is on
local function makeLoop(every, fn)
    local token = 0
    table.insert(activeConnections, { Disconnect = function() token += 1 end })
    return function(on)
        token += 1
        if not on then return end
        local my = token
        local function alive() return token == my end
        task.spawn(function()
            while Rayfield.Loading and alive() do task.wait(0.3) end
            while alive() do
                local ok, err = pcall(fn, alive)
                if not ok then warn("[Titan Hub] loop error: " .. tostring(err)) end
                local t = 0
                while alive() and t < every do task.wait(1) t += 1 end
            end
        end)
    end
end

-- same as makeLoop, but does nothing until auto-spending is allowed for this session
local function makeSpendLoop(every, fn)
    return makeLoop(every, function(alive)
        if Rayfield.SpendArmed then return fn(alive) end
    end)
end

