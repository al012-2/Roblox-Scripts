        "ShadowShopAuto", "DealerAuto", "ScrapShopAuto", "FuserAuto", "AwakeningAuto", "AutoDailyGroup", "AutoBuyCandyShopPotions",
    }

    -- PAUSE only: each active toggle's own callback is called with false to stop its loop,
    -- but the toggles themselves (and the saved config) are NOT touched.
    local function runCallbacks(value)
        for _, flag in ipairs(StopFlags) do
            local t = LToggles[flag]
            if t and t.Value and type(t.Callback) == "function" then
                pcall(t.Callback, value)
            end
        end
    end

