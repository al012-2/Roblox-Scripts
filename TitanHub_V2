-- ==================== Card Awakening (awakeningClient) ====================
-- awakeningAction:InvokeServer("info", cardKey)  -> ok, info { awakened, have, cost, costItem }  (or false, message)
-- awakeningAction:InvokeServer("start", cardKey) -> starts the trial battle (costs Heroic Embers, 6h rest per card)
-- only cards rarer than 1 in 10M can be awakened
do
    local MIN_WEIGHT = 10000000
    local tried = {} -- key -> os.time() of the next allowed try (so we don't spam the same card)

    local function inventory()
        local ok, inv = pcall(function()
            local mod = player.PlayerScripts:FindFirstChild("InventoryManagerClient")
            return mod and require(mod).getInventory()
        end)
        return ok and type(inv) == "table" and inv or {}
    end

    local function awakenedSet()
        local set = {}
        pcall(function()
            local list = game:GetService("HttpService"):JSONDecode(player:GetAttribute("AwakenedKeys") or "[]")
            for _, k in pairs(list) do set[k] = true end
        end)
        return set
    end

    local function inBattle()
        local ok, gui = pcall(function() return player.PlayerGui:FindFirstChild("BattleUI") end)
        return ok and gui and gui.Enabled
    end

    -- starts at most ONE trial per call (a trial is a battle)
    local function awakenPass()
        local remote = Rep:FindFirstChild("awakeningAction")
        if not remote then return false, "awakeningAction not found" end
        if player:GetAttribute("Feature_awakening") ~= true then return false, "Awakening is not unlocked yet" end
        if inBattle() then return false, "in a battle right now" end
        local done = awakenedSet()
        local list = {}
        for key, card in pairs(inventory()) do
            local w = type(card) == "table" and tonumber(card.Weight) or 0
            if w >= MIN_WEIGHT and not done[key] and os.time() >= (tried[key] or 0) then
                table.insert(list, { key = key, w = w })
            end
        end
        table.sort(list, function(a, b) return a.w > b.w end) -- rarest first
        for i, c in ipairs(list) do
            if i > 25 then break end
            tried[c.key] = os.time() + 300 -- not ready / no answer: look again in 5 min
            -- returns ok, info (or ok=false, message)
            local ok, okI, inf = pcall(remote.InvokeServer, remote, "info", c.key)
            if ok and okI and type(inf) == "table" and inf.eligible ~= false and not inf.awakened
                and (tonumber(inf.have) or 0) >= (tonumber(inf.cost) or math.huge) then
                local okS, okStart, smsg
                tried[c.key] = os.time() + 1800
                PerfCache.sendAndWaitBattle(function()
                    okS, okStart, smsg = pcall(remote.InvokeServer, remote, "start", c.key)
                end, 2)
                if okS and okStart then return true, tostring(c.key) end
                if smsg then warn("[Awakening] " .. tostring(c.key) .. ": " .. tostring(smsg)) end
            end
            task.wait(0.4)
        end
        return false, "no card ready (embers / resting)"
    end

    local AwTab = Window:CreateTab("Awakening", 4483362458)
    AwTab:CreateSection("Card Awakening")
    AwTab:CreateToggle({
        Name = "Auto start awakening trials",
        CurrentValue = false,
        Flag = "AwakeningAuto",
        Callback = makeSpendLoop(120, function()
            local ok, what = awakenPass()
            if ok then xNotify("Awakening", "Started trial: " .. what, 5) end
        end),
    })
    AwTab:CreateButton({
        Name = "Start one trial now",
        Callback = function()
            task.spawn(function()
                local ok, what = awakenPass()
                xNotify("Awakening", ok and ("Started trial: " .. what) or ("Can't: " .. tostring(what)), 5)
            end)
        end,
    })
    AwTab:CreateParagraph({
        Title = "Info",
        Content = "Checks your rarest cards (rarer than 1 in 10M) and starts a trial when you have enough Heroic Embers (5 / 10 / 15). A trial is a battle, so it can pause farming for a moment. Each card rests 6 hours after a try.",
    })
end

