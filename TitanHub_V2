                    lastPos, lastMove = root.Position, os.clock()
                elseif os.clock() - lastMove > 2.5 and os.clock() - lastJump > 1.5 then
                    lastJump = os.clock()
                    pcall(function()
                        hum:ChangeState(Enum.HumanoidStateType.Jumping)
                        hum.Jump = true
                    end)
                end
            else
                lastPos, lastMove = nil, os.clock()
