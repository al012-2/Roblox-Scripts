        if not SecretIdOf[name] then table.insert(SecretNames, name) end
        SecretIdOf[name] = id
        BossDisplayName[id] = name
    end

    local function refreshSecret()
        local bn = workspace:FindFirstChild("bossNpcs")
        local f = bn and bn:FindFirstChild("secretBosses")
        if not f then return end
        for _, m in ipairs(f:GetChildren()) do
            if m:IsA("Model") then
                local inner = m:FindFirstChild(m.Name)
                local id = m:GetAttribute("bossId") or (inner and inner:GetAttribute("bossId"))
                    or (m.Name:lower():gsub("%s+", "_"))
                addSecret(m.Name, id)
            end
        end
