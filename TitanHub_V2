-- ==================== Halloween Upgrades (halloweenUpgradesClient) ====================
-- halloweenUpgrade:InvokeServer("buy", id) -> ok, message      ids: luck / speed / candy (max 20 each)
-- level = attribute HwUpgrade_<id>, candies = attribute Candies, price = base * growth ^ level (rounded)
do
    local Upgrades = {
        { id = "luck",  name = "Luck",         base = 2000, growth = 1.4, max = 20 },
        { id = "speed", name = "Battle Speed", base = 1000, growth = 1.4, max = 20 },
        { id = "candy", name = "Candy Gain",   base = 3000, growth = 1.4, max = 20 },
    }
    local Names, ById = {}, {}
    for _, u in ipairs(Upgrades) do table.insert(Names, u.name); ById[u.name] = u end
    local Picked = { ["Luck"] = true, ["Battle Speed"] = true, ["Candy Gain"] = true }

    local function priceOf(u, level)
        local v = u.base * u.growth ^ level
        local step = 10 ^ math.max(0, math.floor(math.log10(v)) - 1)
        return math.floor(v / step + 0.5) * step
    end

    -- buys the cheapest picked upgrade we can afford, again and again
    local function buyUpgrades(alive)
        local remote = Rep:FindFirstChild("halloweenUpgrade")
        if not remote or not inHalloween() then return 0 end
        local bought = 0
        for _ = 1, 60 do
            if alive and not alive() then break end
            local best, bestPrice
            for _, name in ipairs(Names) do
                local u = ById[name]
                local lvl = player:GetAttribute("HwUpgrade_" .. u.id) or 0
                if Picked[name] and lvl < u.max then
                    local p = priceOf(u, lvl)
                    if not bestPrice or p < bestPrice then best, bestPrice = u, p end
                end
            end
            if not best or (player:GetAttribute("Candies") or 0) < bestPrice then break end
            local ok, res, msg = pcall(remote.InvokeServer, remote, "buy", best.id)
            if not (ok and res) then
                if msg then warn("[Halloween Upgrades] " .. tostring(msg)) end
                break
            end
            bought += 1
            task.wait(0.6)
        end
        return bought
    end

