local function executeRejoin()
    rejoinAttempt += 1
    queueReload()

    local requestRejoinRemote = Rep:FindFirstChild("requestRejoin")
    if rejoinAttempt == 1 and requestRejoinRemote then
        pcall(function() requestRejoinRemote:FireServer() end)
        task.wait(1.5)
    end

    if rejoinAttempt == 1 and game.JobId ~= "" then
        pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
        end)
    else
        pcall(function()
            TeleportService:Teleport(game.PlaceId, player)
        end)
    end
end

