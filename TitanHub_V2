    local PotionInterval = 300   -- fallback: seconds one drink lasts (used only when the HUD timer cannot be read)
    local RefillBelow = 10       -- drink again when less than this many seconds remain
    local WeatherMin = 120       -- on a chosen weather, every potion needs at least this many seconds left
    local PrepMin = 30           -- before ending the tower, every prep potion needs at least this many seconds left
    local PotionAmount = 1
    local WeatherGuard = 180     -- do not re-trigger the weather check for the same weather within this time
    local potionToken, weatherPotionToken = 0, 0

    -- survive re-execute / server hop in the same executor session (best effort)
    getgenv().TitanPotionLast = getgenv().TitanPotionLast or {}
    getgenv().TitanPotionWeatherLast = getgenv().TitanPotionWeatherLast or {}
    getgenv().TitanPotionSeen = getgenv().TitanPotionSeen or {}
    local lastDrink = getgenv().TitanPotionLast
    local lastWeather = getgenv().TitanPotionWeatherLast
    local seenInHud = getgenv().TitanPotionSeen

    -- ===== read the potion timers from the HUD =====
    local IconMap = {}                                  -- icon image key -> potion name (learned from the shop cells)
    local hudState = setmetatable({}, { __mode = "k" }) -- label -> { v, t, ticks }
    local hudList, hudUnmapped = {}, {}
    local hudListAt, hudReadAt = 0, 0
    local hudTimers, hudWorks = {}, false
    local hudRows, learnAt = {}, 0

    local function iconKey(img)
        return tostring(img.Image) .. "|" .. tostring(img.ImageRectOffset)
    end

    local function countMap()
        local c = 0
        for _ in pairs(IconMap) do c += 1 end
        return c
    end

    -- "21986" -> 21986, "5:00" -> 300, "1:02:03" -> 3723
    local function parseSeconds(txt)
        local t = tostring(txt or "")
        t = t:gsub("<[^>]+>", "")
        t = t:gsub("[,%s]", "")
        if t == "" then return nil end
        if t:match("^%d+%.?%d*$") then return tonumber(t) end
        local a, b, c = t:match("^(%d+):(%d+):?(%d*)$")
        if a then
            if c ~= "" then return tonumber(a) * 3600 + tonumber(b) * 60 + tonumber(c) end
            return tonumber(a) * 60 + tonumber(b)
        end
        return nil
    end

    local function isShown(obj)
        local node = obj
        while node do
            if node:IsA("GuiObject") and not node.Visible then return false end
            if node:IsA("ScreenGui") and not node.Enabled then return false end
            node = node.Parent
        end
        return true
    end

    -- the potion icon of every shop cell; an image used by several cells (currency, background) is ignored
    local function learnIcons()
        local node = player:FindFirstChild("PlayerGui")
        for _, nm in ipairs({ "NpcInteraction", "RaidShopFrame", "contentFrame", "scrollFrame", "potions:", "cells" }) do
            node = node and node:FindFirstChild(nm)
        end
        if not node then return 0 end
        local perCell, keyCount = {}, {}
        for _, cell in ipairs(node:GetChildren()) do
            local pname = cell.Name:match("^potions:(.+)$")
            if pname then
                perCell[pname] = {}
                for _, d in ipairs(cell:GetDescendants()) do
                    if (d:IsA("ImageLabel") or d:IsA("ImageButton")) and d.Image ~= "" then
                        perCell[pname][iconKey(d)] = true
                    end
                end
            end
        end
        for _, set in pairs(perCell) do
            for key in pairs(set) do keyCount[key] = (keyCount[key] or 0) + 1 end
        end
        IconMap = {}
        for pname, set in pairs(perCell) do
            for key in pairs(set) do
                if keyCount[key] == 1 then IconMap[key] = pname end
            end
        end
        return countMap()
    end

    -- the small icon cell around a number label: returns the image and whether it is a known potion icon
    local function findIcon(label)
        local node = label
        local firstAny
        for _ = 1, 4 do
            node = node.Parent
            if not node or not node:IsA("GuiObject") then break end
            local s = node.AbsoluteSize
            if s.X > 220 or s.Y > 220 then break end
            local pool = { node }
            for _, d in ipairs(node:GetDescendants()) do pool[#pool + 1] = d end
            for _, o in ipairs(pool) do
                if (o:IsA("ImageLabel") or o:IsA("ImageButton")) and o.Image ~= "" then
                    if IconMap[iconKey(o)] then return o, true end
                    firstAny = firstAny or o
                end
            end
        end
        return firstAny, false
    end

    local function rebuildList()
        hudListAt = tick()
        hudList, hudUnmapped = {}, {}
        local pgui = player:FindFirstChild("PlayerGui")
        if not pgui then return end
        if next(IconMap) == nil then learnIcons() end
        for _, d in ipairs(pgui:GetDescendants()) do
            if d:IsA("TextLabel") and parseSeconds(d.Text) ~= nil and isShown(d) then
                local img, mapped = findIcon(d)
                if img then
                    if mapped then
                        table.insert(hudList, { label = d, img = img })
                    elseif #hudUnmapped < 40 then
                        table.insert(hudUnmapped, { label = d, img = img })
                    end
                end
            end
        end
    end

    -- ===== PlayerGui.Main.activeEffectsHolder.activeEffects: the game's own list of active effects =====
    local function getEffectsContainer()
        local pgui = player:FindFirstChild("PlayerGui")
        local main = pgui and pgui:FindFirstChild("Main")
        local holder = main and main:FindFirstChild("activeEffectsHolder")
        return holder and holder:FindFirstChild("activeEffects")
    end

    -- which potion is this effect? name / attributes / text first (longest match wins, so IV is not read as I),
    -- then the icon image
    local function identify(child, img)
        local cands = { child.Name }
        for _, v in pairs(child:GetAttributes()) do
            if type(v) == "string" then cands[#cands + 1] = v end
        end
        for _, d in ipairs(child:GetDescendants()) do
            if d:IsA("TextLabel") and d.Text ~= "" and parseSeconds(d.Text) == nil then cands[#cands + 1] = d.Text end
        end
        local best, bestLen
        for _, c in ipairs(cands) do
            local n = norm((tostring(c):gsub("^potions:", "")))
            for _, pname in ipairs(PotionNames) do
                local pn = norm(pname)
                if n:find(pn, 1, true) and (not bestLen or #pn > bestLen) then best, bestLen = pname, #pn end
            end
        end
        if best then return best end
        if img then return IconMap[iconKey(img)] end
        return nil
    end

    local function readEffects(container)
        local timers, works, rows = {}, false, {}
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("GuiObject") then
                local bestV, img, exact
                local pool = { child }
                for _, d in ipairs(child:GetDescendants()) do pool[#pool + 1] = d end
                for _, o in ipairs(pool) do
                    if o:IsA("TextLabel") then
                        local v = parseSeconds(o.Text)
                        if v and o.Name == "timeLeftLabel" then
                            bestV, exact = v, true   -- the game's own timer label
                        elseif v and not exact and (not bestV or v > bestV) then
                            bestV = v
                        end
                    elseif (o:IsA("ImageLabel") or o:IsA("ImageButton")) and o.Image ~= "" then
                        if not img or IconMap[iconKey(o)] then img = o end
                    end
                end
                local name = identify(child, img)
                table.insert(rows, { child = child, value = bestV, potion = name })
                if name and bestV then
                    timers[name] = math.max(timers[name] or 0, bestV)
                    works = true
                end
            end
        end
        return timers, works, rows
    end

    -- ===== direct server active effects via sendUI("updateActiveEffects", data) =====
    local serverEffects, serverEffectsAt = {}, 0
    onRemoteEvent("sendUI", function(action, data)
        if action ~= "updateActiveEffects" or type(data) ~= "table" then return end
        local map = {}
        for k, info in pairs(data) do
            local pname = (type(info) == "table" and info.itemName) or k
            local d = type(info) == "table" and tonumber(info.duration) or nil
            if type(pname) == "string" and d then
                map[pname] = d
                seenInHud[pname] = true
            end
        end
        serverEffects = map
        serverEffectsAt = tick()
    end)

    -- returns { [potion name] = seconds left }, and whether at least one real (ticking) timer was read.
    -- A label counts as a timer only after it was seen counting down, so item counts are never mistaken for time.
    local function readHud(force)
        if serverEffectsAt > 0 and tick() - serverEffectsAt < 5 then
            return serverEffects, true
        end
        if not force and tick() - hudReadAt < 1.5 then return hudTimers, hudWorks end
        hudReadAt = tick()
        local container = getEffectsContainer()
        if container then
            if next(IconMap) == nil and tick() - learnAt > 10 then
                learnAt = tick()
                learnIcons()
            end
            local timers, works, rows = readEffects(container)
            hudRows = rows
            for name in pairs(timers) do seenInHud[name] = true end
            if not works and next(seenInHud) ~= nil then works = true end
            hudTimers, hudWorks = timers, works
            return timers, works
        end
        if tick() - hudListAt > 20 then rebuildList() end
        local timers, works = {}, false
        local now = tick()
        for _, e in ipairs(hudList) do
            local label, img = e.label, e.img
            if label.Parent and img.Parent then
                local v = parseSeconds(label.Text)
                local name = IconMap[iconKey(img)]
                if v and name then
                    local st = hudState[label]
                    if not st then
                        st = { v = v, t = now, ticks = 0 }
                        hudState[label] = st
                    else
                        local dt = now - st.t
                        if dt >= 0.8 then
                            if v < st.v and math.abs((st.v - v) - dt) <= 2.5 then st.ticks += 1 end
                            st.v, st.t = v, now
                        end
                    end
                    if st.ticks >= 2 and isShown(label) then
                        timers[name] = math.max(timers[name] or 0, v)
                        works = true
                        seenInHud[name] = true
                    end
                end
            end
        end
        hudTimers, hudWorks = timers, works
        return timers, works
    end

    -- reads the timers; the generic fallback scan needs a few seconds to see the numbers counting down
    local function warmHud()
        hudListAt = 0
        readHud(true)
        if not getEffectsContainer() then
            task.wait(2)
            readHud(true)
            task.wait(2)
        end
        return readHud(true)
    end

    local function fmtTime(s)
        s = math.floor(s)
        local h, m = math.floor(s / 3600), math.floor((s % 3600) / 60)
        if h > 0 then return h .. "h " .. m .. "m" end
        if m > 0 then return m .. "m " .. (s % 60) .. "s" end
        return s .. "s"
    end

    -- seconds left on a potion
    local function remainingOf(name)
        local dur = CustomDuration[name] or PotionInterval
        local timers, works = readHud()
        local last = lastDrink[name]
        local since = last and (os.time() - last) or math.huge
        local hud = timers[name]
        if hud then return hud end
        if works and seenInHud[name] then
            -- this potion's timer is normally visible, so "no icon" means it ran out
            if since < 6 then return dur end -- just drunk, the HUD can lag a moment
            return 0
        end
        -- icon never seen / HUD unreadable: fall back to our own drink time
        if last then return math.max(dur - since, 0) end
        return 0
    end

    local function drink(name)
        if not useItemRemote then return false end
        local ok = pcall(function() useItemRemote:FireServer(name, PotionAmount) end)
        if ok then
            lastDrink[name] = os.time()
            if PerfCache.onPotion then PerfCache.onPotion(PotionAmount) end -- Live Tracker
            hudListAt, hudReadAt = 0, 0 -- a new icon may appear: rescan soon
        end
        return ok
    end

    local function hasSelection()
        return next(SelectedPotions) ~= nil
    end

    -- drinks every potion in `set` that has less than `minRemaining` seconds left.
    -- minRemaining = math.huge means "drink all of them now".
    -- The same potion is never drunk twice within 20 seconds (unless forced).
    local function ensure(set, minRemaining)
        local n = 0
        for _, name in ipairs(PotionNames) do
            if set[name] then
                local last = lastDrink[name]
                local since = last and (os.time() - last) or math.huge
                if (minRemaining == math.huge or since >= 20) and remainingOf(name) < minRemaining then
                    if drink(name) then n += 1 end
                    task.wait(0.25)
                end
            end
        end
        return n
    end

    table.insert(activeConnections, { Disconnect = function()
        potionToken += 1
        weatherPotionToken += 1
    end })

    PotionsTab:CreateSection("Potion Selection")

    PotionsTab:CreateDropdown({
        Name = "Select Potions to Use",
        Options = PotionNames,
        CurrentOption = {},
        MultipleOptions = true,
        Flag = "SelectedPotionsList",
        Callback = function(list)
            SelectedPotions = {}
            for _, name in ipairs(list) do SelectedPotions[name] = true end
        end,
    })

    PotionsTab:CreateInput({
        Name = "Amount per use",
        Default = "1",
        Placeholder = "e.g. 1",
        Flag = "PotionUseAmount",
        Callback = function(v)
            PotionAmount = math.clamp(math.floor(tonumber(v) or 1), 1, 100)
        end,
    })

    PotionsTab:CreateButton({
        Name = "Drink Selected Potions Now",
        Callback = function()
            if not hasSelection() then
                Rayfield:Notify({ Title = "Potions", Content = "Pick at least one potion first", Duration = 3 })
                return
            end
            if not useItemRemote then
                Rayfield:Notify({ Title = "Potions", Content = "useItem remote not ready", Duration = 3 })
                return
            end
            task.spawn(function()
                local n = ensure(SelectedPotions, math.huge)
                Rayfield:Notify({ Title = "Potions", Content = "Sent " .. n .. " potion request(s)", Duration = 3 })
            end)
        end,
    })

    PotionsTab:CreateButton({
        Name = "Show potion timers",
        Callback = function()
            task.spawn(function()
                local timers = warmHud()
                local parts = {}
                for _, name in ipairs(PotionNames) do
                    if timers[name] then table.insert(parts, name .. " " .. fmtTime(timers[name])) end
                end
                if #parts > 0 then
                    Rayfield:Notify({ Title = "Potions", Content = table.concat(parts, " | "), Duration = 10 })
                else
                    Rayfield:Notify({
                        Title = "Potions",
                        Content = "No potion timer could be read (shop icons learned: " .. countMap() .. "). Use 'Print potion HUD (F9)'.",
                        Duration = 8,
                    })
                end
            end)
        end,
    })

    PotionsTab:CreateButton({
        Name = "Print potion HUD (F9)",
        Callback = function()
            task.spawn(function()
                warmHud()
                local container = getEffectsContainer()
                print("[Potions HUD] shop icons learned: " .. countMap() .. " | effects container: " .. (container and container:GetFullName() or "NOT FOUND"))
                if container then
                    for _, child in ipairs(container:GetChildren()) do
                        print(("  effect %s (%s)"):format(child.Name, child.ClassName))
                        for k, v in pairs(child:GetAttributes()) do print("    attr " .. tostring(k) .. " = " .. tostring(v)) end
                        local shown = 0
                        for _, d in ipairs(child:GetDescendants()) do
                            if shown >= 12 then break end
                            shown += 1
                            local extra = ""
                            if d:IsA("TextLabel") then
                                extra = " text=" .. d.Text
                            elseif d:IsA("ImageLabel") or d:IsA("ImageButton") then
                                extra = " image=" .. iconKey(d)
                            end
                            print("    " .. d.ClassName .. " " .. d.Name .. extra)
                        end
                    end
                    for _, r in ipairs(hudRows) do
                        print(("  READ  %s | value=%s | potion=%s"):format(r.child.Name, tostring(r.value), tostring(r.potion)))
                    end
                else
                    print("  labels matched: " .. #hudList .. " | not matched: " .. #hudUnmapped)
                    for _, e in ipairs(hudList) do
                        local st = hudState[e.label]
                        print(("  matched   %s | text=%s | potion=%s | ticks=%d"):format(
                            e.label:GetFullName(), e.label.Text, IconMap[iconKey(e.img)] or "?", st and st.ticks or 0))
                    end
                    for _, e in ipairs(hudUnmapped) do
                        print(("  UNMATCHED %s | text=%s | image=%s"):format(e.label:GetFullName(), e.label.Text, iconKey(e.img)))
                    end
                end
                Rayfield:Notify({ Title = "Potions", Content = "HUD info printed in the F9 console", Duration = 4 })
            end)
        end,
    })

    PotionsTab:CreateSection("Auto Drink (keeps every selected potion running)")

    PotionsTab:CreateInput({
        Name = "Drink again when less than (seconds) remain",
        Default = "10",
        Placeholder = "e.g. 10",
        Flag = "PotionRefillBelow",
        Callback = function(v)
            RefillBelow = math.clamp(math.floor(tonumber(v) or 10), 1, 120)
        end,
    })

    PotionsTab:CreateInput({
        Name = "Fallback: seconds one drink lasts",
        Default = "300",
        Placeholder = "5 minutes = 300",
        Flag = "PotionIntervalSec",
        Callback = function(v)
            PotionInterval = math.max(math.floor(tonumber(v) or 300), 10)
        end,
    })

    PotionsTab:CreateToggle({
        Name = "Auto Drink Selected Potions",
        CurrentValue = false,
        Flag = "AutoDrinkPotions",
        Callback = function(Value)
            potionToken += 1
            local myToken = potionToken
            if not Value then return end
            task.spawn(function()
                while potionToken == myToken and Rayfield.Loading do task.wait(0.3) end
                while potionToken == myToken do
                    -- a potion is drunk only when its timer is (almost) over
                    if hasSelection() then ensure(SelectedPotions, RefillBelow) end
                    task.wait(2)
                end
            end)
        end,
    })

    PotionsTab:CreateSection("Weather Burst (make sure potions run on a weather)")

    PotionsTab:CreateDropdown({
        Name = "Trigger on these Weathers",
        Options = PerfCache.weatherNames or { "Arcane", "Awakened", "Glitch", "Monsoon" },
        CurrentOption = { "Arcane", "Awakened" },
        MultipleOptions = true,
        Flag = "PotionTriggerWeathers",
        Callback = function(list)
            PotionWeathers = {}
            for _, n in ipairs(list) do PotionWeathers[norm(n)] = true end
        end,
    })

    PotionsTab:CreateToggle({
        Name = "Drink when Weather Appears",
        CurrentValue = false,
        Flag = "DrinkOnWeather",
        Callback = function(Value)
            weatherPotionToken += 1
            local myToken = weatherPotionToken
            if not Value then return end
            task.spawn(function()
                while weatherPotionToken == myToken and Rayfield.Loading do task.wait(0.3) end
                local lastSeen = nil
                while weatherPotionToken == myToken do
                    local w = PerfCache.getWeather and PerfCache.getWeather()
                    if w and PotionWeathers[norm(w)] and hasSelection() then
                        local key = norm(w)
                        -- once per weather appearance, and never twice within WeatherGuard seconds
                        if lastSeen ~= key and (not lastWeather[key] or os.time() - lastWeather[key] >= WeatherGuard) then
                            lastSeen = key
                            lastWeather[key] = os.time()
                            -- only potions that would run out during the weather are drunk
                            local n = ensure(SelectedPotions, WeatherMin)
                            Rayfield:Notify({ Title = "Potions", Content = "Weather " .. w .. " active - drank " .. n .. " potion(s)", Duration = 4 })
                        end
                    elseif not w then
                        lastSeen = nil
                    end
                    task.wait(2)
                end
            end)
        end,
    })

    -- ===== potions to have running right before the Infinity Tower is ended =====
    local PrepPotions = { ["Luck Potion IV"] = true }
    local PrepEnabled = true
    local PrepDelay = 3

    PotionsTab:CreateSection("Before ending the Infinity Tower")

    PotionsTab:CreateToggle({
        Name = "Prep potions before auto-ending the tower",
        CurrentValue = true,
        Flag = "TowerPrepEnabled",
        Callback = function(v) PrepEnabled = v end,
    })

    PotionsTab:CreateDropdown({
        Name = "Potions to have active before ending",
        Options = PotionNames,
        CurrentOption = { "Luck Potion IV" },
        MultipleOptions = true,
        Flag = "TowerPrepPotions",
        Callback = function(list)
            PrepPotions = {}
            for _, n in ipairs(list) do PrepPotions[n] = true end
        end,
    })

    PotionsTab:CreateInput({
        Name = "Wait after drinking, before ending (seconds)",
        Default = "3",
        Placeholder = "e.g. 3",
        Flag = "TowerPrepDelay",
        Callback = function(v)
            PrepDelay = math.clamp(tonumber(v) or 3, 0, 30)
        end,
    })

    -- called by the Infinity Tower tab right before it sends "end".
    -- Returns how many potions were drunk (a potion that still has time left is NOT drunk again).
    PerfCache.prepBeforeTowerEnd = function()
        if not PrepEnabled or next(PrepPotions) == nil or not useItemRemote then return 0 end
        local n = ensure(PrepPotions, PrepMin)
        if n > 0 and PrepDelay > 0 then task.wait(PrepDelay) end
        return n
    end
end)() end

-- ==================== Raid Shop (auto buy potions) ====================
-- raidShopRequest is a RemoteFunction, captured with Cobalt:
--   InvokeServer("buy", "kaiju", "potions:<Potion Name>")   -> purchase
--   InvokeServer("get", "kaiju")                            -- shop data
-- This spends real in-game currency, so every purchase is capped (see MaxBuys).
-- own scope: adds no top-level locals
do (function()
    local HttpService = game:GetService("HttpService")
    local ShopTab = Window:CreateTab("Raid Shop", 4483362458)

    local shopRemote
    task.spawn(function()
        shopRemote = Rep:WaitForChild("raidShopRequest", 180)
        if not shopRemote then
            warn("[Titan Hub] missing remote: raidShopRequest")
            pcall(function() Rayfield:Notify({ Title = "Missing remote", Content = "raidShopRequest", Duration = 6 }) end)
        end
    end)

    local ShopId = "kaiju"
    -- Skill Tree Reset and Weather Reroll are in the shop too, but are NOT buyable from this tab on purpose
    local BuyNames = {
        "Luck Potion I", "Luck Potion II", "Luck Potion III", "Luck Potion IV",
        "Speed Potion I", "Speed Potion II", "Speed Potion III", "Speed Potion IV",
        "Battle Potion I", "Battle Potion II", "Battle Potion III", "Battle Potion IV",
        "Boss Potion", "Raid Potion",
    }
    local Selected = {}
    local MaxBuys = 5                  -- max purchases per potion per restock cycle (the shop shows 5/5)
    local CYCLE = 4 * 3600 + 60        -- the shop restocks about every 4 hours
    local RETRY_AFTER_FAIL = 900       -- after a refused purchase, wait this long before trying that potion again
    local KeepCurrency = 0             -- never spend below this much of any currency
    local buyToken = 0

    -- survives re-execute / server hop in the same executor session (best effort)
    getgenv().TitanShop = getgenv().TitanShop or { bought = {}, nextTry = {}, cycleStart = os.time() }
    local State = getgenv().TitanShop

    table.insert(activeConnections, { Disconnect = function() buyToken += 1 end })

    local function rollCycle()
        Rayfield.ShopRoll(State, shopRemote, ShopId, CYCLE)
    end

    local function show(v)
        if type(v) == "table" then
            local ok, s = pcall(function() return HttpService:JSONEncode(v) end)
            if ok then return s end
        end
        return tostring(v)
    end


    local function buyOne(name)
        if not shopRemote then return false, "remote not ready" end
        local key, why = Rayfield.ShopKey(shopRemote, ShopId, name, "potions:" .. name, KeepCurrency)
        if not key then return false, why end
        local ok, res = pcall(function() return shopRemote:InvokeServer("buy", ShopId, key) end)
        if not ok then return false, tostring(res) end
        warn("[Raid Shop] " .. name .. " -> " .. show(res))
        local outcome = Rayfield.ShopResult(ShopId, res)
        if outcome ~= "bought" then return false, outcome end
        return true, res
    end

    local function hasSelection() return next(Selected) ~= nil end

    local function buyCycle(alive)
        rollCycle()
        local total = 0
        for _, name in ipairs(BuyNames) do
            if Selected[name] then
                while alive() and (State.bought[name] or 0) < MaxBuys and (State.nextTry[name] or 0) <= os.time() do
                    local ok, why = buyOne(name)
                    if ok then
                        State.bought[name] = (State.bought[name] or 0) + 1
                        total += 1
                        task.wait(0.7)
                    else
                        State.nextTry[name] = Rayfield.ShopRetry(why, RETRY_AFTER_FAIL)
                        break
                    end
                end
            end
        end
        return total
    end

    local function dump(v, indent, depth)
        indent, depth = indent or "", depth or 0
        if type(v) ~= "table" or depth > 4 then
            print(indent .. tostring(v))
            return
        end
        for k, x in pairs(v) do
            if type(x) == "table" then
                print(indent .. tostring(k) .. " = {")
                dump(x, indent .. "  ", depth + 1)
                print(indent .. "}")
            else
                print(indent .. tostring(k) .. " = " .. tostring(x))
            end
        end
    end

    ShopTab:CreateSection("Potions to buy")

    ShopTab:CreateDropdown({
        Name = "Buy these potions",
        Options = BuyNames,
        CurrentOption = {},
        MultipleOptions = true,
        Flag = "ShopPotionsPick",
        Callback = function(list)
            Selected = {}
            for _, n in ipairs(list) do Selected[n] = true end
        end,
    })

    ShopTab:CreateInput({
        Name = "Max buys per potion per restock",
        Default = "5",
        Placeholder = "e.g. 5",
        Flag = "ShopMaxBuys",
        Callback = function(v)
            MaxBuys = math.clamp(math.floor(tonumber(v) or 5), 1, 50)
        end,
    })

    ShopTab:CreateInput({
