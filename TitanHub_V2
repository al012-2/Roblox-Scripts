    local prestigeRemote
    task.spawn(function()
        prestigeRemote = Rep:WaitForChild("runPrestigeTower", 180)
        if not prestigeRemote then
            warn("[Titan Hub] missing remote: runPrestigeTower")
            pcall(function() Rayfield:Notify({ Title = "Missing remote", Content = "runPrestigeTower", Duration = 6 }) end)
        end
    end)

    local MinGap = 10        -- seconds between the end of a run and the next start
    local MaxRun = 1800      -- give up waiting for the end screen after this long, then start again
    local prestigeToken = 0
    local runs, bestFloor = 0, 0

    table.insert(activeConnections, { Disconnect = function() prestigeToken += 1 end })

    local function shown(o)
        local n = o
        while n and n ~= game do
            if n:IsA("GuiObject") and not n.Visible then return false end
            if n:IsA("ScreenGui") and not n.Enabled then return false end
            n = n.Parent
        end
        return n ~= nil
    end

    -- PlayerGui.BattleUI.prestigeFloorEndUI, only when it is on screen
    local function endScreen()
        local ok, ui = pcall(function() return player.PlayerGui.BattleUI.prestigeFloorEndUI end)
        if ok and ui and shown(ui) then return ui end
        return nil
    end

    -- "on Floor 37" -> 37
    local function endFloor(ui)
        local sub = ui:FindFirstChild("subtitle")
        local txt = sub and sub:IsA("TextLabel") and (sub.ContentText ~= "" and sub.ContentText or sub.Text) or ""
        local n = tostring(txt):match("([%d,]+)")
        return n and tonumber((n:gsub(",", ""))) or nil
    end

    -- presses CONTINUE (up to 3 tries); returns the floor that was reached
    local function closeEndScreen()
        local ui = endScreen()
        if not ui then return nil end
        local floor = endFloor(ui)
        local btn = ui:FindFirstChild("continueButton")
        for _ = 1, 3 do
            if not endScreen() then break end
            if btn and btn:IsA("GuiButton") then pressButton(btn) end
            task.wait(1)
        end
        return floor
    end

    -- true if a battle started within 5 seconds after the request
    local function startPrestige()
        if not prestigeRemote then return false, "runPrestigeTower remote not ready" end
        if endScreen() then closeEndScreen() end
        local started, why = PerfCache.sendAndWaitBattle(function() prestigeRemote:FireServer() end, 5)
        if started then return true end
        return false, why or "no battle started (already running, or the server refused)"
    end

    local function recordRun(floor)
        runs += 1
        if floor and floor > bestFloor then bestFloor = floor end
        Rayfield:Notify({
            Title = "Prestige Tower",
            Content = "Run " .. runs .. " ended" .. (floor and (" on floor " .. floor) or "") .. " (best " .. bestFloor .. ")",
            Duration = 5,
        })
    end

    PrestigeTab:CreateSection("Prestige Tower")

    PrestigeTab:CreateButton({
        Name = "Start Prestige Tower now",
        Callback = function()
            task.spawn(function()
                local ok, why = startPrestige()
                Rayfield:Notify({
                    Title = "Prestige Tower",
                    Content = ok and "Prestige Tower started" or ("Not started: " .. tostring(why)),
                    Duration = 5,
                })
            end)
        end,
    })

    PrestigeTab:CreateButton({
        Name = "Press CONTINUE on the end screen",
        Callback = function()
            task.spawn(function()
                if not endScreen() then
                    Rayfield:Notify({ Title = "Prestige Tower", Content = "End screen is not open", Duration = 3 })
                    return
                end
                local floor = closeEndScreen()
                Rayfield:Notify({ Title = "Prestige Tower", Content = "Closed (floor " .. tostring(floor) .. ")", Duration = 3 })
            end)
        end,
    })

    PrestigeTab:CreateInput({
        Name = "Wait after a run before starting again (seconds)",
        Default = "10",
        Placeholder = "e.g. 10",
        Flag = "PrestigeMinGap",
        Callback = function(v)
            MinGap = math.clamp(math.floor(tonumber(v) or 10), 3, 3600)
        end,
    })

    PrestigeTab:CreateToggle({
        Name = "Auto Prestige Tower (CONTINUE + start again)",
        CurrentValue = false,
        Flag = "AutoPrestigeTower",
        Callback = function(Value)
            prestigeToken += 1
            local my = prestigeToken
            if not Value then return end
            task.spawn(function()
                while prestigeToken == my and Rayfield.Loading do task.wait(0.3) end
                local inf = LToggles.AutoInfTowerMulti
                if inf and inf.Value then
                    Rayfield:Notify({
                        Title = "Prestige Tower",
                        Content = "Auto Run Infinite Tower is on too. If the two towers block each other, turn one off.",
                        Duration = 7,
                    })
                end
                local fails = 0
                while prestigeToken == my do
                    local ok, why = startPrestige()
                    local t = os.clock()
                    if ok then
                        fails = 0
                        -- wait for the end screen of this run
                        while prestigeToken == my and not endScreen() and os.clock() - t < MaxRun do
                            task.wait(0.5)
                        end
                        if prestigeToken ~= my then return end
                        if endScreen() then
                            task.wait(1)
                            recordRun(closeEndScreen())
                        end
                        local w = os.clock()
                        while prestigeToken == my and os.clock() - w < MinGap do task.wait(0.5) end
                    else
                        fails += 1
                        if fails == 3 then
                            Rayfield:Notify({ Title = "Prestige Tower", Content = "Did not start 3 times: " .. tostring(why), Duration = 7 })
                        end
                        -- back off: MinGap, 2x, 3x ... up to 6x
                        local waitFor = MinGap * math.min(fails, 6)
                        while prestigeToken == my and os.clock() - t < waitFor do task.wait(0.5) end
                    end
                end
            end)
        end,
    })

    PrestigeTab:CreateParagraph({
        Title = "Safe",
        Content = "Only starts the Prestige Tower and presses CONTINUE on its end screen. It never presses the real Prestige (reset) button.",
    })
end)() end

-- ==================== Live Tracker ====================
-- Works two ways:
--   1) pasted inside the main script, right before Rayfield:LoadConfiguration()  -> panel + "Tracker" tab
--   2) executed on its own in the executor                                        -> panel only (R = reset, - = minimize)
-- Reads only paths confirmed in the game dump (no PlayerGui scans), so it is light.
-- own scope: adds no top-level locals
do (function()
    local Players = game:GetService("Players")
    local UIS = game:GetService("UserInputService")
    local Rep = game:GetService("ReplicatedStorage")

    -- main-script locals when pasted inside it; nil when run alone
    local Win = Window
    local RF = Rayfield
    local LP = player or Players.LocalPlayer
    local mainConns = activeConnections
    local embedded = type(Win) == "table" and type(Win.CreateTab) == "function"
        and type(RF) == "table" and type(mainConns) == "table"
    local PC = type(PerfCache) == "table" and PerfCache or {}

    -- ===== lifetime: one tracker at a time =====
    local conns = {}
    local trackToken = 0
    local function cleanup()
        trackToken += 1
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        table.clear(conns)
    end
    local G = (getgenv and getgenv()) or _G
    if type(G.TitanTrackerCleanup) == "function" then pcall(G.TitanTrackerCleanup) end
    G.TitanTrackerCleanup = cleanup
    if embedded then table.insert(mainConns, { Disconnect = cleanup }) end
    local myToken = trackToken

    -- ===== counters =====
    local S = { start = os.time(), bosses = 0, potions = 0, potSeen = 0, crafts = 0, topFloor = 0 }
    local hooked = { potion = false, craft = false }

    -- called from the Potions / Crafting blocks of the main script (the one-line hooks)
    PC.onPotion = function(n) hooked.potion = true; S.potions += (tonumber(n) or 1) end
    PC.onCraft = function(n) hooked.craft = true; S.crafts += (tonumber(n) or 1) end

    -- ===== extra live data: rolls to next level, server luck, tower cards =====
    local rollInfo = { total = nil, need = nil }
    local luckInfo = { mult = nil, left = nil, at = 0 }
    local towerCards = nil

    local function commas(n)
        local r = tostring(math.floor(n)):reverse():gsub("(%d%d%d)", "%1,"):reverse()
        return (r:gsub("^,", ""))
    end

    if type(onRemoteEvent) == "function" then
        onRemoteEvent("rollResult", function(...)
            for i = 1, select("#", ...) do
                local v = select(i, ...)
                if type(v) == "table" and type(v.totalRolls) == "number" and type(v.spThreshold) == "number" then
                    rollInfo.total, rollInfo.need = v.totalRolls, v.spThreshold
                end
            end
        end)
        onRemoteEvent("sendUI", function(action, data)
            if action == "serverLuckUpdate" and type(data) == "table" then
                luckInfo.mult, luckInfo.left, luckInfo.at = data.multiplier, data.duration, os.clock()
            end
        end)
        onRemoteEvent("floorPromptEvent", function(data)
            if type(data) == "table" and type(data.floorCards) == "number" then
                towerCards = data.floorCards
            end
        end)
    end

    local function onBoss(won)
        if won == true or (type(won) == "table" and (won.won == true or won.win == true or won.victory == true)) then
            S.bosses += 1
        end
    end
    task.spawn(function()
        local ev = Rep:WaitForChild("bossResult", 180)
        if ev and ev:IsA("RemoteEvent") and trackToken == myToken then
            table.insert(conns, ev.OnClientEvent:Connect(onBoss))
        end
    end)

    -- ===== helpers =====
    local function fmtTime(sec)
        return string.format("%02d:%02d:%02d", math.floor(sec / 3600), math.floor((sec % 3600) / 60), sec % 60)
    end

    -- text read from the game goes into a RichText label: escape it so it can never break the panel
    local function esc(s)
        s = tostring(s)
        s = s:gsub("&", "&amp;")
        s = s:gsub("<", "&lt;")
        s = s:gsub(">", "&gt;")
        return s
    end

    -- ContentText = the text without the game's own rich-text tags
    local function textAt(root, path)
        local node = root
        for _, nm in ipairs(path) do node = node and node:FindFirstChild(nm) end
        if node and (node:IsA("TextLabel") or node:IsA("TextButton")) then
            local t = node.ContentText
            if t == nil or t == "" then t = node.Text end
            return t
        end
        return nil
    end

    -- "Currently in battle: Floor 4603" / "Floor: 4603"  (strict)   |   "Infinite F474"  (loose)
    local function floorFrom(txt, loose)
        if not txt then return nil end
        txt = tostring(txt):gsub("<[^>]+>", "")
        local n = txt:match("[Ff]loor%s*:?%s*([%d,]+)")
        if not n and loose then n = txt:match("[Ff]%s*([%d,]+)") end
        return n and tonumber((n:gsub(",", ""))) or nil
    end

    local function playerGui()
        return LP and LP:FindFirstChild("PlayerGui")
    end

    local function readFloor()
        local pg = playerGui()
        local ui = pg and pg:FindFirstChild("BattleUI")
        if not ui then return nil end
        return floorFrom(textAt(ui, { "battleContainer", "battleTabs", "tower", "textLabel" }), true)
            or floorFrom(textAt(ui, { "battleNotifierLabel" }))
            or floorFrom(textAt(ui, { "battleContainer", "floorCount" }))
    end

    local function readMain()
        local pg = playerGui()
        return pg and pg:FindFirstChild("Main")
    end

    -- potion buffs running right now (the game's own active-effects list)
    -- + counts new potion buffs, so "drunk" works even without the main-script hook
    local watchedList
    local function activePotions(main)
        local holder = main and main:FindFirstChild("activeEffectsHolder")
        local list = holder and holder:FindFirstChild("activeEffects")
        if list ~= watchedList then
            watchedList = list
            if list then
                table.insert(conns, list.ChildAdded:Connect(function(ch)
                    task.wait(0.2) -- attribute may be set right after parenting
                    if ch:GetAttribute("category") == "potion" then S.potSeen += 1 end
                end))
            end
        end
        if not list then return nil end
        local n = 0
        for _, ch in ipairs(list:GetChildren()) do
            if ch:GetAttribute("category") == "potion" then n += 1 end
        end
        return n
    end

    -- ===== the on-screen panel =====
    local gui = Instance.new("ScreenGui")
    gui.Name = "TitanTracker"
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 998

    local frame = Instance.new("Frame")
    frame.Active = true
    frame.AutomaticSize = Enum.AutomaticSize.Y
    frame.Size = UDim2.new(0, 215, 0, 0)
    frame.Position = UDim2.new(0, 12, 0.18, 0)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    frame.BackgroundTransparency = 0.2
    frame.BorderSizePixel = 0
    frame.Parent = gui
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
    local pad = Instance.new("UIPadding", frame)
    pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 8), UDim.new(0, 8)
    pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 10), UDim.new(0, 10)

    local content = Instance.new("TextLabel")
    content.AutomaticSize = Enum.AutomaticSize.Y
    content.Size = UDim2.new(1, 0, 0, 0)
    content.BackgroundTransparency = 1
    content.RichText = true
    content.TextWrapped = true
    content.TextXAlignment = Enum.TextXAlignment.Left
    content.TextYAlignment = Enum.TextYAlignment.Top
    content.TextColor3 = Color3.fromRGB(210, 210, 210)
    content.Font = Enum.Font.GothamSemibold
    content.TextSize = 12
    content.Text = "Live Session..."
    content.Parent = frame

    local function mkBtn(txt, x)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0, 18, 0, 18)
        b.Position = UDim2.new(1, x, 0, -2)
        b.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
        b.BorderSizePixel = 0
        b.AutoButtonColor = true
        b.Text = txt
        b.TextColor3 = Color3.fromRGB(220, 220, 220)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 12
        b.ZIndex = 2
        b.Parent = frame
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
        return b
    end
    local minBtn = mkBtn("-", -18)
    local resetBtn = mkBtn("R", -40)

    -- parent: gethui -> CoreGui -> PlayerGui (removes an old panel left from a previous run)
    local function killOld(p)
        pcall(function()
            local old = p and p:FindFirstChild("TitanTracker")
            if old and old ~= gui then old:Destroy() end
        end)
    end
    local parent
    if gethui then
        local ok, h = pcall(gethui)
        if ok and typeof(h) == "Instance" then parent = h end
    end
    if not parent then
        local ok, cg = pcall(function() return game:GetService("CoreGui") end)
        if ok and cg then
            killOld(cg)
            if pcall(function() gui.Parent = cg end) and gui.Parent then parent = cg end
        end
    end
    parent = parent or LP:WaitForChild("PlayerGui")
    killOld(parent)
    gui.Parent = parent
    table.insert(conns, { Disconnect = function() pcall(function() gui:Destroy() end) end })

    -- drag (mouse + touch); follows only the finger / mouse that started the drag
    local dragInput, dragStart, startPos
    local MB1, MOVE, TOUCH = Enum.UserInputType.MouseButton1, Enum.UserInputType.MouseMovement, Enum.UserInputType.Touch
    table.insert(conns, frame.InputBegan:Connect(function(input)
        if input.UserInputType == MB1 or input.UserInputType == TOUCH then
            dragInput, dragStart, startPos = input, input.Position, frame.Position
        end
    end))
    table.insert(conns, UIS.InputChanged:Connect(function(input)
        if not dragInput then return end
        if input == dragInput or (dragInput.UserInputType == MB1 and input.UserInputType == MOVE) then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end))
    table.insert(conns, UIS.InputEnded:Connect(function(input)
        if not dragInput then return end
        if input == dragInput or (dragInput.UserInputType == MB1 and input.UserInputType == MB1) then
            dragInput = nil
        end
    end))

    -- ===== refresh =====
    local lastText = ""
    local collapsed = false
    local TITLE = '<font color="#008CFF"><b>Live Session</b></font>'

    local function refresh()
        local txt
        if collapsed then
            txt = TITLE
        else
            local main = readMain()

            local f = readFloor()
            if f and f > S.topFloor then S.topFloor = f end

            -- weather: server data first (name + time left), HUD label as fallback; expired weather shows "-"
            local weather = "-"
            if PC.getWeatherInfo then
                local okW, wn, wl, sw = pcall(PC.getWeatherInfo)
                if okW and wn then
                    weather = esc(wn)
                    if wl then weather = weather .. " (" .. fmtTime(math.floor(wl)) .. ")" end
                    if sw and sw.speed then weather = weather .. " " .. sw.speed .. "x speed" end
                    if sw and sw.luck then weather = weather .. " " .. sw.luck .. "x luck" end
                end
            end

            -- the Pity Roll block returns 9999 (MaxPity - 1) when the roll bar shows 10,000x+ = pity is full
            local okP, pity = pcall(function() return PC.getPity and PC.getPity() end)
            local pityText = "-"
            if okP and type(pity) == "number" then
                pityText = pity >= 9999 and '<font color="#3CDC50">READY</font>' or (math.floor(pity) .. "/10000")
            end

            local level = main and textAt(main, { "Bottom", "skillPointBarContainer", "levelLabel" }) or "-"
            local pots = activePotions(main)
            local drunk = hooked.potion and S.potions or S.potSeen
            local crafted = (embedded or hooked.craft) and tostring(S.crafts) or "-"

            -- rolls left to the next level (from rollResult: the HUD label lags behind)
            local nextLvl = "-"
            if rollInfo.total and rollInfo.need then
                nextLvl = commas(math.max(rollInfo.need - rollInfo.total, 0)) .. " rolls"
            end

            -- server luck (the server sends it every second)
            local luckText = "-"
            if luckInfo.mult and luckInfo.left then
                local left = luckInfo.left - (os.clock() - luckInfo.at)
                if left > 0 then luckText = luckInfo.mult .. "x (" .. fmtTime(math.floor(left)) .. ")" end
            end

            txt = table.concat({
                TITLE,
                "Time: " .. fmtTime(os.time() - S.start),
                "Bosses beaten: " .. S.bosses,
                "Tower floor: " .. (f and tostring(f) or "-") .. "  (best " .. S.topFloor .. ")",
                "Tower cards: " .. (towerCards and commas(towerCards) or "-"),
                "Potion requests: " .. drunk .. "  |  active: " .. (pots and tostring(pots) or "-"),
                "Crafted: " .. crafted,
                "Pity: " .. pityText,
                "Weather: " .. weather,
                "Server luck: " .. luckText,
                "Next level: " .. nextLvl,
                esc(level),
            }, "\n")
        end
        if txt ~= lastText then
            lastText = txt
            content.Text = txt
        end
    end

    local function resetCounters()
        S.start, S.bosses, S.potions, S.potSeen, S.crafts, S.topFloor = os.time(), 0, 0, 0, 0, 0
        lastText = ""
        pcall(refresh)
        if embedded then
            pcall(function() RF:Notify({ Title = "Tracker", Content = "Counters reset", Duration = 3 }) end)
        end
    end

    table.insert(conns, minBtn.MouseButton1Click:Connect(function()
        collapsed = not collapsed
        minBtn.Text = collapsed and "+" or "-"
        pcall(refresh)
    end))
    table.insert(conns, resetBtn.MouseButton1Click:Connect(resetCounters))

    task.spawn(function()
        while trackToken == myToken do
            if gui.Enabled then pcall(refresh) end
            task.wait(1)
        end
    end)

    -- ===== menu tab (only when pasted inside the main script) =====
    if embedded then
        local ok, err = pcall(function()
            local TrackTab = Win:CreateTab("Tracker", 4483362458)
            TrackTab:CreateSection("Live tracker")
            TrackTab:CreateToggle({
                Name = "Show live tracker",
                CurrentValue = true,
                Flag = "TrackerShow",
                Callback = function(v) gui.Enabled = v end,
            })
            TrackTab:CreateButton({ Name = "Reset session counters", Callback = resetCounters })
            TrackTab:CreateParagraph({
                Title = "Tip",
                Content = "Drag the panel to move it. R = reset, - = minimize. Counters are for this session only.",
            })
        end)
        if not ok then warn("[Tracker] tab: " .. tostring(err)) end
    else
        print("[Tracker] running standalone (panel only). Paste it inside the main script for the menu tab + potion/craft/pity hooks.")
    end
end)() end

Rayfield:LoadConfiguration()

-- queue the script for the next server change right away (needs the Raw Script URL from the config)
task.delay(3, queueReload)

Rayfield:Notify({ Title = "Titan Hub", Content = "Loaded", Duration = 3 })

-- say so when saved auto-spending toggles are waiting, so a paused shop doesn't look broken
task.delay(4, function()
    local waiting = 0
    for _, f in ipairs({ "AutoBuyShopPotions", "AutoBuyCandyShopPotions", "ShadowShopAuto", "DealerAuto", "ScrapShopAuto",
        "FuserAuto", "HwUpgradesAuto", "HalloweenAutoPacks", "AutoCraftPotions", "AwakeningAuto" }) do
        local t = LToggles[f]
        if t and t.Value then waiting += 1 end
    end
    if waiting > 0 and not Rayfield.SpendArmed then
        Rayfield:Notify({ Title = "Auto-spending paused", Content = waiting .. " auto-spend option(s) are on. Allow them in Settings > Auto Save.", Duration = 10 })
    end
end)
