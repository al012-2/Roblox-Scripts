-- ==================== The Masked Man / dealer (dealerClient) ====================
-- dealerRequest:InvokeServer("get")         -> ok, message, state { offers = { {slot, name, rarity, price, bought} }, scrap }
-- dealerRequest:InvokeServer("buy", slot)   -> ok, message, state
do
    local Rarities = { "Common", "Rare", "Epic", "Legendary", "Mythic" }
    local Want = { Legendary = true, Mythic = true }
    local KeepScrap = 0

    local function dealerPass()
        local remote = Rep:FindFirstChild("dealerRequest")
        if not remote then return 0, "dealerRequest not found" end
        local ok, okGet, msg, state = pcall(remote.InvokeServer, remote, "get", nil)
        if not ok or not okGet or type(state) ~= "table" or type(state.offers) ~= "table" then
            return 0, msg or "the dealer is not here right now"
        end
        local scrap = tonumber(state.scrap)
        if not scrap then
            -- unknown balance: the keep-limit can't be honoured, so don't spend
            if KeepScrap > 0 then return 0, "could not read your Scrap" end
            scrap = math.huge
        end
        local n = 0
        for _, offer in ipairs(state.offers) do
            if type(offer) == "table" and not offer.bought and Want[offer.rarity] and offer.slot ~= nil then
                local price = tonumber(offer.price) or 0
                if scrap - price >= KeepScrap then
                    local okB, okBuy, bmsg, newState = pcall(remote.InvokeServer, remote, "buy", offer.slot)
                    if okB and okBuy then
                        n += 1
                        scrap -= price
                        if type(newState) == "table" and tonumber(newState.scrap) then scrap = tonumber(newState.scrap) end
                        xNotify("Masked Man", "Bought " .. tostring(offer.name) .. " (" .. tostring(offer.rarity) .. ")", 4)
                    elseif bmsg then
                        warn("[Masked Man] " .. tostring(bmsg))
                    end
                    task.wait(0.8)
                end
            end
        end
        return n
    end

    local DealerTab = Window:CreateTab("Masked Man", 4483362458)
    DealerTab:CreateSection("Dealer")
    DealerTab:CreateDropdown({
        Name = "Buy offers of these rarities",
        Options = Rarities,
        CurrentOption = { "Legendary", "Mythic" },
        MultipleOptions = true,
        Flag = "DealerRarities",
        Callback = function(list)
            Want = {}
            for _, r in ipairs(list) do Want[r] = true end
        end,
    })
    DealerTab:CreateInput({
        Name = "Always keep at least this much Scrap",
        Default = "0",
        Flag = "DealerKeepScrap",
        Callback = function(v) KeepScrap = tonumber(v) or 0 end,
    })
    DealerTab:CreateToggle({
        Name = "Auto buy from the Masked Man",
        CurrentValue = false,
        Flag = "DealerAuto",
        Callback = makeSpendLoop(90, function() dealerPass() end),
    })
    DealerTab:CreateButton({
        Name = "Check offers now",
        Callback = function()
            task.spawn(function()
                local n, why = dealerPass()
                xNotify("Masked Man", why and ("Can't: " .. tostring(why)) or ("Bought " .. n .. " offer(s)"), 4)
            end)
        end,
    })
    DealerTab:CreateParagraph({
        Title = "Info",
        Content = "Pays with Scrap. If it says he's not here, he only shows up at certain times or you have to stand near him (the game uses a 16 stud range).",
    })
end

-- ==================== Scrap Shop (scrapShopClient) ====================
-- scrapShopRequest:InvokeServer("get", true)        -> ok, message, state { rows = { {id, price, count, extra, owned} }, scrap, level }
-- scrapShopRequest:InvokeServer("buy", id, price)   -> ok, message, state
do
    local Items = {
        { id = "reroll",     name = "Weather Reroll" },
        { id = "dust",       name = "Spirit Dust" },
        { id = "ore",        name = "Enchanted Ore" },
        { id = "boss",       name = "Boss Potion" },
        { id = "raidPotion", name = "Raid Potion" },
        { id = "fortune",    name = "Fortune Draught" },
        { id = "divine",     name = "Divine Fragment" },
        { id = "abyssal",    name = "Abyssal Fragment" },
        { id = "orb",        name = "Orb Fragment" },
        { id = "blueShard",  name = "Blue Raid Shard" },
        { id = "skillPoint", name = "Skill Point" },
        { id = "tonic",      name = "Pack XP Tonic" },
        { id = "counterSwap", name = "Counter Swap" },
    }
    local Names, IdOf = {}, {}
    for _, it in ipairs(Items) do table.insert(Names, it.name); IdOf[it.name] = it.id end
    local Picked = {}
    local KeepScrap = 0

    -- true if paying `cost` would break the keep-limit (an unknown balance counts as breaking it)
    local function breaksReserve(state, cost)
        local have = tonumber(state.scrap)
        if not have then return KeepScrap > 0 end
        return have - cost < KeepScrap
    end

    local function getState(remote)
        local ok, a, b, c = pcall(remote.InvokeServer, remote, "get", true)
        if ok and a and type(c) == "table" then return c end
        return nil, b
    end

    local function findRow(state, id)
        for _, list in ipairs({ state.rows or {}, state.deals or {} }) do
            for _, r in pairs(list) do
                if type(r) == "table" and r.id == id then return r end
            end
        end
    end

    local function scrapBuyPass(alive)
        local remote = Rep:FindFirstChild("scrapShopRequest")
        if not remote then return 0, "scrapShopRequest not found" end
        local state, why = getState(remote)
        if not state then return 0, why or "no shop data" end
        local n = 0
        for _, name in ipairs(Names) do
            if Picked[name] then
                for _ = 1, 30 do
                    if alive and not alive() then return n end
                    local row = findRow(state, IdOf[name])
                    -- only normal stock: never the "extra" (2x, 4x ... price) purchases
                    if not row or row.extra or row.soon or not tonumber(row.count) or row.count <= 0 or not row.price then break end
                    if breaksReserve(state, tonumber(row.price) or 0) then break end
                    local ok, okBuy, msg, newState = pcall(remote.InvokeServer, remote, "buy", row.id, row.price)
                    if not (ok and okBuy) then
                        if msg then warn("[Scrap Shop] " .. tostring(msg)) end
                        break
                    end
                    n += 1
                    if type(newState) == "table" then state = newState end
                    task.wait(0.6)
                end
            end
        end
        return n
    end

    local ScrapTab = Window:CreateTab("Scrap Shop", 4483362458)
    ScrapTab:CreateSection("Scrap Shop")
    ScrapTab:CreateDropdown({
        Name = "Buy these with Scrap",
        Options = Names,
        CurrentOption = {},
        MultipleOptions = true,
        Flag = "ScrapShopPick",
        Callback = function(list)
            Picked = {}
            for _, n in ipairs(list) do Picked[n] = true end
        end,
    })
    ScrapTab:CreateInput({
        Name = "Always keep at least this much Scrap",
        Default = "0",
        Flag = "ScrapShopKeep",
        Callback = function(v) KeepScrap = math.max(0, tonumber(v) or 0) end,
    })
    ScrapTab:CreateToggle({
        Name = "Auto buy Scrap Shop stock",
        CurrentValue = false,
        Flag = "ScrapShopAuto",
        Callback = makeSpendLoop(300, function(alive)
            if next(Picked) == nil then return end
            local n = scrapBuyPass(alive)
            if n > 0 then xNotify("Scrap Shop", "Bought " .. n .. " bundle(s)", 4) end
        end),
    })
    ScrapTab:CreateButton({
        Name = "Buy selected now",
        Callback = function()
            if next(Picked) == nil then return xNotify("Scrap Shop", "Pick at least one item first", 3) end
            task.spawn(function()
                local n, why = scrapBuyPass()
                xNotify("Scrap Shop", (n == 0 and why) and ("Can't: " .. tostring(why)) or ("Bought " .. n .. " bundle(s)"), 4)
            end)
        end,
    })
    ScrapTab:CreateParagraph({
        Title = "Info",
        Content = "Buys today's normal stock only. It never buys the extra sold-out stock (that costs 2x, 4x, 8x...). Items above your shop level are skipped.",
    })

    -- ===== Potion Fuser (fuserClient): fuse every 5 potions into 1 of the next tier =====
    -- scrapShopRequest:InvokeServer("fuseMany", { [recipeId] = count }, nil)
    -- state.fuses = { {id, from, to, fee} },  state.fuseHeld[id or from] = how many of `from` you have
    local Tiers = { "I", "II", "III", "IV", "V", "VI" }
    local FuseLabels, FuseIdOf = {}, {}
    for _, kind in ipairs({ "Luck", "Speed", "Battle" }) do
        for i = 2, 6 do
            local label = kind .. " " .. Tiers[i - 1] .. " -> " .. Tiers[i]
            table.insert(FuseLabels, label)
            FuseIdOf[label] = kind .. i
        end
        local label = "Eternal " .. kind .. " IV -> V"
        table.insert(FuseLabels, label)
        FuseIdOf[label] = kind .. "E5"
    end
    local FusePicked = {}
    local KeepPotions = 0

    local function fusePass()
        local remote = Rep:FindFirstChild("scrapShopRequest")
        if not remote then return 0, "scrapShopRequest not found" end
        local state, why = getState(remote)
        if not state then return 0, why or "no shop data" end
        if type(state.fuses) ~= "table" then return 0, "Potion Fuser is locked (Scrap Shop level 3)" end
        local held = type(state.fuseHeld) == "table" and state.fuseHeld or {}
        local plan, count, fee = {}, 0, 0
        for _, r in pairs(state.fuses) do
            if type(r) == "table" and r.id then
                local wanted = false
                for label, id in pairs(FuseIdOf) do
                    if id == r.id and FusePicked[label] then wanted = true end
                end
                local have = tonumber(held[r.id] or held[r.from]) or 0
                local n = math.min(math.floor(math.max(have - KeepPotions, 0) / 5), 1000)
                if wanted and n > 0 then
                    plan[r.id] = n
                    count += n
                    fee += n * (tonumber(r.fee) or 0)
                end
            end
        end
        if count == 0 then return 0, "nothing to fuse" end
        if breaksReserve(state, fee) then return 0, "not enough Scrap (" .. fee .. " + the amount you keep)" end
        local ok, okF, msg = pcall(remote.InvokeServer, remote, "fuseMany", plan, nil)
        if ok and okF then return count end
        return 0, msg or "refused"
    end

    ScrapTab:CreateSection("Potion Fuser")
    ScrapTab:CreateDropdown({
        Name = "Fuse these (5 -> 1 of next tier)",
        Options = FuseLabels,
        CurrentOption = {},
        MultipleOptions = true,
        Flag = "FuserPick",
        Callback = function(list)
            FusePicked = {}
            for _, n in ipairs(list) do FusePicked[n] = true end
        end,
    })
    ScrapTab:CreateInput({
        Name = "Keep at least this many of each potion",
        Default = "0",
        Flag = "FuserKeep",
        Callback = function(v) KeepPotions = math.max(0, math.floor(tonumber(v) or 0)) end,
    })
    ScrapTab:CreateToggle({
        Name = "Auto fuse potions",
        CurrentValue = false,
        Flag = "FuserAuto",
        Callback = makeSpendLoop(300, function()
            if next(FusePicked) == nil then return end
            local n = fusePass()
            if n > 0 then xNotify("Potion Fuser", "Fused " .. n .. " potion(s)", 4) end
        end),
    })
    ScrapTab:CreateButton({
        Name = "Fuse now",
        Callback = function()
            if next(FusePicked) == nil then return xNotify("Potion Fuser", "Pick at least one recipe first", 3) end
            task.spawn(function()
                local n, why = fusePass()
                xNotify("Potion Fuser", n > 0 and ("Fused " .. n .. " potion(s)") or ("Can't: " .. tostring(why)), 4)
            end)
        end,
    })
end

-- ==================== Recycler auto mode (recyclerClient) ====================
-- recyclerRequest:InvokeServer("info")          -> ok, message, info { auto = {owned, on, index}, scrap }
-- recyclerRequest:InvokeServer("auto", index)   -> turns the game's Auto-Recycle ON at that rarity (1..10)
-- recyclerRequest:InvokeServer("auto", -index)  -> turns it OFF
do
    local Thresholds = { "1 in 1K", "1 in 10K", "1 in 100K", "1 in 1M", "1 in 10M", "1 in 100M", "1 in 1B", "1 in 10B", "1 in 1T", "1 in 1Qa" }
    local WantIndex = 4

    local function info(remote)
        local ok, a, b, c = pcall(remote.InvokeServer, remote, "info")
        if ok and a and type(c) == "table" then return c end
        return nil, b
    end

    local function setRecycler(on)
        local remote = Rep:FindFirstChild("recyclerRequest")
        if not remote then return false, "recyclerRequest not found" end
        local inf, why = info(remote)
        if not inf then return false, why or "no recycler data" end
        local auto = inf.auto
        if type(auto) ~= "table" or not auto.owned then
            return false, "Buy Auto-Recycle in the Scrap Shop first (Level 2)"
        end
        local arg
        if on then
            if auto.on and auto.index == WantIndex then return true, "already on" end
            arg = WantIndex
        else
            if not auto.on then return true, "already off" end
            arg = -(auto.index or WantIndex)
        end
        local ok, okA, msg = pcall(remote.InvokeServer, remote, "auto", arg)
        if ok and okA then return true end
        return false, msg or "refused"
    end

