    local targetData = getSavedTarget()
    if targetData and targetData.CurrentItem then
        local targetItemId = targetData.CurrentItem.Id
        local targetNeeded = targetData.CurrentItem.Amount
        local targetName = targetData.CurrentItem.Name or targetItemId
        currentFarmingItemName = targetName

        local initialHave = getOwnedItemCount(targetItemId)
        currentFarmingProgress = string.format("%d / %d", initialHave, targetNeeded)
        print(string.format("🎯 الهدف الحالي: %s (مطلوب: %d)", targetName, targetNeeded))
        print(string.format("📦 [بداية الجولة] القطعة: %s | معك حالياً: %d / %d", targetName, initialHave, targetNeeded))

        task.spawn(function()
            task.wait(2)
            local autoPlay = PG:FindFirstChild("Automatic Play", true)
            if autoPlay and autoPlay:IsA("GuiButton") then
                firesignal(autoPlay.MouseButton1Click)
            end
        end)

        task.spawn(function()
            local lastLoggedCount = initialHave
            while task.wait(1.5) do
                local currentHave = getOwnedItemCount(targetItemId)
                currentFarmingProgress = string.format("%d / %d", currentHave, targetNeeded)

                if currentHave ~= lastLoggedCount then
                    print(string.format("📦 [تحديث الفارم] القطعة: %s | وصل العدد: %d / %d (+%d جديدة!)", 
                        targetName, currentHave, targetNeeded, currentHave - lastLoggedCount))
                    lastLoggedCount = currentHave
                end

                local returnBtn = nil
                for _, btn in ipairs(PG:GetDescendants()) do
                    if btn:IsA("TextButton") and btn.Text:lower():find("return") and btn.Visible then
                        returnBtn = btn
                        break
                    end
                end

                if returnBtn then
                    print(string.format("🏁 نهاية المرحلة! القطعة: %s | الحصيلة: %d / %d", targetName, currentHave, targetNeeded))
                    if currentHave >= targetNeeded then
                        print(string.format("🎉 [اكتملت القطعة] %s وصلت للحد المطلوب (%d/%d)! العودة للوبي...", targetName, currentHave, targetNeeded))
                        firesignal(returnBtn.MouseButton1Click)
                        task.wait(1)
                        pcall(function() TeleportService:Teleport(STORY_PLACE_ID, LP) end)
                        break
                    else
                        print(string.format("🔄 لم تكتمل بعد (%d/%d)، إعادة المرحلة...", currentHave, targetNeeded))
                        local retryRemote = Remotes:FindFirstChild("RetryGame") or Remotes:FindFirstChild("MatchmakingAction")
                        if retryRemote then
                            pcall(function() retryRemote:FireServer() end)
                        else
                            firesignal(returnBtn.MouseButton1Click)
                        end
                        break
                    end
                end
            end
        end)
    end
end

