local function normUnit(s)
    local x = cleanStr(s)
    x = x:gsub("awakened", ""):gsub("%d+$", "")
    return x
end

local function matchRecipe(bagName)
    local n = normUnit(bagName)
    if n == "" then return nil end
    local best, bestLen = nil, 0
    for _, k in ipairs(recipeKeys) do
        local r = unitEvolutionRecipes[k]
        for _, cand in ipairs({ r.BaseUnit, r.DisplayName, r.Key }) do
            local c = normUnit(cand)
            if c ~= "" then
                if c == n then return r end
                local short = math.min(#c, #n)
                if short >= 4 and c:sub(1, short) == n:sub(1, short) and short > bestLen then
                    best, bestLen = r, short
                end
            end
        end
    end
    return best
end

