-- دالة مرنة لفك متطلبات القطع من الموديول
local function extractRequirements(data)
    local items = {}
    local cost = 15000

    if type(data) ~= "table" then return items, cost end

    cost = tonumber(data.Price or data.Cost or data.Yen or data.Gold or 15000) or 15000

    local rawItems = data["Require Items"] or data.RequireItems or data["Require_Items"] 
                  or data.ItemRequirement or data.Requirements or data.Items

    if not rawItems then
        for k, v in pairs(data) do
            if type(v) == "table" and (tostring(k):lower():find("item") or tostring(k):lower():find("require")) then
                rawItems = v
                break
            end
        end
    end

    if not rawItems then rawItems = data end

    if type(rawItems) == "table" then
        for k, v in pairs(rawItems) do
            if type(v) == "table" then
                local id = v.Id or v.ID or v.Name or v.Item or v[1]
                local amt = v.Amount or v.Count or v.Quantity or v[2] or 1
                if id then
                    table.insert(items, { Id = tostring(id), Amount = tonumber(amt) or 1 })
                else
                    for subId, subAmt in pairs(v) do
                        if tonumber(subAmt) then
                            table.insert(items, { Id = tostring(subId), Amount = tonumber(subAmt) })
                        end
                    end
                end
            elseif type(v) == "number" then
                table.insert(items, { Id = tostring(k), Amount = v })
            elseif type(v) == "string" then
                local iName, iAmt = v:match("^(.-)%s*:%s*(%d+)")
                if iName and iAmt then
                    table.insert(items, { Id = iName, Amount = tonumber(iAmt) or 1 })
                else
                    table.insert(items, { Id = v, Amount = 1 })
                end
            end
        end
    end

    return items, cost
end

-- 2. سحب جميع وصفات التطوير من مجلد Requirements
local unitEvolutionRecipes = {}

local function loadAllEvolutionRecipes()
    local reqFolder = RS:FindFirstChild("Requirements", true)
    local targetModules = {}

    if reqFolder then
        for _, child in ipairs(reqFolder:GetChildren()) do
            if child:IsA("ModuleScript") then
                table.insert(targetModules, child)
            end
        end
    end

    if #targetModules == 0 then
        for _, desc in ipairs(RS:GetDescendants()) do
            if desc:IsA("ModuleScript") and desc.Name:find("_Awakened") and not desc:GetFullName():find("UnitData") then
                table.insert(targetModules, desc)
            end
        end
    end

    for _, mod in ipairs(targetModules) do
        local ok, data = pcall(require, mod)
        if ok and type(data) == "table" then
            local items, cost = extractRequirements(data)
            local baseName = mod.Name:gsub("_Awakened", ""):gsub("_evo", "")
            
            local dispName = baseName
            pcall(function()
                local uMod = RS:FindFirstChild(mod.Name, true)
                if uMod and uMod:IsA("ModuleScript") and uMod ~= mod then
                    local uData = require(uMod)
                    if uData and (uData.DisplayName or uData.Name) then
                        dispName = uData.DisplayName or uData.Name
                    end
                end
            end)

            unitEvolutionRecipes[mod.Name] = {
                Key = mod.Name,
                BaseUnit = baseName,
                DisplayName = dispName,
                Cost = cost,
                Requirements = items
            }
        end
    end
end
loadAllEvolutionRecipes()

-- 3. موديولات اللوبي والدروبات
local itemDropIndex = {}
local CraftingConfig = nil
local EvolutionRecipes = nil

