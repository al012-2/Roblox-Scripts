-- ============================ استخراج المتطلبات بدقة ==========================
local function extractRequirements(data)
    local items, cost = {}, 15000
    if type(data) ~= "table" then return items, cost end
    cost = tonumber(data.Price or data.Cost or data.Yen or data.Gold) or cost

    local raw = data["Require Items"] or data.RequireItems or data["Require_Items"]
        or data.ItemRequirement or data.Requirements or data.Items
    if not raw then
        for k, v in pairs(data) do
            local kl = tostring(k):lower()
            if type(v) == "table" and (kl:find("item") or kl:find("require")) then raw = v break end
        end
    end
    raw = raw or data

    if type(raw) == "table" then
        if raw.Items and type(raw.Items) == "table" then raw = raw.Items end
        for k, v in pairs(raw) do
            if type(v) == "table" then
                local id = v.Id or v.ID or v.Name or v.Item or v[1]
                local amt = v.Amount or v.Count or v.Quantity or v[2] or 1
                if id then
                    table.insert(items, { Id = tostring(id), Amount = tonumber(amt) or 1 })
                else
                    for subId, subAmt in pairs(v) do
                        if tonumber(subAmt) then
                            table.insert(items, { Id = tostring(subId), Amount = tonumber(subAmt) })
                        end
                    end
                end
            elseif type(v) == "number" then
                table.insert(items, { Id = tostring(k), Amount = v })
            elseif type(v) == "string" then
                local n, a = v:match("^(.-)%s*:%s*(%d+)")
                table.insert(items, { Id = n or v, Amount = tonumber(a) or 1 })
            end
        end
    end
    return items, cost
end

-- ============================ فهرسة الدروبات (اللوبي فقط) =====================
local itemDropIndex = {}
local CraftingConfig, EvolutionRecipes = nil, nil

if isInLobby then
    pcall(function() CraftingConfig = require(RS.Modules.CraftingModule.CraftingConfig) end)
    pcall(function() EvolutionRecipes = require(RS.Modules.CraftingModule.CraftingConfig.EvolutionRecipes) end)

    local MapConfig = nil
    pcall(function()
        local m = RS.Modules:FindFirstChild("MapConfig", true)
        if m and m:IsA("ModuleScript") then MapConfig = require(m) end
    end)

    local mapsByName = {}
    if type(MapConfig) == "table" then
        for _, info in pairs(MapConfig) do
            if type(info) == "table" and info.MapToCreate then mapsByName[info.MapToCreate] = info end
        end
    end

    local folder = RS.Modules:FindFirstChild("MapStageReward", true)
    if folder then
        for _, rewardMod in ipairs(folder:GetChildren()) do
            local ok, stages = pcall(require, rewardMod)
            local mapInfo = mapsByName[rewardMod.Name]
                or { Name = rewardMod.Name, MapToCreate = rewardMod.Name, Mode = "Story" }
            if ok and type(stages) == "table" then
                for act, details in pairs(stages) do
                    local items = type(details) == "table" and details.Rewards and details.Rewards.Items
                    if items then
                        for _, r in ipairs(items) do
                            local list = itemDropIndex[r.Id] or {}
                            itemDropIndex[r.Id] = list
                            for _, diff in ipairs(r.Difficulty or { "Normal", "Hard", "Nightmare" }) do
                                table.insert(list, {
                                    MapInfo = mapInfo, Act = act, Rewards = details.Rewards,
                                    Chance = tonumber(r.Chance) or 0, Difficulty = diff,
                                })
                            end
                        end
                    end
                end
            end
        end
    end
end

-- ============================ وصفات التطوير ===================================
local unitEvolutionRecipes = {}
do
    local mods = {}
    local reqFolder = RS:FindFirstChild("Requirements", true)
    if reqFolder then
        for _, c in ipairs(reqFolder:GetChildren()) do
            if c:IsA("ModuleScript") then table.insert(mods, c) end
        end
    end
    if #mods == 0 then
        for _, d in ipairs(RS:GetDescendants()) do
            if d:IsA("ModuleScript") and d.Name:find("_Awakened") and not d:GetFullName():find("UnitData") then
                table.insert(mods, d)
            end
        end
    end

    for _, mod in ipairs(mods) do
        local ok, data = pcall(require, mod)
        if ok and type(data) == "table" then
            local items, cost = extractRequirements(data)
            local baseName = mod.Name:gsub("_Awakened", ""):gsub("_evo", "")
            local dispName = baseName
            pcall(function()
                local uMod = RS:FindFirstChild(mod.Name, true)
                if uMod and uMod ~= mod and uMod:IsA("ModuleScript") then
                    local u = require(uMod)
                    if u and (u.DisplayName or u.Name) then dispName = u.DisplayName or u.Name end
                end
            end)
            unitEvolutionRecipes[mod.Name] = {
                Key = mod.Name, BaseUnit = baseName, DisplayName = cleanRichText(tostring(dispName)),
                Cost = cost, Requirements = items,
            }
        end
    end
end

-- ============================ مطابقة الأسماء والدروبات =========================
local function cleanStr(s) return (tostring(s):lower():gsub("[%s_%-]+", "")) end

local function findDropsForItem(itemId)
    if itemDropIndex[itemId] then return itemDropIndex[itemId] end
    local target = cleanStr(itemId)
    local keys = {}
    for k in pairs(itemDropIndex) do table.insert(keys, k) end
    table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)

    for _, k in ipairs(keys) do
        if cleanStr(k) == target then return itemDropIndex[k] end
    end
    if #target >= 5 then -- حد 5 أحرف لتفادي المطابقات الجزئية العشوائية
        for _, k in ipairs(keys) do
            local ck = cleanStr(k)
            if ck:find(target, 1, true) or target:find(ck, 1, true) then return itemDropIndex[k] end
        end
    end
    return {}
end

local function bestDrop(drops)
    local best = drops[1]
    for _, d in ipairs(drops) do
        if d.Chance > best.Chance then best = d end
    end
    return best
end

local function bumpAttempt(target)
    target.Attempts = (target.Attempts or 0) + 1
    saveTarget(target)
    return target.Attempts <= MAX_ATTEMPTS
end

-- ============================ التيليبورت ======================================
local lobbyRetries = 0
TeleportService.TeleportInitFailed:Connect(function(player)
    if player ~= LP or lobbyRetries >= 3 then return end
    lobbyRetries += 1
    log(("Teleport failed, retrying (%d/3)..."):format(lobbyRetries))
    task.wait(3)
    pcall(function() TeleportService:Teleport(STORY_PLACE_ID, LP) end)
end)

local function returnToLobby()
    lobbyRetries = 0
    pcall(function() TeleportService:Teleport(STORY_PLACE_ID, LP) end)
end

local function teleportToStage(stage)
    if not (isInLobby and Remotes) then return end
    local update = Remotes:FindFirstChild("UpdateLobbySettings")
    local join = Remotes:FindFirstChild("RequestJoinLobby")
    local tp = Remotes:FindFirstChild("TeleportRequest")
    local act = tonumber(stage.Act) or stage.Act
    local mode = stage.MapInfo.Mode or "Story"

    if join then pcall(function() join:InvokeServer("Create") end) end
    task.wait(0.4)
    if update then
        update:FireServer(stage.MapInfo.Name, act, stage.Rewards, stage.Difficulty, stage.MapInfo.MapToCreate, mode)
    end
    task.wait(0.4)
    if tp then
        tp:FireServer(STORY_PLACE_ID, mode, stage.MapInfo.MapToCreate, act, stage.Difficulty)
    end
end

-- ============================ منطق الفارم =====================================
local function processFarmingTarget(target)
    if not Config.AutoFarm then
        WindUI:Notify({ Title = "Auto Farm Disabled", Content = "Enable 'Auto Farm Active' in Settings first.", Duration = 4 })
        return false
    end

    if isInLobby then resync(0) end

    local missing = nil
    for _, req in ipairs(target.Requirements or {}) do
        local need = req.Amount or 1
        if getOwnedItemCount(req.Id) < need then
            missing = { Id = req.Id, Amount = need, Name = getItemDisplayName(req.Id) }
            break
        end
    end

    if not missing then
        log("All requirements completed!")
        WindUI:Notify({ Title = "Complete", Content = "All required items collected!", Duration = 4 })
        clearSavedTarget()
        return false
    end

    target.CurrentItem = missing
    saveTarget(target)
    if not isInLobby then return true end

    local drops = findDropsForItem(missing.Id)
    if #drops == 0 then
        warn("[AM Hub] No stage found dropping: " .. missing.Name)
        WindUI:Notify({ Title = "No Drop Stage", Content = "No stage records found for: " .. missing.Name, Duration = 4 })
        return false
    end

    if not bumpAttempt(target) then
        warn(("[AM Hub] Reached maximum attempts (%d). Auto Farm Stopped."):format(MAX_ATTEMPTS))
        clearSavedTarget()
        return false
    end

    local stage = bestDrop(drops)
    log(("Round %d/%d: %s [%s] in %s (%s%%)"):format(
        target.Attempts, MAX_ATTEMPTS, missing.Name, stage.Difficulty, stage.MapInfo.Name, tostring(stage.Chance)))
    task.wait(0.5)
    teleportToStage(stage)
    return true
end

-- تشغيل الفارم المحفوظ تلقائياً في اللوبي
if isInLobby then
    local active = getSavedTarget()
    if active and Config.AutoFarm then
        task.spawn(function() task.wait(2) processFarmingTarget(active) end)
    end
end

local function startTarget(name, requirements)
    if not isInLobby then
        WindUI:Notify({ Title = "Notice", Content = "Select farm target inside the Lobby.", Duration = 3 })
        return
    end
    if not Config.AutoFarm then
        WindUI:Notify({ Title = "Auto Farm Disabled", Content = "Turn on 'Auto Farm Active' in Settings to start.", Duration = 4 })
        return
    end
    task.spawn(processFarmingTarget, { Name = name, Requirements = requirements })
end

-- ============================ لوحة المتطلبات التفاعلية (Scroll + Red/Green) ===
local GREEN = Color3.fromRGB(80, 220, 120)
local RED   = Color3.fromRGB(240, 85, 85)

local function showRequirements(title, requirements)
    local old = PG:FindFirstChild("AM_ReqPanel")
    if old then old:Destroy() end

    local normalizedReqs = {}
    local rawList, _ = extractRequirements(requirements)
    if #rawList > 0 then
        for _, it in ipairs(rawList) do table.insert(normalizedReqs, it) end
    elseif type(requirements) == "table" then
        for _, it in ipairs(requirements) do table.insert(normalizedReqs, it) end
    end

    -- ترتيب الأولوية المحفوظة لهذي الوصفة فقط (ترتيب ثابت: عند التساوي يبقى الترتيب الأصلي)
    local key = cleanRichText(title)
    do
        local orderMap = {}
        for idx, id in ipairs(Config.PriorityOrder[key] or {}) do orderMap[id] = idx end
        local pos = {}
        for i, it in ipairs(normalizedReqs) do pos[it] = i end
        table.sort(normalizedReqs, function(a, b)
            local oa, ob = orderMap[a.Id] or 999, orderMap[b.Id] or 999
            if oa ~= ob then return oa < ob end
            return pos[a] < pos[b]
        end)
    end

    local function savePriority()
        local ids = {}
        for _, itm in ipairs(normalizedReqs) do ids[#ids + 1] = itm.Id end
        Config.PriorityOrder[key] = ids
        saveConfig()
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = "AM_ReqPanel"
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 100
    gui.Parent = PG

    local frame = Instance.new("Frame")
    frame.Size = UDim2.fromOffset(470, 430)
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    frame.Position = UDim2.fromScale(0.5, 0.5)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
    frame.Active = true
    frame.Draggable = true
    frame.Parent = gui

    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Color3.fromRGB(99, 102, 241)
    stroke.Thickness = 1.5

    local titleLbl = Instance.new("TextLabel")
    titleLbl.BackgroundTransparency = 1
    titleLbl.Size = UDim2.new(1, -30, 0, 26)
    titleLbl.Position = UDim2.fromOffset(15, 10)
    titleLbl.Text = cleanRichText(title)
    titleLbl.TextSize = 17
    titleLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.TextTruncate = Enum.TextTruncate.AtEnd
    titleLbl.Parent = frame

    local summaryLbl = Instance.new("TextLabel")
    summaryLbl.BackgroundTransparency = 1
    summaryLbl.Size = UDim2.new(1, -30, 0, 18)
    summaryLbl.Position = UDim2.fromOffset(15, 36)
    summaryLbl.TextSize = 13
    summaryLbl.Font = Enum.Font.GothamMedium
    summaryLbl.TextXAlignment = Enum.TextXAlignment.Left
    summaryLbl.Parent = frame

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1, -26, 1, -125)
    scroll.Position = UDim2.fromOffset(13, 60)
    scroll.BackgroundColor3 = Color3.fromRGB(26, 26, 32)
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 7
    scroll.ScrollBarImageColor3 = Color3.fromRGB(99, 102, 241)
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.ScrollingDirection = Enum.ScrollingDirection.Y
    scroll.Parent = frame
    Instance.new("UICorner", scroll).CornerRadius = UDim.new(0, 8)

    local listLayout = Instance.new("UIListLayout", scroll)
    listLayout.Padding = UDim.new(0, 5)
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local padding = Instance.new("UIPadding", scroll)
    padding.PaddingTop = UDim.new(0, 6)
    padding.PaddingBottom = UDim.new(0, 6)
    padding.PaddingLeft = UDim.new(0, 8)
    padding.PaddingRight = UDim.new(0, 12)

    local startBtn
    local allDone = false

    -- doResync: القراءة الجديدة (getgc) فقط عند الفتح وزر Refresh، مو عند ▲/▼
    local function render(doResync)
        if doResync and isInLobby then resync(0) end
        for _, c in ipairs(scroll:GetChildren()) do
            if c:IsA("Frame") then c:Destroy() end
        end

        local completeCount, totalCount = 0, 0

        for i, req in ipairs(normalizedReqs) do
            totalCount = totalCount + 1
            local need = req.Amount or 1
            local have = getOwnedItemCount(req.Id)
            local isDone = have >= need
            if isDone then completeCount = completeCount + 1 end

            local rowColor = isDone and GREEN or RED
            local dropInfo = nil

            if not isDone and isInLobby then
                local drops = findDropsForItem(req.Id)
                if #drops > 0 then
                    local best = bestDrop(drops)
                    dropInfo = ("Best: %s [%s] (%s%%)"):format(best.MapInfo.Name, best.Difficulty, tostring(best.Chance))
                else
                    dropInfo = "No drop stage recorded"
                end
            end

            local row = Instance.new("Frame")
            row.LayoutOrder = i
            row.Size = UDim2.new(1, 0, 0, dropInfo and 48 or 34)
            row.BackgroundColor3 = Color3.fromRGB(34, 34, 42)
            row.BorderSizePixel = 0
            row.Parent = scroll
            Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

            -- أزرار ترتيب الأولوية (▲ / ▼)
            local upBtn = Instance.new("TextButton")
            upBtn.Size = UDim2.fromOffset(20, 18)
            upBtn.Position = UDim2.fromOffset(6, 6)
            upBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
            upBtn.TextColor3 = Color3.fromRGB(200, 200, 210)
            upBtn.Text = "▲"
            upBtn.TextSize = 10
            upBtn.Font = Enum.Font.GothamBold
            upBtn.Parent = row
            Instance.new("UICorner", upBtn).CornerRadius = UDim.new(0, 4)

            local downBtn = Instance.new("TextButton")
            downBtn.Size = UDim2.fromOffset(20, 18)
            downBtn.Position = UDim2.fromOffset(28, 6)
            downBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
            downBtn.TextColor3 = Color3.fromRGB(200, 200, 210)
            downBtn.Text = "▼"
            downBtn.TextSize = 10
            downBtn.Font = Enum.Font.GothamBold
            downBtn.Parent = row
            Instance.new("UICorner", downBtn).CornerRadius = UDim.new(0, 4)

            upBtn.MouseButton1Click:Connect(function()
                if i > 1 then
                    normalizedReqs[i], normalizedReqs[i - 1] = normalizedReqs[i - 1], normalizedReqs[i]
                    savePriority()
                    render()
                end
            end)

            downBtn.MouseButton1Click:Connect(function()
                if i < #normalizedReqs then
                    normalizedReqs[i], normalizedReqs[i + 1] = normalizedReqs[i + 1], normalizedReqs[i]
                    savePriority()
                    render()
                end
            end)

            local itemName = getItemDisplayName(req.Id)

            local nameText = Instance.new("TextLabel")
            nameText.BackgroundTransparency = 1
            nameText.Size = UDim2.new(1, -170, 0, 20)
            nameText.Position = UDim2.fromOffset(54, 5)
            nameText.Text = (isDone and "✓ " or "✗ ") .. itemName
            nameText.TextSize = 14
            nameText.TextColor3 = rowColor
            nameText.Font = Enum.Font.GothamMedium
            nameText.TextXAlignment = Enum.TextXAlignment.Left
            nameText.TextTruncate = Enum.TextTruncate.AtEnd
            nameText.Parent = row

            local countText = Instance.new("TextLabel")
            countText.BackgroundTransparency = 1
            countText.Size = UDim2.fromOffset(100, 20)
            countText.Position = UDim2.new(1, -108, 0, 5)
            countText.Text = ("%d / %d"):format(have, need)
            countText.TextSize = 14
            countText.TextColor3 = rowColor
            countText.Font = Enum.Font.GothamBold
            countText.TextXAlignment = Enum.TextXAlignment.Right
            countText.Parent = row

            if dropInfo then
                local dropText = Instance.new("TextLabel")
                dropText.BackgroundTransparency = 1
                dropText.Size = UDim2.new(1, -60, 0, 16)
                dropText.Position = UDim2.fromOffset(54, 26)
                dropText.Text = dropInfo
                dropText.TextSize = 11
                dropText.TextColor3 = Color3.fromRGB(160, 160, 170)
                dropText.Font = Enum.Font.Gotham
                dropText.TextXAlignment = Enum.TextXAlignment.Left
                dropText.Parent = row
            end
        end

        allDone = (totalCount > 0 and completeCount == totalCount)

        if totalCount == 0 then
            summaryLbl.Text = "No requirement data found for this recipe."
            summaryLbl.TextColor3 = Color3.fromRGB(180, 180, 190)
        elseif allDone then
            summaryLbl.Text = ("All materials acquired ✅ (%d / %d)"):format(completeCount, totalCount)
            summaryLbl.TextColor3 = GREEN
        else
            summaryLbl.Text = ("Completed: %d of %d items (Use ▲/▼ for Priority)"):format(completeCount, totalCount)
            summaryLbl.TextColor3 = Color3.fromRGB(240, 190, 80)
