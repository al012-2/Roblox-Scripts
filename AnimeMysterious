        if btn:IsA("TextButton") and btn.Text:lower():find("return") then
            local ours = btn:FindFirstAncestor("AM_ToggleFloating")
            if not ours and isGuiShown(btn) then return btn end
        end
    end
    return nil
end

if not isInLobby then
    -- مراقب جمع السيوف بالمنصة المخفية
    task.spawn(function()
        local KEYWORD = "swordprompt"
        local MAX_PER_ROUND = 10
        local SETTLE = 0.2
        local STEP_DELAY = 0.5
        local ROUND_TIMEOUT = 45
        local tracked = {}

        local function isSwordPrompt(p)
            return p.Name:lower():find(KEYWORD, 1, true) ~= nil
        end
        local function track(p)
            if p:IsA("ProximityPrompt") then tracked[p] = true end
        end
        for _, d in ipairs(workspace:GetDescendants()) do track(d) end
        workspace.DescendantAdded:Connect(track)
        workspace.DescendantRemoving:Connect(function(d) tracked[d] = nil end)

        local counterLbl, waveLbl = nil, nil
        local lastScan = 0

        local function alive(l) return l ~= nil and l.Parent ~= nil and l:IsDescendantOf(PG) end

        local function parseCounter(l)
            local a, b = l.Text:match("%(%s*(%d+)%s*/%s*(%d+)%s*%)")
            if a and tonumber(b) == MAX_PER_ROUND then return tonumber(a) end
        end
        local function parseWave(l)
            local a, b = l.Text:match("[Ww][Aa][Vv][Ee]%s*:?%s*(%d+)%s*/%s*(%d+)")
            if a then return tonumber(a), tonumber(b) end
        end

        local function rescan()
            if tick() - lastScan < 2 then return end
            lastScan = tick()
            for _, l in ipairs(PG:GetDescendants()) do
                if l:IsA("TextLabel") and l.Visible then
                    if not counterLbl and parseCounter(l) then counterLbl = l end
                    if not waveLbl and parseWave(l) then waveLbl = l end
                end
            end
        end

        local function readCounter()
            if alive(counterLbl) and counterLbl.Visible then
                local v = parseCounter(counterLbl)
                if v then return v end
            end
            counterLbl = nil
            rescan()
            if counterLbl then return parseCounter(counterLbl) end
            return nil
        end

        local function readWave()
            if alive(waveLbl) then
                local n, m = parseWave(waveLbl)
                if n then return n, m end
            end
            waveLbl = nil
            rescan()
            if waveLbl then return parseWave(waveLbl) end
            return nil
        end

        local function eventActive()
            local c = readCounter()
            if c then return true, c end
            local n, m = readWave()
            if n and m and n >= m then return true, nil end
            return false, nil
        end

        local function getRoot()
            local c = LP.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then return r end
            return nil
        end

        local function promptPos(p)
            local par = p.Parent
            local part = par and (par:IsA("BasePart") and par or p:FindFirstAncestorWhichIsA("BasePart"))
            return part and part.Position or nil
        end

        local function nextSword(fromPos, fired)
            local best, bestPos, bestD
            for p in pairs(tracked) do
                if p.Parent and p.Enabled and not fired[p] and isSwordPrompt(p) then
                    local pos = promptPos(p)
                    if pos then
                        local d = (pos - fromPos).Magnitude
                        if not bestD or d < bestD then best, bestPos, bestD = p, pos, d end
                    end
                end
            end
            return best, bestPos
        end

        local preferHold, modeKnown = false, false
        local function press(p, hold)
            if preferHold then
                pcall(function()
                    p.HoldDuration = hold
                    p:InputHoldBegin()
                    task.wait(hold + 0.15)
                    p:InputHoldEnd()
                end)
            else
                pcall(function()
                    p.HoldDuration = 0
                    p.RequiresLineOfSight = false
                end)
                if fireproximityprompt then pcall(fireproximityprompt, p) end
            end
        end

        local function collectRound()
            local root = getRoot()
            if not root then return 0 end
            if not nextSword(root.Position, {}) then return 0 end
            local origin = root.CFrame

            local platform = Instance.new("Part")
            platform.Name = "AM_SafePlatform"
            platform.Size = Vector3.new(10, 1, 10)
            platform.Anchored = true
            platform.CanCollide = true
            platform.Transparency = 1
            platform.Parent = workspace

            local fired, count = {}, 0
            local deadline = tick() + ROUND_TIMEOUT

            local ok, err = pcall(function()
                while tick() < deadline do
                    root = getRoot()
                    if not root then break end

                    local now = readCounter()
                    if now and now >= MAX_PER_ROUND then break end
                    if not now and count >= MAX_PER_ROUND then break end

                    local p, pos = nextSword(root.Position, fired)
                    if not p then break end
                    fired[p] = true
                    count += 1
                    local hold = p.HoldDuration

                    platform.CFrame = CFrame.new(pos - Vector3.new(0, 1, 0))
                    root.CFrame = CFrame.new(pos + Vector3.new(0, 2.5, 0))
                    root.AssemblyLinearVelocity = Vector3.zero
                    task.wait(SETTLE)

                    press(p, hold)
                    task.wait(STEP_DELAY)
                    local after = readCounter()

                    if now and after and after <= now and hold > 0 and not modeKnown then
                        preferHold = not preferHold
                        press(p, hold)
                        task.wait(STEP_DELAY)
                        local retry = readCounter()
                        if retry and retry > after then
                            after = retry
                            log("press mode switched, hold mode = " .. tostring(preferHold))
                        else
                            preferHold = not preferHold
                        end
                    end
                    if now and after and after > now then modeKnown = true end

                    -- إرجاع اللوق الصريح لكل سيف
                    if now and after then
                        log(("sword %s: %d -> %d %s"):format(
                            p.Parent and p.Parent.Name or "?", now, after,
                            after > now and "(counted)" or "(NOT counted - already used?)"))
                    else
                        log("pressed " .. p:GetFullName() .. " (counter not found)")
                    end
                end
            end)

            platform:Destroy()
            local r = getRoot()
            if r then r.CFrame = origin end
            if not ok then warn("[AM Hub] sword round error: " .. tostring(err)) end
            return count
        end

        local doneThisEvent, lastCount, wasActive = false, nil, false

        while task.wait(1) do
            -- التحقق داخل الحلقة ليتفاعل التبديل فوراً
            if not Config.FarmSwords then continue end

            local active, cur = eventActive()
            if not active then
                if wasActive then log("event ended / not active, waiting...") end
                wasActive, doneThisEvent, lastCount = false, false, nil
            else
                if not wasActive then log("sword event active, starting...") end
                wasActive = true

                if cur and lastCount and cur < lastCount then doneThisEvent = false end
                lastCount = cur or lastCount

                if not doneThisEvent and not (cur and cur >= MAX_PER_ROUND) then
                    local n = collectRound()
                    if n > 0 then
                        doneThisEvent = true
                        lastCount = readCounter() or lastCount
                        log(("collect round finished, pressed %d swords"):format(n))
                    end
                end
            end
        end
    end)

    -- حلقة مراقبة الستوري والإنهاء
    task.spawn(function()
        while task.wait(1.5) do
            local target = getSavedTarget()
            if target and target.CurrentItem then
                local id = target.CurrentItem.Id
                local need = target.CurrentItem.Amount
                local name = target.CurrentItem.Name or id
                local have = getOwnedItemCount(id)

                if targetParagraph then pcall(function() targetParagraph:SetDesc(tostring(name)) end) end
                if progressParagraph then pcall(function() progressParagraph:SetDesc(("%d / %d"):format(have, need)) end) end

                local autoPlay = PG:FindFirstChild("Automatic Play", true)
                if autoPlay and autoPlay:IsA("GuiButton") and isGuiShown(autoPlay) then
                    pcall(firesignal, autoPlay.MouseButton1Click)
                end

                local ret = findReturnButton()
                if ret then
                    resync(0)
                    have = getOwnedItemCount(id)

                    -- إذا اكتملت المواد ارجع للوبي
                    if have >= need then
                        log(("Item completed %s (%d/%d), returning to lobby..."):format(name, have, need))
                        pcall(firesignal, ret.MouseButton1Click)
                        task.wait(2)
                        returnToLobby()
                        break
                    end

                    -- فحص AutoFarm قبل تكرار الجولة
                    local retry = Remotes and (Remotes:FindFirstChild("RetryGame") or Remotes:FindFirstChild("MatchmakingAction"))
                    if Config.AutoFarm and retry and bumpAttempt(target) then
                        log(("Retrying round %d/%d (%s: %d/%d)"):format(target.Attempts, MAX_ATTEMPTS, name, have, need))
                        pcall(function() retry:FireServer() end)
                        task.wait(8)
                    else
                        if retry and not Config.AutoFarm then
                            log("Auto Farm is toggled OFF. Returning to lobby...")
                        elseif retry then
                            warn("[AM Hub] Max attempts reached, stopping.")
                            clearSavedTarget()
                        end
                        pcall(firesignal, ret.MouseButton1Click)
                        task.wait(2)
                        returnToLobby()
                        break
                    end
                end
            end
        end
    end)
end

