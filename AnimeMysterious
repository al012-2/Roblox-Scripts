-- ============================ بيانات اللاعب ===================================
local playerData = nil

local function scanForData()
    local found = nil
    pcall(function()
        for _, obj in ipairs(getgc(true)) do
            if type(obj) == "table" then
                local ok, d = pcall(rawget, obj, "Data")
                if ok and type(d) == "table" and rawget(d, "ItemInventory") and rawget(d, "Inventory") then
                    found = d
                    break
                end
            end
        end
    end)
    return found
end

local function resync(timeout)
    timeout = timeout or 0
    local start = tick()
    while true do
        local d = scanForData()
        if d then playerData = d return true end
        local left = timeout - (tick() - start)
        if left <= 0 then return false end
        task.wait(math.min(2, left))
    end
end

resync(15)

local function getOwnedItemCount(itemId)
    if playerData and playerData.ItemInventory then
        return tonumber(playerData.ItemInventory[itemId]) or 0
    end
    return 0
end

local UnitConfig = nil
pcall(function() UnitConfig = require(RS.Modules.UnitConfig) end)

local function resolveUnitName(unitId)
    local u = UnitConfig and type(UnitConfig.Units) == "table" and UnitConfig.Units[unitId]
    if type(u) == "table" then
        return cleanRichText(u.Name or u.DisplayName or unitId)
    end
    return tostring(unitId)
end

local function getBagUnits()
    local bag = {}
    local inv = playerData and playerData.Inventory
    if type(inv) ~= "table" then return bag end
    for slotId, info in pairs(inv) do
        if type(info) == "table" then
            local id = info.UnitId or info.Id or info.Name
            if id then
                table.insert(bag, {
                    Slot = slotId,
                    UnitId = tostring(id),
                    Name = resolveUnitName(id),
                    Level = tonumber(info.Level or info.Lv) or 1,
                })
            end
        elseif type(info) == "string" then
            table.insert(bag, { Slot = slotId, UnitId = info, Name = resolveUnitName(info), Level = 1 })
        end
    end
    return bag
end

