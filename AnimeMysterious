-- دوال حفظ واسترجاع المهمة
local function saveTarget(data)
    if writefile then
        writefile(TARGET_FILE, HttpService:JSONEncode(data))
    end
end

local function getSavedTarget()
    if isfile and isfile(TARGET_FILE) then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(readfile(TARGET_FILE))
        end)
        if ok and type(data) == "table" then return data end
    end
    return nil
end

local function clearSavedTarget()
    if delfile and isfile and isfile(TARGET_FILE) then
        delfile(TARGET_FILE)
    end
end

-- 1. قراءة الـ Replica لمرة واحدة فقط
local playerData = nil
for _, obj in pairs(getgc(true)) do
    if type(obj) == "table" then
        local okData, dataTbl = pcall(function() return rawget(obj, "Data") end)
        if okData and type(dataTbl) == "table" and rawget(dataTbl, "ItemInventory") then
            playerData = dataTbl
            break
        end
    end
end

local function getOwnedItemCount(itemId)
    if playerData and playerData.ItemInventory then
        return playerData.ItemInventory[itemId] or 0
    end
    return 0
end

local function getBagUnits()
    local bag = {}
    if playerData and playerData.Inventory and type(playerData.Inventory) == "table" then
        for slotId, unitInfo in pairs(playerData.Inventory) do
            if type(unitInfo) == "table" then
                local uName = unitInfo.Name or unitInfo.Id or unitInfo.UnitId
                if uName then
                    table.insert(bag, {
                        Slot = slotId,
                        Name = tostring(uName),
                        Level = tonumber(unitInfo.Level or unitInfo.Lv) or 1
                    })
                end
            elseif type(unitInfo) == "string" then
                table.insert(bag, { Slot = slotId, Name = unitInfo, Level = 1 })
            end
        end
    end
    return bag
end

