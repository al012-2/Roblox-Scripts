local bagUnits = getBagUnits()
local matchedOwnedCount = 0

local function checkMatch(bagName, recipe)
    local b = bagName:lower()
    local rBase = recipe.BaseUnit:lower()
    local rDisp = recipe.DisplayName:lower()
    local rKey = recipe.Key:lower()
    return b:find(rBase, 1, true) or rBase:find(b, 1, true) 
        or b:find(rDisp, 1, true) or rDisp:find(b, 1, true)
        or b:find(rKey, 1, true) or rKey:find(b, 1, true)
        or (b:find("saber") and rBase:find("gojo"))
        or (b:find("gojo") and rBase:find("saber"))
end

for _, u in ipairs(bagUnits) do
    local matchedRecipe = nil
    for _, rData in pairs(unitEvolutionRecipes) do
        if checkMatch(u.Name, rData) then
            matchedRecipe = rData
            break
        end
    end

    if matchedRecipe then
        matchedOwnedCount = matchedOwnedCount + 1
        local btnTitle = string.format("🟢 %s (لفل %d) ➔ %s", matchedRecipe.DisplayName, u.Level, matchedRecipe.Key)
        local btnDesc = string.format("السلوت: %s | تكلفة: %s ين | فرم متطلبات التطوير", tostring(u.Slot), tostring(matchedRecipe.Cost))

