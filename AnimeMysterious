-- ============================ Helper: Clean HTML / RichText ===================
local function cleanRichText(str)
    if type(str) ~= "string" then return tostring(str or "") end
    local s = str:gsub("<[^>]+>", "")
    s = s:gsub("^%s+", ""):gsub("%s+$", "")
    return s
end

