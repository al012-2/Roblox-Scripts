    pcall(function() EvolutionRecipes = require(RS.Modules.CraftingModule.CraftingConfig.EvolutionRecipes) end)

    local okMapCfg, MapConfig = pcall(function()
        local pm = RS.Modules:FindFirstChild("PlayingModule")
        return pm and require(pm:FindFirstChild("MapConfig"))
    end)

    local mapModulesByName = {}
    if okMapCfg and type(MapConfig) == "table" then
        for _, mapInfo in pairs(MapConfig) do
            if type(mapInfo) == "table" and mapInfo.MapToCreate then
                mapModulesByName[mapInfo.MapToCreate] = mapInfo
            end
        end
    end

    local mapStageRewardsFolder = nil
    pcall(function()
        mapStageRewardsFolder = RS.Modules.PlayingModule.MapConfig:FindFirstChild("MapStageReward")
    end)

    if mapStageRewardsFolder then
        for _, rewardMod in ipairs(mapStageRewardsFolder:GetChildren()) do
            local ok, stagesData = pcall(require, rewardMod)
            local mapInfo = mapModulesByName[rewardMod.Name]
            if ok and type(stagesData) == "table" and mapInfo then
                for actNumber, stageDetails in pairs(stagesData) do
                    if type(stageDetails) == "table" and stageDetails.Rewards and stageDetails.Rewards.Items then
                        for _, rewardItem in ipairs(stageDetails.Rewards.Items) do
                            itemDropIndex[rewardItem.Id] = itemDropIndex[rewardItem.Id] or {}
                            table.insert(itemDropIndex[rewardItem.Id], {
                                MapInfo = mapInfo,
                                Act = actNumber,
                                Rewards = stageDetails.Rewards,
                                Chance = rewardItem.Chance or 0,
                                Difficulties = rewardItem.Difficulty or {"Normal", "Hard", "Nightmare"}
                            })
                        end
                    end
                end
            end
        end
    end
end

-- دالة التيليبورت
local function teleportToStage(stageDropData, chosenDiff)
    if not isInLobby then return end
    local UpdateLobbySettings = Remotes:FindFirstChild("UpdateLobbySettings")
    local RequestJoinLobby = Remotes:FindFirstChild("RequestJoinLobby")
    local TeleportRequest = Remotes:FindFirstChild("TeleportRequest")

    if RequestJoinLobby then pcall(function() RequestJoinLobby:InvokeServer("Create") end) end
    task.wait(0.12)
    if UpdateLobbySettings then
        UpdateLobbySettings:FireServer(
            stageDropData.MapInfo.Name,
            tonumber(stageDropData.Act) or stageDropData.Act,
            stageDropData.Rewards,
            chosenDiff,
            stageDropData.MapInfo.MapToCreate,
            stageDropData.MapInfo.Mode or "Story"
        )
    end
    task.wait(0.12)
    if TeleportRequest then
        TeleportRequest:FireServer(
            STORY_PLACE_ID,
            stageDropData.MapInfo.Mode or "Story",
            stageDropData.MapInfo.MapToCreate,
            tonumber(stageDropData.Act) or stageDropData.Act,
            chosenDiff
        )
    end
end

local function findDropsForItem(itemId)
    if itemDropIndex[itemId] then return itemDropIndex[itemId] end
    local lower = tostring(itemId):lower():gsub("%s+", "")
    for k, v in pairs(itemDropIndex) do
        if tostring(k):lower():gsub("%s+", "") == lower or tostring(k):lower():find(lower, 1, true) or lower:find(tostring(k):lower(), 1, true) then
            return v
        end
    end
    return {}
end

-- دالة بدء الفارم المتتالي
local function processFarmingTarget(targetData)
    local nextMissing = nil

    for _, req in ipairs(targetData.Requirements) do
        local reqId = req.Id
        local needed = req.Amount or 1
        local owned = getOwnedItemCount(reqId)
        if owned < needed then
            nextMissing = { Id = reqId, Amount = needed, Name = getItemDisplayName(reqId) }
            break
        end
    end

    if not nextMissing then
        print("🎉 اكتملت جميع المتطلبات بالكامل!")
        clearSavedTarget()
        return false
    end

    targetData.CurrentItem = nextMissing
    saveTarget(targetData)

    if not isInLobby then
        print("ℹ️ تم حفظ الهدف، سيتم نقلك تلقائياً فور إنهاء المرحلة والعودة للوبي.")
        return true
    end

    local drops = findDropsForItem(nextMissing.Id)
    if #drops == 0 then
        warn("⚠️ لم يتم العثور على مرحلة تسقط: " .. nextMissing.Name)
        return false
    end

    local bestStage, bestDiff = drops[1], "Normal"
    local highestChance = -1
    for _, drop in ipairs(drops) do
        for _, diff in ipairs(drop.Difficulties) do
            local chance = tonumber(drop.Chance) or 0
            if chance > highestChance then
                highestChance = chance
                bestStage = drop
                bestDiff = diff
            end
        end
    end

    print(string.format("🚀 التوجه لفرم: %s [%s] في %s (نسبة السقوط: %s%%)", nextMissing.Name, bestDiff, bestStage.MapInfo.Name, tostring(highestChance)))
    task.wait(0.5)
    teleportToStage(bestStage, bestDiff)
    return true
end

