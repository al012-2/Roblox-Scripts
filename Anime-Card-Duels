local rollEngine = task.spawn(function()
    while Hub.Running do
        local canRoll = Hub.Settings.AutoRoll
            and (Hub.Settings.RollInBattle or not Hub.State.InBattle)

        if canRoll then
            local ok, res = pcall(function()
                return RollRemote:InvokeServer()
            end)

            if not ok or res == false then
                local rollBtn = PlayerGui:FindFirstChild("RollHud")
                    and PlayerGui.RollHud.Canvas:FindFirstChild("Roll")
                if rollBtn and safeClick(rollBtn) then
                    ok = true
                    res = nil
                end
            end

            if ok and res ~= false then
                Hub.State.ConsecutiveFailures = 0
                Hub.State.SuccessfulRolls = Hub.State.SuccessfulRolls + 1

                if Hub.Settings.AutoEquipBest
                    and Hub.State.SuccessfulRolls % Hub.Settings.EquipInterval == 0 then
                    pcall(function()
                        if EquipBestRemote then EquipBestRemote:InvokeServer() end
                    end)
                end

                task.wait(Hub.Settings.RollDelay)
            else
                Hub.State.ConsecutiveFailures = Hub.State.ConsecutiveFailures + 1
                task.wait(math.clamp(Hub.State.ConsecutiveFailures * 1.5, 2, 8))
            end
        else
            task.wait(0.5)
        end
    end
end)
table.insert(Hub.Threads, rollEngine)

-- 2. القتال والبرج (أحداث السيرفر الحقيقية)
local function bossReady()
    local srv = Hub.State.Server
    if not srv or not srv.ServerTime then return true end
    local now = srv.ServerTime + (os.clock() - Hub.State.ServerStamp)
    local readyAt = srv.StoryCooldowns and srv.StoryCooldowns[Hub.Settings.TargetBoss]
    return readyAt == nil or readyAt <= now
end

local function inBattle()
    if os.clock() - Hub.State.LastBattleEvent > 90 then
        Hub.State.InBattle = false
    end
    return Hub.State.InBattle
end

if BattleEventRemote then
    table.insert(Hub.Connections, BattleEventRemote.OnClientEvent:Connect(function(kind)
        Hub.State.LastBattleEvent = os.clock()
        if kind == "Start" then
            Hub.State.InBattle = true
        elseif kind == "End" then
            Hub.State.InBattle = false
        end
    end))
end

local lastNextKey
if TowerEventRemote then
    table.insert(Hub.Connections, TowerEventRemote.OnClientEvent:Connect(function(kind, data)
        Hub.State.LastTowerEvent = os.clock()
        if kind == "Paused" then
            Hub.State.TowerPaused = true
        elseif kind == "Started" then
            Hub.State.TowerPaused = false
        end

        if type(data) == "table" and data.floor then
            Hub.State.TowerFloorText = tostring(data.id or "?") .. " / Floor " .. tostring(data.floor)
        end

        if not Hub.Running or not Hub.Settings.AutoTower or not Hub.Settings.AutoNextFloor then return end
        if kind ~= "Cleared" or type(data) ~= "table" then return end
        if data.id ~= Hub.Settings.TowerMode or data.paused or not data.intermission then return end

        local key = tostring(data.id) .. ":" .. tostring(data.floor)
        if key == lastNextKey then return end
        lastNextKey = key
        task.delay(1.5, function()
            if Hub.Running and Hub.Settings.AutoTower and not Hub.State.TowerPaused then
                towerAction("Next", data.id)
            end
        end)
    end))
end

