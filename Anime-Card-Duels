-- حالة اللاعب: نقراها من StateController حق اللعبة نفسها
-- (نفس الجدول اللي تستخدمه واجهة اللعبة، فيه StoryCleared و StoryCooldowns)
-- ====================================================================
local GameState
pcall(function()
    local ctrl = LocalPlayer:WaitForChild("PlayerScripts", 5):WaitForChild("Client", 5)
        :WaitForChild("Controllers", 5):WaitForChild("StateController", 5)
    GameState = require(ctrl)
end)

local function mergeServerState(data)
    if type(data) ~= "table" then return end
    -- StateChanged يرسل الحالة كاملة، فنستبدلها مثل ما تسوي اللعبة
    Hub.State.Server = data
    Hub.State.ServerStamp = os.clock()
    Hub.State.SnapshotLoaded = true
end

if StateChangedRemote then
    table.insert(Hub.Connections, StateChangedRemote.OnClientEvent:Connect(mergeServerState))
end

local function playerState()
    if GameState and GameState.Loaded then
        local ok, st = pcall(GameState.Get, GameState)
        if ok and type(st) == "table" then return st end
    end
    return Hub.State.Server
end

local function stateLoaded()
    return (GameState ~= nil and GameState.Loaded == true) or Hub.State.SnapshotLoaded == true
end

-- GetSnapshot يرجع {ok = true, snapshot = {...}} (من StateController.Start)
local GetSnapshotRemote = R("GetSnapshot")
local lastSnapshotAsk = 0
local function fetchSnapshot()
    if not GetSnapshotRemote or os.clock() - lastSnapshotAsk < 5 then return end
    lastSnapshotAsk = os.clock()
    task.spawn(function()
        local ok, res = invoke(GetSnapshotRemote)
        if ok and type(res) == "table" and res.ok and type(res.snapshot) == "table" then
            mergeServerState(res.snapshot)
        else
            print("[Hub] GetSnapshot failed:", ok, type(res) == "table" and res.reason or res)
        end
    end)
end

do
    if not stateLoaded() then fetchSnapshot() end
    local t0 = os.clock()
    while not stateLoaded() and os.clock() - t0 < 5 do task.wait(0.1) end
    print("[Hub] player state:", stateLoaded() and "loaded" or "NOT loaded",
        "| source:", (GameState and GameState.Loaded) and "game StateController" or "snapshot")
end

local function serverSetting(name)
    local st = playerState()
    st = st and st.Settings
    return type(st) == "table" and st[name] == true
end

local function abilitiesAreAuto()
    local st = playerState()
    st = st and st.Settings
    if type(st) ~= "table" then return true end
    return st.AbilityPrompts == "AutoUse"
end

