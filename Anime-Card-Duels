function Hub:Destroy()
    self.Running = false
    self.State.InBattle = false
    self.State.ProcessingTurn = false

    for _, conn in ipairs(self.Connections) do
        if conn and conn.Connected then conn:Disconnect() end
    end
    table.clear(self.Connections)

    for _, th in ipairs(self.Threads) do
        if coroutine.status(th) ~= "dead" then task.cancel(th) end
    end
    table.clear(self.Threads)

    if self.Window then
        pcall(function() self.Window:Destroy() end)
        self.Window = nil
    end
end

-- ====================================================================
-- محاكي الضغط كـ Fallback في حال تغيرت صيغ السيرفر
-- ====================================================================
local function safeClick(btn)
    if not btn then return false end
    if firesignal then
        firesignal(btn.Activated or btn.MouseButton1Click)
        return true
    elseif getconnections then
        for _, c in ipairs(getconnections(btn.Activated or btn.MouseButton1Click)) do
            c:Fire()
        end
        return true
    end
    return false
end

-- Airflow passes a string (or nil when a row is unchecked); keep table support for safety
local function optionToString(option)
    if option == nil then return "" end
    if type(option) == "table" then
        return tostring(option[1] or "")
    end
    return tostring(option)
end

-- أوامر البرج (Start / Next) حسب الوضع المختار
local function towerAction(action, mode)
    if not TowerActionRemote then return false end
    local ok, res = pcall(function()
        return TowerActionRemote:InvokeServer(action, mode or Hub.Settings.TowerMode, nil, nil)
    end)
    return ok and res ~= false
end

-- إيقاف البرج مؤقتاً (الاستدعاء من Cobalt بوسيطين فقط)
local function towerPause()
    if not TowerActionRemote then return false end
    local ok, res = pcall(function()
        return TowerActionRemote:InvokeServer("Pause", Hub.Settings.TowerMode)
    end)
    if ok and res ~= false then Hub.State.TowerPaused = true end
    return ok and res ~= false
end

-- تغيير إعدادات اللعبة (مثل HideBattleOn)
local function setGameSetting(name, value)
    if not SetSettingRemote then return false end
    local ok, res = pcall(function()
        return SetSettingRemote:InvokeServer(name, value)
    end)
    return ok and res ~= false
end

