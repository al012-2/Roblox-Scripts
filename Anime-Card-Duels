-- 5. لوحة الحالة
local function onOff(v) return v and "ON" or "OFF" end
local function fmtTime(sec)
    sec = math.floor(sec)
    return string.format("%02d:%02d:%02d", sec // 3600, (sec % 3600) // 60, sec % 60)
end

table.insert(Hub.Threads, task.spawn(function()
    while Hub.Running do
        local S = Hub.Settings
        local lines = {
            "Uptime: " .. fmtTime(os.clock() - Hub.State.StartTime),
            "Rolls this session: " .. Hub.State.SuccessfulRolls .. "   (Auto-Roll: " .. onOff(S.AutoRoll) .. ")",
            "Battle: " .. (inBattle() and "In battle" or "Idle")
                .. " | World: " .. tostring(Hub.State.CurrentPlace or "?"),
            "Tower: " .. onOff(S.AutoTower) .. " | " .. S.TowerMode
                .. " | " .. (Hub.State.TowerPaused and "Paused" or "Running")
                .. (towerAllowed() and "" or " (yield)")
                .. " | " .. (Hub.State.TowerLastError or Hub.State.TowerFloorText),
            "Boss: " .. onOff(S.AutoStoryBoss) .. " | " .. S.TargetBoss
                .. " (" .. S.TargetDifficulty .. ") | " .. (bossReady() and "Ready" or "Cooldown"),
            "Story: " .. onOff(S.AutoStory) .. " | wins " .. Hub.State.StoryWins
                .. " | " .. Hub.State.LastStoryResult,
            "Raid: " .. onOff(S.AutoRaid) .. " | wins " .. Hub.State.RaidWins
                .. " | " .. Hub.State.LastRaidResult,
            "Last boss result: " .. Hub.State.LastBossResult,
            "Claims: chest " .. onOff(S.AutoClaimChest) .. ", quests " .. onOff(S.AutoClaimQuests)
                .. ", daily " .. onOff(S.AutoClaimRewards) .. ", index " .. onOff(S.AutoClaimIndex),
        }
        pcall(function()
            for i, line in ipairs(lines) do
                if StatusLabels[i] then StatusLabels[i]:SetText(line) end
            end
        end)
        task.wait(1)
    end
end))

