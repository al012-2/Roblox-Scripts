-- Story Farm: كل الستيجات الجاهزة، عالم عالم
table.insert(Hub.Threads, task.spawn(function()
    while Hub.Running do
        local place, stage, diff
        local known = cooldownsKnown()
        if Hub.Settings.AutoStory and StoryFightRemote and known then
            place, stage, diff = pickStoryJob()
        end
        Hub.State.StoryIdle = (place == nil)

        if not (Hub.Settings.AutoStory and StoryFightRemote) then
            task.wait(2)
        elseif not known then
            Hub.State.LastStoryResult = "waiting for cooldown data from server..."
            fetchSnapshot()
            task.wait(1)
        elseif place and Hub.State.Busy then
            task.wait(1)
        elseif place and inBattle() then
            -- معركة شغالة (غالباً البرج): نوقف البرج وننتظر نهاية المعركة
            if towerActive() then
                Hub.State.TowerYield = true
                towerPause()
            end
            local t0 = os.clock()
            while Hub.Running and inBattle() and os.clock() - t0 < 45 do task.wait(0.5) end
            task.wait(1)
        else
            if not place then
                local n = nextStoryReadyIn()
                Hub.State.LastStoryResult = n and ("all on cooldown, next in " .. math.ceil(n) .. "s")
                    or "nothing ready"
                task.wait(3)
            else
                if towerActive() then
                    Hub.State.TowerYield = true
                    towerPause()
                    task.wait(2)
                end

                Hub.State.Busy = true
                if not goToWorld(place) then
                    Hub.State.LastStoryResult = "teleport to " .. place .. " failed"
                    warn("[Hub] ما قدرت أوصل", place)
                    task.wait(10)
                else
                    local startedBefore = Hub.State.LastBattleEvent
                    local ok, res = invoke(StoryFightRemote, stage, diff)
                    print("[Hub] StoryFight ->", stage, diff, ok, res)

                    local refused = not ok or res == false or type(res) == "string"
                    if type(res) == "table" and (res.ok == false or res.success == false
                        or res.error ~= nil or res.reason ~= nil or res.err ~= nil) then
                        refused = true
                        for k, v in pairs(res) do print("    ", k, "=", v) end
                    end
                    if refused then
                        -- السيرفر رفض: نتخطى هالستيج دقيقتين ونكمل غيره
                        Hub.State.StorySkipUntil[stage] = os.clock() + 120
                        Hub.State.LastStoryResult = stage .. " refused: " .. tostring(res)
                        task.wait(3)
                    else
                        Hub.State.LastStoryResult = "fighting " .. stage .. " [" .. diff .. "]"
                        -- ننتظر بداية المعركة ثم نهايتها
                        local t0 = os.clock()
                        while Hub.Running and Hub.State.LastBattleEvent == startedBefore
                            and os.clock() - t0 < 5 do
                            task.wait(0.2)
                        end
                        if Hub.State.LastBattleEvent == startedBefore then
                            -- ما بدأت معركة = رفض صامت: نتخطاه ونطلب الأوقات من جديد
                            Hub.State.StorySkipUntil[stage] = os.clock() + 90
                            Hub.State.LastStoryResult = stage .. ": no battle started, skipped"
                            print("[Hub] no battle for", stage, "- skipping")
                            fetchSnapshot()
                            task.wait(1)
                        else
                            while Hub.Running and inBattle() do task.wait(0.5) end
                            humanWait(1) -- مهلة + تأخير عشوائي بين المعارك
                        end
                    end
                end
                Hub.State.Busy = false
            end
        end
    end
end))

-- Raid Farm (Dracula): من RaidWindow.fightPressed و RaidController.nearArena
--  - Dracula موجود إذا ReplicatedStorage.RaidHp > 0
--  - إذا مات: يرجع عند RaidRespawnAt
--  - الساحة: workspace["Burning London"] (اللعبة تعتبرك قريب إذا المسافة <= 420)
local RAID_ARENA = "Burning London"

local function raidHp()
    return tonumber(ReplicatedStorage:GetAttribute("RaidHp")) or 0
end

local function raidRespawnIn()
    local at = tonumber(ReplicatedStorage:GetAttribute("RaidRespawnAt")) or 0
    return math.max(math.ceil(at - serverNow()), 0)
end

local function nearRaidArena()
    local arena = workspace:FindFirstChild(RAID_ARENA)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (arena and root and arena:IsA("Model")) then return false end
    return (root.Position - arena:GetPivot().Position).Magnitude <= 420
end

goToRaid = function()
    if nearRaidArena() then return true end
    local ok, res = invoke(TeleportRemote, "DraculaRaid")
    print("[Hub] Teleport -> DraculaRaid", ok, type(res) == "table" and (res.ok and "ok" or res.reason) or res)
    local t0 = os.clock()
    while Hub.Running and os.clock() - t0 < 12 do
        if nearRaidArena() then
            task.wait(1)
            return true
        end
        task.wait(0.3)
    end
    return nearRaidArena()
end

table.insert(Hub.Threads, task.spawn(function()
    while Hub.Running do
        if not (Hub.Settings.AutoRaid and RaidFightRemote) then
            Hub.State.RaidWaiting = false
            task.wait(2)
        elseif raidHp() <= 0 then
            -- Dracula ميت: البرج ياخذ الوقت لين يرجع
            Hub.State.RaidWaiting = true
            local left = raidRespawnIn()
            Hub.State.LastRaidResult = left > 0
                and string.format("Dracula back in %dm %02ds", left // 60, left % 60)
                or "Dracula not up"
            task.wait(3)
        elseif inBattle() or Hub.State.Busy or not Hub.State.StoryIdle then
            Hub.State.RaidWaiting = false
            task.wait(2)
        else
            Hub.State.RaidWaiting = false
            Hub.State.Busy = true
            if towerActive() then
                towerPause()
                task.wait(2)
            end

            if not goToRaid() then
                warn("[Hub] ما وصلت ساحة Dracula، بنحاول القتال على أي حال")
            end

            local startedBefore = Hub.State.LastBattleEvent
            local ok, res = invoke(RaidFightRemote, "Fight")
            local good = ok and type(res) == "table" and res.ok == true
            print("[Hub] RaidFight Fight ->", ok, type(res) == "table" and (res.ok and "ok" or res.reason) or res)

            if not good then
                Hub.State.LastRaidResult = "refused: " .. tostring(type(res) == "table" and res.reason or res)
                Hub.State.Busy = false
                Hub.State.RaidWaiting = true
                task.wait(Hub.Settings.RaidRetryDelay)
                Hub.State.RaidWaiting = false
            else
                Hub.State.LastRaidResult = "fighting Dracula"
                local t0 = os.clock()
                while Hub.Running and Hub.State.LastBattleEvent == startedBefore
                    and os.clock() - t0 < 8 do
                    task.wait(0.3)
                end
                while Hub.Running and inBattle() do task.wait(0.5) end
                Hub.State.Busy = false
                humanWait(1)
            end
        end
    end
end))

