towerAllowed = function()
    if Hub.State.Busy or Hub.Settings.AutoStoryBoss then return false end
    if Hub.Settings.AutoStory then
        if not (Hub.Settings.TowerInDowntime and Hub.State.StoryIdle) then return false end
    end
    if Hub.Settings.AutoRaid and not Hub.State.RaidWaiting then return false end
    return true
end

-- البرج: يبدأ إذا ما فيه نشاط، مع backoff لو السيرفر ما يرد
table.insert(Hub.Threads, task.spawn(function()
    while Hub.Running do
        local fails = Hub.State.TowerStartFails
        local quiet = 6 + math.min(fails * 10, 120)
        if Hub.Settings.AutoTower
            and towerAllowed()
            and not inBattle()
            and os.clock() - math.max(Hub.State.LastTowerEvent, Hub.State.LastTowerAttempt or 0) > quiet
            and os.clock() - Hub.State.LastBattleEvent > 6 then
            -- فيه رن موقوف؟ نكمله بدل ما نبدأ جديد ("You have a paused run - Resume it")
            local good = towerAction("Resume")
            if not good then good = towerAction("Start") end
            Hub.State.LastTowerAttempt = os.clock()
            if good then
                Hub.State.TowerPaused = false
                Hub.State.TowerYield = false
                Hub.State.TowerStartFails = 0
            else
                Hub.State.TowerStartFails = fails + 1
            end
        end
        task.wait(2)
    end
end))

