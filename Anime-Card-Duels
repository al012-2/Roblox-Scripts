if BattleEventRemote then
    table.insert(Hub.Connections, BattleEventRemote.OnClientEvent:Connect(function(kind, data)
        Hub.State.LastBattleEvent = os.clock()
        if kind == "Start" then
            Hub.State.InBattle = true
        elseif kind == "End" then
            Hub.State.InBattle = false
            -- نتيجة الستوري: {mode="story", result="Victory", story={stage, difficulty}}
            if type(data) == "table" and data.mode == "story" and type(data.story) == "table" then
                local key = tostring(data.story.stage) .. "|" .. tostring(data.story.difficulty)
                if Hub.State.LastEndKey == key and os.clock() - (Hub.State.LastEndAt or 0) < 2 then
                    return -- نفس النتيجة وصلت مرتين
                end
                Hub.State.LastEndKey, Hub.State.LastEndAt = key, os.clock()
                if data.result == "Victory" then
                    Hub.State.StoryWins += 1
                    Hub.State.StoryLosses[key] = nil
                    Hub.State.StoryBlocked[key] = nil
                else
                    local n = (Hub.State.StoryLosses[key] or 0) + 1
                    Hub.State.StoryLosses[key] = n
                    -- خسارتين متتاليتين = نحظر هالصعوبة 20 دقيقة (الفوز على صعوبة ثانية ما يلغي الحظر)
                    if n >= 2 then
                        Hub.State.StoryBlocked[key] = os.clock() + 20 * 60
                        Hub.State.StoryLosses[key] = 0
                        print("[Hub] blocking", key, "for 20 min after 2 losses")
                    end
                end
                -- إحصائيات الجوائز
                local st = Hub.State.StoryStats[key]
                if not st then
                    st = { fights = 0, wins = 0, seconds = 0, items = {} }
                    Hub.State.StoryStats[key] = st
                end
                st.fights += 1
                if data.result == "Victory" then st.wins += 1 end
                if type(data.stats) == "table" and tonumber(data.stats.seconds) then
                    st.seconds += tonumber(data.stats.seconds)
                end
                local rw = data.rewards
                if type(rw) == "table" then
                    if type(rw.items) == "table" then
                        for _, it in ipairs(rw.items) do
                            if type(it) == "table" and it.item then
                                st.items[it.item] = (st.items[it.item] or 0) + (tonumber(it.count) or 1)
                            end
                        end
                    end
                    -- نحدث الكولداون فوراً بدل ما ننتظر StateChanged
                    if rw.cooldownEnds and rw.stage and Hub.State.Server
                        and not (GameState and GameState.Loaded) then
                        Hub.State.Server.StoryCooldowns = Hub.State.Server.StoryCooldowns or {}
                        Hub.State.Server.StoryCooldowns[rw.stage] = rw.cooldownEnds
                    end
                end
                Hub.State.LastStoryResult = key .. " -> " .. tostring(data.result)
                print("[Hub] Story result:", key, data.result)
            elseif type(data) == "table" and type(data.mode) == "string" and data.mode:find("raid") then
                if data.result == "Victory" then Hub.State.RaidWins += 1 end
                Hub.State.LastRaidResult = data.mode .. " -> " .. tostring(data.result)
                print("[Hub] Raid result:", data.mode, data.result)
            end
        end
    end))
end

local lastNextKey
if TowerEventRemote then
    table.insert(Hub.Connections, TowerEventRemote.OnClientEvent:Connect(function(kind, data)
        Hub.State.LastTowerEvent = os.clock()
        if kind == "Paused" then
            Hub.State.TowerPaused = true
        elseif kind == "Started" then
            Hub.State.TowerPaused = false
            Hub.State.TowerStartFails = 0
            lastNextKey = nil -- يمنع التعليق لو رجع البرج لنفس رقم الطابق
        end

        if type(data) == "table" and data.floor then
            local id = data.id or data.tower or "?"
            Hub.State.TowerFloorText = tostring(id) .. " / Floor " .. tostring(data.floor)
        end

        if not Hub.Running or not Hub.Settings.AutoTower or not Hub.Settings.AutoNextFloor then return end
        if not towerAllowed() then return end
        if kind ~= "Cleared" or type(data) ~= "table" then return end
        if data.id ~= Hub.Settings.TowerMode or data.paused or not data.intermission then return end

        local key = tostring(data.id) .. ":" .. tostring(data.floor)
        if key == lastNextKey then return end
        lastNextKey = key
        task.delay(1.5, function()
            if Hub.Running and Hub.Settings.AutoTower and towerAllowed() then
                towerAction("Next", data.id)
            end
        end)
    end))
end

