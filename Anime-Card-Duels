local function findPath(root, ...)
    local cur = root
    for _, name in ipairs({ ... }) do
        cur = cur and cur:FindFirstChild(name)
        if not cur then return nil end
    end
    return cur
end

local function safeClick(btn)
    if not btn or not btn:IsA("GuiButton") then return false end
    local sig = btn.Activated or btn.MouseButton1Click
    if firesignal then
        pcall(firesignal, sig)
        return true
    elseif getconnections then
        for _, c in ipairs(getconnections(sig)) do pcall(function() c:Fire() end) end
        return true
    end
    return false
end

local function optionToString(option)
    if option == nil then return "" end
    if type(option) == "table" then return tostring(option[1] or "") end
    return tostring(option)
end

local function invoke(remote, ...)
    if not remote then return false, "remote missing" end
    local args = table.pack(...)
    return pcall(function() return remote:InvokeServer(table.unpack(args, 1, args.n)) end)
end

local function humanWait(base)
    if Hub.Settings.HumanDelay then
        task.wait(base + math.random() * 2 + 0.5)
    else
        task.wait(base)
    end
end

-- TowerAction يرجع {ok, reason, state} (من TowerController.action)
local lastTowerWarn = {}
local function towerAction(action, mode)
    mode = mode or Hub.Settings.TowerMode
    local ok, res = invoke(TowerActionRemote, action, mode, nil, nil)
    local good = ok and type(res) == "table" and res.ok == true
    if not good then
        local reason = tostring(type(res) == "table" and res.reason or res)
        Hub.State.TowerLastError = action .. ": " .. reason
        -- نطبع نفس الخطأ مرة كل 30 ثانية بس
        local key = action .. reason
        if os.clock() - (lastTowerWarn[key] or 0) > 30 then
            lastTowerWarn[key] = os.clock()
            print("[Hub] TowerAction", action, mode, "refused:", reason)
        end
    else
        Hub.State.TowerLastError = nil
    end
    return good
end

local function towerPause()
    local good = towerAction("Pause")
    local err = Hub.State.TowerLastError or ""
    if good or err:find("No run") then
        Hub.State.TowerPaused = true -- إما وقفناه أو ما كان شغال أصلاً
        if not good then Hub.State.TowerLastError = nil end
    end
    return good
end

local function setGameSetting(name, value)
