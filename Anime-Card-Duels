local function teleportToZone(zoneName)
    task.spawn(function()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local before = root and root.Position

        local TeleportRemote = Remotes:FindFirstChild("Teleport")
        if TeleportRemote then
            pcall(function() return TeleportRemote:InvokeServer(zoneName) end)
            task.wait(1.2)
            root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if root and before and (root.Position - before).Magnitude > 20 then return end
        end

        local zones = ReplicatedStorage:FindFirstChild("WorldZones")
        local wz = zones and zones:FindFirstChild(zoneName)
        local cf = wz and wz:GetAttribute("CFrame")
        local size = wz and wz:GetAttribute("Size")
        if cf and root then
            local drop = size and (size.Y / 2 - 5) or 0
            root.CFrame = cf + Vector3.new(0, -drop, 0)
        end
    end)
end

