local function goToWorld(place)
    if Hub.State.CurrentPlace == place then return true end
    if not TeleportRemote then return false end

    local before = Hub.State.LastTeleport
    local ok, res = invoke(TeleportRemote, place)
    print("[Hub] Teleport ->", place, ok, res)

    local t0 = os.clock()
    while os.clock() - t0 < 10 and Hub.Running do
        if Hub.State.LastTeleport > before then
            task.wait(1.5) -- مهلة تحميل العالم (اللعبة ترد TeleportReady بنفسها)
            return Hub.State.CurrentPlace == place
        end
        task.wait(0.2)
    end
