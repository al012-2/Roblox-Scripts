local function mergeServerState(data)
    if type(data) ~= "table" then return end
    Hub.State.Server = Hub.State.Server or {}
    for k, v in pairs(data) do Hub.State.Server[k] = v end
    Hub.State.ServerStamp = os.clock()
end

if StateChangedRemote then
    table.insert(Hub.Connections, StateChangedRemote.OnClientEvent:Connect(mergeServerState))
end

do
    local GetSnapshotRemote = Remotes:FindFirstChild("GetSnapshot")
    if GetSnapshotRemote then
        task.spawn(function()
            pcall(function()
                local snap = GetSnapshotRemote:InvokeServer()
                if type(snap) == "table" then
                    if type(snap.Settings) == "table" then
                        mergeServerState(snap)
                    elseif type(snap.State) == "table" then
                        mergeServerState(snap.State)
                    end
                end
            end)
        end)
    end

    local t0 = os.clock()
    while not (Hub.State.Server and type(Hub.State.Server.Settings) == "table")
        and os.clock() - t0 < 3 do
        task.wait(0.1)
    end
end

local function serverSetting(name)
    local srv = Hub.State.Server
    local st = srv and srv.Settings
    return type(st) == "table" and st[name] == true
end

local function abilitiesAreAuto()
    local srv = Hub.State.Server
    local st = srv and srv.Settings
    if type(st) ~= "table" then return true end
    return st.AbilityPrompts == "AutoUse"
end

