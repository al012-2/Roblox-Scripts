local function safeClick(btn)
    if not btn then return false end
    local sig = btn:IsA("GuiButton") and (btn.Activated or btn.MouseButton1Click)
    if not sig then return false end
    if firesignal then
        firesignal(sig)
        return true
    elseif getconnections then
        for _, c in ipairs(getconnections(sig)) do c:Fire() end
        return true
    end
    return false
end

-- Rayfield يعيد الخيار كجدول {"..."}؛ ندعم الحالتين
local function optionToString(option)
    if option == nil then return "" end
    if type(option) == "table" then return tostring(option[1] or "") end
    return tostring(option)
end

local function towerAction(action, mode)
    if not TowerActionRemote then return false end
    local ok, res = pcall(function()
        return TowerActionRemote:InvokeServer(action, mode or Hub.Settings.TowerMode, nil, nil)
    end)
    return ok and res ~= false
end

local function towerPause()
    if not TowerActionRemote then return false end
    local ok, res = pcall(function()
        return TowerActionRemote:InvokeServer("Pause", Hub.Settings.TowerMode)
    end)
    if ok and res ~= false then Hub.State.TowerPaused = true end
    return ok and res ~= false
end

local function setGameSetting(name, value)
    if not SetSettingRemote then return false end
    local ok, res = pcall(function()
        return SetSettingRemote:InvokeServer(name, value)
    end)
    return ok and res ~= false
end

