-- ====================================================================
-- Story: نفس قواعد اللعبة (ReplicatedStorage.Shared.Story.StoryRules)
--  - الصعوبة تنفتح إذا ختمت اللي قبلها في نفس الستيج + نفس الصعوبة في الستيج اللي قبله
--  - الكولداون يمنع بس الصعوبات اللي ختمتها (عادي 10 دقائق، بوس 30)
-- ====================================================================
local DIFFS = { "Easy", "Medium", "Hard", "Nightmare" }
local WORLD_ORDER = {
    { place = "Purple Forest", prefix = "purple_forest" },
    { place = "Android Games", prefix = "android_games" },
    { place = "Hollow World",  prefix = "hollow_world" },
    { place = "Purple Town",   prefix = "purple_town" },
}

-- الترتيب حسب Index في StoryConfig
local STAGE_ORDER = {}
for _, w in ipairs(WORLD_ORDER) do
    for _, suffix in ipairs({ "_1", "_2", "_3", "_boss" }) do
        STAGE_ORDER[#STAGE_ORDER + 1] = w.prefix .. suffix
    end
end
local STAGE_INDEX = {}
for i, id in ipairs(STAGE_ORDER) do STAGE_INDEX[id] = i end

-- نفس الوقت اللي تستخدمه اللعبة
local function serverNow()
    local ok, t = pcall(function() return workspace:GetServerTimeNow() end)
    if ok and type(t) == "number" and t > 0 then return t end
    return os.time()
end

local function cooldownsKnown()
    return stateLoaded()
end

local function beaten(stage, diff)
    local st = playerState()
    local c = st and st.StoryCleared and st.StoryCleared[stage]
    return type(c) == "table" and c[diff] == true
end

local function prevStage(stage)
    local i = STAGE_INDEX[stage]
    return (i and i > 1) and STAGE_ORDER[i - 1] or nil
end

local function stageOpen(stage)
    local p = prevStage(stage)
    return p == nil or beaten(p, "Easy")
end

local function difficultyOpen(stage, diff)
    if not stageOpen(stage) then return false end
    local i = table.find(DIFFS, diff) or 1
    if i == 1 then return true end
    local p = prevStage(stage)
    if p and not beaten(p, diff) then return false end
    return beaten(stage, DIFFS[i - 1])
end

local function cooldownLeft(stage)
    local st = playerState()
    local t = st and st.StoryCooldowns and st.StoryCooldowns[stage]
    if type(t) ~= "number" then return 0 end
    return math.max(math.ceil(t - serverNow()), 0)
end

local function onCooldown(stage, diff)
    return beaten(stage, diff) and cooldownLeft(stage) > 0
end

local function pickDifficulty(stage)
    local top = 0
    for i, d in ipairs(DIFFS) do
        if difficultyOpen(stage, d) then top = i end
    end
    if top == 0 then return nil end -- الستيج مقفل

    local mode = Hub.Settings.StoryDiffMode
    local idx
    if mode == "Highest unlocked" then
        -- ننزل من أعلى صعوبة مفتوحة لين نلقى وحدة مو محظورة بسبب الخسارة
        idx = nil
        for i = top, 1, -1 do
            if (Hub.State.StoryBlocked[stage .. "|" .. DIFFS[i]] or 0) <= os.clock() then
                idx = i
                break
            end
        end
        if not idx then return nil end -- كل الصعوبات محظورة: نتخطى الستيج مؤقتاً
    elseif mode == "Highest cleared" then
        idx = 1
        for i = top, 1, -1 do
            if beaten(stage, DIFFS[i]) then idx = i break end
        end
    else
        idx = math.min(table.find(DIFFS, mode) or 1, top)
    end
    return DIFFS[idx]
end

-- يرجع الصعوبة إذا الستيج جاهز للقتال، أو nil
local function stageReady(stage)
    if (Hub.State.StorySkipUntil[stage] or 0) > os.clock() then return nil end
    if not cooldownsKnown() then return nil end
    local diff = pickDifficulty(stage)
    if not diff or onCooldown(stage, diff) then return nil end
    return diff
end

local function storyStages(prefix)
    local list = { prefix .. "_1", prefix .. "_2", prefix .. "_3" }
    if Hub.Settings.StoryIncludeBoss then list[#list + 1] = prefix .. "_boss" end
    return list
end

-- يختار ستيج جاهز: البوسات أول، بعدين العالم الحالي عشان نقلل التيليبورتات
local function pickStoryJob()
    local ordered = {}
    for _, w in ipairs(WORLD_ORDER) do
        if Hub.Settings.StoryWorlds[w.place] then
            if w.place == Hub.State.CurrentPlace then
                table.insert(ordered, 1, w)
            else
                ordered[#ordered + 1] = w
            end
        end
    end
    if Hub.Settings.BossFirst and Hub.Settings.StoryIncludeBoss then
        for _, w in ipairs(ordered) do
            local boss = w.prefix .. "_boss"
            local diff = stageReady(boss)
            if diff then return w.place, boss, diff end
        end
    end
    for _, w in ipairs(ordered) do
        for _, stage in ipairs(storyStages(w.prefix)) do
            local diff = stageReady(stage)
            if diff then return w.place, stage, diff end
        end
    end
end

local function nextStoryReadyIn()
    if not cooldownsKnown() then return nil end
    local soonest
    for _, w in ipairs(WORLD_ORDER) do
        if Hub.Settings.StoryWorlds[w.place] then
            for _, stage in ipairs(storyStages(w.prefix)) do
                local left = cooldownLeft(stage)
                if left > 0 and (not soonest or left < soonest) then soonest = left end
            end
        end
    end
    return soonest
end

