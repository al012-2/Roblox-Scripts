        Rayfield:Notify({Title = "Auto Farm", Content = "الحالة: " .. tostring(autoFarmEnabled), Duration = 2})
    elseif cmd == "/quest" then
        autoQuestEnabled = not autoQuestEnabled
        Rayfield:Notify({Title = "Auto Quest", Content = "الحالة: " .. tostring(autoQuestEnabled), Duration = 2})
    elseif cmd == "/switch" then
        if #dummyList > 0 then
            local currentIndex = 1
            for i, name in ipairs(dummyList) do
                if name == selectedDummy then
                    currentIndex = i
                    break
                end
            end
            local nextIndex = currentIndex % #dummyList + 1
            selectedDummy = dummyList[nextIndex]
            Rayfield:Notify({Title = "Quest Dummy", Content = "تم تغيير الكوست إلى: " .. selectedDummy, Duration = 3})
        end
    end
end)

