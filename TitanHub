local TabClass = {}
TabClass.__index = TabClass

function TabClass:_newBox(title)
    self._n += 1
    local box
    if self._n % 2 == 1 then
        box = self._tab:AddLeftGroupbox(title)
    else
        box = self._tab:AddRightGroupbox(title)
    end
    self._cur = box
    return box
end

function TabClass:_box()
    return self._cur or self:_newBox(self._name)
end

function TabClass:CreateSection(title)
    self:_newBox(title)
end

function TabClass:CreateButton(cfg)
    self:_box():AddButton({
        Text = cfg.Name,
        Func = function() if cfg.Callback then cfg.Callback() end end,
    })
end

function TabClass:CreateParagraph(cfg)
    self:_box():AddLabel((cfg.Title and (cfg.Title .. "\n") or "") .. (cfg.Content or ""), true)
end

function TabClass:CreateInput(cfg)
    local idx = nextIdx(cfg.Flag)
    self:_box():AddInput(idx, {
        Default = cfg.Default or "",
        Numeric = false,
        Finished = false,
        Text = cfg.Name,
        Placeholder = cfg.Placeholder or "",
        Callback = function(v)
            if cfg.Callback then cfg.Callback(v) end
        end,
    })
end

function TabClass:CreateToggle(cfg)
    local idx = nextIdx(cfg.Flag)
    self:_box():AddToggle(idx, {
        Text = cfg.Name,
        Default = cfg.CurrentValue or false,
        Callback = function(v) if cfg.Callback then cfg.Callback(v) end end,
    })
    return {
        Set = function(_, v)
            local t = LToggles[idx]
            if t then pcall(function() t:SetValue(v) end) end
        end,
    }
end

function TabClass:CreateDropdown(cfg)
    local idx = nextIdx(cfg.Flag)
    local values = cfg.Options
    local multi = cfg.MultipleOptions == true
    local init = cfg.CurrentOption or {}
    local default
    if not multi and init[1] then default = table.find(values, init[1]) end

    self:_box():AddDropdown(idx, {
        Values = values,
        Default = default,
        Multi = multi,
        Text = cfg.Name,
        Callback = function(v)
            if not cfg.Callback then return end
            if multi then
                local list = {}
                if type(v) == "table" then
                    for _, name in ipairs(values) do
                        if v[name] == true then table.insert(list, name) end
                    end
                end
                cfg.Callback(list)
            else
                cfg.Callback({ v })
            end
        end,
    })

    local function setValue(list)
        local d = LOptions[idx]
        if not d then return end
        if multi then
            local map = {}
            for _, name in ipairs(list) do map[name] = true end
            pcall(function() d:SetValue(map) end)
        elseif list[1] ~= nil then
            pcall(function() d:SetValue(list[1]) end)
        end
    end

    if multi then setValue(init) end
    return { Set = function(_, list) setValue(list or {}) end }
end

