    end
end

-- آخر عالم انتقلنا له (بنفس الشخصية)، عشان ما نعيد الانتقال وإحنا فيه
local lastTpWorld, lastTpChar = nil, nil

-- هل بوسات هذا العالم قريبة من الشخصية؟ (يعني وصلنا)
local function nearWorldBosses(worldKey)
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local folder = workspace:FindFirstChild("bossNpcs")
    folder = folder and folder:FindFirstChild(tostring(worldKey))
    if not folder then return true end -- ما نقدر نتحقق، نعتمد على الحركة فقط
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") then
            local ok, pos = pcall(function() return m:GetPivot().Position end)
            if ok and (pos - root.Position).Magnitude < 500 then return true end
        end
    end
    return false
end

local function forceTeleportToWorld(worldKey)
    local char = getCharWithTimeout(10)
    if not char then return end
    local root = char:WaitForChild("HumanoidRootPart", 5)
    if not root then return end

    if worldKey == "raid" then
        local raidFolder = workspace:FindFirstChild("KaijuRaid")
        if raidFolder then
            local raidPart = raidFolder:FindFirstChildWhichIsA("BasePart", true)
            if raidPart then
                root.AssemblyLinearVelocity = Vector3.zero
                root.CFrame = raidPart.CFrame + Vector3.new(0, 3, 0)
            end
        end
        return
    end

    -- إذا إحنا فيه أصلاً (نفس الشخصية) ما نعيد الانتقال
    if lastTpWorld == worldKey and lastTpChar == char then return end

    -- الانتقال المباشر بالريموت (نفس زر Teleport في اللعبة): teleportToArea:FireServer(<رقم العالم>, nil)
    -- ننتظر الوصول (بوسات العالم قريبة) ثم نكمل للبوس مباشرة، وإذا فشل مرتين نجرب البوابات
    local areaIndex = tonumber(worldKey)
    local startPos = root.Position
    if teleportAreaRemote and areaIndex then
        for _ = 1, 2 do
            pcall(function() teleportAreaRemote:FireServer(areaIndex, nil) end)
            local t = os.clock()
            while os.clock() - t < 5 do
                task.wait(0.25)
                local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if r and nearWorldBosses(worldKey) then
                    local moved = (r.Position - startPos).Magnitude >= 25
                    if moved or os.clock() - t >= 2 then
                        task.wait(0.5) -- مهلة قصيرة لاستقرار الشخصية
                        lastTpWorld, lastTpChar = worldKey, player.Character
                        return
                    end
                end
            end
        end
    end

    local lobby = workspace:FindFirstChild("Lobby")
    local portals = lobby and lobby:FindFirstChild("portals")
    local portalFolder = portals and portals:FindFirstChild(tostring(worldKey))

    if not portalFolder then
        returnToLobby()
        task.wait(0.5)
        lobby = workspace:FindFirstChild("Lobby")
        portals = lobby and lobby:FindFirstChild("portals")
        portalFolder = portals and portals:FindFirstChild(tostring(worldKey))
    end

    if portalFolder then
        local pModel = portalFolder:FindFirstChild("portalModel")
        local triggerPart = nil
        if pModel then
            triggerPart = pModel:FindFirstChild("Part") or pModel:FindFirstChildWhichIsA("BasePart", true)
        end
        triggerPart = triggerPart or portalFolder:FindFirstChildWhichIsA("BasePart", true)

        if triggerPart and root.Parent then
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = triggerPart.CFrame
            task.wait(0.15)
            if firetouchinterest then
                firetouchinterest(root, triggerPart, 0)
                task.wait(0.1)
                firetouchinterest(root, triggerPart, 1)
            end
            humanDelay(1.2, 1.6)
        end
    end
end

local function recoverIfDead(worldKey, alive)
    if isCharAlive() then return true end
    local t = os.clock()
    repeat
        task.wait(0.5)
    until isCharAlive() or not alive() or os.clock() - t > 30
    if not alive() or not isCharAlive() then return false end
    humanDelay(1.5, 2.0)
    forceTeleportToWorld(worldKey)
    return true
end

-- ==================== البحث عن البوسات والـ Cooldown ====================
local BossCache, MissUntil = {}, {}

local function findBossModel(bossName)
    local key = bossName:lower()
    local cached = BossCache[key]
    if cached and cached.Parent and cached:IsDescendantOf(workspace) then
        return cached
    end
    BossCache[key] = nil

    if MissUntil[key] and os.clock() < MissUntil[key] then return nil end

    local want = norm(bossName)
    local want2 = BossDisplayName[bossName] and norm(BossDisplayName[bossName]) or nil
    local found

    local searchRoots = { workspace:FindFirstChild("bossNpcs"), workspace:FindFirstChild("KaijuRaid") }
    for _, root in ipairs(searchRoots) do
        if root then
            local unnamed
            for _, folder in ipairs(root:GetChildren()) do
                for _, m in ipairs(folder:GetChildren()) do
                    if m:IsA("Model") then
                        local n = norm(m.Name)
                        if m:GetAttribute("bossId") == bossName
                            or n == want
                            or (want2 and n == want2)
                            or (n ~= "" and want ~= "" and n:find(want, 1, true)) then
                            found = m
                            break
                        elseif n == "" and UnnamedFallback[bossName] and BossWorldOf[bossName] == folder.Name then
                            unnamed = unnamed or m
                        end
                    end
                end
                if found then break end
            end
            if found then break end
            found = found or unnamed
        end
    end

    if not found then
        local npcsFolder = workspace:FindFirstChild("npcs")
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model")
                and not (npcsFolder and obj:IsDescendantOf(npcsFolder))
                and (norm(obj.Name) == want or (want2 and norm(obj.Name) == want2)) then
                found = obj
                break
            end
        end
    end

    if found then BossCache[key] = found else MissUntil[key] = os.clock() + 5 end
    return found
end

local function isBossOnCooldown(bossName, difficulty)
    local bossModel = findBossModel(bossName)
    if not bossModel then return false end

    local pgui = player:FindFirstChild("PlayerGui")
    if not pgui then return false end

    for _, gui in ipairs(pgui:GetChildren()) do
        if gui.Name == "bossCooldownBillboard" and gui:IsA("BillboardGui") then
            local adornee = gui.Adornee
            if adornee and adornee:IsDescendantOf(bossModel) then
                local label = gui:FindFirstChild("cooldownLabel", true)
                if label and label:IsA("TextLabel") and label.Text:find(difficulty, 1, true) then
                    return true
                end
            end
        end
    end
    return false
end

