-- أول سطح تحت نقطة معيّنة (نتجاهل الشخصية وجسم البوس)
local function groundAt(x, y, z, ignore)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = ignore
    params.RespectCanCollide = true -- يتجاهل الأجزاء الوهمية/الشفافة (طقس، مطر، حواجز)
    return workspace:Raycast(Vector3.new(x, y + 8, z), Vector3.new(0, -200, 0), params)
end

-- ينقلك جنب البوس على نفس أرضيته (مو فوق طوبة أو مبنى)
local function teleportNear(targetPosition, attempt, bossModel)
    local AttemptDistances = { {4, 6}, {3, 5}, {2, 3} }
    local range = AttemptDistances[attempt or 1] or AttemptDistances[1]
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local ignore = { char }
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Character then table.insert(ignore, pl.Character) end
    end
    if bossModel then table.insert(ignore, bossModel) end

    local base = groundAt(targetPosition.X, targetPosition.Y, targetPosition.Z, ignore)
    local groundY = base and base.Position.Y or targetPosition.Y
    groundY = math.min(groundY, targetPosition.Y) -- الأرضية ما تكون فوق البوس

    local spot
    for _ = 1, 10 do
        local angle = math.random() * math.pi * 2
        local dist = range[1] + math.random() * (range[2] - range[1])
        local x = targetPosition.X + math.cos(angle) * dist
        local z = targetPosition.Z + math.sin(angle) * dist
        local hit = groundAt(x, groundY, z, ignore)
        -- نقبل فقط نقطة على نفس مستوى أرضية البوس
        if hit and math.abs(hit.Position.Y - groundY) <= 3 then
            spot = hit.Position + Vector3.new(0, 3.5, 0)
            break
        end
    end
    if not spot then
        spot = Vector3.new(targetPosition.X + range[1], groundY + 3.5, targetPosition.Z)
    end

    root.AssemblyLinearVelocity = Vector3.zero
    root.CFrame = CFrame.new(spot)
    return true
end

local ResultCounter = 0
local LastBossCooldown = 300
if bossResultRemote then
    table.insert(activeConnections, bossResultRemote.OnClientEvent:Connect(function(won, boss, diff, cd)
        ResultCounter += 1
        if type(cd) == "number" then LastBossCooldown = cd end
