-- ==================== Roll Goal + Weather Wait tab (fixed) ====================
do
    -- احتياطات: لو المتغيرات هذي مو معرّفة قبل البلوك ما يطيح السكربت
    local Rep = Rep or game:GetService("ReplicatedStorage")
    local player = player or game:GetService("Players").LocalPlayer
    local norm = norm or function(s)
        return (tostring(s or ""):lower():gsub("[%s_%-]", ""))
    end
    if ignoreIdx then table.insert(ignoreIdx, "RollGoalWeather") end

    local ExpectedMax = 10000            -- ماكس البار الأساسي
    local ServerWeatherTimeout = 900     -- ثواني: بعدها نعتبر طقس الريموت منتهي لو ما جا إشارة نهاية

    local RollGoalText = "10K"
    local RollGoalWeathers = {}
    local WaitForWeatherFirst = true
    local FinishAfterWeatherEnds = true
    local rollGoalToken = 0
    local rollGoalToggle
    local ActiveServerWeather = nil
    local ActiveServerWeatherAt = 0

    local function parseAmount(s)
        s = tostring(s or ""):gsub(",", ""):gsub("%s", "")
        local num, suf = s:match("^([%d%.]+)([KkMmBb]?)$")
        num = tonumber(num)
        if not num then return nil end
        local mult = ({ k = 1e3, m = 1e6, b = 1e9 })[suf:lower()] or 1
        return num * mult
    end

    local function isShown(obj)
        local cur = obj
        while cur and cur ~= game do
            if cur:IsA("GuiObject") and not cur.Visible then return false end
            if cur:IsA("ScreenGui") and not cur.Enabled then return false end
            cur = cur.Parent
        end
        return true
    end

    -- أسماء الطقس من ReplicatedStorage.weatherEffects
    local WeatherNames, WeatherSet = {}, {}
    do
        local folder = Rep:FindFirstChild("weatherEffects")
        local skip = { possible = true, skyboxes = true }
        if folder then
            for _, c in ipairs(folder:GetChildren()) do
                if not skip[c.Name:lower()] then table.insert(WeatherNames, c.Name) end
            end
        end
        if #WeatherNames == 0 then
            WeatherNames = {
                "Arcane", "Aurora", "Awakened", "Doodle", "Eclipse", "Galactic", "Glitch", "Goofy",
                "Hailstorm", "Ice Age", "Light Rain", "Mashup", "Monsoon", "Sandstorm", "Snowfall",
                "Thunderstorm", "Windy",
            }
        end
        table.sort(WeatherNames)
        for _, n in ipairs(WeatherNames) do WeatherSet[norm(n)] = true end
    end

    -- استماع لريموت weatherUpdate
    local weatherUpdateRemote = Rep:FindFirstChild("weatherUpdate")
    if weatherUpdateRemote then
        local conn = weatherUpdateRemote.OnClientEvent:Connect(function(a, b)
            local candidate = nil
            if type(a) == "string" then
                candidate = a
            elseif type(a) == "table" then
                candidate = a.weather or a.Weather or a.name or a.Name or a.type or a[1]
            elseif type(b) == "string" then
                candidate = b
            end
            if type(candidate) == "string" then
                local n = norm(candidate)
                if n == "none" or n == "clear" or n == "" then
                    ActiveServerWeather = nil
                elseif WeatherSet[n] then
                    ActiveServerWeather = candidate
                    ActiveServerWeatherAt = os.clock()
                end
            elseif a == nil then
                ActiveServerWeather = nil
            end
        end)
        if activeConnections then table.insert(activeConnections, conn) end
    end

    -- زر Roll!
    local rollBtn
    local function findRollButton()
        if rollBtn and rollBtn.Parent and isShown(rollBtn) then return rollBtn end
        rollBtn = nil
        local pgui = player:FindFirstChild("PlayerGui")
        if not pgui then return nil end
        local dm = pgui:FindFirstChild("Main")
        local db = dm and dm:FindFirstChild("Bottom")
        local directBtn = db and db:FindFirstChild("RollButton", true)
        if directBtn and directBtn:IsA("GuiButton") and isShown(directBtn) then
            rollBtn = directBtn
            return rollBtn
        end
        for _, d in ipairs(pgui:GetDescendants()) do
            if d:IsA("TextButton") and d.Text == "Roll!" and isShown(d) then
                rollBtn = d
                break
            elseif d:IsA("TextLabel") and d.Text == "Roll!" and isShown(d) then
                local b = d:FindFirstAncestorWhichIsA("GuiButton")
                if b then
                    rollBtn = b
                    break
                end
            end
        end
        return rollBtn
    end

    local rollRemote = Rep:FindFirstChild("RollRequest")
    local function doRoll()
        if rollRemote then
            pcall(function() rollRemote:FireServer() end)
        else
            local btn = findRollButton()
            if btn and pressButton then pressButton(btn) end
        end
    end

    -- قراءة بار التقدم مثل "854/10K"
    local function parseProgressText(t)
        local a, as, b, bs = tostring(t):match("^%s*([%d%.,]+)%s*([KkMmBb]?)%s*/%s*([%d%.,]+)%s*([KkMmBb]?)%s*$")
        if not a then return nil end
        local cur = parseAmount(a .. as)
        local max = parseAmount(b .. bs)
        if not cur or not max then return nil end
        -- استبعاد بطاقات الندرة مثل 1/240K
        if max ~= ExpectedMax and cur == 1 and as == "" then return nil end
        return cur, max
    end

    local progLabel, lastProgScan = nil, 0
    local function findProgressLabel()
        if progLabel and progLabel.Parent then return progLabel end
        progLabel = nil
        if os.clock() - lastProgScan < 1.5 then return nil end
        lastProgScan = os.clock()
        local btn = findRollButton()
        local pgui = player:FindFirstChild("PlayerGui")
        if not pgui then return nil end

        -- المسار المؤكد: Main.Bottom.rollButtons.RollButtonFrame.RollButton.progressContainer.progressLabel
        local main = pgui:FindFirstChild("Main")
        local bottom = main and main:FindFirstChild("Bottom")
        local direct = bottom and bottom:FindFirstChild("progressLabel", true)
        if direct and direct:IsA("TextLabel") and parseProgressText(direct.Text) then
            progLabel = direct
            return progLabel
        end

        local best, bestDist
        for _, d in ipairs(pgui:GetDescendants()) do
            if d:IsA("TextLabel") and isShown(d) then
                local cur, max = parseProgressText(d.Text)
                if cur and max then
                    if btn then
                        local bx = btn.AbsolutePosition.X + btn.AbsoluteSize.X / 2
                        local by = btn.AbsolutePosition.Y
                        local cx = d.AbsolutePosition.X + d.AbsoluteSize.X / 2
                        local cy = d.AbsolutePosition.Y + d.AbsoluteSize.Y / 2
                        if cy < by and math.abs(cx - bx) < 400 then
                            local dist = by - cy
                            if not bestDist or dist < bestDist then best, bestDist = d, dist end
                        end
                    elseif max == ExpectedMax then
                        best = d
                        break
                    end
                end
            end
        end
        progLabel = best
        return progLabel
    end

    -- يرجّع nil إذا البار مو موجود (ما يرجّع قيمة قديمة)
    local function readProgress()
        local lbl = findProgressLabel()
        if lbl and isShown(lbl) then
            local cur, max = parseProgressText(lbl.Text)
            if cur then return cur, max end
        end
        progLabel = nil
        return nil, nil
    end

    -- قراءة الطقس من الواجهة + ريموت السيرفر
    local weatherLabel, lastWeatherScan = nil, 0
    local function readWeatherPanel(pgui)
        -- المسار المؤكد من الـ dump: Main.weatherInfo.nameContainer.nameLabel
        -- (نتجنب fountainBoostUI.durationLabel لأنه يطابق "Ends in:" أيضاً)
        local main = pgui:FindFirstChild("Main")
        local wi = main and main:FindFirstChild("weatherInfo")
        if wi then
            local nl = wi:FindFirstChild("nameLabel", true)
            if nl and nl:IsA("TextLabel") and WeatherSet[norm(nl.Text)] then
                return nl
            end
            return nil
        end
        for _, d in ipairs(pgui:GetDescendants()) do
            if d:IsA("TextLabel") and d.Text:match("^Ends in:") and isShown(d) then
                local container = d.Parent
                for _ = 1, 4 do
                    if not container then break end
                    local fallback
                    for _, c in ipairs(container:GetDescendants()) do
                        if c:IsA("TextLabel") and WeatherSet[norm(c.Text)] then
                            if c.Name == "nameLabel" then return c end
                            fallback = fallback or c
                        end
                    end
                    if fallback then return fallback end
                    container = container.Parent
                end
            end
        end
        return nil
    end

    local function currentWeather()
        if weatherLabel and weatherLabel.Parent and isShown(weatherLabel) and WeatherSet[norm(weatherLabel.Text)] then
            return weatherLabel.Text
        end
        weatherLabel = nil
        if os.clock() - lastWeatherScan >= 1 then
            lastWeatherScan = os.clock()
            local pgui = player:FindFirstChild("PlayerGui")
            if pgui then
                weatherLabel = readWeatherPanel(pgui)
                if not weatherLabel then
                    for _, d in ipairs(pgui:GetDescendants()) do
                        if d:IsA("TextLabel") and WeatherSet[norm(d.Text)] and isShown(d) then
                            weatherLabel = d
                            break
                        end
                    end
                end
            end
        end
        if weatherLabel and weatherLabel.Parent and isShown(weatherLabel) then
            return weatherLabel.Text
        end
        -- طقس الريموت ينتهي تلقائياً بعد مدة لو ما جا إشارة نهاية
        if ActiveServerWeather and os.clock() - ActiveServerWeatherAt > ServerWeatherTimeout then
            ActiveServerWeather = nil
        end
        return ActiveServerWeather
    end

    local function weatherMatches(w)
        if next(RollGoalWeathers) == nil then return true end
        if not w then return false end
        local n = norm(w)
        if RollGoalWeathers[n] then return true end
        return n == "mashup"
    end

    local function stopRollGoal(reason)
        if reason then Rayfield:Notify({ Title = "Roll Goal", Content = reason, Duration = 5 }) end
        if rollGoalToggle then rollGoalToggle:Set(false) end
    end

    -- المنطق الرئيسي:
    -- 1. ينتظر الطقس المطلوب
    -- 2. لما يجي، يرول لين يوصل الهدف (حتى لو خلص الطقس)
    -- 3. لما يوصل يوقف، وينتظر البار ينزل + يرجع الطقس
    local function runRollGoal(token)
        local target = parseAmount(RollGoalText)
        if not target then
            stopRollGoal("Invalid target. Use a number like 10K, 5000 or 1.5M")
            return
        end

        local collectingSession = not WaitForWeatherFirst
        local notifiedGoal = false
        local missingSince = nil

        while rollGoalToken == token do
            local cur = readProgress()

            if cur == nil then
                missingSince = missingSince or os.clock()
                if os.clock() - missingSince > 8 then
                    stopRollGoal("Roll bar (like 854/10K) not found on screen")
                    return
                end
                task.wait(0.3)
            else
                missingSince = nil
                local w = currentWeather()
                local isGoodWeather = weatherMatches(w)

                if cur >= target then
                    if collectingSession or not notifiedGoal then
                        collectingSession = false
                        notifiedGoal = true
                        Rayfield:Notify({
                            Title = "Roll Goal",
                            Content = "Reached target (" .. tostring(cur) .. "/" .. RollGoalText .. "). Paused until bar resets & weather returns!",
                            Duration = 5,
                        })
                    end
                    task.wait(0.5)
                else
                    notifiedGoal = false

                    if isGoodWeather and not collectingSession then
                        collectingSession = true
                        Rayfield:Notify({
                            Title = "Roll Goal",
                            Content = "Weather active (" .. tostring(w or "Any") .. ")! Rolling until " .. RollGoalText,
                            Duration = 4,
                        })
                    end

                    if collectingSession and (FinishAfterWeatherEnds or isGoodWeather) then
                        doRoll()
                        task.wait(0.18)
                    else
                        if not FinishAfterWeatherEnds and not isGoodWeather then
                            collectingSession = false
                        end
                        task.wait(0.4)
                    end
                end
            end
        end
    end

    local RollGoalTab = Window:CreateTab("Roll Goal", 4483362458)

    RollGoalTab:CreateSection("Weather -> Roll to Goal -> Repeat")

    RollGoalTab:CreateInput({
        Name = "Target roll progress (e.g. 10K, 9990, 5000)",
        CurrentValue = "10K",
        PlaceholderText = "10K",
        RemoveTextAfterFocusLost = false,
        Flag = "RollGoalTarget",
        Callback = function(v)
            if v and v ~= "" then RollGoalText = v end
        end,
    })

    RollGoalTab:CreateDropdown({
        Name = "Trigger Weathers (weatherEffects)",
        Options = WeatherNames,
        CurrentOption = {},
        MultipleOptions = true,
        Flag = "RollGoalWeathers",
        Callback = function(list)
            RollGoalWeathers = {}
            for _, n in ipairs(list) do
                if n ~= "None" then RollGoalWeathers[norm(n)] = true end
            end
        end,
    })

    RollGoalTab:CreateToggle({
        Name = "Wait for selected weather before starting",
        CurrentValue = true,
        Flag = "RollGoalWaitWeatherFirst",
        Callback = function(v) WaitForWeatherFirst = v end,
    })

    RollGoalTab:CreateToggle({
        Name = "Keep rolling to target even if weather ends early",
        CurrentValue = true,
        Flag = "RollGoalFinishAfterWeather",
        Callback = function(v) FinishAfterWeatherEnds = v end,
    })

    rollGoalToggle = RollGoalTab:CreateToggle({
        Name = "Start Auto Roll Goal Cycle",
        CurrentValue = false,
        Flag = "RollGoalWeather",
        Callback = function(Value)
            rollGoalToken += 1
            local myToken = rollGoalToken
            if not Value then return end
            task.spawn(function()
                local ok, err = pcall(runRollGoal, myToken)
                if not ok then warn("roll goal error:", err) end
            end)
        end,
    })

    RollGoalTab:CreateSection("Debug")

    RollGoalTab:CreateButton({
        Name = "Show detected roll bar + weather",
        Callback = function()
            progLabel, weatherLabel = nil, nil
            lastProgScan, lastWeatherScan = 0, 0
            local cur, max = readProgress()
            local w = currentWeather()
            print("[RollGoal] bar:", progLabel and progLabel:GetFullName() or "not found", "| value:", cur, "/", max)
            print("[RollGoal] weather:", weatherLabel and weatherLabel:GetFullName() or "not found", "|", w)
            Rayfield:Notify({
                Title = "Roll Goal",
                Content = "Bar: " .. tostring(cur) .. "/" .. tostring(max) .. " | Weather: " .. tostring(w),
                Duration = 6,
            })
        end,
    })
end
