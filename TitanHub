-- ==================== منطق الفارم والعوالم ====================
local SkipUntil = {}

local function attemptBoss(boss, diff, alive, worldKey)
    local k = boss .. "|" .. diff
    if SkipUntil[k] and os.clock() < SkipUntil[k] then return false end
    if not recoverIfDead(worldKey, alive) then return false end
    if isBossOnCooldown(boss, diff) then return false end

    local function stillGoing() return alive() and isCharAlive() end

    local fired = hitAndRunBoss(boss, diff, stillGoing, true)
    if not alive() then return false end

    if not fired then
        if not isCharAlive() then return false end
        SkipUntil[k] = os.clock() + 15
        return false
    end
    if not isCharAlive() then return false end

    task.wait(0.8)
    if isBossOnCooldown(boss, diff) then
        SkipUntil[k] = os.clock() + math.max(LastBossCooldown - 5, 20)
        return true
    end

    SkipUntil[k] = os.clock() + 45
    return false
end

local function diffsToRun()
    if not LadderMode then return {SelectedDifficulty} end
    local list = {}
    for _, d in ipairs(DiffList) do
        table.insert(list, d)
        if d == MaxDifficulty then break end
    end
    return list
end

-- bossFilter (اختياري): جدول set لتحديد بوسات معينة فقط
local function worldHasWork(worldKey, bossFilter)
    for _, diff in ipairs(diffsToRun()) do
        for _, boss in ipairs(BossHierarchy[worldKey]) do
            if not bossFilter or bossFilter[boss] then
                local s = SkipUntil[boss .. "|" .. diff]
                if not s or os.clock() >= s then return true end
            end
        end
    end
    return false
end

local function farmWorldOnce(worldKey, alive, bossFilter)
    local didAny = false
    for _, diff in ipairs(diffsToRun()) do
        for _, boss in ipairs(BossHierarchy[worldKey]) do
            if not alive() then return didAny end
            if not bossFilter or bossFilter[boss] then
                if attemptBoss(boss, diff, alive, worldKey) then didAny = true end
            end
        end
    end
    return didAny
end

local function runSmartWorldFarm(worldKey)
    startMode(worldKey, function(alive)
        forceTeleportToWorld(worldKey)
        while alive() do
            local didAny = farmWorldOnce(worldKey, alive)
            task.wait(didAny and 0.5 or 3)
        end
    end)
end

local function runAllWorldsFarm()
    startMode("all", function(alive)
        while alive() do
            local didAny = false
            for _, worldKey in ipairs(WorldOrder) do
                if not alive() then break end
                if worldHasWork(worldKey) then
                    forceTeleportToWorld(worldKey)
                    if farmWorldOnce(worldKey, alive) then didAny = true end
                end
            end
            task.wait(didAny and 0.5 or 3)
        end
    end)
end

-- ==================== Custom AutoBoss: صعوبة مستقلة لكل بوس ====================
-- BossDiffs[boss] = { Normal = true, Hard = true, ... }  (فاضي = ما يُفارم)
local DiffSet = { Normal = true, Hard = true, Extreme = true, Nightmare = true }
local BossDiffs = { cart_titan = { Normal = true } }

local function hasSelectedBosses()
    for _, list in pairs(BossHierarchy) do
        for _, boss in ipairs(list) do
            if BossDiffs[boss] and next(BossDiffs[boss]) ~= nil then return true end
        end
    end
    return false
end

local function customWorldHasWork(worldKey)
    for _, diff in ipairs(DiffList) do
        for _, boss in ipairs(BossHierarchy[worldKey]) do
            if BossDiffs[boss] and BossDiffs[boss][diff] then
                local s = SkipUntil[boss .. "|" .. diff]
                if not s or os.clock() >= s then return true end
            end
        end
    end
    return false
end

local function customFarmWorldOnce(worldKey, alive)
    local didAny = false
    for _, diff in ipairs(DiffList) do
        for _, boss in ipairs(BossHierarchy[worldKey]) do
            if not alive() then return didAny end
            if BossDiffs[boss] and BossDiffs[boss][diff] then
                if attemptBoss(boss, diff, alive, worldKey) then didAny = true end
            end
        end
    end
    return didAny
end

local function runCustomBossFarm()
    if not hasSelectedBosses() then
        Rayfield:Notify({ Title = "Custom AutoBoss", Content = "Pick at least one boss difficulty first", Duration = 4 })
        if ModeToggles["custom"] then
            pcall(function() ModeToggles["custom"]:Set(false) end)
        end
        return
    end

    startMode("custom", function(alive)
        while alive() do
            local didAny = false
            for _, worldKey in ipairs(WorldOrder) do
                if not alive() then break end
                -- الاختيارات تُقرأ في كل دورة، فتغييرها يسري مباشرة
                if customWorldHasWork(worldKey) then
                    forceTeleportToWorld(worldKey)
                    if customFarmWorldOnce(worldKey, alive) then didAny = true end
                end
            end
            task.wait(didAny and 0.5 or 3)
        end
    end)
end

