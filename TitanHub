local WorldShort = { ["1"] = "SHI", ["2"] = "LEAF", ["3"] = "INF", ["4"] = "MAR", ["5"] = "SHIB", ["raid"] = "RAID" }

local function titleCase(id)
    local t = id:gsub("_", " ")
    t = t:gsub("(%a)([%w]*)", function(a, rest) return a:upper() .. rest end)
    return t
end

local BossLabels, LabelToBoss = {}, {}
for _, worldKey in ipairs(WorldOrder) do
    for _, boss in ipairs(BossHierarchy[worldKey]) do
        local label = WorldShort[worldKey] .. " - " .. (BossDisplayName[boss] or titleCase(boss))
        table.insert(BossLabels, label)
        LabelToBoss[label] = boss
    end
end

local DiffDropdowns = {}

local function labelsForDiff(diff)
    local out = {}
    for _, label in ipairs(BossLabels) do
        local boss = LabelToBoss[label]
        if BossDiffs[boss] and BossDiffs[boss][diff] then table.insert(out, label) end
    end
    return out
end

