-- ==================== الجديد: Custom AutoBoss (اختيار بوسات محددة) ====================
local function hasSelectedBosses()
    return next(SelectedBosses) ~= nil
end

local function runCustomBossFarm()
    if not hasSelectedBosses() then
        Rayfield:Notify({ Title = "Custom AutoBoss", Content = "اختر بوس واحد على الأقل من القائمة أولاً", Duration = 4 })
        if ModeToggles["custom"] then
            pcall(function() ModeToggles["custom"]:Set(false) end)
        end
        return
    end

    startMode("custom", function(alive)
        while alive() do
            local didAny = false
            for _, worldKey in ipairs(WorldOrder) do
                if not alive() then break end
                -- القائمة تُقرأ في كل دورة، فتغيير الاختيار يسري مباشرة
                if worldHasWork(worldKey, SelectedBosses) then
                    forceTeleportToWorld(worldKey)
                    if farmWorldOnce(worldKey, alive, SelectedBosses) then didAny = true end
                end
            end
            task.wait(didAny and 0.5 or 3)
        end
    end)
end

