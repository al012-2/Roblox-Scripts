local function getBattleParts()
    local pgui = player:FindFirstChild("PlayerGui")
    local ui = pgui and pgui:FindFirstChild("BattleUI")
    local container = ui and ui:FindFirstChild("battleContainer")
    local toggle = ui and ui:FindFirstChild("toggleBattleUI")
    return ui, container, toggle
end

local clickedForStart, clickTries, lastToggleClick = -1, 0, 0
local function collapseBattleView()
    local ui, container, toggle = getBattleParts()
    if not (ui and container and toggle) then return end
    if BattleStarts ~= clickedForStart then
        clickedForStart = BattleStarts
        clickTries = 0
    end
    if ui.Enabled and container.Visible and clickTries < 3
        and os.clock() - lastToggleClick > 0.8 then
        lastToggleClick = os.clock()
        clickTries += 1
        pressButton(toggle)
    end
end

local Lighting = game:GetService("Lighting")
local hiddenEffects = {}

local function hideBlurEffects()
    for _, parent in ipairs({Lighting, workspace.CurrentCamera}) do
        if parent then
            for _, e in ipairs(parent:GetChildren()) do
                if (e:IsA("BlurEffect") or e:IsA("DepthOfFieldEffect")) and e.Enabled then
                    e.Enabled = false
                    hiddenEffects[e] = true
                end
            end
        end
    end
end

local function restoreBlurEffects()
    for e in pairs(hiddenEffects) do
        if e.Parent then pcall(function() e.Enabled = true end) end
    end
    hiddenEffects = {}
end

local function hideBattleGuis()
    hideBlurEffects()
    local pgui = player:FindFirstChild("PlayerGui")
    if not pgui then return end
    for _, gui in ipairs(pgui:GetChildren()) do
        if shouldHideGui(gui) and gui.Enabled then
            gui.Enabled = false
            hiddenGuis[gui] = true
        end
    end
end

local function restoreBattleGuis()
    for gui in pairs(hiddenGuis) do
        if gui.Parent then pcall(function() gui.Enabled = true end) end
    end
    hiddenGuis = {}
    restoreBlurEffects()
end

