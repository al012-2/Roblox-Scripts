-- ==================== General utilities ====================
local function humanDelay(minSec, maxSec)
    task.wait(minSec + math.random() * (maxSec - minSec))
end

local function getCharWithTimeout(timeout)
    local char = player.Character
    if char then return char end
    local t = os.clock()
    repeat
        task.wait(0.2)
        char = player.Character
    until char or os.clock() - t > (timeout or 10)
    return char
end

local function isCharAlive()
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    return hum ~= nil and root ~= nil and hum.Health > 0
end

local function norm(s)
    return (s:lower():gsub("[%s_%-]", ""))
end

-- small caches so heavy lookups do not run every frame
local PerfCache = { cd = {}, scanAt = 0 }

-- ==================== World navigation ====================
local function returnToLobby()
    local char = getCharWithTimeout(5)
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if teleportAreaRemote then
        pcall(function() teleportAreaRemote:FireServer("Lobby") end)
    end

    local lobby = workspace:FindFirstChild("Lobby")
    if lobby then
        local lobbySpawn = lobby:FindFirstChildWhichIsA("SpawnLocation", true) or lobby:FindFirstChild("portals")
        if lobbySpawn then
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = lobbySpawn.CFrame + Vector3.new(0, 4, 0)
            task.wait(0.5)
        end
    end
end

local lastTpWorld, lastTpChar = nil, nil

local function nearWorldBosses(worldKey)
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    if worldKey == "raid" then
        local raidFolder = workspace:FindFirstChild("KaijuRaid")
        if not raidFolder then return false end
        -- "am I inside the raid map": distance to the raid portal spawn (no map scan, works even with no bosses alive)
        local sp = raidFolder:FindFirstChild("portal")
        sp = sp and sp:FindFirstChild("spawnLoc")
        if sp and sp:IsA("BasePart") then
            return (sp.Position - root.Position).Magnitude < 600
        end
        return false
    end
    local folder = workspace:FindFirstChild("bossNpcs")
    folder = folder and folder:FindFirstChild(tostring(worldKey))
    if not folder then return true end
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") then
            local ok, pos = pcall(function() return m:GetPivot().Position end)
            if ok and (pos - root.Position).Magnitude < 500 then return true end
        end
    end
    return false
end

-- press a button the way a click would (runs the game's own handler)
local function fireButton(btn)
    if getconnections then
        for _, sig in ipairs({ btn.Activated, btn.MouseButton1Click, btn.MouseButton1Down }) do
            local ok, conns = pcall(getconnections, sig)
            if ok and conns and #conns > 0 then
                for _, c in ipairs(conns) do pcall(function() c:Fire() end) end
                return true
            end
        end
    end
    if firesignal then
        pcall(function() firesignal(btn.MouseButton1Click) end)
        pcall(function() firesignal(btn.Activated) end)
        return true
    end
    return false
end

-- find the world's button inside the game's Teleport menu and press it (FALLBACK only)
local function pressTeleportMenuButton(keyword, tabName)
    local pgui = player:FindFirstChild("PlayerGui")
    local ok, frame = pcall(function() return pgui.Inventory.InventoryFrame.teleportFrame end)
    if not (ok and frame) then return false end

    if tabName then
        local tabFrame = frame:FindFirstChild("tabFrame")
        local tab = tabFrame and tabFrame:FindFirstChild(tabName)
        if tab and tab:IsA("GuiButton") then
            fireButton(tab)
            task.wait(0.6)
        end
    end

    local collection = frame:FindFirstChild("CollectionFrame")
    local scope = (tabName == "raidsTab" and collection and collection:FindFirstChild("raidScrollFrame")) or frame

    for _, d in ipairs(scope:GetDescendants()) do
        if d.Name == "tpFrame" then
            local nameLabel = d:FindFirstChild("nameLabel")
            if nameLabel and nameLabel:IsA("TextLabel") and norm(nameLabel.Text):find(keyword, 1, true) then
                local btn = d:FindFirstChild("teleportButton", true)
                if btn and btn:IsA("GuiButton") and fireButton(btn) then return true end
            end
        end
    end
    return false
end

local lastRaidNotify = 0

local function forceTeleportToWorld(worldKey)
    local char = getCharWithTimeout(10)
    if not char then return end
    local root = char:WaitForChild("HumanoidRootPart", 5)
    if not root then return end

    -- If we are already near the world's bosses, don't teleport again
    if nearWorldBosses(worldKey) then
        lastTpWorld, lastTpChar = worldKey, char
        return
    end

    if worldKey == "raid" then
        local startPos = root.Position

        local function arrived(maxWait)
            local t = os.clock()
            repeat
                if nearWorldBosses("raid") then return true end
                task.wait(0.3)
            until os.clock() - t >= maxWait
            return false
        end

        -- 1) the real arguments captured with the Spy (direct remote call, no GUI needed)
        if teleportAreaRemote then
            for _, args in ipairs({
                { "Kaiju Raid", nil },
                { "raid", "kaiju" },
            }) do
                pcall(function() teleportAreaRemote:FireServer(args[1], args[2]) end)
                if arrived(6) then return end

                local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if r and (r.Position - startPos).Magnitude > 150 then
                    task.wait(1.5)
                    return
                end
            end
        end

        -- 2) fallback: press the Kaiju Raid button in the game's Teleport menu
        if pressTeleportMenuButton("kaiju", "raidsTab") and arrived(6) then return end

        -- 3) last resort: move to the raid map if it is loaded
        local raidFolder = workspace:FindFirstChild("KaijuRaid")
        if raidFolder then
            local raidPart = raidFolder:FindFirstChildWhichIsA("BasePart", true)
            if raidPart then
                root.AssemblyLinearVelocity = Vector3.zero
                root.CFrame = raidPart.CFrame + Vector3.new(0, 3, 0)
                task.wait(1.0)
            end
        end

        if not nearWorldBosses("raid") and os.clock() - lastRaidNotify > 30 then
            lastRaidNotify = os.clock()
            Rayfield:Notify({ Title = "Raid", Content = "Could not reach the Kaiju Raid (maybe closed right now).", Duration = 6 })
        end
        return
    end

    if lastTpWorld == worldKey and lastTpChar == char then return end

    local areaIndex = tonumber(worldKey)
    local startPos = root.Position
    if teleportAreaRemote and areaIndex then
        for _ = 1, 2 do
            pcall(function() teleportAreaRemote:FireServer(areaIndex, nil) end)
            local t = os.clock()
            while os.clock() - t < 5 do
                task.wait(0.25)
                local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if r and nearWorldBosses(worldKey) then
                    local moved = (r.Position - startPos).Magnitude >= 25
                    if moved or os.clock() - t >= 2 then
                        task.wait(0.5)
                        lastTpWorld, lastTpChar = worldKey, player.Character
                        return
                    end
                end
            end
        end
    end

    if TravelViaMenu and teleportAreaRemote then
        warn("[Travel] Teleport menu did not move us to world " .. tostring(worldKey) .. " (portals disabled)")
        return
    end

    local lobby = workspace:FindFirstChild("Lobby")
    local portals = lobby and lobby:FindFirstChild("portals")
    local portalFolder = portals and portals:FindFirstChild(tostring(worldKey))

    if not portalFolder then
        returnToLobby()
        task.wait(0.5)
        lobby = workspace:FindFirstChild("Lobby")
        portals = lobby and lobby:FindFirstChild("portals")
        portalFolder = portals and portals:FindFirstChild(tostring(worldKey))
    end

    if portalFolder then
        local pModel = portalFolder:FindFirstChild("portalModel")
        local triggerPart = nil
        if pModel then
            triggerPart = pModel:FindFirstChild("Part") or pModel:FindFirstChildWhichIsA("BasePart", true)
        end
        triggerPart = triggerPart or portalFolder:FindFirstChildWhichIsA("BasePart", true)

        if triggerPart and root.Parent then
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = triggerPart.CFrame
            task.wait(0.15)
            if firetouchinterest then
                firetouchinterest(root, triggerPart, 0)
                task.wait(0.1)
                firetouchinterest(root, triggerPart, 1)
            end
            humanDelay(1.2, 1.6)
        end
    end
end

local function recoverIfDead(worldKey, alive)
    if isCharAlive() then return true end
    local t = os.clock()
    repeat
        task.wait(0.5)
    until isCharAlive() or not alive() or os.clock() - t > 30
    if not alive() or not isCharAlive() then return false end
    humanDelay(1.5, 2.0)
    forceTeleportToWorld(worldKey)
    return true
end

-- ==================== Boss lookup and cooldowns ====================
local BossCache, MissUntil = {}, {}

local function findBossModel(bossName)
    local key = bossName:lower()
    local cached = BossCache[key]
    if cached and cached.Parent and cached:IsDescendantOf(workspace) then
        return cached
    end
    BossCache[key] = nil

    if MissUntil[key] and os.clock() < MissUntil[key] then return nil end

    local want = norm(bossName)
    local want2 = BossDisplayName[bossName] and norm(BossDisplayName[bossName]) or nil
    local found

    local searchRoots = { workspace:FindFirstChild("bossNpcs"), workspace:FindFirstChild("KaijuRaid") }
    for _, root in ipairs(searchRoots) do
        if root then
            local unnamed
            for _, folder in ipairs(root:GetChildren()) do
                if folder:IsA("Model") then
                    local n = norm(folder.Name)
                    if folder:GetAttribute("bossId") == bossName or n == want or (want2 and n == want2) then
                        found = folder
                        break
                    end
                end
                for _, m in ipairs(folder:GetChildren()) do
                    if m:IsA("Model") then
                        local n = norm(m.Name)
                        if m:GetAttribute("bossId") == bossName
                            or n == want
                            or (want2 and n == want2)
                            or (n ~= "" and want ~= "" and n:find(want, 1, true)) then
                            found = m
                            break
                        elseif n == "" and UnnamedFallback[bossName] and BossWorldOf[bossName] == folder.Name then
                            unnamed = unnamed or m
                        end
                    end
                end
                if found then break end
            end
            if found then break end
            found = found or unnamed
        end
    end

    -- full-workspace scan is expensive: allowed at most once every 20s (shared by all bosses)
    if not found and os.clock() - PerfCache.scanAt > 20 then
        PerfCache.scanAt = os.clock()
        local npcsFolder = workspace:FindFirstChild("npcs")
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model")
                and not (npcsFolder and obj:IsDescendantOf(npcsFolder))
                and (norm(obj.Name) == want or (want2 and norm(obj.Name) == want2)) then
                found = obj
                break
            end
        end
    end

    if found then BossCache[key] = found else MissUntil[key] = os.clock() + 5 end
    return found
end

local function isBossOnCooldownRaw(bossName, difficulty)
    local bossModel = findBossModel(bossName)
    if not bossModel then return false end

    local pgui = player:FindFirstChild("PlayerGui")
    if not pgui then return false end

    for _, gui in ipairs(pgui:GetChildren()) do
        if gui.Name == "bossCooldownBillboard" and gui:IsA("BillboardGui") then
            local adornee = gui.Adornee
            if adornee and adornee:IsDescendantOf(bossModel) then
                local label = gui:FindFirstChild("cooldownLabel", true)
                if label and label:IsA("TextLabel") and label.Text:find(difficulty, 1, true) then
                    return true
                end
            end
        end
    end
