       Callback = function(Options)
          local list = type(Options) == "table" and Options or {Options}
          local chosen = {}
          for _, label in ipairs(list) do
              local boss = LabelToBoss[label]
              if boss then chosen[boss] = true end
          end
          for _, boss in ipairs(AllBossList) do
              BossDiffs[boss] = BossDiffs[boss] or {}
              BossDiffs[boss][diff] = chosen[boss] or nil
          end
       end,
    })
end

