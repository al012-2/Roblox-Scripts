local macroDropdownRef

local function GetSavedMacrosList()
    SavedMacros = {}
    if listfiles then
        local success, files = pcall(function() return listfiles(FolderName) end)
        if success then
            for _, file in ipairs(files) do
                if file:match(".json$") and file ~= "AutoConfig.json" then
                    local name = file:match("([^/\\]+)%.json$")
                    if name then
                        table.insert(SavedMacros, name)
                    end
                end
            end
        end
    end
    if #SavedMacros == 0 then
        table.insert(SavedMacros, "No Macros Found")
    end
    return SavedMacros
end

local function SaveCurrentMacro()
    if writefile then
        local success, encoded = pcall(function() return HttpService:JSONEncode(MacroData) end)
        if success then
            writefile(FolderName .. "/" .. currentMacroName .. ".json", encoded)
            if macroDropdownRef then
                macroDropdownRef:Refresh(GetSavedMacrosList())
            end
            Rayfield:Notify({Title = "Saved Successfully", Content = "Macro (" .. currentMacroName .. ") saved with steps: " .. #MacroData, Duration = 4})
        else
            Rayfield:Notify({Title = "Save Error", Content = "Failed to encode macro data!", Duration = 3})
        end
    end
end

local function LoadMacroByName(name)
    local path = FolderName .. "/" .. name .. ".json"
    if readfile and isfile(path) then
        local success, res = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
        if success and type(res) == "table" then
            MacroData = res
            currentMacroName = name
            ConfigData.SelectedMacro = name
            SaveConfig()
            return true
        end
    end
    return false
end

local function CleanArg(arg)
    local t = typeof(arg)
    if t == "Vector3" then
        return {__type = "Vector3", x = arg.X, y = arg.Y, z = arg.Z}
    elseif t == "CFrame" then
        local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = arg:GetComponents()
        return {__type = "CFrame", components = {x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22}}
    elseif t == "number" or t == "string" or t == "boolean" then
        return arg
    elseif t == "table" then
        local cleanTable = {}
        for k, v in pairs(arg) do
            local cleaned = CleanArg(v)
            if cleaned ~= nil then
                cleanTable[k] = cleaned
            end
        end
        return cleanTable
    end
    return nil
end

local function RestoreArg(arg)
    if type(arg) == "table" then
        if arg.__type == "Vector3" then
            return Vector3.new(arg.x, arg.y, arg.z)
        elseif arg.__type == "CFrame" then
            local c = arg.components
            return CFrame.new(c[1], c[2], c[3], c[4], c[5], c[6], c[7], c[8], c[9], c[10], c[11], c[12])
        else
            local restoredTable = {}
            for k, v in pairs(arg) do
                restoredTable[k] = RestoreArg(v)
            end
            return restoredTable
        end
    end
    return arg
end

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if isRecording and (method == "FireServer" or method == "InvokeServer") then
        local remoteName = self.Name
        if remoteName:match("PlaceTower") or remoteName:match("UpgradeTower") or remoteName:match("SellTower") or remoteName:match("PlayerReadyToNextWave") then
            local currentTime = math.floor((GetCurrentTime() - recordStartTime) * 10) / 10
            
            local cleanArgs = {}
            for i, v in ipairs(args) do
                cleanArgs[i] = CleanArg(v)
            end
            
            local stepData = {
                RemoteName = remoteName,
                Arguments = cleanArgs,
                Time = currentTime
            }
            
            table.insert(MacroData, stepData)
            print("[EXACT REC] " .. remoteName .. " | Step: " .. #MacroData)
        end
    end
    
    return oldNamecall(self, ...)
end)

local function StartPlayingMacro()
    if isPlaying or #MacroData == 0 then return end
    
    isPlaying = true
    Rayfield:Notify({Title = "Playing", Content = "Executing macro steps: " .. #MacroData, Duration = 3})
    
    task.spawn(function()
        local playStartTime = GetCurrentTime()
        for _, step in ipairs(MacroData) do
            if not isPlaying then break end
            
            local targetTime = step.Time or 0
            local waitTime = targetTime - (GetCurrentTime() - playStartTime)
            if waitTime > 0 then task.wait(waitTime) end
            
            local remote = FindRemote(step.RemoteName)
            if remote then
                pcall(function()
                    local restoredArgs = {}
                    for i, v in ipairs(step.Arguments or {}) do
                        restoredArgs[i] = RestoreArg(v)
                    end
                    
                    remote:FireServer(unpack(restoredArgs))
                    print("[EXACT PLAYED] Success -> " .. step.RemoteName)
                end)
            end
        end
        isPlaying = false
    end)
end

