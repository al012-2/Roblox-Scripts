-- دالة بحث آمنة تضمن إرجاع Remote حقيقي وتتجاهل المجلدات
local function FindRemote(name)
    local success, result = pcall(function()
        for _, descendant in ipairs(ReplicatedStorage:GetDescendants()) do
            if descendant.Name == name and (descendant:IsA("RemoteEvent") or descendant:IsA("RemoteFunction")) then
                return descendant
            end
        end
        return ReplicatedStorage:FindFirstChild(name, true)
    end)
    if success and result and (result:IsA("RemoteEvent") or result:IsA("RemoteFunction")) then
        return result
    end
    return nil
end

