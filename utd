-- دوال تنظيف واسترجاع الإحداثيات
--------------------------------------------------
local function CleanArg(arg)
    local t = typeof(arg)
    if t == "Vector3" then
        return {__type = "Vector3", x = arg.X, y = arg.Y, z = arg.Z}
    elseif t == "CFrame" then
        local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = arg:GetComponents()
        return {__type = "CFrame", components = {x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22}}
    elseif t == "number" or t == "string" or t == "boolean" then
        return arg
    elseif t == "table" then
        local cleanTable = {}
        for k, v in pairs(arg) do
            local cleaned = CleanArg(v)
            if cleaned ~= nil then
                cleanTable[k] = cleaned
            end
        end
        return cleanTable
    end
    return nil
end

local function RestoreArg(arg)
    if type(arg) == "table" then
        if arg.__type == "Vector3" then
            return Vector3.new(arg.x, arg.y, arg.z)
        elseif arg.__type == "CFrame" then
            local c = arg.components
            return CFrame.new(c[1], c[2], c[3], c[4], c[5], c[6], c[7], c[8], c[9], c[10], c[11], c[12])
        else
            local restoredTable = {}
            for k, v in pairs(arg) do
                restoredTable[k] = RestoreArg(v)
            end
            return restoredTable
        end
    end
    return arg
end

