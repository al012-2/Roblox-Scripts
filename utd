local macroDropdownRef

local function GetSavedMacrosList()
    SavedMacros = {}
    if listfiles then
        local success, files = pcall(function() return listfiles(FolderName) end)
        if success then
            for _, file in ipairs(files) do
                if file:match(".json$") and file ~= "AutoConfig.json" then
                    local name = file:match("([^/\\]+)%.json$")
                    if name then
                        table.insert(SavedMacros, name)
                    end
                end
            end
        end
    end
    if #SavedMacros == 0 then
        table.insert(SavedMacros, "No Macros Found")
    end
    return SavedMacros
end

local function SaveCurrentMacro()
    if writefile then
        local success, encoded = pcall(function() return HttpService:JSONEncode(MacroData) end)
        if success then
            writefile(FolderName .. "/" .. currentMacroName .. ".json", encoded)
            if macroDropdownRef then
                macroDropdownRef:Refresh(GetSavedMacrosList())
            end
            Rayfield:Notify({Title = "💾 Saved Successfully", Content = "تم حفظ الماكرو (" .. currentMacroName .. ") برصيد خطوات: " .. #MacroData, Duration = 4})
        else
            Rayfield:Notify({Title = "❌ Save Error", Content = "فشل ترميز بيانات الماكرو!", Duration = 3})
        end
    end
end

local function LoadMacroByName(name)
    local path = FolderName .. "/" .. name .. ".json"
    if readfile and isfile(path) then
        local success, res = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
        if success and type(res) == "table" then
            MacroData = res
            currentMacroName = name
            ConfigData.SelectedMacro = name
            SaveConfig()
            return true
        end
    end
    return false
end

